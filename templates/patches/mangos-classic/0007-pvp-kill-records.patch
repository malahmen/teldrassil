+// kalimdor: the PvP kill records' table, made as the world starts - the stats
+// exporter reads it before any kill (World::SetInitialWorldSettings).
+void Unit::MakePvPKillTable()
+{
+    CharacterDatabase.DirectExecute(
+            "CREATE TABLE IF NOT EXISTS `kalimdor_pvp_kill` ("
+            " `id` int unsigned NOT NULL AUTO_INCREMENT, `time` bigint unsigned NOT NULL,"
+            " `killer` int unsigned NOT NULL, `killer_level` tinyint unsigned NOT NULL,"
+            " `victim` int unsigned NOT NULL, `victim_level` tinyint unsigned NOT NULL,"
+            " `map` smallint unsigned NOT NULL, `zone` int unsigned NOT NULL,"
+            " `battleground` tinyint unsigned NOT NULL, `honorable` tinyint unsigned NOT NULL,"
+            " PRIMARY KEY (`id`), KEY `killer` (`killer`), KEY `victim` (`victim`), KEY `time` (`time`))"
+            " ENGINE=InnoDB DEFAULT CHARSET=utf8 COMMENT='kalimdor: PvP kills, killing blows (stats)'");
+}
+
+// kalimdor: one row per PvP kill in kalimdor_pvp_kill (characters database;
+// Unit::Kill).
+void Unit::RecordPvPKill(Player* killer, Player* victim)
+{
+    // Honorable as the game rewards it: not a grey victim to the killer, no
+    // Honorless Target on it.
+    bool const honorable = !MaNGOS::XP::IsTrivialLevelDifference(killer->GetLevel(), victim->GetLevel()) &&
+        !victim->GetAura(2479, EFFECT_INDEX_0);
+    CharacterDatabase.PExecute("INSERT INTO `kalimdor_pvp_kill` (`time`, `killer`, `killer_level`, `victim`, `victim_level`, `map`, `zone`, `battleground`, `honorable`)"
+        " VALUES (%u, %u, %u, %u, %u, %u, %u, %u, %u)", uint32(time(nullptr)), killer->GetGUIDLow(), uint32(killer->GetLevel()),
+        victim->GetGUIDLow(), uint32(victim->GetLevel()), victim->GetMapId(), victim->GetZoneId(),
+        uint32(victim->GetMap()->IsBattleGround()), uint32(honorable));
+}
