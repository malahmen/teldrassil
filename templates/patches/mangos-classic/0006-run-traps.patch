+            float const dist2 = (entry->x - x) * (entry->x - x) + (entry->y - y) * (entry->y - y) + (entry->z - z) * (entry->z - z);
+            if (dist2 < best)
+            {
+                best = dist2;
+                graveyard = entry;
+            }
+        }
+    }
