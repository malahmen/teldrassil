 bool UnitAI::IsMainSpellPrevented(SpellEntry const* spellInfo) const
 {
+    // kalimdor: a creature in ranged mode can have no main spell (EventAI logs
+    // "has ranged mode action but no main spell", e.g. Pyrewood Watcher, 1891),
+    // and UpdateAI passes m_mainSpellInfo here unchecked: dereferencing it
+    // segfaulted the world server (core dump, 2026-10-29). No spell is a
+    // spell that cannot be cast.
+    if (!spellInfo)
+        return true;
+
     if (!m_unit->IsSpellReady(*spellInfo))
         return true;
 
