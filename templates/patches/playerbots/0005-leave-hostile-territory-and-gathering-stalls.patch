new file mode 100644
index 0000000..ba3d1d8
--- /dev/null
+++ b/playerbot/strategy/values/GatheringStalls.cpp
@@ -0,0 +1,52 @@
+#include "playerbot/playerbot.h"
+#include "GatheringStalls.h"
+
+#include <sstream>
+
+using namespace ai;
+
+// Kept per bot as "key:until key:until ..." in a manual string; a point is
+// keyed by its address, which the travel manager's destinations keep for the
+// server's life.
+static std::string Key(const WorldPosition* point)
+{
+    return std::to_string(reinterpret_cast<uintptr_t>(point));
+}
+
+bool GatheringStalls::IsGivenUp(PlayerbotAI* ai, const WorldPosition* point)
+{
+    std::string const list = ai->GetAiObjectContext()->GetValue<std::string>("manual string", "stalled gathers")->Get();
+    if (list.empty())
+        return false;
+
+    std::string const key = Key(point) + ":";
+    size_t const at = list.find(key);
+    if (at == std::string::npos || (at > 0 && list[at - 1] != ' '))
+        return false;
+
+    time_t const until = std::stoll(list.substr(at + key.size()));
+    return until > time(nullptr);
+}
+
+void GatheringStalls::GiveUp(PlayerbotAI* ai, const WorldPosition* point)
+{
+    std::string const list = ai->GetAiObjectContext()->GetValue<std::string>("manual string", "stalled gathers")->Get();
+    time_t const now = time(nullptr);
+
+    // Keep what has not expired, drop this point's old entry, add it anew.
+    std::string kept;
+    std::istringstream in(list);
+    std::string entry;
+    std::string const key = Key(point) + ":";
+    while (in >> entry)
+    {
+        size_t const colon = entry.find(':');
+        if (colon == std::string::npos || entry.compare(0, key.size(), key) == 0)
+            continue;
+        if (std::stoll(entry.substr(colon + 1)) > now)
+            kept += entry + " ";
+    }
+
+    kept += key + std::to_string(now + GiveUpFor);
+    ai->GetAiObjectContext()->GetValue<std::string>("manual string", "stalled gathers")->Set(kept);
+}
