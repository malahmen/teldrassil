+bool LeaveHostileTerritoryAction::Execute(Event& event)
+{
+    WorldPosition const botPosition(bot);
+
+    // The way out: of the travel graph's nodes in non-hostile territory, the
+    // one with the shortest walking route from here, on this continent
+    // however far - a faction's lands can be wide (an Alliance bot at Razor
+    // Hill has Durotar and the Barrens to cross), and a long walk is still
+    // better than a hearth. Straight-line nearest picked an island across
+    // open sea (Alcaz, off Dustwallow) - fatigue water - so candidates are
+    // ranked by route. A node whose area cannot be read (its map data not
+    // loaded) is not an exit: unknown is not "not hostile".
+    WorldPosition* exit = nullptr;
+    std::string const failedExits = AI_VALUE2(std::string, "manual string", "failed exits");
+    int32 const failedCount = AI_VALUE2(int32, "manual int", "failed exit count");
+    TravelNode* start = failedCount < EnemyGuards::ExitsBeforeHearth ? sTravelNodeMap.getNode(botPosition, bot) : nullptr;
+    if (start)
+    {
+        float bestDistance = 0.0f;
+        int candidates = 0;
+        for (TravelNode* node : sTravelNodeMap.getNodes(botPosition))
+        {
+            WorldPosition* position = node->getPosition();
+
+            // A way out this bot could not walk to is not tried again.
+            if (failedExits.find(EnemyGuards::ExitKey(*position) + " ") != std::string::npos)
+                continue;
+
+            position->loadMapAndVMap(0);
+            if (!position->GetArea() || EnemyGuards::IsHostileTerritory(*position, bot))
+                continue;
+
+            if (!start->hasRouteTo(node))
+                continue;
+
+            TravelNodeRoute route = sTravelNodeMap.getRoute(start, node, bot);
+            if (route.isEmpty())
+                continue;
+
+            float const distance = route.getTotalDistance();
+            if (!exit || distance < bestDistance)
+            {
+                exit = position;
+                bestDistance = distance;
+            }
+
+            if (++candidates >= 10)
+                break;
+        }
+    }
+
+    // Judged now; the walk gets its time before the next judgement.
+    SET_AI_VALUE2(time_t, "manual time", "left hostile territory", time(nullptr));
+    SET_AI_VALUE2(int32, "manual int", "guard retreats", 0);
+
+    // The whole group leaves: one member may be there for a quest the others
+    // have finished (owner, 2026-10-30). Its leader is given the way out and
+    // the rest follow it, as they do. A group a player leads is theirs to
+    // move.
+    Player* leader = bot;
+    if (Group* group = bot->GetGroup())
+    {
+        // Unless this member is far from its leader (EnemyGuards::GroupRange):
+        // then it goes on its own, as it was judged.
+        Player* groupLeader = sObjectMgr.GetPlayer(group->GetLeaderGuid());
+        if (groupLeader && groupLeader->GetMapId() == bot->GetMapId() && bot->GetDistance(groupLeader) <= EnemyGuards::GroupRange)
+            leader = groupLeader;
+    }
+    PlayerbotAI* leaderAi = leader->GetPlayerbotAI();
+    if (!leaderAi || leaderAi->IsRealPlayer())
+        return false;
+
+    if (!exit)
+    {
+        // The last resort (owner, 2026-10-30): no way out on foot, or two
+        // that could not be walked.
+        sLog.outString("Bot #%d %s:%d <%s> in %s: %s - %s uses the hearthstone", bot->GetGUIDLow(),
+            bot->GetTeam() == ALLIANCE ? "A" : "H", bot->GetLevel(), bot->GetName(), botPosition.getAreaName().c_str(),
+            failedCount >= EnemyGuards::ExitsBeforeHearth ? "two ways out could not be walked" : "no way out on foot",
+            leader == bot ? "it" : "its group leader");
+        return leaderAi->DoSpecificAction("hearthstone", Event(), true);
+    }
+
+    TravelTarget* target = leaderAi->GetAiObjectContext()->GetValue<TravelTarget*>("travel target")->Get();
+    if (!target)
+        return false;
+
+    TemporaryTravelDestination* destination = new TemporaryTravelDestination(*exit);
+    target->SetTarget(destination, destination->GetPosition());
+    target->SetStatus(TravelStatus::TRAVEL_STATUS_TRAVEL);
+    target->SetForced(true);
+    target->SetExpireIn(EnemyGuards::LeaveTime * IN_MILLISECONDS);
+    if (!leaderAi->HasStrategy("travel", BotState::BOT_STATE_NON_COMBAT))
+        leaderAi->ChangeStrategy("+travel once", BotState::BOT_STATE_NON_COMBAT);
+
+    // Said where people can hear it, in character (owner, 2026-10-30).
+    std::string const here = botPosition.getAreaName();
+    std::string const there = exit->getAreaName();
+    bool const together = leader != bot || bot->GetGroup();
+    std::vector<std::string> const lines = {
+        "Too many guards in " + here + " for the likes of " + std::string(together ? "us" : "me") + ". Heading for " + there + ".",
+        here + " is crawling with guards. " + std::string(together ? "We're" : "I'm") + " making for " + there + ".",
+        "No getting past the guards here. Back towards " + there + " it is.",
+        "Not worth dying in " + here + " over. " + std::string(together ? "We're" : "I'm") + " off to " + there + ".",
+    };
+    ai->SayToGeneral(lines[urand(0, lines.size() - 1)]);
+
+    sLog.outString("Bot #%d %s:%d <%s> in %s (%s): %s walks out of hostile territory to %s", bot->GetGUIDLow(),
+        bot->GetTeam() == ALLIANCE ? "A" : "H", bot->GetLevel(), bot->GetName(), here.c_str(),
+        AI_VALUE2(std::string, "manual string", "leave reason").c_str(),
+        leader == bot ? "it" : (std::string("its group, led by ") + leader->GetName() + ",").c_str(), there.c_str());
+    return true;
+}
