index 0000000..3af95f6
--- /dev/null
+++ b/playerbot/strategy/triggers/GatheringStalledTrigger.cpp
@@ -0,0 +1,34 @@
+#include "playerbot/playerbot.h"
+#include "GatheringStalledTrigger.h"
+#include "playerbot/TravelMgr.h"
+#include "playerbot/strategy/values/GatheringStalls.h"
+
+using namespace ai;
+
+bool GatheringStalledTrigger::IsActive()
+{
+    // Herb and ore nodes only: one pick there ends the work. Fishing (many
+    // casts) and skinning (the kills first) take minutes at one destination
+    // by nature - giving those up after three was a false alarm (2026-10-30).
+    TravelTarget* target = AI_VALUE(TravelTarget*, "travel target");
+    GatherTravelDestination* gather = target ? dynamic_cast<GatherTravelDestination*>(target->GetDestination()) : nullptr;
+    bool const gathering = gather && target->GetStatus() == TravelStatus::TRAVEL_STATUS_WORK && target->GetPosition() &&
+        (gather->GetPurpose() == TravelDestinationPurpose::GatherHerbalism || gather->GetPurpose() == TravelDestinationPurpose::GatherMining);
+
+    std::string const point = gathering ? std::to_string(reinterpret_cast<uintptr_t>(target->GetPosition())) : "";
+    time_t const now = time(nullptr);
+
+    // A new gathering point, or none: start (or stop) the clock.
+    if (point != AI_VALUE2(std::string, "manual string", "gathering point"))
+    {
+        SET_AI_VALUE2(std::string, "manual string", "gathering point", point);
+        SET_AI_VALUE2(time_t, "manual time", "gathering since", gathering ? now : 0);
+        return false;
+    }
+
+    if (!gathering)
+        return false;
+
+    time_t const since = AI_VALUE2(time_t, "manual time", "gathering since");
+    return since && now - since >= GatheringStalls::StallTime;
+}
