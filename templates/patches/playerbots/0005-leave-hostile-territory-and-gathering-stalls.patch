+#pragma once
+#include "playerbot/strategy/Action.h"
+
+namespace ai
+{
+    // kalimdor: give up a gathering point the bot has been working at too
+    // long without moving on (values/GatheringStalls.h), and choose again.
+    class GiveUpGatheringAction : public Action
+    {
+    public:
+        GiveUpGatheringAction(PlayerbotAI* ai) : Action(ai, "give up gathering") {}
+        bool Execute(Event& event) override;
+
+#ifdef GenerateBotHelp
+        virtual std::string GetHelpName() { return "give up gathering"; }
+        virtual std::string GetHelpDescription()
+        {
+            return "This action gives up a gathering node the bot has worked at for minutes\\n"
+                   "without picking it, so travel skips it for half an hour.";
+        }
+        virtual std::vector<std::string> GetUsedActions() { return {}; }
+        virtual std::vector<std::string> GetUsedValues() { return {"travel target"}; }
+#endif
+    };
+}
