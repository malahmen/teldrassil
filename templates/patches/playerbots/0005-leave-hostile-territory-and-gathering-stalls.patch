+    // Every guard spawn, read once from the spawn data: where it stands and
+    // which factions it is friendly to. A few thousand points, checked by
+    // distance - the spawn data itself is a whole-server scan per call.
+    struct HavenGuard { uint32 map; float x, y; bool alliance, horde; };
+    std::vector<HavenGuard> havenGuards;
+    std::once_flag havenGuardsLoaded;
+
+    struct HavenGuardCollector
+    {
+        bool operator()(CreatureDataPair const& pair)
+        {
+            CreatureData const& data = pair.second;
+            CreatureInfo const* info = ObjectMgr::GetCreatureTemplate(data.id);
+            if (!info || !(info->ExtraFlags & CREATURE_EXTRA_FLAG_GUARD))
+                return false;
+
+            FactionTemplateEntry const* faction = sFactionTemplateStore.LookupEntry(info->Faction);
+            if (!faction)
+                return false;
+
+            havenGuards.push_back({ data.mapid, data.posX, data.posY,
+                PlayerbotAI::friendToAlliance(faction), PlayerbotAI::friendToHorde(faction) });
+            return false;
+        }
+    };
+}
+
+bool EnemyGuards::IsSafeHaven(const WorldPosition& position, Player* bot)
+{
+    std::call_once(havenGuardsLoaded, [] { HavenGuardCollector collector; sObjectMgr.DoCreatureData(collector); });
+
+    float const range2 = HavenRange * HavenRange;
+    for (HavenGuard const& guard : havenGuards)
+    {
+        if (guard.map != position.getMapId() || !(guard.alliance && guard.horde))
+            continue;
+
+        float const dx = guard.x - position.getX(), dy = guard.y - position.getY();
+        if (dx * dx + dy * dy < range2)
+            return true;
+    }
+
+    return false;
+}
