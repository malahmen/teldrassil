+bool BlockedInHostileTerritoryTrigger::IsActive()
+{
+    time_t const now = time(nullptr);
+
+    // Idle is measured from the last fight or real move: farming resets it.
+    PositionEntry idleFrom = AI_VALUE2(PositionEntry, "pos", "hostile idle");
+    if (bot->IsInCombat() || !idleFrom.isSet() || idleFrom.Get().distance(WorldPosition(bot)) > EnemyGuards::IdleMoveRange)
+    {
+        SET_AI_VALUE2(PositionEntry, "pos", "hostile idle", PositionEntry(bot));
+        SET_AI_VALUE2(time_t, "manual time", "hostile idle since", now);
+        return false;
+    }
+
+    if (bot->GetInstanceId() || bot->InBattleGround())
+        return false;
+
+    if (bot->GetLevel() >= sWorld.getConfig(CONFIG_UINT32_MAX_PLAYER_LEVEL))
+        return false;
+
+    // Sent out lately: not judged again - unless the way out stalls (below).
+    bool const leaving = now - AI_VALUE2(time_t, "manual time", "left hostile territory") < EnemyGuards::LeaveTime;
+
+    if (!EnemyGuards::IsHostileTerritory(WorldPosition(bot), bot))
+    {
+        SET_AI_VALUE2(time_t, "manual time", "no objective since", 0);
+        SET_AI_VALUE2(std::string, "manual string", "hostile objective logged", "");
+        SET_AI_VALUE2(std::string, "manual string", "failed exits", "");
+        SET_AI_VALUE2(int32, "manual int", "failed exit count", 0);
+        return false;
+    }
+
+    // No objective here: in hostile territory, that is reason enough to go
+    // (owner's rule, 2026-10-30). Any travel destination is one - a quest,
+    // gathering, grinding, roleplay, exploring, the way out itself; having
+    // none is not, and is what left bots here killing whatever was near. A
+    // group goes where its leader does, so a member is judged by its bot
+    // leader's target.
+    PlayerbotAI* judged = ai;
+    if (Group* group = bot->GetGroup())
+    {
+        Player* leader = sObjectMgr.GetPlayer(group->GetLeaderGuid());
+        if (leader && leader != bot && leader->GetPlayerbotAI() && !leader->GetPlayerbotAI()->IsRealPlayer() &&
+            leader->GetMapId() == bot->GetMapId() && bot->GetDistance(leader) <= EnemyGuards::GroupRange)
+            judged = leader->GetPlayerbotAI();
+    }
+    TravelTarget* target = judged->GetAiObjectContext()->GetValue<TravelTarget*>("travel target")->Get();
+    TravelDestination* destination = target ? target->GetDestination() : nullptr;
+    bool objective = destination && !dynamic_cast<NullTravelDestination*>(destination);
+    bool const toExit = dynamic_cast<TemporaryTravelDestination*>(destination) != nullptr;
+
+    // ...and one the bot is getting to: on this continent, and nearer by
+    // ProgressYards within NoObjectiveTime unless already within WorkRange.
+    std::string lacking = "no objective here";
+    if (objective && target->GetPosition())
+    {
+        WorldPosition const* goal = target->GetPosition();
+        std::string const goalKey = std::to_string(reinterpret_cast<uintptr_t>(goal));
+        if (goal->getMapId() != bot->GetMapId())
+        {
+            objective = false;
+            lacking = "objective on another continent";
+        }
+        else
+        {
+            float const distance = goal->distance(WorldPosition(judged->GetBot()));
+            if (distance <= EnemyGuards::WorkRange || goalKey != AI_VALUE2(std::string, "manual string", "progress goal"))
+            {
+                SET_AI_VALUE2(std::string, "manual string", "progress goal", goalKey);
+                SET_AI_VALUE2(int32, "manual int", "progress best", int32(distance));
+                SET_AI_VALUE2(time_t, "manual time", "progress since", now);
+            }
+            else if (distance < AI_VALUE2(int32, "manual int", "progress best") - EnemyGuards::ProgressYards)
+            {
+                SET_AI_VALUE2(int32, "manual int", "progress best", int32(distance));
+                SET_AI_VALUE2(time_t, "manual time", "progress since", now);
+            }
+            else if (now - AI_VALUE2(time_t, "manual time", "progress since") >= (toExit ? EnemyGuards::ExitStallTime : EnemyGuards::NoObjectiveTime))
+            {
+                objective = false;
+                lacking = toExit ? "no progress towards the way out" : "no progress towards its objective";
+            }
+        }
+    }
+
+    // What the bot is here for, logged on arrival and whenever it changes -
+    // the console cannot ask a bot, so this is how it is seen (2026-10-30).
+    std::string const doing = !destination || dynamic_cast<NullTravelDestination*>(destination) ? std::string("none") :
+        destination->GetTitle() + (objective ? "" : " - " + lacking);
+    if (doing != AI_VALUE2(std::string, "manual string", "hostile objective logged"))
+    {
+        SET_AI_VALUE2(std::string, "manual string", "hostile objective logged", doing);
+        sLog.outString("Bot #%d %s:%d <%s> in %s (hostile territory): objective %s%s", bot->GetGUIDLow(),
+            bot->GetTeam() == ALLIANCE ? "A" : "H", bot->GetLevel(), bot->GetName(), WorldPosition(bot).getAreaName().c_str(),
+            doing.c_str(), judged != ai ? " (its group leader's)" : "");
+    }
+
+    // Sent out lately: only a stalled way out is judged again, at once - it
+    // is remembered as failed, and the next choice takes another.
+    if (leaving)
+    {
+        if (!toExit || objective)
+            return false;
+
+        std::string failed = AI_VALUE2(std::string, "manual string", "failed exits");
+        SET_AI_VALUE2(std::string, "manual string", "failed exits", failed + EnemyGuards::ExitKey(*target->GetPosition()) + " ");
+        SET_AI_VALUE2(int32, "manual int", "failed exit count", AI_VALUE2(int32, "manual int", "failed exit count") + 1);
+        SET_AI_VALUE2(std::string, "manual string", "leave reason", lacking);
+        return true;
+    }
+
+    // Why, for the log - and none yet means stay.
+    std::string reason;
+    if (!objective)
+    {
+        time_t since = AI_VALUE2(time_t, "manual time", "no objective since");
+        if (!since)
+            SET_AI_VALUE2(time_t, "manual time", "no objective since", since = now);
+        if (now - since >= EnemyGuards::NoObjectiveTime)
+            reason = lacking;
+    }
+    else
+    {
+        SET_AI_VALUE2(time_t, "manual time", "no objective since", 0);
+
+        // With one, blocked from it: pushed back by the guards...
+        if (now - AI_VALUE2(time_t, "manual time", "guard retreats since") <= EnemyGuards::RetreatWindow &&
+            AI_VALUE2(int32, "manual int", "guard retreats") >= EnemyGuards::RetreatsBeforeLeaving)
+            reason = "pushed back by enemy guards";
+
+        // ...or standing idle just outside their reach.
+        if (reason.empty() && now - AI_VALUE2(time_t, "manual time", "hostile idle since") >= EnemyGuards::IdleTime)
+        {
+            for (Creature* guard : EnemyGuards::Near(bot, 100.0f))
+            {
+                if (bot->GetDistance(guard) < EnemyGuards::Reach(guard, bot) + EnemyGuards::IdleRange)
+                {
+                    reason = "idle near enemy guards";
+                    break;
+                }
+            }
+        }
+    }
+
+    if (reason.empty())
+        return false;
+
+    // Rested first: the walk out is long (EnemyGuards::RestBeforeLeavingPercent).
+    if (bot->GetHealthPercent() < EnemyGuards::RestBeforeLeavingPercent)
+        return false;
+
+    SET_AI_VALUE2(std::string, "manual string", "leave reason", reason);
+    return true;
+}
