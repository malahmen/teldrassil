+bool EnemyGuards::IsHostileTerritory(const WorldPosition& position, Player* bot)
+{
+    AreaTableEntry const* area = position.GetArea();
+    if (!area)
+        return false;
+
+    uint32 team = area->team;
+    if (area->zone)
+    {
+        if (AreaTableEntry const* zone = GetAreaEntryByAreaID(area->zone))
+            team |= zone->team;
+    }
+
+    uint32 const own = bot->GetTeam() == ALLIANCE ? AREATEAM_ALLY : AREATEAM_HORDE;
+    uint32 const enemy = own == AREATEAM_ALLY ? AREATEAM_HORDE : AREATEAM_ALLY;
+    return (team & enemy) && !(team & own) && !IsSafeHaven(position, bot);
+}
