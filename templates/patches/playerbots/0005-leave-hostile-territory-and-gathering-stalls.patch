diff --git a/playerbot/strategy/actions/GiveUpGatheringAction.cpp b/playerbot/strategy/actions/GiveUpGatheringAction.cpp
new file mode 100644
index 0000000..cb5693b
--- /dev/null
+++ b/playerbot/strategy/actions/GiveUpGatheringAction.cpp
@@ -0,0 +1,24 @@
+#include "playerbot/playerbot.h"
+#include "GiveUpGatheringAction.h"
+#include "playerbot/TravelMgr.h"
+#include "playerbot/strategy/values/GatheringStalls.h"
+
+using namespace ai;
+
+bool GiveUpGatheringAction::Execute(Event& event)
+{
+    TravelTarget* target = AI_VALUE(TravelTarget*, "travel target");
+    if (!target || !target->GetPosition())
+        return false;
+
+    GatheringStalls::GiveUp(ai, target->GetPosition());
+    SET_AI_VALUE2(time_t, "manual time", "gathering since", 0);
+
+    sLog.outString("Bot #%d %s:%d <%s> gives up gathering (%s) at %s after %d minutes: travel skips it for %d minutes", bot->GetGUIDLow(),
+        bot->GetTeam() == ALLIANCE ? "A" : "H", bot->GetLevel(), bot->GetName(),
+        target->GetDestination() ? target->GetDestination()->GetTitle().c_str() : "?", target->GetPosition()->getAreaName().c_str(),
+        int(GatheringStalls::StallTime / 60), int(GatheringStalls::GiveUpFor / 60));
+
+    target->SetStatus(TravelStatus::TRAVEL_STATUS_EXPIRED);
+    return true;
+}
