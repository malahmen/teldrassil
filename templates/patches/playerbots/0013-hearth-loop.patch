@@ -0,0 +1,15 @@
+#include "playerbot/playerbot.h"
+#include "HomeBindNotAllowedTrigger.h"
+#include "playerbot/strategy/values/HomeBinds.h"
+#include "playerbot/TravelMgr.h"
+
+using namespace ai;
+
+bool HomeBindNotAllowedTrigger::IsActive()
+{
+    if (ai->IsRealPlayer() || bot->InBattleGround() || bot->GetInstanceId())
+        return false;
+
+    WorldPosition const bind = AI_VALUE(WorldPosition, "home bind");
+    return bind && !HomeBinds::Allowed(bot, bind);
+}
