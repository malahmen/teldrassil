diff --git a/playerbot/strategy/values/HomeBinds.cpp b/playerbot/strategy/values/HomeBinds.cpp
new file mode 100644
index 0000000..4688841
--- /dev/null
+++ b/playerbot/strategy/values/HomeBinds.cpp
@@ -0,0 +1,102 @@
+#include "playerbot/playerbot.h"
+#include "HomeBinds.h"
+#include "EnemyGuards.h"
+#include "playerbot/TravelMgr.h"
+
+#include <cstdlib>
+#include <map>
+#include <mutex>
+
+using namespace ai;
+
+namespace
+{
+    // The classic default inns, by innkeeper (one spawn each, checked in
+    // the world database): the race's starting area's and its capital's.
+    std::pair<uint32, uint32> RaceInnkeepers(uint8 race)
+    {
+        switch (race)
+        {
+            case RACE_HUMAN:    return { 295, 6740 };   // Farley, Goldshire; Allison, Stormwind
+            case RACE_DWARF:
+            case RACE_GNOME:    return { 1247, 5111 };  // Belm, Kharanos; Firebrew, Ironforge
+            case RACE_NIGHTELF: return { 6736, 6735 };  // Keldamyr, Dolanaar; Saelienne, Darnassus
+            case RACE_ORC:
+            case RACE_TROLL:    return { 6928, 6929 };  // Grosk, Razor Hill; Gryshka, Orgrimmar
+            case RACE_UNDEAD:   return { 5688, 6741 };  // Renee, Brill; Norman, Undercity
+            case RACE_TAUREN:   return { 6747, 6746 };  // Kauth, Bloodhoof Village; Pala, Thunder Bluff
+            default:            return { 0, 0 };
+        }
+    }
+
+    struct Inn { uint32 map, zone, area; float x, y, z; };
+    std::map<uint32, Inn> innsByEntry;
+    std::once_flag innsLoaded;
+
+    struct InnCollector
+    {
+        bool operator()(CreatureDataPair const& pair)
+        {
+            CreatureData const& data = pair.second;
+            bool wanted = false;
+            for (uint8 race : { RACE_HUMAN, RACE_DWARF, RACE_NIGHTELF, RACE_ORC, RACE_UNDEAD, RACE_TAUREN })
+            {
+                auto const [start, capital] = RaceInnkeepers(race);
+                wanted |= data.id == start || data.id == capital;
+            }
+            if (!wanted)
+                return false;
+
+            // The zone needs the map loaded there (an unloaded grid reads 0).
+            WorldPosition(data.mapid, data.posX, data.posY, data.posZ).loadMapAndVMap(0);
+            uint32 zone = 0, area = 0;
+            sTerrainMgr.GetZoneAndAreaId(zone, area, data.mapid, data.posX, data.posY, data.posZ);
+            innsByEntry[data.id] = { data.mapid, zone, area, data.posX, data.posY, data.posZ };
+            return false;
+        }
+    };
+
+    Inn const* DefaultInn(Player* bot)
+    {
+        std::call_once(innsLoaded, [] { InnCollector collector; sObjectMgr.DoCreatureData(collector); });
+
+        auto const [start, capital] = RaceInnkeepers(bot->getRace());
+        auto it = innsByEntry.find(bot->GetLevel() < HomeBinds::CapitalFromLevel ? start : capital);
+        return it == innsByEntry.end() ? nullptr : &it->second;
+    }
+}
+
+bool HomeBinds::Allowed(Player* bot, const WorldPosition& bind)
+{
+    bind.loadMapAndVMap(0);
+    uint32 zone = 0, area = 0;
+    sTerrainMgr.GetZoneAndAreaId(zone, area, bind.getMapId(), bind.getX(), bind.getY(), bind.getZ());
+
+    Inn const* home = DefaultInn(bot);
+    if (home && zone && zone == home->zone)
+        return true;
+
+    if (EnemyGuards::IsHostileTerritory(bind, bot))
+        return false;
+
+    // The level of the spot (its sub-area's, else its zone's from its
+    // sub-areas or creatures): a zone's own level is 0 in the game data.
+    int32 const level = sTravelMgr.GetAreaLevel(area ? area : zone);
+    if (level <= 0)
+        return false;
+
+    return std::abs(int(bot->GetLevel()) - level) <= LevelSpread;
+}
+
+bool HomeBinds::BindToDefault(Player* bot)
+{
+    Inn const* inn = DefaultInn(bot);
+    if (!inn)
+        return false;
+
+    bot->SetHomebindToLocation(WorldLocation(inn->map, inn->x, inn->y, inn->z, 0.0f), inn->area);
+    sLog.outString("Bot #%d %s:%d <%s>: hearthstone bound to its %s, %s", bot->GetGUIDLow(),
+        bot->GetTeam() == ALLIANCE ? "A" : "H", bot->GetLevel(), bot->GetName(),
+        bot->GetLevel() < CapitalFromLevel ? "starting area" : "capital", WorldPosition(inn->map, inn->x, inn->y, inn->z).getAreaName().c_str());
+    return true;
+}
diff --git a/playerbot/strategy/values/HomeBinds.h b/playerbot/strategy/values/HomeBinds.h
new file mode 100644
index 0000000..b4a4538
--- /dev/null
+++ b/playerbot/strategy/values/HomeBinds.h
@@ -0,0 +1,33 @@
+#pragma once
+
+#include "Entities/ObjectGuid.h"
+
+// kalimdor: where a bot's hearthstone may lead (owner, 2026-10-31). Every bot
+// is bound to its race's starting area below level 20 and to its race's
+// capital from 20 - the innkeeper there. It may bind elsewhere, a neutral town
+// included, only where the zone's level matches its own (LevelSpread), and
+// never in hostile territory. A level-2 Alliance bot carried to Ratchet on a
+// world-PvP trip bound itself there, and every hearthstone home took it back
+// among the Horde (meksha). A bind breaking the rule is put back to the
+// default (trigger "home bind not allowed"). A zone has no level in the
+// game data; the level of the inn's spot is used (TravelMgr::GetAreaLevel).
+
+class Player;
+
+namespace ai
+{
+    class WorldPosition;
+
+    class HomeBinds
+    {
+    public:
+        static constexpr uint32 CapitalFromLevel = 20;
+        static constexpr int LevelSpread = 5;
+
+        // Whether the bot may have its hearthstone bound there.
+        static bool Allowed(Player* bot, const WorldPosition& bind);
+        // Bind the bot to its default home - its starting area's or capital's
+        // innkeeper - if one is known. Says so in the log.
+        static bool BindToDefault(Player* bot);
+    };
+}
