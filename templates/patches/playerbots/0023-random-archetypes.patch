+const Archetype* Archetypes::Drawn(Player* bot)
+{
+    // Only random bots draw: a player's own bots (.bot add) stay as they are.
+    PlayerbotAI* ai = bot->GetPlayerbotAI();
+    if (ai->IsRealPlayer() || !sPlayerbotAIConfig.IsInRandomAccountList(bot->GetSession()->GetAccountId()))
+        return nullptr;
+
+    std::call_once(rosterArchetypesRead, []()
+    {
+        auto results = CharacterDatabase.Query("SELECT DISTINCT `guid` FROM `ai_playerbot_db_store` WHERE `preset` = '' AND `key` = 'value' AND `value` LIKE 'manual saved string::archetype>%'");
+        if (results)
+        {
+            do
+            {
+                rosterArchetypes.insert(ObjectGuid(results->Fetch()[0].GetUInt64()).GetCounter());
+            } while (results->NextRow());
+        }
+    });
+    if (rosterArchetypes.count(bot->GetGUIDLow()))
+        return nullptr;
+
+    std::call_once(archetypesParsed, Parse);
+
+    uint32 total = 0;
+    for (const auto& [name, archetype] : archetypes)
+        total += archetype.share;
+    if (!total)
+        return nullptr;
+
+    // By name, so the same config gives every bot the same archetype.
+    uint32 number = ai->GetFixedBotNumber(BotTypeNumber::ARCHETYPE_NUMBER, total - 1);
+    for (const auto& [name, archetype] : archetypes)
+    {
+        if (number < archetype.share)
+        {
+            // Said once per bot.
+            static std::mutex saidLock;
+            static std::set<uint32> said;
+            std::lock_guard<std::mutex> guard(saidLock);
+            if (said.insert(bot->GetGUIDLow()).second)
+                sLog.outString("Bot #%u <%s> draws the archetype %s", bot->GetGUIDLow(), bot->GetName(), archetype.name.c_str());
+            return &archetype;
+        }
+        number -= archetype.share;
+    }
+
+    return nullptr;
+}
