+bool GroupQuests::StandInHealer(Player const* bot)
+{
+    std::lock_guard<std::mutex> guard(standInLock);
+    return bot && standInHeals.count(bot->GetGUIDLow());
+}
+
+bool GroupQuests::CanStandInHeal(Player const* bot)
+{
+    // A class that heals, with its first heal: Lesser Heal, Healing Wave,
+    // Healing Touch, Holy Light.
+    if (!bot)
+        return false;
+    switch (bot->getClass())
+    {
+        case CLASS_PRIEST: return bot->HasSpell(2050);
+        case CLASS_SHAMAN: return bot->HasSpell(331);
+        case CLASS_DRUID: return bot->HasSpell(5185);
+        case CLASS_PALADIN: return bot->HasSpell(635);
+        default: return false;
+    }
+}
+
+void GroupQuests::SetStandInHeal(Player const* bot, bool on)
+{
+    std::lock_guard<std::mutex> guard(standInLock);
+    if (on)
+        standInHeals.insert(bot->GetGUIDLow());
+    else
+        standInHeals.erase(bot->GetGUIDLow());
+}
