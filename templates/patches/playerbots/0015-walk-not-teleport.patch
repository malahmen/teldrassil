 using namespace ai;
 
@@ -99,3 +101,21 @@ bool ZoneLevels::MayHuntHere(Player* bot)
 {
     return Outlevelled(bot) && !EnemyGuards::IsSafeHaven(WorldPosition(bot), bot) && EnemyPlayerInZone(bot);
 }
+
+bool ZoneLevels::MayShortcutTo(Player* bot, const WorldPosition& to)
+{
+    to.loadMapAndVMap(0);
+    uint32_t min = 0, max = 0;
+    uint32_t const zone = sTerrainMgr.GetZoneId(to.getMapId(), to.getX(), to.getY(), to.getZ());
+    if (!Range(zone, min, max) || bot->GetLevel() >= min)
+        return true;
+
+    // Said once per bot and zone, so the log shows who had to walk where.
+    static std::mutex saidLock;
+    static std::set<std::string> said;
+    std::lock_guard<std::mutex> guard(saidLock);
+    if (said.insert(std::to_string(bot->GetGUIDLow()) + ":" + std::to_string(zone)).second)
+        sLog.outString("Bot #%d %s:%d <%s>: walks into %s (from level %u), no shortcut", bot->GetGUIDLow(),
+            bot->GetTeam() == ALLIANCE ? "A" : "H", bot->GetLevel(), bot->GetName(), to.getAreaName().c_str(), min);
+    return false;
+}
