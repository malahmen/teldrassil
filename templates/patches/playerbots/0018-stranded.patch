@@ -3,6 +3,7 @@
 #include "EnemyGuards.h"
 #include "playerbot/ServerFacade.h"
 #include "playerbot/TravelMgr.h"
+#include "playerbot/TravelNode.h"
 
 #include <map>
 #include <mutex>
@@ -119,3 +120,61 @@ bool ZoneLevels::MayShortcutTo(Player* bot, const WorldPosition& to)
             bot->GetTeam() == ALLIANCE ? "A" : "H", bot->GetLevel(), bot->GetName(), to.getAreaName().c_str(), min);
     return false;
 }
+
+bool ZoneLevels::Stranded(Player* bot)
+{
+    uint32_t min = 0, max = 0;
+    if (!Range(bot->GetZoneId(), min, max) || min <= bot->GetLevel() + StrandedAbove)
+        return false;
+
+    // Not its own faction's zone: contested, or the other faction's.
+    AreaTableEntry const* zone = GetAreaEntryByAreaID(bot->GetZoneId());
+    uint32 const own = bot->GetTeam() == ALLIANCE ? AREATEAM_ALLY : AREATEAM_HORDE;
+    return !zone || !(zone->team & own);
+}
+
+namespace
+{
+    std::set<std::pair<uint32_t, uint32_t>> neighbours;
+    std::once_flag neighboursFound;
+
+    // Every pair of zones a walking link of the travel graph joins - read
+    // once; a node's zone needs its map loaded there.
+    void FindNeighbours()
+    {
+        std::map<TravelNode*, uint32_t> zoneOf;
+        for (TravelNode* node : sTravelNodeMap.getNodes())
+        {
+            WorldPosition* position = node->getPosition();
+            position->loadMapAndVMap(0);
+            zoneOf[node] = sTerrainMgr.GetZoneId(position->getMapId(), position->getX(), position->getY(), position->getZ());
+        }
+
+        for (auto const& [node, zone] : zoneOf)
+        {
+            for (auto const& [other, path] : *node->getLinks())
+            {
+                if (!path || path->getPathType() != TravelNodePathType::walk)
+                    continue;
+
+                auto it = zoneOf.find(other);
+                if (it != zoneOf.end() && it->second != zone && zone && it->second)
+                {
+                    neighbours.insert({ zone, it->second });
+                    neighbours.insert({ it->second, zone });
+                }
+            }
+        }
+
+        sLog.outString("Zone neighbours on foot: %u pairs, from the travel graph.", uint32(neighbours.size() / 2));
+    }
+}
+
+bool ZoneLevels::SameOrNeighbour(uint32_t zoneA, uint32_t zoneB)
+{
+    if (zoneA == zoneB)
+        return true;
+
+    std::call_once(neighboursFound, FindNeighbours);
+    return neighbours.count({ zoneA, zoneB }) > 0;
+}
