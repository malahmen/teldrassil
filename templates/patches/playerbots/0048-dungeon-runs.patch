+
+using namespace ai;
+
+uint32_t DungeonRun::WingAt(uint32_t mapId, float x, float y, float z)
+{
+    switch (mapId)
+    {
+        case 229: // Blackrock Spire: the upper spire is above (Emberseer 97, Wyrmthalak 91).
+            return z >= 95.0f ? WING_UPPER_SPIRE : WING_LOWER_SPIRE;
+        case 429: // Dire Maul: East to the south, West to the north-west, North to the east.
+            if (y < -100.0f)
+                return WING_DM_EAST;
+            return (y > 100.0f && x < 300.0f) ? WING_DM_WEST : WING_DM_NORTH;
+        case 189: // Scarlet Monastery: Graveyard and Cathedral to the north, Library and Armory to the south.
+            if (y < 0.0f)
+                return x < 1000.0f ? WING_SM_LIBRARY : WING_SM_ARMORY;
+            return x < 1400.0f ? WING_SM_CATHEDRAL : WING_SM_GRAVEYARD;
+        case 329: // Stratholme: the Undead side east and south (the Service Entrance), the Live side the rest (the Main Gate).
+            return (x >= 3800.0f || y < -3580.0f) ? WING_STRAT_UNDEAD : WING_STRAT_LIVE;
+        case 349: // Maraudon: Orange to the east, Purple south of it, the Inner part (Earth Song Falls) the rest.
+            if (x >= 900.0f)
+                return WING_MARA_ORANGE;
+            return (x >= 600.0f && y < 0.0f) ? WING_MARA_PURPLE : WING_MARA_INNER;
+        default:
+            return WING_NONE;
+    }
+}
+
+uint32_t DungeonRun::RunWing(Player* leader)
+{
+    if (leader->GetMapId() == 229)
+        return leader->GetGroup() && leader->GetGroup()->GetMembersCount() > 5 ? WING_UPPER_SPIRE : WING_LOWER_SPIRE;
+    return WingAt(leader->GetMapId(), leader->GetPositionX(), leader->GetPositionY(), leader->GetPositionZ());
+}
+
+char const* DungeonRun::WingName(uint32_t wing)
+{
+    switch (wing)
+    {
+        case WING_LOWER_SPIRE: return "Lower Blackrock Spire";
+        case WING_UPPER_SPIRE: return "Upper Blackrock Spire";
+        case WING_DM_EAST: return "Dire Maul East";
+        case WING_DM_WEST: return "Dire Maul West";
+        case WING_DM_NORTH: return "Dire Maul North";
+        case WING_SM_GRAVEYARD: return "Scarlet Monastery Graveyard";
+        case WING_SM_LIBRARY: return "Scarlet Monastery Library";
+        case WING_SM_ARMORY: return "Scarlet Monastery Armory";
+        case WING_SM_CATHEDRAL: return "Scarlet Monastery Cathedral";
+        case WING_STRAT_LIVE: return "Stratholme Live";
+        case WING_STRAT_UNDEAD: return "Stratholme Undead";
+        case WING_MARA_ORANGE: return "Maraudon Orange";
+        case WING_MARA_PURPLE: return "Maraudon Purple";
+        case WING_MARA_INNER: return "Maraudon Inner";
+        default: return nullptr;
+    }
+}
+
+// The boss rule, corrected by name (owner, 2026-11-10; the boss list in
+// Kamino, dungeons-raids-bosses-2026-11-10.md). Trash it takes for bosses -
+// single-spawn elites with trash loot, prisoners, pets:
+static std::set<uint32> const namedTrash =
+{
+    657, 1732, 4418,         // Deadmines: Defias Pirate, Defias Squallshaper, Defias Wizard
+    3849, 3850, 3854, 10000, // Shadowfang Keep: Deathstalker Adamant, Sorcerer Ashcrombe (prisoners), Shadowfang Wolfguard, Arugal (the entrance scene)
+    4442, 4520,              // Razorfen Kraul: Razorfen Defender, Razorfen Geomancer
+    6392,                    // Gnomeregan: Holdout Medic
+    4297,                    // Scarlet Monastery Armory: Scarlet Conjuror
+    4850, 4851, 4853, 4863,  // Uldaman: Stonevault Cave Lurker, Rockchewer, Geomancer, Jadespine Basilisk
+    7274,                    // Zul'Farrak: Sandfury Executioner (carries the cage key)
+    5277, 5280, 5283, 5708,  // Sunken Temple: Nightmare Scalebane, Wyrmkin, Wanderer, Spawn of Hakkar
+    14308, 14349,            // Dire Maul: Ferra (Illyanna's pet), Pimgib (Lethtendris's imp)
+};
+// And bosses it misses - several spawns, or not hostile until engaged:
+static std::set<uint32> const namedBosses =
+{
+    1663, 1696,              // Stormwind Stockade: Dextren Ward, Targorr the Dread
+    7271,                    // Zul'Farrak: Witch Doctor Zum'rah
+    11486,                   // Dire Maul West: Prince Tortheldrin
+};
+
+std::vector<DungeonRun::Boss> const& DungeonRun::BossesOf(uint32_t mapId)
+{
+    static std::mutex lock;
+    static std::map<uint32_t, std::vector<Boss>> cache;
+    std::lock_guard<std::mutex> guard(lock);
+    auto found = cache.find(mapId);
+    if (found != cache.end())
+        return found->second;
+
+    std::vector<Boss>& bosses = cache[mapId];
+    MapEntry const* mapEntry = sMapStore.LookupEntry(mapId);
+    if (!mapEntry || !mapEntry->IsNonRaidDungeon())
+        return bosses;
+
+    // Spawns on this map, by entry: fixed ones, and points with a random
+    // creature (each of its creatures counted once).
+    std::map<uint32_t, std::vector<uint32_t>> spawns;
+    for (CreatureDataPair const* pair : WorldPosition().getCreaturesNear())
+    {
+        if (pair->second.mapid != mapId)
+            continue;
+        if (pair->second.id)
+            spawns[pair->second.id].push_back(pair->first);
+        else if (std::vector<uint32> const* entries = sObjectMgr.GetAllRandomCreatureEntries(pair->first))
+            for (uint32 entry : *entries)
+                spawns[entry].push_back(pair->first);
+    }
+
+    // A creature its script turns into one not hostile to players is an
+    // NPC in disguise, not a boss - the Scarshield Infiltrator, who becomes
+    // Vaelan as a player comes near (owner, 2026-11-10).
+    auto inDisguise = [](uint32 entry)
+    {
+        auto const& events = sEventAIMgr.GetCreatureEventEntryAIMap();
+        auto found = events ? events->find(entry) : CreatureEventAI_Event_Map::const_iterator();
+        if (!events || found == events->end())
+            return false;
+        for (CreatureEventAI_Event const& event : found->second)
+            for (CreatureEventAI_Action const& action : event.action)
+            {
+                if (action.type != ACTION_T_UPDATE_TEMPLATE)
+                    continue;
+                CreatureInfo const* into = ObjectMgr::GetCreatureTemplate(action.update_template.creatureId);
+                FactionTemplateEntry const* faction = into ? sFactionTemplateStore.LookupEntry(into->Faction) : nullptr;
+                if (faction && !faction->IsHostileToPlayers())
+                    return true;
+            }
+        return false;
+    };
+
+    auto isBoss = [&inDisguise](uint32 entry, size_t count)
+    {
+        CreatureInfo const* info = ObjectMgr::GetCreatureTemplate(entry);
+        if (namedBosses.count(entry))
+            return true;
+        return info && !namedTrash.count(entry) && !inDisguise(entry) && (info->Rank == CREATURE_ELITE_RARE || info->Rank == CREATURE_ELITE_RAREELITE || info->Rank == CREATURE_ELITE_WORLDBOSS ||
+            (info->Rank == CREATURE_ELITE_ELITE && count == 1));
+    };
+
+    auto wingOf = [mapId](uint32 guid)
+    {
+        CreatureData const* data = sObjectMgr.GetCreatureData(guid);
+        return data ? WingAt(mapId, data->posX, data->posY, data->posZ) : uint32_t(WING_NONE);
+    };
+
+    for (auto const& [entry, guids] : spawns)
+        if (isBoss(entry, guids.size()))
+            for (uint32_t guid : guids)
+                // Magistrate Barthilas stands at the Undead side's gate but
+                // drops its key, the Key to the City: the Live side's boss
+                // (owner, 2026-11-10).
+                bosses.push_back({ entry, guid, 0, entry == 10435 ? uint32_t(WING_STRAT_LIVE) : wingOf(guid) });
+
+    for (Boss& boss : bosses)
+        if (boss.guid)
+            boss.event = sGameEventMgr.GetGameEventId<Creature>(boss.guid);
+
+    // Spawn groups on this map: a creature the group places at most once.
+    if (auto container = sObjectMgr.GetSpawnGroupContainer())
+        for (auto const& [id, group] : container->spawnGroupMap)
+        {
+            if (group.Type != SPAWN_GROUP_CREATURE || group.DbGuids.empty())
+                continue;
+            CreatureData const* first = sObjectMgr.GetCreatureData(group.DbGuids.front().DbGuid);
+            if (!first || first->mapid != mapId)
+                continue;
+            for (SpawnGroupRandomEntry const& random : group.RandomEntries)
+                if (random.MaxCount == 1 && spawns.find(random.Entry) == spawns.end() && isBoss(random.Entry, 1))
+                    bosses.push_back({ random.Entry, 0, id, wingOf(group.DbGuids.front().DbGuid) });
+        }
+    return bosses;
+}
+
+Player* DungeonRun::Leader(Player* bot)
+{
+    Group* group = bot->GetGroup();
+    if (!group || !bot->GetMap()->IsDungeon() || bot->GetMap()->IsRaid())
+        return nullptr;
+    Player* leader = sObjectMgr.GetPlayer(group->GetLeaderGuid());
+    if (!leader || !leader->GetPlayerbotAI() || leader->GetMapId() != bot->GetMapId() || leader->GetInstanceId() != bot->GetInstanceId())
+        return nullptr;
+    return leader;
+}
+
+bool DungeonRun::Active(Player* bot)
+{
+    Player* leader = Leader(bot);
+    if (!leader)
+        return false;
+    AiObjectContext* context = leader->GetPlayerbotAI()->GetAiObjectContext();
+    return context->GetValue<int>("manual int", "run instance")->Get() == int(leader->GetInstanceId());
+}
+
+std::vector<DungeonRun::Boss> DungeonRun::RunBosses(Player* bot)
+{
+    std::vector<Boss> bosses;
+    Map* map = bot->GetMap();
+    MapPersistentState* state = map->GetPersistentState();
+    uint32_t wing = WING_NONE;
+    if (Player* leader = Leader(bot))
+        wing = uint32_t(leader->GetPlayerbotAI()->GetAiObjectContext()->GetValue<int>("manual int", "run wing")->Get());
+    for (Boss boss : BossesOf(bot->GetMapId()))
+    {
+        if (wing && boss.wing != wing)
+            continue;
+        // A spawn group's boss: the point this instance chose for it, if
+        // known yet.
+        if (boss.group)
+            if (SpawnGroup* group = map->GetSpawnManager().GetSpawnGroup(boss.group))
+                for (SpawnGroupDbGuids const& point : group->GetGroupEntry().DbGuids)
+                    if (group->GetGuidEntry(point.DbGuid) == boss.entry)
+                        boss.guid = point.DbGuid;
+        // A pooled spawn this instance did not choose is not there.
+        if (boss.guid && !boss.group && state && sPoolMgr.IsPartOfAPool<Creature>(boss.guid) && !state->IsSpawnedPoolObject<Creature>(boss.guid))
+            continue;
+        // An event's spawn while it is off (or a spawn it removes, while on).
+        if ((boss.event > 0 && !sGameEventMgr.IsActiveEvent(boss.event)) || (boss.event < 0 && sGameEventMgr.IsActiveEvent(-boss.event)))
+            continue;
+        if (!namedBosses.count(boss.entry) && !GuidPosition(bot).IsHostileTo(GuidPosition(HIGHGUID_UNIT, boss.entry), bot->GetInstanceId()))
+            continue;
+        bosses.push_back(boss);
+    }
+    return bosses;
+}
+
+std::vector<DungeonRun::Boss> DungeonRun::AliveBosses(Player* bot)
+{
+    std::vector<Boss> alive;
+    MapPersistentState* state = bot->GetMap()->GetPersistentState();
+    time_t const now = time(nullptr);
+    for (Boss const& boss : RunBosses(bot))
+        if (!boss.guid || !state || state->GetCreatureRespawnTime(boss.guid) <= now)
+            alive.push_back(boss);
+    return alive;
+}
+
+bool DungeonRun::IsAliveBoss(Player* bot, uint32_t entry)
+{
+    for (Boss const& boss : AliveBosses(bot))
+        if (boss.entry == entry)
+            return true;
+    return false;
+}
+
+uint32_t DungeonRun::Fights(std::vector<Boss> const& bosses)
+{
+    std::set<uint64_t> fights;
+    std::map<uint16, std::set<uint32_t>> pools;
+    for (Boss const& boss : bosses)
+    {
+        if (boss.guid)
+            if (uint16 pool = sPoolMgr.IsPartOfAPool<Creature>(boss.guid))
+            {
+                pools[pool].insert(boss.guid);
+                continue;
+            }
+        fights.insert(boss.guid ? uint64_t(boss.guid) : (uint64_t(1) << 32) | boss.entry);
+    }
+    uint32_t count = uint32_t(fights.size());
+    for (auto const& [pool, guids] : pools)
+    {
+        uint32_t const limit = sPoolMgr.GetPoolTemplate(pool).MaxLimit;
+        count += limit ? std::min<uint32_t>(limit, guids.size()) : uint32_t(guids.size());
+    }
+    return count;
+}
+
+bool InDungeonRunValue::Calculate()
+{
+    return DungeonRun::Active(bot);
+}
