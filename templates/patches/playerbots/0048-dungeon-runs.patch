+#include "playerbot/playerbot.h"
+#include "DungeonRunTrigger.h"
+#include "playerbot/strategy/values/DungeonRun.h"
+
+using namespace ai;
+
+bool DungeonRunTrigger::IsActive()
+{
+    if (ai->IsRealPlayer() || !bot->GetGroup() || !bot->GetGroup()->IsLeader(bot->GetObjectGuid()))
+        return false;
+    if (!bot->GetMap()->IsDungeon() || bot->GetMap()->IsRaid())
+        return false;
+    int const instance = int(bot->GetInstanceId());
+    if (AI_VALUE2(int, "manual int", "run instance") == instance)
+        return true;
+    // Done here: this instance, and on a map with wings this wing.
+    if (AI_VALUE2(int, "manual int", "run done instance") == instance && AI_VALUE2(int, "manual int", "run done wing") == int(DungeonRun::RunWing(bot)))
+        return false;
+    return !DungeonRun::BossesOf(bot->GetMapId()).empty();
+}
