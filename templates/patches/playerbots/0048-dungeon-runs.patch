diff --git a/playerbot/strategy/actions/DungeonRunAction.cpp b/playerbot/strategy/actions/DungeonRunAction.cpp
new file mode 100644
index 0000000..b70d5d4
--- /dev/null
+++ b/playerbot/strategy/actions/DungeonRunAction.cpp
@@ -0,0 +1,76 @@
+#include "playerbot/playerbot.h"
+#include "DungeonRunAction.h"
+#include "playerbot/strategy/values/DungeonRun.h"
+#include "playerbot/TravelMgr.h"
+
+using namespace ai;
+
+bool DungeonRunAction::Execute(Event& event)
+{
+    Group* group = bot->GetGroup();
+    if (!group)
+        return false;
+
+    int const instance = int(bot->GetInstanceId());
+    MapEntry const* mapEntry = sMapStore.LookupEntry(bot->GetMapId());
+    char const* place = mapEntry ? mapEntry->name[0] : "a dungeon";
+    // A map with wings: the run's wing and its bosses only.
+    int const wing = AI_VALUE2(int, "manual int", "run instance") == instance ? AI_VALUE2(int, "manual int", "run wing") : int(DungeonRun::RunWing(bot));
+    if (char const* wingName = DungeonRun::WingName(wing))
+        place = wingName;
+    // Set first: the run's bosses are read in its wing.
+    if (AI_VALUE2(int, "manual int", "run instance") != instance)
+        SET_AI_VALUE2(int, "manual int", "run wing", wing);
+    uint32 const bosses = DungeonRun::Fights(DungeonRun::RunBosses(bot));
+    char const* team = bot->GetTeam() == ALLIANCE ? "A" : "H";
+
+    if (AI_VALUE2(int, "manual int", "run instance") != instance)
+    {
+        SET_AI_VALUE2(int, "manual int", "run instance", instance);
+        SET_AI_VALUE2(int, "manual int", "run wing", wing);
+        SET_AI_VALUE2(int, "manual int", "run wipes", 0);
+        SET_AI_VALUE2(bool, "manual bool", "run wiped", false);
+        // Its next destination is chosen now, among the bosses.
+        AI_VALUE(TravelTarget*, "travel target")->SetStatus(TravelStatus::TRAVEL_STATUS_EXPIRED);
+        sLog.outString("Bot #%d %s:%d <%s>: starts a run in %s with %u - %u bosses, %u alive", bot->GetGUIDLow(), team, bot->GetLevel(),
+            bot->GetName(), place, group->GetMembersCount(), bosses, DungeonRun::Fights(DungeonRun::AliveBosses(bot)));
+        return true;
+    }
+
+    // A wipe: every member in the dungeon dead at once.
+    uint32 here = 0, dead = 0;
+    for (GroupReference* ref = group->GetFirstMember(); ref; ref = ref->next())
+    {
+        Player* member = ref->getSource();
+        if (!member || member->GetMapId() != bot->GetMapId() || member->GetInstanceId() != bot->GetInstanceId())
+            continue;
+        ++here;
+        if (!member->IsAlive())
+            ++dead;
+    }
+    bool const wiped = here && dead == here;
+    int wipes = AI_VALUE2(int, "manual int", "run wipes");
+    if (wiped && !AI_VALUE2(bool, "manual bool", "run wiped"))
+    {
+        SET_AI_VALUE2(int, "manual int", "run wipes", ++wipes);
+        sLog.outString("Bot #%d %s:%d <%s>: wipe %d in %s (it gives up after %u)", bot->GetGUIDLow(), team, bot->GetLevel(), bot->GetName(),
+            wipes, place, bosses);
+    }
+    SET_AI_VALUE2(bool, "manual bool", "run wiped", wiped);
+
+    std::vector<DungeonRun::Boss> const alive = DungeonRun::AliveBosses(bot);
+    if (!alive.empty() && wipes <= int(bosses))
+        return false;
+
+    if (alive.empty())
+        sLog.outString("Bot #%d %s:%d <%s>: clears %s - all %u bosses dead, %d wipes", bot->GetGUIDLow(), team, bot->GetLevel(), bot->GetName(),
+            place, bosses, wipes);
+    else
+        sLog.outString("Bot #%d %s:%d <%s>: gives up %s after %d wipes - %u of %u bosses left", bot->GetGUIDLow(), team, bot->GetLevel(),
+            bot->GetName(), place, wipes, DungeonRun::Fights(alive), bosses);
+    SET_AI_VALUE2(int, "manual int", "run instance", 0);
+    SET_AI_VALUE2(int, "manual int", "run done instance", instance);
+    SET_AI_VALUE2(int, "manual int", "run done wing", wing);
+    AI_VALUE(TravelTarget*, "travel target")->SetStatus(TravelStatus::TRAVEL_STATUS_EXPIRED);
+    return true;
+}
