+// Repairs at a repairer in sight, if any, paying as usual: a group repairs
+// before it sets off - where groups form, by flight masters, repairers are
+// close - and never travels away to repair (owner, 2026-11-10).
+static void RepairNearby(Player* member)
+{
+    if (member->GetMoney() == 0)
+        return;
+    std::list<ObjectGuid> npcs = member->GetPlayerbotAI()->GetAiObjectContext()->GetValue<std::list<ObjectGuid>>("nearest npcs")->Get();
