+        if (uint32 const cost = member->DurabilityRepairAll(true, member->GetReputationPriceDiscount(npc)))
+            sLog.outString("Bot #%d %s:%d <%s>: repairs at %s before setting off (%u copper)", member->GetGUIDLow(),
+                member->GetTeam() == ALLIANCE ? "A" : "H", member->GetLevel(), member->GetName(), npc->GetName(), cost);
+        return;
+    }
+}
