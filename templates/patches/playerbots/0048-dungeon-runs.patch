@@ -0,0 +1,82 @@
+#pragma once
+
+#include <cstdint>
+#include <vector>
+
+// kalimdor: a group of bots inside a dungeon is on a run (owner, 2026-11-10;
+// Kamino 151, step 1b): it quits only once it has killed all the dungeon's
+// bosses - whatever brought it there, a quest or a boss - or when it has
+// wiped more times than the dungeon has bosses. Meanwhile its leader goes
+// from boss to boss, its errands wait and its members stay.
+// The bosses: the dungeon's unique elites (one spawn on its map) and its
+// rares and world bosses - upstream's own measure of a boss (TravelValues.cpp)
+// - hostile to the group. Spawns count from creature rows, from points with a
+// random creature (creature_spawn_entry) and from spawn groups (at most one
+// of it in a group) - Lady Anacondra and Mutanus are placed by spawn groups
+// only (owner, 2026-11-10). A boss is dead while its instance holds a respawn
+// time for it (MapPersistentState), which also holds where its part of the
+// map is not loaded.
+// Wings: Blackrock Spire, Dire Maul, Scarlet Monastery, Stratholme and
+// Maraudon hold independent wings in one map (owner, 2026-11-10) - a run counts its own wing's bosses only. Dire Maul's
+// wing is where its leader stands as the run starts (each entrance is in its
+// wing), and Scarlet Monastery's, Stratholme's and Maraudon's the same -
+// Maraudon's Inner part, reached through either wing, starts its own run
+// once the wing's run ends; Blackrock Spire's one entrance is in the lower spire, so a group
+// over 5 is an upper spire run (its 10-player quests), else lower.
+
+#include "playerbot/strategy/Value.h"
+
+class Player;
+
+namespace ai
+{
+    // "in dungeon run": the bot's group is on a run in its instance - read
+    // into PlayerTravelInfo, for travel's boss destinations.
+    class InDungeonRunValue : public BoolCalculatedValue
+    {
+    public:
+        InDungeonRunValue(PlayerbotAI* ai) : BoolCalculatedValue(ai, "in dungeon run", 2) {}
+        virtual bool Calculate() override;
+    };
+
+    class DungeonRun
+    {
+    public:
+        // guid: its spawn point; group: the spawn group that places it
+        // (guid 0 - the point is the instance's choice), or 0.
+        // event: the game event it spawns in (> 0) or is gone in (< 0), or
+        // 0 - the Scourge Invasion's instance bosses spawn in its event only.
+        struct Boss { uint32_t entry; uint32_t guid; uint32_t group; uint32_t wing; int16_t event = 0; };
+
+        enum Wing : uint32_t { WING_NONE = 0, WING_LOWER_SPIRE, WING_UPPER_SPIRE, WING_DM_EAST, WING_DM_WEST, WING_DM_NORTH,
+            WING_SM_GRAVEYARD, WING_SM_LIBRARY, WING_SM_ARMORY, WING_SM_CATHEDRAL,
+            WING_STRAT_LIVE, WING_STRAT_UNDEAD, WING_MARA_ORANGE, WING_MARA_PURPLE, WING_MARA_INNER };
+        // The wing a position on the map is in, WING_NONE where the map has
+        // none. The bounds are from the bosses' and entrances' positions.
+        static uint32_t WingAt(uint32_t mapId, float x, float y, float z);
+        // The wing a run the leader starts now is in.
+        static uint32_t RunWing(Player* leader);
+        static char const* WingName(uint32_t wing);
+
+        // The dungeon's bosses (cached per map); none outside a 5-player
+        // dungeon.
+        static std::vector<Boss> const& BossesOf(uint32_t mapId);
+        // The leader's run in this instance, or the bot's leader's.
+        static Player* Leader(Player* bot);
+        static bool Active(Player* bot);
+        // The run's bosses in the bot's instance: in its run's wing, if the
+        // map has wings; hostile to it - friendly NPCs (prisoners, an event's
+        // cast before it starts) are not fights; there - a pooled spawn this
+        // instance did not choose is not.
+        static std::vector<Boss> RunBosses(Player* bot);
+        // Those still alive.
+        static std::vector<Boss> AliveBosses(Player* bot);
+        static bool IsAliveBoss(Player* bot, uint32_t entry);
+        // How many fights: a point that places one of several bosses at
+        // random is listed once per boss but is one fight, and a pool of
+        // spawns is as many fights as it spawns at once - the Scarlet
+        // Monastery Graveyard's rares: six points, one of three rares each,
+        // one point in a pool of one per instance (owner, 2026-11-10).
+        static uint32_t Fights(std::vector<Boss> const& bosses);
+    };
+}
