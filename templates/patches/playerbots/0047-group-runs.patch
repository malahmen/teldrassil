+
+namespace
+{
+    // The quest as the bot's only travel focus, or none (0); its current
+    // destination dropped, so the next one is chosen now.
+    void SetGroupQuestFocus(Player* member, uint32 questId)
+    {
+        AiObjectContext* context = member->GetPlayerbotAI()->GetAiObjectContext();
+        std::set<uint32> focus;
+        if (questId)
+            focus.insert(questId);
+        context->GetValue<std::set<uint32>>("focus travel target")->Set(focus);
+        context->GetValue<int>("manual int", "group quest focus")->Set(int(questId));
+        context->GetValue<TravelTarget*>("travel target")->Get()->SetStatus(TravelStatus::TRAVEL_STATUS_EXPIRED);
+    }
+}
+
+bool GoGroupQuestAction::Execute(Event& event)
+{
+    Quest const* quest = GroupQuests::Ready(bot);
+    Group* group = bot->GetGroup();
+    if (!quest || !group)
+        return false;
+
+    uint32 set = 0;
+    for (GroupReference* ref = group->GetFirstMember(); ref; ref = ref->next())
+    {
+        Player* member = ref->getSource();
+        if (!member || !member->GetPlayerbotAI() || member->GetPlayerbotAI()->IsRealPlayer())
+            continue;
+        SetGroupQuestFocus(member, quest->GetQuestId());
+        ++set;
+    }
+    // A member leaving later starts a new search, not the old clock's end.
+    SET_AI_VALUE2(time_t, "manual time", "lfg since", time(nullptr));
+
+    sLog.outString("Bot #%d %s:%d <%s>: leads its group to %s (%u of %u members)", bot->GetGUIDLow(),
+        bot->GetTeam() == ALLIANCE ? "A" : "H", bot->GetLevel(), bot->GetName(), quest->GetTitle().c_str(),
+        group->GetMembersCount(), GroupQuests::WantedSize(quest));
+    return set > 0;
+}
+
+bool EndGroupQuestAction::Execute(Event& event)
+{
+    int const questId = AI_VALUE2(int, "manual int", "group quest focus");
+    if (questId <= 0)
+        return false;
+    Quest const* quest = sObjectMgr.GetQuestTemplate(uint32(questId));
+    sLog.outString("Bot #%d %s:%d <%s>: %s is over for it (%s)", bot->GetGUIDLow(), bot->GetTeam() == ALLIANCE ? "A" : "H",
+        bot->GetLevel(), bot->GetName(), quest ? quest->GetTitle().c_str() : "a group quest",
+        !bot->GetGroup() ? "no group" : bot->GetQuestStatus(uint32(questId)) == QUEST_STATUS_COMPLETE ? "done" : "no longer in its log");
+    SetGroupQuestFocus(bot, 0);
+    return true;
+}
