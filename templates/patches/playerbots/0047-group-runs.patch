+Quest const* GroupQuests::Ready(Player* bot)
+{
+    Group* group = bot->GetGroup();
+    if (!group || !group->IsLeader(bot->GetObjectGuid()) || bot->InBattleGround())
+        return nullptr;
+
+    int const questId = bot->GetPlayerbotAI()->GetAiObjectContext()->GetValue<int>("manual int", "lfg quest")->Get();
+    Quest const* quest = questId > 0 ? sObjectMgr.GetQuestTemplate(uint32(questId)) : nullptr;
+    if (!IsGroupQuest(quest) || bot->GetQuestStatus(quest->GetQuestId()) != QUEST_STATUS_INCOMPLETE || QuestFlow::IsGrey(bot, quest))
+        return nullptr;
+
+    // Members, not invitations still open.
+    return group->GetMembersCount() >= WantedSize(quest) ? quest : nullptr;
+}
+
+bool GroupQuests::FocusOver(Player* bot)
+{
+    AiObjectContext* context = bot->GetPlayerbotAI()->GetAiObjectContext();
+    int const questId = context->GetValue<int>("manual int", "group quest focus")->Get();
+    if (questId <= 0)
+        return false;
+    return !bot->GetGroup() || bot->GetQuestStatus(uint32(questId)) != QUEST_STATUS_INCOMPLETE;
+}
+
+bool GroupQuests::Holds(Player* bot)
+{
+    if (!bot->GetGroup())
+        return false;
+    AiObjectContext* context = bot->GetPlayerbotAI()->GetAiObjectContext();
+    for (char const* key : { "group quest focus", "lfg joined", "lfg quest" })
+    {
+        int const questId = context->GetValue<int>("manual int", key)->Get();
+        if (questId > 0 && bot->GetQuestStatus(uint32(questId)) == QUEST_STATUS_INCOMPLETE)
+            return true;
+    }
+    return false;
+}
