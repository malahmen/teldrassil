diff --git a/playerbot/strategy/values/Archetypes.cpp b/playerbot/strategy/values/Archetypes.cpp
new file mode 100644
index 0000000..90740c4
--- /dev/null
+++ b/playerbot/strategy/values/Archetypes.cpp
@@ -0,0 +1,160 @@
+#include "playerbot/playerbot.h"
+#include "Archetypes.h"
+#include "EngageOdds.h"
+#include "playerbot/PlayerbotAIConfig.h"
+
+#include <algorithm>
+#include <mutex>
+
+using namespace ai;
+
+namespace
+{
+    std::map<std::string, Archetype> archetypes;
+    std::once_flag archetypesParsed;
+
+    std::string Trim(const std::string& text)
+    {
+        size_t const first = text.find_first_not_of(" \t");
+        if (first == std::string::npos)
+            return "";
+        return text.substr(first, text.find_last_not_of(" \t") - first + 1);
+    }
+
+    // "1.2", "always" or "never" - false if it is none of them.
+    bool ParseMargin(const std::string& text, float& margin)
+    {
+        if (text == "always") { margin = Archetypes::Always; return true; }
+        if (text == "never") { margin = Archetypes::Never; return true; }
+        try
+        {
+            size_t used = 0;
+            margin = std::stof(text, &used);
+            return used == text.size() && margin >= 0.0f;
+        }
+        catch (...)
+        {
+            return false;
+        }
+    }
+
+    // Each archetype's definition, read once; a part that cannot be read is
+    // said in the log and left out, the rest kept.
+    void Parse()
+    {
+        for (const auto& [name, definition] : sPlayerbotAIConfig.archetypes)
+        {
+            Archetype archetype;
+            archetype.name = name;
+
+            for (const std::string& part : split(definition, ';'))
+            {
+                std::string const field = Trim(part);
+                if (field.empty())
+                    continue;
+
+                size_t const equals = field.find('=');
+                std::string const key = equals == std::string::npos ? field : Trim(field.substr(0, equals));
+                std::string const value = equals == std::string::npos ? "" : Trim(field.substr(equals + 1));
+
+                if (key == "activities")
+                {
+                    for (const std::string& item : split(value, ','))
+                    {
+                        std::string const activity = Trim(item);
+                        const std::vector<std::string>& known = Archetypes::ActivityNames();
+                        if (std::find(known.begin(), known.end(), activity) == known.end())
+                            sLog.outError("Archetype %s: unknown activity '%s' left out", name.c_str(), activity.c_str());
+                        else if (std::find(archetype.activities.begin(), archetype.activities.end(), activity) == archetype.activities.end())
+                            archetype.activities.push_back(activity);
+                    }
+                }
+                else if (key == "pvp" || key.rfind("pvp@", 0) == 0)
+                {
+                    uint32_t fromLevel = 1;
+                    float margin = 0.0f;
+                    bool ok = ParseMargin(value, margin);
+                    if (ok && key != "pvp")
+                    {
+                        try { fromLevel = std::stoul(key.substr(4)); }
+                        catch (...) { ok = false; }
+                    }
+
+                    if (ok)
+                        archetype.pvp[fromLevel] = margin;
+                    else
+                        sLog.outError("Archetype %s: '%s' left out (pvp is a number, always or never; pvp@<level> from that level)", name.c_str(), field.c_str());
+                }
+                else
+                    sLog.outError("Archetype %s: unknown part '%s' left out", name.c_str(), field.c_str());
+            }
+
+            archetypes[name] = archetype;
+        }
+
+        sLog.outString("Loaded %u archetypes.", uint32(archetypes.size()));
+    }
+}
+
+const std::vector<std::string>& Archetypes::ActivityNames()
+{
+    static const std::vector<std::string> names = { "quests", "grind", "gather", "ah", "wpvp", "bosses", "explore", "rpg" };
+    return names;
+}
+
+const Archetype* Archetypes::Find(const std::string& name)
+{
+    std::call_once(archetypesParsed, Parse);
+
+    auto it = archetypes.find(name);
+    return it == archetypes.end() ? nullptr : &it->second;
+}
+
+const Archetype* Archetypes::Of(Player* bot)
+{
+    PlayerbotAI* ai = bot ? bot->GetPlayerbotAI() : nullptr;
+    if (!ai)
+        return nullptr;
+
+    std::string const name = ai->GetAiObjectContext()->GetValue<std::string>("manual saved string", "archetype")->Get();
+    if (name.empty())
+        return nullptr;
+
+    const Archetype* archetype = Find(name);
+    if (!archetype)
+    {
+        // Said once per name: a bot given an archetype the config lacks.
+        static std::mutex saidLock;
+        static std::set<std::string> said;
+        std::lock_guard<std::mutex> guard(saidLock);
+        if (said.insert(name).second)
+            sLog.outError("Archetype '%s' (bot %s) is not in AiPlayerbot.Archetypes; the bot behaves as without one", name.c_str(), bot->GetName());
+    }
+
+    return archetype;
+}
+
+int Archetypes::Rank(const Archetype* archetype, const std::string& activity)
+{
+    if (!archetype)
+        return -1;
+
+    auto it = std::find(archetype->activities.begin(), archetype->activities.end(), activity);
+    return it == archetype->activities.end() ? -1 : int(it - archetype->activities.begin());
+}
+
+float Archetypes::PvpMargin(Player* bot)
+{
+    const Archetype* archetype = Of(bot);
+    float margin = EngageOdds::PvpMargin;
+    if (!archetype)
+        return margin;
+
+    for (const auto& [fromLevel, value] : archetype->pvp)
+    {
+        if (bot->GetLevel() >= fromLevel)
+            margin = value;
+    }
+
+    return margin;
+}
diff --git a/playerbot/strategy/values/Archetypes.h b/playerbot/strategy/values/Archetypes.h
new file mode 100644
index 0000000..539f79c
--- /dev/null
+++ b/playerbot/strategy/values/Archetypes.h
@@ -0,0 +1,56 @@
+#pragma once
+
+#include <map>
+#include <string>
+#include <vector>
+
+// kalimdor: archetypes as data (Kamino 211; owner's rules, 2026-10-30). An
+// archetype is named and defined once in aiplayerbot.conf - teldrassil writes
+// it there from the roster - and a bot is given one by name, stored as its
+// "manual saved string::archetype". Without one, a bot behaves as upstream.
+//
+//   AiPlayerbot.Archetypes = quester,wpvper,creeper
+//   AiPlayerbot.Archetype.quester = activities=quests,grind,explore; pvp=1.2
+//   AiPlayerbot.Archetype.wpvper  = activities=wpvp,quests,grind; pvp=1.0
+//   AiPlayerbot.Archetype.creeper = activities=wpvp,grind; pvp@60=always
+//
+// activities: what the bot travels to do, most wanted first - between its
+//   upkeep (vendor, repair, trainers, mail, bank), which stays first. One not
+//   listed keeps upstream's place, below the listed ones. A bot whose
+//   archetype lists wpvp is not held by the world-PvP gates.
+// pvp: how much stronger its side must be to start a fight with an enemy
+//   player (values/EngageOdds.h; 1.2 without an archetype) - "always": every
+//   enemy player on sight, guards or not; "never": none, and it keeps away
+//   from all of them. pvp@N applies from level N on; the highest N at or
+//   below the bot's level wins, plain pvp below that.
+
+class Player;
+
+namespace ai
+{
+    struct Archetype
+    {
+        std::string name;
+        std::vector<std::string> activities;
+        std::map<uint32_t, float> pvp;  // from level -> margin
+    };
+
+    class Archetypes
+    {
+    public:
+        static constexpr float Always = 0.0f;
+        static constexpr float Never = 1.0e9f;
+
+        // The activity names an archetype can list.
+        static const std::vector<std::string>& ActivityNames();
+
+        static const Archetype* Find(const std::string& name);
+        // The bot's archetype, or none.
+        static const Archetype* Of(Player* bot);
+        // Where the activity is in the archetype's list, first 0, or -1.
+        static int Rank(const Archetype* archetype, const std::string& activity);
+        // The margin for starting a fight with an enemy player, at the bot's
+        // level: its archetype's, or EngageOdds::PvpMargin.
+        static float PvpMargin(Player* bot);
+    };
+}
