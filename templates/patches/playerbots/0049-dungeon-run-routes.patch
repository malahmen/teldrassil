+                Creature* starter = escort ? GetClosestCreatureWithEntry(bot, escort->starter, 300.0f) : nullptr;
+                bool const byStarter = starter && bot->GetDistance(starter) <= 30.0f &&
+                    std::abs(starter->GetPositionZ() - bot->GetPositionZ()) <= 5.0f;
+                for (int i = std::max(0, step); !byStarter && i < int(route->size()); ++i)
+                    if (!(*route)[i].entry)
