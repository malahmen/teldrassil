+bool GoToGatheringAction::Execute(Event& event)
+{
+    WorldPosition point;
+    Player* leader = nullptr;
+    std::string place;
+
+    // A trip it was sent on with no reason left - gathered, or inside after
+    // its leader - ends: bots walked back out to the entrance they had just
+    // come in by, 400 times in 7 hours (dev, 2026-11-14).
+    if (DungeonRun::StaleGatherTrip(bot))
+    {
+        AI_VALUE(TravelTarget*, "travel target")->SetStatus(TravelStatus::TRAVEL_STATUS_EXPIRED);
+        SET_AI_VALUE2(std::string, "manual string", "gather trip", "");
+        return true;
+    }
+
+    // Its leader inside: after it, by the way in. On its way 10 minutes and
+    // not in, it is put inside by the entrance - the leader too: a leader
+    // walked 30 minutes from the Wailing Caverns' cave mouth and never found
+    // the way in (dev, 2026-11-17).
+    // Its way in's points first (RunFollowAction); the travel only for the
+    // last stretch to the portal.
+    if (DungeonRun::WayInLeft(bot))
+    {
+        // A trip to the portal under way: off - its points move it now.
+        if (!AI_VALUE2(std::string, "manual string", "gather trip").empty())
+        {
+            AI_VALUE(TravelTarget*, "travel target")->SetStatus(TravelStatus::TRAVEL_STATUS_EXPIRED);
+            SET_AI_VALUE2(std::string, "manual string", "gather trip", "");
+        }
+        return false;
+    }
+    if (DungeonRun::FollowLeaderIn(bot, point))
+    {
+        time_t const now = time(nullptr);
+        time_t since = AI_VALUE2(time_t, "manual time", "going in since");
+        WorldPosition way, inside;
+        // At the way in: through it (no client to step in for it).
+        if (DungeonRun::WayInto(bot, way, inside) && way.getMapId() == bot->GetMapId() && way.distance(WorldPosition(bot)) <= 8.0f)
+        {
+            SET_AI_VALUE2(time_t, "manual time", "going in since", 0);
+            AI_VALUE(TravelTarget*, "travel target")->SetStatus(TravelStatus::TRAVEL_STATUS_EXPIRED);
+            SET_AI_VALUE2(std::string, "manual string", "gather trip", "");
+            return bot->TeleportTo(inside.getMapId(), inside.getX(), inside.getY(), inside.getZ(), inside.getO());
+        }
+        if (since && now - since >= DungeonRun::GoingInTime && now - since < 4 * DungeonRun::GoingInTime && DungeonRun::WayInto(bot, way, inside))
+        {
+            sLog.outString("Bot #%d %s:%d <%s>: not in its dungeon after %d minutes - put inside", bot->GetGUIDLow(),
+                bot->GetTeam() == ALLIANCE ? "A" : "H", bot->GetLevel(), bot->GetName(), int((now - since) / 60));
+            SET_AI_VALUE2(time_t, "manual time", "going in since", 0);
+            AI_VALUE(TravelTarget*, "travel target")->SetStatus(TravelStatus::TRAVEL_STATUS_EXPIRED);
+            SET_AI_VALUE2(std::string, "manual string", "gather trip", "");
+            return bot->TeleportTo(inside.getMapId(), inside.getX(), inside.getY(), inside.getZ(), inside.getO());
+        }
+        if (!since || now - since >= 4 * DungeonRun::GoingInTime)
+            SET_AI_VALUE2(time_t, "manual time", "going in since", now);
+        TravelTarget* target = AI_VALUE(TravelTarget*, "travel target");
+        TemporaryTravelDestination* destination = new TemporaryTravelDestination(point);
+        target->SetTarget(destination, destination->GetPosition());
+        target->SetStatus(TravelStatus::TRAVEL_STATUS_TRAVEL);
+        target->SetForced(true);
+        SET_AI_VALUE2(std::string, "manual string", "gather trip", DungeonRun::PointKey(point));
+        target->SetExpireIn(30 * MINUTE * IN_MILLISECONDS);
+        if (!ai->HasStrategy("travel", BotState::BOT_STATE_NON_COMBAT))
+            ai->ChangeStrategy("+travel once", BotState::BOT_STATE_NON_COMBAT);
+        sLog.outString("Bot #%d %s:%d <%s>: %s into its dungeon (%s)", bot->GetGUIDLow(), bot->GetTeam() == ALLIANCE ? "A" : "H",
+            bot->GetLevel(), bot->GetName(), bot->GetGroup()->IsLeader(bot->GetObjectGuid()) ? "goes first" : "follows its leader",
+            bot->GetMapId() == point.getMapId() ? (std::to_string(int(point.distance(WorldPosition(bot)))) + "y").c_str() : "another continent");
+        return true;
+    }
+
+    if (!DungeonRun::GatherPoint(bot, point, leader, &place))
+        return false;
+    char const* team = bot->GetTeam() == ALLIANCE ? "A" : "H";
+
+    if (leader == bot)
+    {
+        std::string missing;
+        if (DungeonRun::GroupGathered(bot, &missing))
+        {
+            SET_AI_VALUE2(int, "manual int", "gathered", AI_VALUE2(int, "manual int", "group quest focus"));
+            SET_AI_VALUE2(int, "manual int", "way in step", 0);
+            DungeonRun::ShareQuests(bot);
+            AI_VALUE(TravelTarget*, "travel target")->SetStatus(TravelStatus::TRAVEL_STATUS_EXPIRED);
+            sLog.outString("Bot #%d %s:%d <%s>: its group is gathered at %s - it goes on", bot->GetGUIDLow(), team, bot->GetLevel(),
+                bot->GetName(), place.c_str());
+            return true;
+        }
+        // Where it stands, every 10 minutes while it waits.
+        time_t const now = time(nullptr);
+        if (DungeonRun::AtGathering(bot) && now - AI_VALUE2(time_t, "manual time", "gather logged") >= 10 * MINUTE)
+        {
+            SET_AI_VALUE2(time_t, "manual time", "gather logged", now);
+            sLog.outString("Bot #%d %s:%d <%s>: waits for its group at %s (missing: %s)", bot->GetGUIDLow(), team, bot->GetLevel(),
+                bot->GetName(), place.c_str(), missing.c_str());
+        }
+        if (DungeonRun::AtGathering(bot))
+            return false;
+    }
+
+    // Stuck on the way, leader or member: the unstuck - to the gathering
+    // point (RepopAction).
+    if (!DungeonRun::AtGathering(bot) && DungeonRun::GatherStuck(bot, point))
+    {
+        sLog.outString("Bot #%d %s:%d <%s>: has not moved in %d minutes on its way to its group's gathering point at %s (%dy) - stuck", bot->GetGUIDLow(), team,
+            bot->GetLevel(), bot->GetName(), int(DungeonRun::GatherStuckTime / 60), place.c_str(), int(point.distance(WorldPosition(bot))));
+        DungeonRun::GatherProgressReset(bot);
+        return ai->DoSpecificAction("repop", Event(), true);
+    }
+
+    // Stocked first: food, drink, bag room (DungeonRun::NeedsStock).
+    {
+        int const focus = AI_VALUE2(int, "manual int", "group quest focus");
+        time_t const now = time(nullptr);
+        WorldPosition vendor;
+        uint32 entry = 0;
+        if (AI_VALUE2(int, "manual int", "stocked for") != focus)
+        {
+            time_t const since = AI_VALUE2(time_t, "manual time", "stock since");
+            if (!since)
+                SET_AI_VALUE2(time_t, "manual time", "stock since", now);
+            bool const due = DungeonRun::NeedsStock(bot) && now - (since ? since : now) < DungeonRun::StockTime &&
+                DungeonRun::StockVendor(bot, vendor, entry);
+            Creature* npc = due ? GetClosestCreatureWithEntry(bot, entry, 30.0f) : nullptr;
+            if (!due || (npc && bot->GetDistance(npc) <= INTERACTION_DISTANCE))
+            {
+                if (npc)
+                {
+                    if (bot->IsMoving())
+                        ai->StopMoving();
+                    uint32 const money = bot->GetMoney();
+                    RESET_AI_VALUE(std::list<ObjectGuid>, "nearest npcs");
+                    uint32 sold = 0, got = 0;
+                    DungeonRun::SellForRoom(bot, sold, got);
+                    ai->DoSpecificAction("buy", Event("dungeon stock", "vendor"), true);
+                    sLog.outString("Bot #%d %s:%d <%s>: stocks up at %s before its dungeon (%d copper)", bot->GetGUIDLow(), team, bot->GetLevel(),
+                        bot->GetName(), npc->GetName(), int(bot->GetMoney()) - int(money));
+                }
+                else if (since && now - since >= DungeonRun::StockTime)
+                    sLog.outString("Bot #%d %s:%d <%s>: no vendor reached in %d minutes - on to its group unstocked", bot->GetGUIDLow(), team,
+                        bot->GetLevel(), bot->GetName(), int(DungeonRun::StockTime / 60));
+                SET_AI_VALUE2(int, "manual int", "stocked for", focus);
+                SET_AI_VALUE2(time_t, "manual time", "stock since", 0);
+            }
+            else if (npc)
+            {
+                // In sight: the last yards to it (the travel stops short).
+                if (!bot->IsMoving())
+                    bot->GetMotionMaster()->MovePoint(0, npc->GetPositionX(), npc->GetPositionY(), npc->GetPositionZ(), FORCED_MOVEMENT_RUN, true);
+                return true;
+            }
+            else
+            {
+                TravelTarget* target = AI_VALUE(TravelTarget*, "travel target");
+                TemporaryTravelDestination* to = target->IsForced() && target->IsActive() ? dynamic_cast<TemporaryTravelDestination*>(target->GetDestination()) : nullptr;
+                if (to && to->GetPosition() && to->GetPosition()->distance(vendor) <= 1.0f)
+                    return false;
+                TemporaryTravelDestination* destination = new TemporaryTravelDestination(vendor);
+                target->SetTarget(destination, destination->GetPosition());
+                target->SetStatus(TravelStatus::TRAVEL_STATUS_TRAVEL);
+                target->SetForced(true);
+                target->SetExpireIn(DungeonRun::StockTime * IN_MILLISECONDS);
+                if (!ai->HasStrategy("travel", BotState::BOT_STATE_NON_COMBAT))
+                    ai->ChangeStrategy("+travel once", BotState::BOT_STATE_NON_COMBAT);
+                CreatureInfo const* info = ObjectMgr::GetCreatureTemplate(entry);
+                sLog.outString("Bot #%d %s:%d <%s>: goes to %s to stock up before its dungeon (%dy)", bot->GetGUIDLow(), team, bot->GetLevel(),
+                    bot->GetName(), info ? info->Name : "a vendor", int(vendor.distance(WorldPosition(bot))));
+                return true;
+            }
+        }
+    }
+
+    // On its way there, first of all.
+    TravelTarget* target = AI_VALUE(TravelTarget*, "travel target");
+    TemporaryTravelDestination* to = target->IsForced() && target->IsActive() ? dynamic_cast<TemporaryTravelDestination*>(target->GetDestination()) : nullptr;
+    if (to && to->GetPosition() && to->GetPosition()->distance(point) <= 1.0f)
+        return false;
+    TemporaryTravelDestination* destination = new TemporaryTravelDestination(point);
+    target->SetTarget(destination, destination->GetPosition());
+    target->SetStatus(TravelStatus::TRAVEL_STATUS_TRAVEL);
+    target->SetForced(true);
+    SET_AI_VALUE2(std::string, "manual string", "gather trip", DungeonRun::PointKey(point));
+    target->SetExpireIn(30 * MINUTE * IN_MILLISECONDS);
+    if (!ai->HasStrategy("travel", BotState::BOT_STATE_NON_COMBAT))
+        ai->ChangeStrategy("+travel once", BotState::BOT_STATE_NON_COMBAT);
+    sLog.outString("Bot #%d %s:%d <%s>: goes to its group's gathering point at %s (%s)", bot->GetGUIDLow(), team, bot->GetLevel(),
+        bot->GetName(), place.c_str(), bot->GetMapId() == point.getMapId() ? (std::to_string(int(point.distance(WorldPosition(bot)))) + "y").c_str() : "another continent");
+    return true;
+}
