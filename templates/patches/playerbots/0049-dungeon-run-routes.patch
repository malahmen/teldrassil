+DungeonRun::EscortEvent const* DungeonRun::EscortOf(uint32 mapId)
+{
+    // Wailing Caverns: the Disciple of Naralex (3678), the event ready at his
+    // TYPE_DISCIPLE (4) SPECIAL, Mutanus (3654) at TYPE_MUTANUS (5).
+    static EscortEvent const events[] = { { 43, 3678, 4, 3654, 5 } };
+    for (EscortEvent const& event : events)
+        if (event.map == mapId)
+            return &event;
+    return nullptr;
+}
+
+DungeonRun::EscortState DungeonRun::EscortStateOf(Player* bot)
+{
+    EscortEvent const* event = EscortOf(bot->GetMapId());
+    InstanceData* data = bot->GetMap()->IsDungeon() ? bot->GetMap()->GetInstanceData() : nullptr;
+    if (!event || !data)
+        return ESCORT_NONE;
+    if (data->GetData(event->bossType) == 3) // DONE
+        return ESCORT_DONE;
+    switch (data->GetData(event->readyType))
+    {
+        case 4: return ESCORT_READY;   // SPECIAL
+        case 1: return ESCORT_ON;      // IN_PROGRESS
+        default: return ESCORT_WAITING; // not open yet, or failed
+    }
+}
+
+Creature* DungeonRun::EscortNpc(Player* bot)
+{
+    if (!bot->IsInWorld() || !bot->GetMap()->IsDungeon() || EscortStateOf(bot) != ESCORT_ON)
+        return nullptr;
+    EscortEvent const* event = EscortOf(bot->GetMapId());
+    Creature* npc = event ? GetClosestCreatureWithEntry(bot, event->starter, EscortNpcRange) : nullptr;
+    return npc && npc->IsAlive() ? npc : nullptr;
+}
+
+bool DungeonRun::EscortFollow(Player* member, Player* leader)
+{
+    if (!leader || !leader->GetPlayerbotAI() || leader->GetMapId() != member->GetMapId() || leader->GetInstanceId() != member->GetInstanceId())
+        return false;
+    if (time(nullptr) - leader->GetPlayerbotAI()->GetAiObjectContext()->GetValue<time_t>("manual time", "run escort")->Get() <= 5)
+        return true;
+    return EscortStateOf(member) == ESCORT_ON &&
+        leader->GetPlayerbotAI()->GetAiObjectContext()->GetValue<int>("manual int", "run escort tries")->Get() <= EscortTries;
+}
+
+bool DungeonRun::EscortPending(Player* leader)
+{
+    EscortState const state = EscortStateOf(leader);
+    // On - unless given up (its starter dead after its last try, the event
+    // left "in progress" till he respawns).
+    if (state == ESCORT_ON)
+        return leader->GetPlayerbotAI()->GetAiObjectContext()->GetValue<int>("manual int", "run escort tries")->Get() <= EscortTries;
+    if (state == ESCORT_READY)
+        return leader->GetPlayerbotAI()->GetAiObjectContext()->GetValue<int>("manual int", "run escort tries")->Get() < EscortTries;
+    if (state != ESCORT_WAITING)
+        return false;
+    // Failed: its starter back after its respawn - a while at most.
+    AiObjectContext* context = leader->GetPlayerbotAI()->GetAiObjectContext();
+    time_t const failed = context->GetValue<time_t>("manual time", "run escort failed")->Get();
+    return context->GetValue<int>("manual int", "run escort tries")->Get() > 0 &&
+        context->GetValue<int>("manual int", "run escort tries")->Get() < EscortTries &&
+        failed && time(nullptr) - failed < EscortWaitTime;
+}
