+    // Progress by the walkable path's length, not the straight line: in
+    // winding caves a bot on its way can be farther in a line while nearer
+    // along the path (the Wailing Caverns, dev, 2026-11-16).
+    int distance = int(pos.distance(WorldPosition(bot)));
+    {
+        std::vector<WorldPosition> const path = WorldPosition(bot).getPathTo(pos, bot);
+        if (path.size() > 1 && pos.isPathTo(path))
+        {
+            float length = 0.0f;
+            for (size_t i = 1; i < path.size(); ++i)
+                length += path[i - 1].distance(path[i]);
+            distance = int(length);
+        }
+    }
+    CreatureInfo const* info = entry > 0 ? ObjectMgr::GetCreatureTemplate(uint32(entry)) : nullptr;
+    char const* bossName = info ? info->Name : entry < 0 ? "a waypoint of its route" : "a boss";
+    if (entry != AI_VALUE2(int, "manual int", "run boss entry"))
+    {
+        SET_AI_VALUE2(int, "manual int", "run boss entry", entry);
+        SET_AI_VALUE2(std::string, "manual string", "run seen", "");
+        SET_AI_VALUE2(int, "manual int", "run boss best", distance);
+        SET_AI_VALUE2(time_t, "manual time", "run boss since", now);
+        SET_AI_VALUE2(std::string, "manual string", "run boss from", WorldPosition(bot).to_string());
+        sLog.outString("Bot #%d %s:%d <%s>: goes for %s (%dy)", bot->GetGUIDLow(), bot->GetTeam() == ALLIANCE ? "A" : "H", bot->GetLevel(),
+            bot->GetName(), bossName, distance);
+    }
+    else if (distance < AI_VALUE2(int, "manual int", "run boss best") - 10)
+    {
+        SET_AI_VALUE2(int, "manual int", "run boss best", distance);
+        SET_AI_VALUE2(time_t, "manual time", "run boss since", now);
+    }
+    else if (now - AI_VALUE2(time_t, "manual time", "run boss since") >= DungeonRun::RunReachTime)
+    {
+        // Not moved at all meanwhile: it is stuck where it stands, its moves
+        // taken but going nowhere (Kiilsohi, the Wailing Caverns, hours on one
+        // spot, dev 2026-11-16) - back to the run's start, the step kept.
+        WorldPosition const from(AI_VALUE2(std::string, "manual string", "run boss from"));
+        WorldPosition start;
+        // Heading for a waypoint, onto it: back at the start, the same way
+        // led to the same spot (the Wailing Caverns, dev, 2026-11-16).
+        if (from.distance(WorldPosition(bot)) < 5.0f && entry < 0)
+        {
+            sLog.outString("Bot #%d %s:%d <%s>: stuck on its way to %s - moved onto it", bot->GetGUIDLow(),
+                bot->GetTeam() == ALLIANCE ? "A" : "H", bot->GetLevel(), bot->GetName(), bossName);
+            SET_AI_VALUE2(int, "manual int", "run boss entry", 0);
+            return bot->TeleportTo(pos.getMapId(), pos.getX(), pos.getY(), pos.getZ(), bot->GetOrientation());
+        }
+        if (from.distance(WorldPosition(bot)) < 5.0f && DungeonRun::RunStart(bot, start))
+        {
+            sLog.outString("Bot #%d %s:%d <%s>: stuck on its way to %s - back to the start of its run", bot->GetGUIDLow(),
+                bot->GetTeam() == ALLIANCE ? "A" : "H", bot->GetLevel(), bot->GetName(), bossName);
+            SET_AI_VALUE2(int, "manual int", "run boss entry", 0);
+            return bot->TeleportTo(start.getMapId(), start.getX(), start.getY(), start.getZ(), bot->GetOrientation());
+        }
+        // No nearer in RunReachTime: not reachable from here - skipped.
+        sLog.outString("Bot #%d %s:%d <%s>: can't reach %s (%dy) - skipped", bot->GetGUIDLow(), bot->GetTeam() == ALLIANCE ? "A" : "H",
+            bot->GetLevel(), bot->GetName(), bossName, distance);
+        if (onRoute)
+            SET_AI_VALUE2(int, "manual int", "run step", AI_VALUE2(int, "manual int", "run step") + 1);
+        else
+            SET_AI_VALUE2(std::string, "manual string", "run skip", AI_VALUE2(std::string, "manual string", "run skip") + std::to_string(entry) + ",");
+        SET_AI_VALUE2(int, "manual int", "run boss entry", 0);
+        return true;
+    }
+    // Fallen - well below both ends of its leg: onto its step at once.
+    if (entry < 0 && onRoute && !bot->IsInCombat())
+    {
+        int const at = -entry - 1;
+        if (at > 0 && pos.getMapId() == bot->GetMapId() && bot->GetPositionZ() < pos.getZ() - DungeonRun::FallDepth &&
+            bot->GetPositionZ() < route[at - 1].point.getZ() - DungeonRun::FallDepth)
+        {
+            sLog.outString("Bot #%d %s:%d <%s>: fell below its way - put on its next step", bot->GetGUIDLow(),
+                bot->GetTeam() == ALLIANCE ? "A" : "H", bot->GetLevel(), bot->GetName());
+            return bot->TeleportTo(pos.getMapId(), pos.getX(), pos.getY(), pos.getZ(), bot->GetOrientation());
+        }
+    }
+    // A step in a line - straight, a drop, a jump, a swim: the leader makes
+    // it first; each member makes the same move from the same point after
+    // it (RunFollowAction; owner, 2026-11-18). Again if not there in
+    // StraightTime.
+    if (entry < 0 && (kind == "straight" || kind == "drop" || kind == "jump" || kind == "swim"))
+    {
+        // A drop or a jump: over the edge, no way looked for - no 3 yards
+        // nearer in 6 seconds, it is put down there (the leader hung half
+        // way down the slope after Cobrahn, its group went back looking
+        // for a way; owner, 2026-11-20).
+        if ((kind == "drop" || kind == "jump") && DungeonRun::DropStuck(bot, entry, pos))
+        {
+            sLog.outString("Bot #%d %s:%d <%s>: no way %s - put there", bot->GetGUIDLow(), bot->GetTeam() == ALLIANCE ? "A" : "H",
+                bot->GetLevel(), bot->GetName(), kind == "drop" ? "down" : "across");
+            return bot->TeleportTo(pos.getMapId(), pos.getX(), pos.getY(), pos.getZ(), bot->GetOrientation());
+        }
+        if (now - AI_VALUE2(time_t, "manual time", "run straight since") < 3 &&
+            AI_VALUE2(int, "manual int", "run straight step") == entry)
+            return true;
+        if (AI_VALUE2(int, "manual int", "run straight step") != entry)
+            sLog.outString("Bot #%d %s:%d <%s>: goes %s to %s, its group after it", bot->GetGUIDLow(), bot->GetTeam() == ALLIANCE ? "A" : "H",
+                bot->GetLevel(), bot->GetName(), kind == "straight" ? "straight" : kind == "drop" ? "down" : kind == "jump" ? "across" : "swimming",
+                pos.to_string().c_str());
+        SET_AI_VALUE2(int, "manual int", "run straight step", entry);
+        SET_AI_VALUE2(time_t, "manual time", "run straight since", now);
+        bot->GetMotionMaster()->MovePoint(0, pos.getX(), pos.getY(), pos.getZ(), FORCED_MOVEMENT_RUN, false);
+        return true;
+    }
+    // A charge step: the tank goes in - a caster pulled stays back and
+    // casts (owner, 2026-11-17: Cobrahn, Pythas, Skum, Serpentis, Verdan).
+    if (entry > 0 && kind == "charge" && boss && boss->IsAlive() && bot->GetDistance(boss) <= DungeonRun::PullScanRange && bot->IsWithinLOSInMap(boss))
+    {
+        // To it first: an attack from afar set its target and stood there,
+        // nothing hit - out of combat it tried again every 2 seconds (dev,
+        // 2026-11-20, Cobrahn).
+        if (!bot->IsInCombat() && bot->GetDistance(boss) > ATTACK_DISTANCE)
+        {
+            if (!bot->IsMoving())
+                sLog.outString("Bot #%d %s:%d <%s>: charges %s (%.0fy)", bot->GetGUIDLow(), bot->GetTeam() == ALLIANCE ? "A" : "H",
+                    bot->GetLevel(), bot->GetName(), boss->GetName(), bot->GetDistance(boss));
+            return MoveTo(boss->GetMapId(), boss->GetPositionX(), boss->GetPositionY(), boss->GetPositionZ());
+        }
+        return Attack(nullptr, boss);
+    }
+    // A pull under way: it waits - the puller hits, comes back, the
+    // creature after it - PullTime at most; a pull that came to nothing is
+    // not tried again, the tank goes in itself (owner, 2026-11-17).
+    std::string const pulling = AI_VALUE2(std::string, "manual string", "run pull");
+    if (!pulling.empty())
+    {
+        Creature* pulled = bot->GetMap()->GetAnyTypeCreature(ObjectGuid(uint64(std::stoull(pulling))));
+        if (pulled && pulled->IsAlive() && !pulled->IsInCombat() && now - AI_VALUE2(time_t, "manual time", "run pull since") < DungeonRun::PullTime)
+        {
+            // Its shot not off after 2 seconds: the puller shoots it itself
+            // - in range and sight, facing it - else goes 5 yards inside its
+            // range first. Upstream's pull shoots once as it starts; a shot
+            // that failed left the puller standing by, re-arming it did not
+            // help (27 of 41 pulls, dev, 2026-11-17).
+            if (Player* puller = sObjectMgr.GetPlayer(AI_VALUE2(std::string, "manual string", "run puller").c_str()))
+                if (puller->GetPlayerbotAI() && puller->IsAlive() && !puller->IsNonMeleeSpellCasted(true) &&
+                    now - AI_VALUE2(time_t, "manual time", "run pull since") >= 2)
+                    if (PullStrategy* strategy = PullStrategy::Get(puller->GetPlayerbotAI()))
+                    {
+                        PlayerbotAI* pullerAi = puller->GetPlayerbotAI();
+                        std::string const spell = strategy->GetSpellName();
+                        float range = 30.0f;
+                        pullerAi->GetSpellRange(spell, &range);
+                        // Out of range or sight: it does not walk to it - the
+                        // pull comes to nothing, and the tank goes in; but
+                        // round a corner it steps out into sight, shoots and
+                        // comes back.
+                        if (puller->GetDistance(pulled) > range - 2.0f || !puller->IsWithinLOSInMap(pulled))
+                        {
+                            if (!AI_VALUE2(std::string, "manual string", "run pull corner").empty())
+                            {
+                                if (!puller->IsMoving())
+                                {
+                                    float const angle = pulled->GetAngle(puller);
+                                    float x = pulled->GetPositionX() + (range - 5.0f) * std::cos(angle);
+                                    float y = pulled->GetPositionY() + (range - 5.0f) * std::sin(angle);
+                                    float z = puller->GetPositionZ();
+                                    puller->UpdateAllowedPositionZ(x, y, z);
+                                    puller->GetMotionMaster()->MovePoint(0, x, y, z, FORCED_MOVEMENT_RUN);
+                                }
+                            }
+                            else if (puller->IsMoving())
+                                pullerAi->StopMoving();
+                        }
+                        else
+                        {
+                            if (puller->IsMoving())
+                                pullerAi->StopMoving();
+                            // Its selection on it: a wand's Shoot goes at what it has
+                            // selected - cast at no selection, nothing came (dev,
+                            // 2026-11-17).
+                            puller->SetSelectionGuid(pulled->GetObjectGuid());
+                            pullerAi->GetAiObjectContext()->GetValue<ObjectGuid>("current target")->Set(pulled->GetObjectGuid());
+                            puller->SetFacingToObject(pulled);
+                            pullerAi->CastSpell(spell, pulled);
+                        }
+                    }
+            if (bot->IsMoving())
+                ai->StopMoving();
+            SET_AI_VALUE2(time_t, "manual time", "run boss since", now);
+            return true;
+        }
+        if (pulled && pulled->IsAlive() && !pulled->IsInCombat())
+        {
+            sLog.outString("Bot #%d %s:%d <%s>: the pull of %s came to nothing - it goes in itself", bot->GetGUIDLow(),
+                bot->GetTeam() == ALLIANCE ? "A" : "H", bot->GetLevel(), bot->GetName(), pulled->GetName());
+            SET_AI_VALUE2(std::string, "manual string", "run pull failed",
+                AI_VALUE2(std::string, "manual string", "run pull failed") + "," + std::to_string(pulled->GetGUIDLow()) + ",");
+        }
+        // The puller let go: its pull over, out of the fight state the pull
+        // put it in, if nothing fights it - one left in it stood 11 minutes,
+        // its follow never run again (dev, 2026-11-20).
+        if (Player* puller = sObjectMgr.GetPlayer(AI_VALUE2(std::string, "manual string", "run puller").c_str()))
+            if (PlayerbotAI* pullerAi = puller->GetPlayerbotAI())
+            {
+                if (PullStrategy* strategy = PullStrategy::Get(pullerAi))
+                    strategy->OnPullEnded();
+                if (puller->IsAlive() && !puller->IsInCombat())
+                    pullerAi->OnCombatEnded();
+            }
+        SET_AI_VALUE2(std::string, "manual string", "run pull", "");
+    }
+
+    // Something to fight ahead: pulled, not walked into. A caster or a pack
+    // round a corner - the group waits out of its sight first.
+    std::string const cornered = AI_VALUE2(std::string, "manual string", "run corner");
+    uint32 const keptLow = cornered.empty() ? 0 : uint32(std::stoul(cornered.substr(0, cornered.find('|'))));
+    // The one it went round a corner for, by its guid while alive and not
+    // fighting, 60 yards at most - out of sight and beyond the scan from the
+    // corner it was lost, the leader to and fro (dev, 2026-11-21).
+    Creature* trash = nullptr;
+    std::string const keptGuid = AI_VALUE2(std::string, "manual string", "run corner guid");
+    if (!cornered.empty() && !keptGuid.empty())
+        if (Creature* kept = bot->GetMap()->GetAnyTypeCreature(ObjectGuid(uint64(std::stoull(keptGuid)))))
+            if (kept->IsAlive() && !kept->IsInCombat() && bot->GetDistance(kept) <= 60.0f &&
+                AI_VALUE2(std::string, "manual string", "run pull failed").find("," + std::to_string(kept->GetGUIDLow()) + ",") == std::string::npos)
+                trash = kept;
+    if (!trash)
+        trash = DungeonRun::TrashAhead(bot, pos, AI_VALUE2(std::string, "manual string", "run pull failed"), keptLow);
+    if (trash)
+    {
+        SET_AI_VALUE2(time_t, "manual time", "run boss since", now);
+        WorldPosition spot(bot);
+        bool corner = false;
+        // A hard hold here: the pull is part of it - no corner pull, the two
+        // exclude each other (owner, 2026-11-20). The tank waits at its
+        // spot; the puller steps out, pulls, and comes back to its own.
+        bool holdLeg = false, hasTankSpot = false;
+        WorldPosition tankSpot;
+        DungeonRun::FightLeg(bot, holdLeg, tankSpot, hasTankSpot);
+        if (holdLeg && hasTankSpot && tankSpot.distance(WorldPosition(bot)) > 3.0f)
+        {
+            if (!bot->IsMoving())
+                sLog.outString("Bot #%d %s:%d <%s>: to its tank spot for %s (%.0fy)", bot->GetGUIDLow(), bot->GetTeam() == ALLIANCE ? "A" : "H",
+                    bot->GetLevel(), bot->GetName(), trash->GetName(), tankSpot.distance(WorldPosition(bot)));
+            SET_AI_VALUE2(time_t, "manual time", "to tank spot", now);
+            return MoveTo(tankSpot.getMapId(), tankSpot.getX(), tankSpot.getY(), tankSpot.getZ());
+        }
+        if (!holdLeg && DungeonRun::NeedsCorner(bot, trash))
+        {
+            std::string const key = std::to_string(trash->GetGUIDLow());
+            std::string const kept = AI_VALUE2(std::string, "manual string", "run corner");
+            if (kept.find(key + "|") == 0)
+            {
+                spot = WorldPosition(kept.substr(key.size() + 1));
+                corner = true;
+            }
+            else if (DungeonRun::HiddenSpot(bot, trash, spot))
+            {
+                SET_AI_VALUE2(std::string, "manual string", "run corner", key + "|" + spot.to_string());
+                SET_AI_VALUE2(std::string, "manual string", "run corner guid", std::to_string(trash->GetObjectGuid().GetRawValue()));
+                corner = true;
+            }
+            if (corner && spot.distance(WorldPosition(bot)) > 3.0f)
+            {
+                if (!bot->IsMoving())
+                    sLog.outString("Bot #%d %s:%d <%s>: out of %s's sight first (%.0fy)", bot->GetGUIDLow(), bot->GetTeam() == ALLIANCE ? "A" : "H",
+                        bot->GetLevel(), bot->GetName(), trash->GetName(), spot.distance(WorldPosition(bot)));
+                return MoveTo(spot.getMapId(), spot.getX(), spot.getY(), spot.getZ());
+            }
+        }
+        // The group closes up to its leader before a pull - members walk a
+        // point behind it, and its puller ran on from there past it, round
+        // to the far side of what it pulled, and pulled more (owner,
+        // 2026-11-20).
+        if (!holdLeg)
+            SET_AI_VALUE2(time_t, "manual time", "run close up", now);
+        for (GroupReference* ref = bot->GetGroup()->GetFirstMember(); !holdLeg && ref; ref = ref->next())
+            if (Player* member = ref->getSource())
+                if (member != bot && member->IsInWorld() && member->IsAlive() && member->GetMapId() == bot->GetMapId() &&
+                    member->GetDistance(bot) > DungeonRun::CloseUpRange)
+                {
+                    if (bot->IsMoving())
+                        ai->StopMoving();
+                    // Said once a minute; one not come in 90 seconds is put
+                    // by it - the group waited an hour and 40 minutes, not
+                    // a word, for one that could not come (before Cobrahn,
+                    // dev, 2026-11-23).
+                    if (AI_VALUE2(std::string, "manual string", "close up for") != member->GetName())
+                    {
+                        SET_AI_VALUE2(std::string, "manual string", "close up for", member->GetName());
+                        SET_AI_VALUE2(time_t, "manual time", "close up since", now);
+                        SET_AI_VALUE2(time_t, "manual time", "close up said", 0);
+                    }
+                    if (now - AI_VALUE2(time_t, "manual time", "close up said") >= 60)
+                    {
+                        SET_AI_VALUE2(time_t, "manual time", "close up said", now);
+                        sLog.outString("Bot #%d %s:%d <%s>: waits for %s to close up before pulling %s (%.0fy)", bot->GetGUIDLow(),
+                            bot->GetTeam() == ALLIANCE ? "A" : "H", bot->GetLevel(), bot->GetName(), member->GetName(), trash->GetName(),
+                            member->GetDistance(bot));
+                    }
+                    if (now - AI_VALUE2(time_t, "manual time", "close up since") >= 90 && member->GetPlayerbotAI() && !member->IsInCombat())
+                    {
+                        sLog.outString("Bot #%d %s:%d <%s>: %s has not closed up in 90s - put by it", bot->GetGUIDLow(),
+                            bot->GetTeam() == ALLIANCE ? "A" : "H", bot->GetLevel(), bot->GetName(), member->GetName());
+                        SET_AI_VALUE2(std::string, "manual string", "close up for", "");
+                        member->GetPlayerbotAI()->OnCombatEnded();
+                        member->TeleportTo(bot->GetMapId(), bot->GetPositionX(), bot->GetPositionY(), bot->GetPositionZ(), bot->GetOrientation());
+                    }
+                    return true; // they come to it (RunFollowAction)
+                }
+        SET_AI_VALUE2(std::string, "manual string", "close up for", "");
+        Player* puller = DungeonRun::Puller(bot, trash);
+        // From where the group stands: in its puller's range and sight, or
+        // the group a few yards nearer first - the puller never walks to it.
+        if (puller && !corner && !holdLeg && !DungeonRun::InPullRange(puller, trash))
+        {
+            WorldPosition const step = DungeonRun::LegTowards(bot, WorldPosition(trash), 8.0f);
+            return MoveNear(step.getMapId(), step.getX(), step.getY(), step.getZ(), 1.0f);
+        }
+        // Where the puller comes back to: the corner, its hold spot (the
+        // ranged spot marked, else where it stands), or its leader.
+        WorldPosition back = corner ? spot : WorldPosition(bot);
+        if (puller && holdLeg && !DungeonRun::RangedSpot(puller, back))
+            back = WorldPosition(puller);
+        if (puller)
+            if (DungeonRun::StartPull(bot, puller, trash, back))
+            {
+                SET_AI_VALUE2(std::string, "manual string", "run pull corner", (corner || holdLeg) ? "1" : "");
+                if (bot->IsMoving())
+                    ai->StopMoving();
+                SET_AI_VALUE2(std::string, "manual string", "run pull", std::to_string(trash->GetObjectGuid().GetRawValue()));
+                SET_AI_VALUE2(std::string, "manual string", "run puller", puller->GetName());
+                SET_AI_VALUE2(time_t, "manual time", "run pull since", now);
+                sLog.outString("Bot #%d %s:%d <%s>: %s pulls %s (%.0fy)%s", bot->GetGUIDLow(), bot->GetTeam() == ALLIANCE ? "A" : "H",
+                    bot->GetLevel(), bot->GetName(), puller == bot ? "it" : puller->GetName(), trash->GetName(), bot->GetDistance(trash),
+                    corner ? " round a corner" : "");
+                return true;
+            }
+        // None can pull it: the tank goes in.
+        return Attack(nullptr, trash);
+    }
+    if (boss && boss->IsAlive() && bot->GetDistance(boss) <= DungeonRun::RunEngageRange)
+        return Attack(nullptr, boss);
+    // Moving to a route point and getting no nearer: 60 tries (about two
+    // minutes of moving - pulls and waits between do not count) without 3
+    // yards gained, it is put on it - pulls and mana waits kept resetting
+    // the step's clock, and a leader walked into the rock below a waypoint
+    // for two hours (the Wailing Caverns, dev, 2026-11-19).
+    if (entry < 0)
+    {
+        int const gap = int(pos.distance(WorldPosition(bot)));
+        if (AI_VALUE2(int, "manual int", "run try step") != entry || gap < AI_VALUE2(int, "manual int", "run try best") - 3)
+        {
+            SET_AI_VALUE2(int, "manual int", "run try step", entry);
+            SET_AI_VALUE2(int, "manual int", "run try best", gap);
+            SET_AI_VALUE2(int, "manual int", "run tries", 0);
+        }
+        else if (AI_VALUE2(int, "manual int", "run tries") >= 60)
+        {
+            sLog.outString("Bot #%d %s:%d <%s>: no nearer to %s after 60 tries - put on it", bot->GetGUIDLow(),
+                bot->GetTeam() == ALLIANCE ? "A" : "H", bot->GetLevel(), bot->GetName(), bossName);
+            SET_AI_VALUE2(int, "manual int", "run tries", 0);
+            return bot->TeleportTo(pos.getMapId(), pos.getX(), pos.getY(), pos.getZ(), bot->GetOrientation());
+        }
+        else
+            SET_AI_VALUE2(int, "manual int", "run tries", AI_VALUE2(int, "manual int", "run tries") + 1);
+    }
+    // A route point its path goes round to: the line, like the group's
+    // others (DungeonRun::Detour); a leg at most, looking ahead between.
+    if (entry < 0 && DungeonRun::Detour(bot, pos))
+    {
+        WorldPosition leg = pos;
+        if (pos.distance(WorldPosition(bot)) > DungeonRun::LegLength)
+        {
+            float const part = DungeonRun::LegLength / pos.distance(WorldPosition(bot));
+            leg = WorldPosition(pos.getMapId(), bot->GetPositionX() + (pos.getX() - bot->GetPositionX()) * part,
+                bot->GetPositionY() + (pos.getY() - bot->GetPositionY()) * part, bot->GetPositionZ() + (pos.getZ() - bot->GetPositionZ()) * part);
+        }
+        bot->GetMotionMaster()->MovePoint(0, leg.getX(), leg.getY(), leg.getZ(), FORCED_MOVEMENT_RUN, false);
+        return true;
+    }
+    // On in legs, looking ahead between them.
+    WorldPosition const leg = DungeonRun::LegTowards(bot, pos, DungeonRun::LegLength);
+    // A leg its path goes round to, the line to it (step 29 to 30 of the
+    // Wailing Caverns' way in: its path went 30 yards back up, it off its
+    // way and back, again and again - two groups; dev, 2026-11-20).
+    // Only on a leg of the owner's route (a waypoint): toward a boss or a
+    // pull the line ran over a drop, the leader left hanging in the air
+    // (dev, 2026-11-21).
+    if (entry < 0 && DungeonRun::Detour(bot, leg))
+    {
+        bot->GetMotionMaster()->MovePoint(0, leg.getX(), leg.getY(), leg.getZ(), FORCED_MOVEMENT_RUN, false);
+        return true;
+    }
+    return MoveNear(leg.getMapId(), leg.getX(), leg.getY(), leg.getZ(), 2.0f);
+}
+
+bool RunFollowAction::Execute(Event& event)
+{
+    Player* leader = DungeonRun::Leader(bot);
+    if (!leader && (DungeonRun::WalkingIn(bot) || DungeonRun::WayInLeft(bot)))
+        leader = sObjectMgr.GetPlayer(bot->GetGroup()->GetLeaderGuid());
+    if (!leader)
+        return false;
+    // On a route: its steps, one by one, after its leader - not after the
+    // leader itself, whose path from where the member stands differs
+    // (owner, 2026-11-18). A step walked: up to the one the leader heads
+    // for; a step in a line (a drop, a jump): once the leader has made it,
+    // the same move from the same point. Boss steps are fights: passed.
+    // An escort under way (RunNextBossAction::Escort): after its leader.
+    if (DungeonRun::EscortFollow(bot, leader))
+        return bot->GetDistance(leader) > DungeonRun::CloseUpRange / 2.0f ?
+            MoveTo(leader->GetMapId(), leader->GetPositionX(), leader->GetPositionY(), leader->GetPositionZ()) : false;
+    // Its leader about to pull: to it, whatever its point - the group pulls
+    // from where it stands together.
+    if (leader->GetPlayerbotAI() && time(nullptr) - leader->GetPlayerbotAI()->GetAiObjectContext()->GetValue<time_t>("manual time", "run close up")->Get() <= 3 &&
+        bot->GetDistance(leader) > DungeonRun::CloseUpRange / 2.0f)
+        return MoveNear(leader, 3.0f);
+    DungeonRun::RouteStep const* next = nullptr;
+    if (DungeonRun::MemberStep(bot, leader, next))
+    {
+        // Fallen - well below both ends of its leg (off a ledge, a bridge,
+        // in a fight): put on its step at once (owner, 2026-11-19: members
+        // ended in the water under the Wailing Caverns' bridges).
+        if (!bot->IsInCombat() && DungeonRun::Fell(bot, leader, *next))
+        {
+            sLog.outString("Bot #%d %s:%d <%s>: off its group's way in height - put on its next step", bot->GetGUIDLow(),
+                bot->GetTeam() == ALLIANCE ? "A" : "H", bot->GetLevel(), bot->GetName());
+            return bot->TeleportTo(next->point.getMapId(), next->point.getX(), next->point.getY(), next->point.getZ(), bot->GetOrientation());
+        }
+        if ((next->kind == "drop" || next->kind == "jump") && DungeonRun::DropStuck(bot, -1000 - AI_VALUE2(int, "manual int", "follow step"), next->point))
+        {
+            sLog.outString("Bot #%d %s:%d <%s>: no way %s - put there", bot->GetGUIDLow(), bot->GetTeam() == ALLIANCE ? "A" : "H",
+                bot->GetLevel(), bot->GetName(), next->kind == "drop" ? "down" : "across");
+            return bot->TeleportTo(next->point.getMapId(), next->point.getX(), next->point.getY(), next->point.getZ(), bot->GetOrientation());
+        }
+        // No 3 yards nearer its next point in a minute - progress, not just
+        // moving: one circled 30 yards from its point ten minutes, never
+        // 5 yards from where it was a minute before (dev, 2026-11-20).
+        time_t const now = time(nullptr);
+        int const gap = next->point.getMapId() == bot->GetMapId() ? int(next->point.distance(WorldPosition(bot))) : 9999;
+        int const target = AI_VALUE2(int, "manual int", "follow step");
+        time_t const since = AI_VALUE2(time_t, "manual time", "follow since");
+        // Its clock anew: no "stuck" this time - read before the reset, its
+        // time looked a minute old, and members went back a point on every
+        // update, thousands of times (dev, 2026-11-23).
+        bool const reset = !since || AI_VALUE2(int, "manual int", "follow target") != target || gap < AI_VALUE2(int, "manual int", "follow best") - 3;
+        if (reset)
+        {
+            SET_AI_VALUE2(int, "manual int", "follow target", target);
+            SET_AI_VALUE2(int, "manual int", "follow best", gap);
+            SET_AI_VALUE2(time_t, "manual time", "follow since", now);
+        }
+        // On a drop's slope - below the point before it, the slope not
+        // climbable back: down only, as its leader (DropStuck: no 3 yards
+        // nearer in 6 seconds, put down there; owner, 2026-11-22: members
+        // held on its ledges two minutes, sent back up to its top).
+        if ((next->kind == "drop" || next->kind == "jump") && DungeonRun::OnDropSlope(bot, next) &&
+            DungeonRun::DropStuck(bot, target, next->point))
+        {
+            sLog.outString("Bot #%d %s:%d <%s>: no way down - put there", bot->GetGUIDLow(), bot->GetTeam() == ALLIANCE ? "A" : "H",
+                bot->GetLevel(), bot->GetName());
+            SET_AI_VALUE2(time_t, "manual time", "follow since", 0);
+            return bot->TeleportTo(next->point.getMapId(), next->point.getX(), next->point.getY(), next->point.getZ(), bot->GetOrientation());
+        }
+        else if (!reset && now - since >= 60 && !bot->IsInCombat() && AI_VALUE2(int, "manual int", "follow tried back") != AI_VALUE2(int, "manual int", "follow step") &&
+            AI_VALUE2(int, "manual int", "follow step") > 0 && !DungeonRun::OnDropSlope(bot, next))
+        {
+            // First, back to the point before and on from there (owner,
+            // 2026-11-20); stuck again, put on it.
+            int const step = AI_VALUE2(int, "manual int", "follow step");
+            sLog.outString("Bot #%d %s:%d <%s>: stuck on its way to its group's next step - back to the one before", bot->GetGUIDLow(),
+                bot->GetTeam() == ALLIANCE ? "A" : "H", bot->GetLevel(), bot->GetName());
+            SET_AI_VALUE2(int, "manual int", "follow tried back", step);
+            SET_AI_VALUE2(int, "manual int", "follow step", step - 1);
+            SET_AI_VALUE2(time_t, "manual time", "follow since", 0);
+            return true;
+        }
+        else if (!reset && now - since >= 60 && !bot->IsInCombat())
+        {
+            sLog.outString("Bot #%d %s:%d <%s>: stuck on its way to its group's next step - put on it", bot->GetGUIDLow(),
+                bot->GetTeam() == ALLIANCE ? "A" : "H", bot->GetLevel(), bot->GetName());
+            SET_AI_VALUE2(time_t, "manual time", "follow since", 0);
+            return bot->TeleportTo(next->point.getMapId(), next->point.getX(), next->point.getY(), next->point.getZ(), bot->GetOrientation());
+        }
+        bool const inLine = next->kind == "straight" || next->kind == "drop" || next->kind == "jump" || next->kind == "swim";
+        if (inLine || DungeonRun::Detour(bot, next->point))
+        {
+            // Again every 3 seconds until there, moving or not: another move
+            // looking for a way round the drop took it over, and getting
+            // down was luck (owner, 2026-11-20).
+            if (now - AI_VALUE2(time_t, "manual time", "follow line since") >= 3)
+            {
+                SET_AI_VALUE2(time_t, "manual time", "follow line since", now);
+                bot->GetMotionMaster()->MovePoint(0, next->point.getX(), next->point.getY(), next->point.getZ(), FORCED_MOVEMENT_RUN, false);
+            }
+            return true;
+        }
+        return MoveTo(next->point.getMapId(), next->point.getX(), next->point.getY(), next->point.getZ());
+    }
+    if (DungeonRun::OnWalkedRoute(leader))
+    {
+        // Its leader not yet on its way (by the gathering point, or the
+        // portal's landing): with it.
+        if (DungeonRun::LeaderStarted(leader) || bot->GetDistance(leader) <= DungeonRun::RunFollowRange)
+            return false; // caught up: it waits where it is for its leader's next step
+        return MoveNear(leader, 4.0f);
+    }
+    // Its path to its leader round about: the line, the leader's way.
+    if (DungeonRun::Detour(bot, WorldPosition(leader)))
+    {
+        bot->GetMotionMaster()->MovePoint(0, leader->GetPositionX(), leader->GetPositionY(), leader->GetPositionZ(), FORCED_MOVEMENT_RUN, false);
+        return true;
+    }
+    return MoveNear(leader, 4.0f);
+}
