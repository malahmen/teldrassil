+                        best = d;
+                    }
+                }
+            bool const toAhead = ahead >= 0 && !(*route)[last].entry && best < (*route)[last].point.distance(WorldPosition(bot)) &&
+                std::abs((*route)[ahead].point.getZ() - bot->GetPositionZ()) < 8.0f && !DungeonRun::Detour(bot, (*route)[ahead].point);
+            int const go = toAhead ? ahead : last;
+            if (!(*route)[go].entry)
+            {
+                if (toAhead && ahead > step)
+                    SET_AI_VALUE2(int, "manual int", DungeonRun::WalkingIn(bot) && !bot->GetMap()->IsDungeon() ? "way in step" : "run step", ahead);
+                SET_AI_VALUE2(int, "manual int", "going back", go + 1);
+                SET_AI_VALUE2(time_t, "manual time", "going back since", now);
+                sLog.outString("Bot #%d %s:%d <%s>: a fight over - to step %s (%s)", bot->GetGUIDLow(), bot->GetTeam() == ALLIANCE ? "A" : "H",
+                    bot->GetLevel(), bot->GetName(), DungeonRun::StepName(*route, go).c_str(), toAhead ? "nearer, on its way" : "its last");
+            }
+        }
