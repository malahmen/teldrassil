+            return true;
+        }
+    if (state == DungeonRun::ESCORT_ON)
+    {
+        SET_AI_VALUE2(time_t, "manual time", "run escort", now);
+        SET_AI_VALUE2(int, "manual int", "run escort on", 1);
+        if (!starter || !starter->IsAlive())
+            return false;
+        for (Unit* attacker : starter->getAttackers())
+            if (attacker && attacker->IsAlive() && bot->IsWithinLOSInMap(attacker))
+                return Attack(nullptr, attacker);
