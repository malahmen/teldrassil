+// kalimdor: a member holding its spot in a fight moves for nothing but to get
+// back to it - its other moves off (attacking, casting and healing from where
+// it stands stay; and getting out of fire on the ground).
+float RunTankFirstMultiplier::GetValue(Action* action)
+{
+    if (!action || action->getThreatType() == ActionThreatType::ACTION_THREAT_NONE || PlayerbotAI::IsTank(bot) ||
+        PlayerbotAI::IsHeal(bot) || !DungeonRun::Active(bot))
+        return 1.0f;
+    Unit* unit = ai->GetUnit(AI_VALUE(ObjectGuid, "current target"));
+    if (!unit || unit->GetTypeId() != TYPEID_UNIT || !unit->IsAlive() || unit->GetVictim() == bot)
+        return 1.0f;
+    Player* tank = DungeonRun::TankOf(bot);
+    if (!tank || tank == bot || !tank->IsAlive())
+        return 1.0f;
+    uint32 const now = WorldTimer::getMSTime();
+    if (unit->GetObjectGuid() != target)
+    {
+        target = unit->GetObjectGuid();
+        seen = now;
+        onTank = 0;
+    }
+    if (!onTank && unit->GetVictim() == tank)
+        onTank = now;
+    // A kill-first one (a healer, a sleeper) the tank may never hold: a
+    // second at most.
+    if (WorldTimer::getMSTimeDiff(seen, now) >= (DungeonRun::IsKillFirst(static_cast<Creature*>(unit)) ? KillFirstMs : TankFirstMaxMs))
+        return 1.0f;
+    return onTank && WorldTimer::getMSTimeDiff(onTank, now) >= TankFirstMs ? 1.0f : 0.0f;
+}
+
+float RunCcSafeMultiplier::GetValue(Action* action)
+{
+    CastSpellAction* cast = dynamic_cast<CastSpellAction*>(action);
+    if (!cast || !DungeonRun::Active(bot))
+        return 1.0f;
+    SpellEntry const* spell = sServerFacade.LookupSpellInfo(cast->GetSpellID());
+    if (!spell || IsPositiveSpell(spell) || !DungeonRun::HitsMany(spell))
+        return 1.0f;
+    time_t const now = time(nullptr);
+    if (now != checked)
+    {
+        checked = now;
+        ccNear = DungeonRun::CcNear(bot, DungeonRun::CcSafeRange);
+    }
+    return ccNear ? 0.0f : 1.0f;
+}
+
+float RunHoldMultiplier::GetValue(Action* action)
+{
+    if (!action || !dynamic_cast<MovementAction*>(action) || dynamic_cast<AttackAction*>(action) ||
+        dynamic_cast<RunHoldAction*>(action) || dynamic_cast<MoveAwayFromHazard*>(action))
+        return 1.0f;
+    time_t const now = time(nullptr);
+    if (now != checked)
+    {
+        checked = now;
+        WorldPosition spot;
+        holding = DungeonRun::HoldSpot(bot, spot);
+    }
+    return holding ? 0.0f : 1.0f;
+}
+
+void DungeonStrategy::InitCombatMultipliers(std::list<Multiplier*>& multipliers)
+{
+    multipliers.push_back(new RunHoldMultiplier(ai));
+    multipliers.push_back(new RunTankFirstMultiplier(ai));
+    multipliers.push_back(new RunCcSafeMultiplier(ai));
+}
