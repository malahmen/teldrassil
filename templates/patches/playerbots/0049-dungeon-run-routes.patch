+void DungeonRun::ClearGatherPoint(Player* leader)
+{
+    leader->GetPlayerbotAI()->GetAiObjectContext()->GetValue<std::string>("manual string", "gather point")->Set("");
+}
+
+bool DungeonRun::GatherPoint(Player* bot, WorldPosition& point, Player*& leader, std::string* place, float* radius)
+{
+    Group* group = bot->GetGroup();
+    if (!group)
+        return false;
+    leader = sObjectMgr.GetPlayer(group->GetLeaderGuid());
+    if (!leader || !leader->GetPlayerbotAI() || leader->GetPlayerbotAI()->IsRealPlayer())
+        return false;
+    AiObjectContext* context = leader->GetPlayerbotAI()->GetAiObjectContext();
+    int const focus = context->GetValue<int>("manual int", "group quest focus")->Get();
+    std::string const stored = context->GetValue<std::string>("manual string", "gather point")->Get();
+    if (focus <= 0 || stored.empty() || context->GetValue<int>("manual int", "gathered")->Get() == focus)
+        return false;
+    uint32 map = 0;
+    float x = 0, y = 0, z = 0, r = GatherRange;
+    std::istringstream in(stored.substr(0, stored.find('|')));
+    if (!(in >> map >> x >> y >> z))
+        return false;
+    in >> r;
+    point = WorldPosition(map, x, y, z);
+    if (radius)
+        *radius = r;
+    if (place)
+        *place = stored.substr(stored.find('|') + 1);
+    return true;
+}
+
+bool DungeonRun::AtGathering(Player* bot)
+{
+    WorldPosition point;
+    Player* leader = nullptr;
+    float radius = GatherRange;
+    return GatherPoint(bot, point, leader, nullptr, &radius) && bot->IsInWorld() && bot->GetMapId() == point.getMapId() &&
+        point.distance(WorldPosition(bot)) <= radius;
+}
+
+bool DungeonRun::GroupGathered(Player* leader, std::string* missing)
+{
+    WorldPosition point;
+    Player* l = nullptr;
+    float radius = GatherRange;
+    if (!GatherPoint(leader, point, l, nullptr, &radius) || l != leader)
+        return false;
+    // Only a full group is gathered - fewer groups that finish rather than
+    // short ones that go in to fail (owner, 2026-11-14).
+    bool all = true;
+    int const focus = leader->GetPlayerbotAI()->GetAiObjectContext()->GetValue<int>("manual int", "group quest focus")->Get();
+    if (Quest const* quest = focus > 0 ? sObjectMgr.GetQuestTemplate(uint32(focus)) : nullptr)
+    {
+        uint32 const have = GroupQuests::GroupSize(leader), wanted = GroupQuests::WantedSize(quest);
+        if (have < wanted)
+        {
+            all = false;
+            if (missing)
+                *missing = std::to_string(wanted - have) + " member(s) still to find";
+        }
+    }
+    for (GroupReference* ref = leader->GetGroup()->GetFirstMember(); ref; ref = ref->next())
+    {
+        Player* member = ref->getSource();
+        if (!member || !member->GetPlayerbotAI() || member->GetPlayerbotAI()->IsRealPlayer())
+            continue;
+        // Not in the world (teleporting, logging in): not here yet - and no
+        // map to ask (the server stopped on GetMap(), 2026-11-11).
+        bool const here = member->IsInWorld() && !member->IsBeingTeleported() && (member->GetMap()->IsDungeon() ||
+            (member->GetMapId() == point.getMapId() && point.distance(WorldPosition(member)) <= radius));
+        if (here)
+            continue;
+        all = false;
+        if (missing)
+            *missing += std::string(missing->empty() ? "" : ", ") + member->GetName() + (member->GetMapId() == point.getMapId() ?
+                " " + std::to_string(int(point.distance(WorldPosition(member)))) + "y" : " on map " + std::to_string(member->GetMapId()));
+    }
+    return all;
+}
+
+bool DungeonRun::GatherStuck(Player* bot, WorldPosition const& point)
+{
+    AiObjectContext* context = bot->GetPlayerbotAI()->GetAiObjectContext();
+    auto from = context->GetValue<std::string>("manual string", "gather progress from");
+    auto since = context->GetValue<time_t>("manual time", "gather progress since");
+    time_t const now = time(nullptr);
+    WorldPosition const here(bot);
+    auto restart = [&]()
+    {
+        std::ostringstream out;
+        out << here.getMapId() << " " << here.getX() << " " << here.getY() << " " << here.getZ();
+        from->Set(out.str());
+        since->Set(now);
+        return false;
+    };
+
+    // Travelling another way - a flight, a ship or a zeppelin, waiting at
+    // its dock: not stuck (the first measure took bots waiting for a
+    // zeppelin 2,000-5,800 yards away for stuck, 36 teleports in an hour).
+    if (bot->IsTaxiFlying() || bot->GetTransport())
+        return restart();
+    for (TravelNode* node : sTravelNodeMap.getNodes(here, 60.0f))
+        if (node->isTransport())
+            return restart();
+
+    // Stuck: not GatherProgress yards from where it stood GatherStuckTime ago.
+    uint32 map = 0;
+    float x = 0, y = 0, z = 0;
+    std::istringstream in(from->Get());
+    if (!since->Get() || !(in >> map >> x >> y >> z) || map != here.getMapId() || here.distance(WorldPosition(map, x, y, z)) >= GatherProgress)
+        return restart();
+    return now - since->Get() >= GatherStuckTime;
+}
