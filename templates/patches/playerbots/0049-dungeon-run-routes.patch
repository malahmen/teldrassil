+
+bool DungeonRun::MemberStep(Player* bot, Player* leader, RouteStep const*& next)
+{
+    SettlePieces(bot);
+    int leaderStep = 0;
+    std::string key;
+    std::vector<RouteStep> const* route = nullptr;
+    // Still outside, its leader gone in: the rest of the way in, every point
+    // of it - its leader passed them all (one left to find its own way to
+    // the portal went back and forth short of it; dev, 2026-11-20).
+    WorldPosition way, inside;
+    if (!bot->GetMap()->IsDungeon() && leader->GetMap()->IsDungeon() && WayInto(bot, way, inside))
+    {
+        route = &Route(inside.getMapId(), WayInWing);
+        leaderStep = int(route->size());
+        key = std::to_string(inside.getMapId()) + "|way in";
+    }
+    else
+        route = DungeonRun::LeaderRoute(leader, leaderStep, key);
+    // Its leader past the last point (to the portal): the last point too.
+    if (!route || route->empty() || leaderStep > int(route->size()))
+        return false;
+    // Its leader makes every first move (owner, 2026-11-20): a member goes
+    // only to the points its leader reached - the one it left and those
+    // before - one behind it; before its leader's first step, nowhere.
+    int const reached = leaderStep - 1;
+    AiObjectContext* context = bot->GetPlayerbotAI()->GetAiObjectContext();
+    // "follow step": how many of the route's points it has done - its next
+    // is that one; reached + 1 done, it has caught up and waits.
+    if (context->GetValue<std::string>("manual string", "follow route")->Get() != key)
+    {
+        context->GetValue<std::string>("manual string", "follow route")->Set(key);
+        context->GetValue<int>("manual int", "follow step")->Set(0);
+        context->GetValue<int>("manual int", "follow back")->Set(-1);
+    }
+    int step = context->GetValue<int>("manual int", "follow step")->Get();
+    auto near = [&](RouteStep const& at)
+    {
+        if (at.point.getMapId() == bot->GetMapId() && Reached(bot, at))
+            return true;
+        // A piece of a long leg off the walkable way: as good as reached.
+        return at.piece && at.kind == "walk" && at.point.getMapId() == bot->GetMapId() && Detour(bot, at.point);
+    };
+    // Back from a fight or a pause (no call for 5 seconds), or far from
+    // its group's way and its leader: on from the nearest point it may go
+    // to - after a fight it is wherever the fight took it (owner,
+    // 2026-11-20); a member separated by a fall or a revive likewise.
+    time_t const now = time(nullptr);
+    // A fight over: back to the last point it passed, and on point by point
+    // from there (owner, 2026-11-20).
+    bool backNow = false;
+    if (FightOver(bot) && step > 0)
+    {
+        int back = std::max(0, LastPoint(bot, *route, step));
+        if (!(*route)[back].entry && back <= reached)
+        {
+            step = back;
+            backNow = true;
+            context->GetValue<int>("manual int", "going back")->Set(back + 1);
+            context->GetValue<time_t>("manual time", "going back since")->Set(now);
+        }
+    }
+    {
+        int const back = context->GetValue<int>("manual int", "going back")->Get() - 1;
+        if (back >= 0 && (back >= int(route->size()) || near((*route)[back]) || now - context->GetValue<time_t>("manual time", "going back since")->Get() >= GoingBackTime))
+            context->GetValue<int>("manual int", "going back")->Set(0);
+    }
+    if (!backNow && !bot->IsInCombat())
+        if (int const to = Shortcut(bot, *route, step, reached); to > step)
+        {
+            sLog.outString("Bot #%d %s:%d <%s>: takes a shortcut from step %s to step %s", bot->GetGUIDLow(), bot->GetTeam() == ALLIANCE ? "A" : "H",
+                bot->GetLevel(), bot->GetName(), StepName(*route, LastPoint(bot, *route, to)).c_str(), StepName(*route, to).c_str());
+            step = to;
+            context->GetValue<time_t>("manual time", "follow since")->Set(0);
+        }
+    bool const paused = !backNow && now - context->GetValue<time_t>("manual time", "follow last")->Get() >= 5;
+    context->GetValue<time_t>("manual time", "follow last")->Set(now);
+    // Outside still, its leader in: on the other map, never "by" it - a
+    // member walking to the portal was sent back point by point every half
+    // minute (dev, 2026-11-22); it walks on to the portal instead.
+    bool const byLeader = (!bot->GetMap()->IsDungeon() && leader->GetMap()->IsDungeon()) ||
+        (leader->GetMapId() == bot->GetMapId() && leader->GetDistance(bot) <= SeparatedRange);
+    // Displaced: more than 15 yards off the line of its leg, its last point
+    // to its next - a member back from drinking half way along an 84-yard
+    // leg was taken for displaced and sent back, again and again (dev,
+    // 2026-11-20).
+    int last = LastPoint(bot, *route, step), ahead = step;
+    while (ahead < int(route->size()) && (*route)[ahead].entry)
+        ++ahead;
+    bool displaced;
+    if (ahead < int(route->size()) && ((*route)[ahead].kind == "drop" || (*route)[ahead].kind == "jump") &&
+        (*route)[ahead].point.getMapId() == bot->GetMapId() &&
+        ((*route)[ahead].point.distance(WorldPosition(bot)) < 40.0f || OnDropSlope(bot, &(*route)[ahead])))
+        displaced = false; // on its way down or across (DropStuck) - never back up a slope
+    else if (last >= 0 && ahead < int(route->size()))
+        displaced = FromLeg(bot, (*route)[last].point, (*route)[ahead].point) > 15.0f;
+    else
+    {
+        int const only = last >= 0 ? last : ahead;
+        displaced = only < 0 || only >= int(route->size()) || (*route)[only].point.getMapId() != bot->GetMapId() ||
+            (*route)[only].point.distance(WorldPosition(bot)) > 15.0f;
+    }
+    // Once sent back, on to that point - not again before 30 seconds: sent
+    // anew on every call, one flipped between two points (dev,
+    // 2026-11-21).
+    bool const sentLately = now - context->GetValue<time_t>("manual time", "follow back since")->Get() < 30;
+    if (!backNow && !sentLately && ((paused && displaced) || (!byLeader && displaced)) && !bot->IsInCombat() && reached >= 0)
+    {
+        int nearest = -1;
+        float best = 0.0f;
+        // Never past the points its leader reached: one sent on to step 12
+        // died among creatures its group had not pulled (dev, 2026-11-19).
+        // From its leader's point back: an earlier point only if clearly
+        // nearer - a route passing the same place twice (the Wailing
+        // Caverns' entrances, steps 24-26 and 99-101) sent members back to
+        // the first time through, their leader on the second (dev,
+        // 2026-11-21).
+        // The nearest by cost first, then the latest point within 15 of it
+        // - a margin against the running best never let a nearer point
+        // win point by point, members flipping between two pieces 30
+        // yards apart every few seconds (dev, 2026-11-21).
+        auto costOf = [&](RouteStep const& at)
+        {
+            return at.point.distance(WorldPosition(bot)) + 3.0f * std::abs(at.point.getZ() - bot->GetPositionZ());
+        };
+        int const top = std::min(reached, int(route->size()) - 1);
+        // Never back past the last point it passed: the nearest of the whole
+        // route sent members off to loot back point by point - a corpse
+        // looted at step 43, sent to 41.1, then 41.3 (dev, 2026-11-22); one
+        // fallen is Fell's.
+        int const floor = std::max(0, std::min(last, top));
+        for (int i = top; i >= floor; --i)
+        {
+            RouteStep const& at = (*route)[i];
+            if (at.entry || at.point.getMapId() != bot->GetMapId())
+                continue;
+            if (nearest < 0 || costOf(at) < best)
+            {
+                nearest = i;
+                best = costOf(at);
+            }
+        }
+        for (int i = top; nearest >= 0 && i > nearest; --i)
+        {
+            RouteStep const& at = (*route)[i];
+            if (!at.entry && at.point.getMapId() == bot->GetMapId() && costOf(at) <= best + 15.0f)
+            {
+                nearest = i;
+                break;
+            }
+        }
+        if (nearest >= 0 && nearest != step)
+        {
+            if (!byLeader && nearest != context->GetValue<int>("manual int", "follow back")->Get())
+                sLog.outString("Bot #%d %s:%d <%s>: away from its group's way - back by its step %s", bot->GetGUIDLow(),
+                    bot->GetTeam() == ALLIANCE ? "A" : "H", bot->GetLevel(), bot->GetName(), StepName(*route, nearest).c_str());
+            context->GetValue<int>("manual int", "follow back")->Set(nearest);
+            context->GetValue<time_t>("manual time", "follow back since")->Set(now);
+            step = nearest;
+        }
+    }
+    // Ahead of the points its leader reached (its leader revived at the
+    // start, it far up the route): back along them to the last.
+    while (step > reached + 1 && step - 1 < int(route->size()) && step >= 1)
+    {
+        RouteStep const& at = (*route)[step - 1];
+        if (at.entry || near(at))
+        {
+            --step;
+            continue;
+        }
+        context->GetValue<int>("manual int", "follow step")->Set(step);
+        next = &at;
+        return true;
+    }
+    // On to the points its leader reached; caught up at the last of them.
+    while (step <= reached && step >= 0 && step < int(route->size()))
+    {
+        RouteStep const& at = (*route)[step];
+        if (at.entry || near(at))
+        {
+            ++step; // a boss is the group's fight, not a place; or there
+            continue;
+        }
+        context->GetValue<int>("manual int", "follow step")->Set(step);
+        next = &at;
+        return true;
+    }
+    context->GetValue<int>("manual int", "follow step")->Set(step);
+    return false;
+}
+
+bool DungeonRun::Reached(Player* bot, RouteStep const& at)
+{
+    WorldPosition const here(bot);
+    if (at.kind == "drop" || at.kind == "swim")
+    {
+        float const dz = here.getZ() - at.point.getZ();
+        if (at.point.sqDistance2d(here) <= 16.0f && dz <= 6.0f && dz >= -3.0f)
+            return true;
+    }
+    bool const inLine = at.kind == "straight" || at.kind == "drop" || at.kind == "jump" || at.kind == "swim";
+    return at.point.distance(here) <= (inLine ? 3.0f : 6.0f);
+}
+
+bool DungeonRun::LootLevel(Player* bot, WorldObject* loot)
+{
+    if (!loot || loot->GetMapId() != bot->GetMapId() || std::abs(loot->GetPositionZ() - bot->GetPositionZ()) > 4.0f)
+        return false;
+    WorldPosition const to(loot);
+    std::vector<WorldPosition> path = WorldPosition(bot).getPathTo(to, bot);
+    if (path.size() < 2 || !to.isPathTo(path, 3.0f))
+        return false;
+    for (size_t i = 1; i < path.size(); ++i)
+        if (path[i - 1].getZ() - path[i].getZ() > 3.0f)
+            return false; // a step down it would fall
+    return true;
+}
+
+bool DungeonRun::Fell(Player* bot, Player* leader, RouteStep const& next)
+{
+    int leaderStep = 0;
+    std::string key;
+    std::vector<RouteStep> const* route = DungeonRun::LeaderRoute(leader, leaderStep, key);
+    // Below or above both ends of its leg and its leader: off its way in
+    // height - only a step of the route drops a group (owner, 2026-11-20:
+    // one left 36 yards up on a cliff).
+    float const z = bot->GetPositionZ();
+    if (!route || next.point.getMapId() != bot->GetMapId() || std::abs(z - next.point.getZ()) <= FallDepth)
+        return false;
+    bool const below = z < next.point.getZ();
+    // Off its leader too - one off a bridge is under its leader on it;
+    // one by its leader is not off.
+    if (leader->GetMapId() != bot->GetMapId() || (below ? z >= leader->GetPositionZ() - FallDepth : z <= leader->GetPositionZ() + FallDepth))
+        return false;
+    for (size_t i = 0; i < route->size(); ++i)
+        if (&(*route)[i] == &next)
+            return i > 0 && !(*route)[i - 1].entry &&
+                (below ? z < (*route)[i - 1].point.getZ() - FallDepth : z > (*route)[i - 1].point.getZ() + FallDepth);
+    return false;
+}
+
+bool DungeonRun::Detour(Player* bot, WorldPosition const& goal)
+{
+    WorldPosition const from(bot);
+    if (goal.getMapId() != from.getMapId())
+        return false;
+    float const line = from.distance(goal);
+    std::vector<WorldPosition> path = from.getPathTo(goal, bot);
+    if (path.size() < 2 || !goal.isPathTo(path, 3.0f))
+        return true; // no walkable way: the line
+    float length = 0.0f;
+    for (size_t i = 1; i < path.size(); ++i)
+        length += path[i - 1].distance(path[i]);
+    return length > line * 1.5f + 10.0f;
+}
+
+WorldPosition DungeonRun::LegTowards(Player* bot, WorldPosition const& goal, float length)
+{
+    WorldPosition const from(bot);
+    if (from.distance(goal) <= length)
+        return goal;
+    std::vector<WorldPosition> path = from.getPathTo(goal, bot);
+    float walked = 0.0f;
+    for (size_t i = 1; i < path.size(); ++i)
+    {
+        walked += path[i - 1].distance(path[i]);
+        if (walked >= length)
+            return path[i];
+    }
+    return goal;
+}
+
+bool DungeonRun::MemberBehind(Player* leader)
+{
+    Group* group = leader->GetGroup();
+    if (!group)
+        return false;
+    for (GroupReference* ref = group->GetFirstMember(); ref; ref = ref->next())
+    {
+        Player* member = ref->getSource();
+        if (!member || member == leader || !member->IsInWorld() || !member->IsAlive())
+            continue;
+        if (member->GetMapId() == leader->GetMapId() && member->GetInstanceId() == leader->GetInstanceId() &&
+            member->GetDistance(leader) > RunWaitRange)
+            return true;
+    }
+    return false;
+}
