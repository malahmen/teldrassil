+void DungeonRun::SetGatherPoint(Player* leader, Quest const* quest)
+{
+    AiObjectContext* context = leader->GetPlayerbotAI()->GetAiObjectContext();
+    WorldPosition point(leader);
+    std::string place = point.getAreaName();
+    float radius = GatherRange;
+    AreaTableEntry const* area = quest->GetZoneOrSort() > 0 ? GetAreaEntryByAreaID(quest->GetZoneOrSort()) : nullptr;
+    MapEntry const* dungeon = area ? sMapStore.LookupEntry(area->mapid) : nullptr;
+    if (dungeon && dungeon->IsDungeon())
+    {
+        if (leader->GetMapId() == dungeon->MapID)
+            return; // inside already
+        if (!MeetingPoint(dungeon->MapID, leader, point, place, radius))
+            return;
+    }
+    std::ostringstream out;
+    out << point.getMapId() << " " << point.getX() << " " << point.getY() << " " << point.getZ() << " " << radius << "|" << place;
+    context->GetValue<std::string>("manual string", "gather point")->Set(out.str());
+    context->GetValue<int>("manual int", "gathered")->Set(0);
+    context->GetValue<time_t>("manual time", "gather logged")->Set(0);
+    sLog.outString("Bot #%d %s:%d <%s>: gathers its group at %s", leader->GetGUIDLow(), leader->GetTeam() == ALLIANCE ? "A" : "H",
+        leader->GetLevel(), leader->GetName(), place.c_str());
+}
