+    if (!DungeonRun::GroupReady(bot, &why, &notReady))
+    {
+        time_t const since = AI_VALUE2(time_t, "manual time", "run wait since");
+        // Itself off its way after a fight (a chase, a corner): back to its
+        // last point to wait - its members wait on the route's points, it
+        // waited 85 yards back from them eight minutes (dev, 2026-11-20).
+        {
