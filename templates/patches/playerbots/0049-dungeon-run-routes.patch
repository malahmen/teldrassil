+    // fight before (owner, 2026-11-17; DungeonRun::GroupReady). Said once a
+    // minute while it waits.
+    time_t const now = time(nullptr);
+    // A fight over: back to the last point it passed - or on to the nearest
+    // point past it, if nearer and reachable, short of a boss step - and the
+    // group rests and waits there, not where the fight ended (owner,
+    // 2026-11-20).
+    {
+        int step = 0;
+        std::string key;
+        std::vector<DungeonRun::RouteStep> const* route = DungeonRun::LeaderRoute(bot, step, key);
+        if (route && step > 0 && step < int(route->size()) && DungeonRun::FightOver(bot))
+        {
+            int last = std::max(0, DungeonRun::LastPoint(bot, *route, step));
