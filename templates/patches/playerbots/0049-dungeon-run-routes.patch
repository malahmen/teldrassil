+bool DungeonRun::MakeRoom(Player* bot, ItemPrototype const* forItem)
+{
+    Item* cheapest = nullptr;
+    uint32 cheapestPrice = 0;
+    auto consider = [&](Item* item)
+    {
+        ItemPrototype const* proto = item ? item->GetProto() : nullptr;
+        if (!proto || proto->Class == ITEM_CLASS_QUEST || proto->Class == ITEM_CLASS_CONTAINER || proto->Class == ITEM_CLASS_CONSUMABLE ||
+            proto->Class == ITEM_CLASS_PROJECTILE || proto->Class == ITEM_CLASS_QUIVER || proto->Class == ITEM_CLASS_REAGENT ||
+            proto->Class == ITEM_CLASS_KEY || proto->ItemSet || proto->StartQuest || proto->Bonding == BIND_QUEST_ITEM ||
+            !proto->SellPrice) // nothing to sell: a hearthstone, a key, a token - two hearthstones went for linen (dev, 2026-11-22)
+            return;
+        uint32 const price = proto->SellPrice * item->GetCount();
+        if (!cheapest || price < cheapestPrice)
+        {
+            cheapest = item;
+            cheapestPrice = price;
+        }
+    };
+    for (uint8 slot = INVENTORY_SLOT_ITEM_START; slot < INVENTORY_SLOT_ITEM_END; ++slot)
+        consider(bot->GetItemByPos(INVENTORY_SLOT_BAG_0, slot));
+    for (uint8 bag = INVENTORY_SLOT_BAG_START; bag < INVENTORY_SLOT_BAG_END; ++bag)
+        if (Bag* container = (Bag*)bot->GetItemByPos(INVENTORY_SLOT_BAG_0, bag))
+            for (uint32 slot = 0; slot < container->GetBagSize(); ++slot)
+                consider(container->GetItemByPos(slot));
+    if (!cheapest)
+        return false;
+    sLog.outString("Bot #%d %s:%d <%s>: bags full - destroys %s (%u copper) to make room for %s", bot->GetGUIDLow(),
+        bot->GetTeam() == ALLIANCE ? "A" : "H", bot->GetLevel(), bot->GetName(), cheapest->GetProto()->Name1, cheapestPrice,
+        forItem ? forItem->Name1 : "loot");
+    bot->DestroyItem(cheapest->GetBagSlot(), cheapest->GetSlot(), true);
+    return true;
+}
+
+namespace
+{
+    // Vendors selling food or drink, collected once from the spawns.
+    struct FoodVendor { uint32 entry, faction, map; float x, y, z; };
+    std::vector<FoodVendor> foodVendors;
+    std::once_flag foodVendorsLoaded;
+
+    bool SellsFood(VendorItemData const* items)
+    {
+        if (!items)
+            return false;
+        for (VendorItem const* item : items->m_items)
+            if (ItemPrototype const* proto = item ? ObjectMgr::GetItemPrototype(item->item) : nullptr)
+                if (proto->Spells[0].SpellCategory == 11 || proto->Spells[0].SpellCategory == 59)
+                    return true;
+        return false;
+    }
+
+    struct FoodVendorCollector
+    {
+        bool operator()(CreatureDataPair const& pair)
+        {
+            CreatureData const& data = pair.second;
+            CreatureInfo const* info = ObjectMgr::GetCreatureTemplate(data.id);
+            if (!info || !(info->NpcFlags & UNIT_NPC_FLAG_VENDOR))
+                return false;
+            if (!SellsFood(sObjectMgr.GetNpcVendorItemList(data.id)) && !SellsFood(sObjectMgr.GetNpcVendorTemplateItemList(info->VendorTemplateId)))
+                return false;
+            foodVendors.push_back({ data.id, info->Faction, data.mapid, data.posX, data.posY, data.posZ });
+            return false;
+        }
+    };
+
+    uint32 Carried(Player* bot, uint32 category, uint32& freeSlots)
+    {
+        uint32 count = 0;
+        freeSlots = 0;
+        auto add = [&](Item* item)
+        {
+            if (!item)
+                ++freeSlots;
+            else if (item->GetProto()->Spells[0].SpellCategory == category && item->GetProto()->RequiredLevel <= bot->GetLevel())
+                count += item->GetCount();
+        };
+        for (uint8 slot = INVENTORY_SLOT_ITEM_START; slot < INVENTORY_SLOT_ITEM_END; ++slot)
+            add(bot->GetItemByPos(INVENTORY_SLOT_BAG_0, slot));
+        for (uint8 bag = INVENTORY_SLOT_BAG_START; bag < INVENTORY_SLOT_BAG_END; ++bag)
+            if (Bag* container = (Bag*)bot->GetItemByPos(INVENTORY_SLOT_BAG_0, bag))
+                for (uint32 slot = 0; slot < container->GetBagSize(); ++slot)
+                    add(container->GetItemByPos(slot));
+        return count;
+    }
+}
+
+bool DungeonRun::NeedsStock(Player* bot)
+{
+    uint32 freeSlots = 0;
+    if (Carried(bot, 11, freeSlots) < StockCount || freeSlots < StockFreeSlots)
+        return true;
+    return bot->HasMana() && Carried(bot, 59, freeSlots) < StockCount;
+}
+
+bool DungeonRun::StockVendor(Player* bot, WorldPosition& vendor, uint32& entry)
+{
+    std::call_once(foodVendorsLoaded, [] { FoodVendorCollector collector; sObjectMgr.DoCreatureData(collector); });
+    FactionTemplateEntry const* own = bot->GetFactionTemplateEntry();
+    float best = StockRange;
+    entry = 0;
+    for (FoodVendor const& v : foodVendors)
+    {
+        if (v.map != bot->GetMapId())
+            continue;
+        FactionTemplateEntry const* theirs = sFactionTemplateStore.LookupEntry(v.faction);
+        if (!own || !theirs || theirs->IsHostileTo(*own))
+            continue;
+        float const d = bot->GetDistance(v.x, v.y, v.z);
+        if (d < best)
+        {
+            best = d;
+            entry = v.entry;
+            vendor = WorldPosition(v.map, v.x, v.y, v.z);
+        }
+    }
+    return entry != 0;
+}
+
+void DungeonRun::SellForRoom(Player* bot, uint32& sold, uint32& money)
+{
+    PlayerbotAI* ai = bot->GetPlayerbotAI();
+    sold = money = 0;
+    if (!ai)
+        return;
+    std::vector<Item*> sell, goods;
+    uint32 freeSlots = 0;
+    auto consider = [&](Item* item)
+    {
+        if (!item)
+        {
+            ++freeSlots;
+            return;
+        }
+        ItemPrototype const* proto = item->GetProto();
+        if (!proto->SellPrice || proto->Class == ITEM_CLASS_QUEST || proto->Class == ITEM_CLASS_CONSUMABLE || proto->Class == ITEM_CLASS_CONTAINER ||
+            proto->Class == ITEM_CLASS_PROJECTILE || proto->Class == ITEM_CLASS_QUIVER || proto->Class == ITEM_CLASS_KEY ||
+            proto->StartQuest || proto->Bonding == BIND_QUEST_ITEM || proto->ItemSet ||
+            proto->InventoryType == INVTYPE_TABARD || proto->InventoryType == INVTYPE_BODY ||
+            (proto->Class == ITEM_CLASS_WEAPON && proto->SubClass == ITEM_SUBCLASS_WEAPON_FISHING_POLE) ||
+            proto->ItemId == 2901 || proto->ItemId == 5956 || proto->ItemId == 7005 || proto->ItemId == 6219) // pick, hammer, knife, wrench
+            return;
+        ItemUsage const usage = ai->GetAiObjectContext()->GetValue<ItemUsage>("item usage", ItemQualifier(item).GetQualifier())->Get();
+        bool const gear = proto->Class == ITEM_CLASS_WEAPON || proto->Class == ITEM_CLASS_ARMOR;
+        if (proto->Quality == ITEM_QUALITY_POOR || usage == ItemUsage::ITEM_USAGE_VENDOR || (gear && usage != ItemUsage::ITEM_USAGE_EQUIP))
+            sell.push_back(item);
+        // The rest it may part with for room, cheapest first: auction goods,
+        // then materials kept for a skill - a bot with 50 trade goods had 1
+        // slot free after its stop (dev, 2026-11-23).
+        else if (usage != ItemUsage::ITEM_USAGE_EQUIP && usage != ItemUsage::ITEM_USAGE_QUEST && usage != ItemUsage::ITEM_USAGE_USE &&
+            usage != ItemUsage::ITEM_USAGE_AMMO)
+            goods.push_back(item);
+    };
+    for (uint8 slot = INVENTORY_SLOT_ITEM_START; slot < INVENTORY_SLOT_ITEM_END; ++slot)
+        consider(bot->GetItemByPos(INVENTORY_SLOT_BAG_0, slot));
+    for (uint8 bag = INVENTORY_SLOT_BAG_START; bag < INVENTORY_SLOT_BAG_END; ++bag)
+        if (Bag* container = (Bag*)bot->GetItemByPos(INVENTORY_SLOT_BAG_0, bag))
+            for (uint32 slot = 0; slot < container->GetBagSize(); ++slot)
+                consider(container->GetItemByPos(slot));
+    std::sort(goods.begin(), goods.end(), [](Item* a, Item* b)
+        { return a->GetProto()->SellPrice * a->GetCount() < b->GetProto()->SellPrice * b->GetCount(); });
+    for (Item* item : goods)
+        if (freeSlots + sell.size() < StockFreeSlots)
+            sell.push_back(item);
+    for (Item* item : sell)
+    {
+        money += item->GetProto()->SellPrice * item->GetCount();
+        ++sold;
+        bot->DestroyItem(item->GetBagSlot(), item->GetSlot(), true);
+    }
+    bot->ModifyMoney(int32(money));
+}
