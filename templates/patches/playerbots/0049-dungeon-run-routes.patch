+std::string DungeonRun::StockInPlace(Player* bot)
+{
+    PlayerbotAI* ai = bot->GetPlayerbotAI();
+    if (!ai)
+        return "";
+    uint32 sold = 0, money = 0;
+    SellForRoom(bot, sold, money);
+    PlayerbotFactory factory(bot, bot->GetLevel(), ITEM_QUALITY_NORMAL);
+    factory.AddFood();
+    bool hearth = false;
+    if (!bot->HasItemCount(6948, 1, true))
+        hearth = bot->StoreNewItemInInventorySlot(6948, 1) != nullptr;
+    uint32 freeSlots = 0;
+    Carried(bot, 11, freeSlots);
+    return std::to_string(sold) + " sold (" + std::to_string(money) + " copper), " + std::to_string(freeSlots) + " slots free" +
+        (hearth ? ", a hearthstone" : "");
+}
