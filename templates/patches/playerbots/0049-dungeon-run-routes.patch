+// The ways into a map (area triggers that lead to it), by the map they are on.
+static std::vector<AreaTriggerEntry const*> const& WaysInto(uint32 mapId)
+{
+    static std::mutex lock;
+    static std::map<uint32, std::vector<AreaTriggerEntry const*>> cache;
+    std::lock_guard<std::mutex> guard(lock);
+    auto found = cache.find(mapId);
+    if (found != cache.end())
+        return found->second;
+    std::vector<AreaTriggerEntry const*>& ways = cache[mapId];
+    for (uint32 i = 0; i < sAreaTriggerStore.GetNumRows(); ++i)
+        if (AreaTriggerEntry const* entry = sAreaTriggerStore.LookupEntry(i))
+            if (AreaTrigger const* teleport = sObjectMgr.GetAreaTrigger(entry->id))
+                if (teleport->target_mapId == mapId && entry->mapid != mapId)
+                    ways.push_back(entry);
+    return ways;
+}
+
+// The way into the place the dungeon's portal is in - a cave, a mine, a
+// sunken ruin: the bots' travel graph names those places' nodes "c1-<place>",
+// "c2-<place>" (its cave connectors); the outermost one on foot from the
+// portal, within OuterRange, is where the place opens to the world - for the
+// Wailing Caverns its cave mouth, 243 yards from the portal through 56 yards
+// of water and 17 hostiles (owner, 2026-11-11). Null for a portal out in the
+// open (the Scarlet Monastery, Zul'Farrak...): the group gathers at it.
+// Walking the graph out from the portal by its shortest links instead stopped
+// under water (Blackfathom Deeps) and in Orgrimmar (Ragefire Chasm).
+static constexpr float OuterRange = 700.0f;
+static bool IsCaveNode(std::string const& name)
+{
+    if (name.size() < 3 || name[0] != 'c')
+        return false;
+    size_t i = 1;
+    while (i < name.size() && isdigit(static_cast<unsigned char>(name[i])))
+        ++i;
+    return i < name.size() && name[i] == '-';
+}
+
+static TravelNode* OuterEntrance(AreaTriggerEntry const* way)
+{
+    static std::mutex lock;
+    static std::map<uint32, TravelNode*> cache;
+    std::lock_guard<std::mutex> guard(lock);
+    auto found = cache.find(way->id);
+    if (found != cache.end())
+        return found->second;
+    TravelNode*& outer = cache[way->id];
+    outer = nullptr;
+
+    WorldPosition const portal(way->mapid, way->x, way->y, way->z);
+    TravelNode* at = nullptr;
+    for (TravelNode* node : sTravelNodeMap.getNodes(portal, 40.0f))
+        if (node->isPortal() && (!at || node->getDistance(portal) < at->getDistance(portal)))
+            at = node;
+    if (!at)
+        return outer;
+
+    // Every node on foot from the portal, staying within OuterRange of it.
+    std::set<TravelNode*> seen = { at };
+    std::vector<TravelNode*> open = { at };
+    while (!open.empty())
+    {
+        TravelNode* node = open.back();
+        open.pop_back();
+        for (auto& [to, path] : *node->getLinks())
+            if (path->getPathType() == TravelNodePathType::walk && !seen.count(to) && to->getMapId() == way->mapid &&
+                to->getDistance(portal) <= OuterRange)
+            {
+                seen.insert(to);
+                open.push_back(to);
+                if (IsCaveNode(to->getName()) && (!outer || to->getDistance(portal) > outer->getDistance(portal)))
+                    outer = to;
+            }
+    }
+    return outer;
+}
+
+// Gathering points set by hand (kalimdor_dungeon_meet, sql/0003), by
+// dungeon map; read once.
+static std::map<uint32_t, WorldPosition> const& SetMeetingPoints()
+{
+    static std::mutex lock;
+    static std::map<uint32_t, WorldPosition> points;
+    static bool loaded = false;
+    std::lock_guard<std::mutex> guard(lock);
+    if (!loaded)
+    {
+        loaded = true;
+        if (auto result = WorldDatabase.Query("SELECT map, x, y, z, continent FROM kalimdor_dungeon_meet"))
+        {
+            do
+            {
+                Field* fields = result->Fetch();
+                points[fields[0].GetUInt32()] = WorldPosition(fields[4].GetUInt32(), fields[1].GetFloat(), fields[2].GetFloat(), fields[3].GetFloat());
+            } while (result->NextRow());
+        }
+    }
+    return points;
+}
+
+bool DungeonRun::MeetingPoint(uint32_t mapId, Player* near, WorldPosition& point, std::string& place, float& radius)
+{
+    MapEntry const* dungeon = sMapStore.LookupEntry(mapId);
+    if (!dungeon || !dungeon->IsDungeon())
+        return false;
+    // One set by hand first: where a group really meets (owner, 2026-11-17).
+    auto const set = SetMeetingPoints().find(mapId);
+    if (set != SetMeetingPoints().end())
+    {
+        point = set->second;
+        place = std::string(dungeon->name[0]) + "'s gathering point";
+        radius = GatherRange;
+        return true;
+    }
+    // Its entrance: the way in nearest the bot on its continent, else any.
+    AreaTriggerEntry const* best = nullptr;
+    for (AreaTriggerEntry const* way : WaysInto(mapId))
+        if (!best || (way->mapid == near->GetMapId() &&
+            (best->mapid != near->GetMapId() || near->GetDistance(way->x, way->y, way->z) < near->GetDistance(best->x, best->y, best->z))))
+            best = way;
+    if (!best)
+        return false;
+    // The way into the place the portal is in; without one in the graph,
+    // the portal itself - in a cave or under water, bots stopped 60-160
+    // yards short of it: a wider circle, still outside.
+    if (TravelNode* outer = OuterEntrance(best))
+    {
+        point = *outer->getPosition();
+        place = std::string(dungeon->name[0]) + "'s way in (" + outer->getName() + ")";
+        radius = GatherRange;
+    }
+    else
+    {
+        point = WorldPosition(best->mapid, best->x, best->y, best->z);
+        place = std::string(dungeon->name[0]) + "'s entrance";
+        radius = EntranceRange;
+    }
+    return true;
+}
