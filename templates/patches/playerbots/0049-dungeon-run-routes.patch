+void DungeonRun::RecordBossLoot(Player* looter, Creature* boss)
+{
+    static std::mutex lock;
+    static std::set<uint64> recorded;
+    if (!IsBoss(boss) || !boss->m_loot)
+        return;
+    {
+        std::lock_guard<std::mutex> guard(lock);
+        if (!recorded.insert(boss->GetObjectGuid().GetRawValue()).second)
+            return; // once per corpse
+    }
+    EnsureStatsTables();
+    LootItemList items;
+    boss->m_loot->GetLootItemsListFor(looter, items);
+    std::string list;
+    for (LootItem const* item : items)
+    {
+        ItemPrototype const* proto = item ? ObjectMgr::GetItemPrototype(item->itemId) : nullptr;
+        if (!proto)
+            continue;
+        list += (list.empty() ? "" : ", ") + std::string(proto->Name1) + (item->count > 1 ? " x" + std::to_string(item->count) : "");
+        CharacterDatabase.PExecute("INSERT INTO `kalimdor_boss_loot` (`time`, `map`, `instance`, `boss`, `item`, `count`) VALUES (%u, %u, %u, %u, %u, %u)",
+            uint32(time(nullptr)), boss->GetMapId(), boss->GetInstanceId(), boss->GetEntry(), item->itemId, uint32(item->count));
+    }
+    sLog.outString("Bot #%d %s:%d <%s>: %s (%u) dropped: %s; %u copper", looter->GetGUIDLow(), looter->GetTeam() == ALLIANCE ? "A" : "H",
+        looter->GetLevel(), looter->GetName(), boss->GetName(), boss->GetEntry(), list.empty() ? "nothing" : list.c_str(), boss->m_loot->GetGoldAmount());
+}
