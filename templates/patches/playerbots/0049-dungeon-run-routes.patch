+namespace
+{
+    std::set<std::pair<uint32_t, uint32_t>> killFirst;
+    std::set<uint32_t> healers;
+    std::once_flag killFirstLoaded;
+
+    void LoadKillFirst()
+    {
+        std::call_once(killFirstLoaded, []()
+        {
+            if (auto result = WorldDatabase.Query("SELECT map, entry FROM kalimdor_dungeon_kill_first"))
+                do
+                {
+                    Field* fields = result->Fetch();
+                    killFirst.insert({ fields[0].GetUInt32(), fields[1].GetUInt32() });
+                } while (result->NextRow());
+            // EVENT_T_FRIENDLY_HP (14): it heals its own.
+            if (auto result = WorldDatabase.Query("SELECT DISTINCT creature_id FROM creature_ai_scripts WHERE event_type = 14"))
+                do
+                {
+                    healers.insert(result->Fetch()[0].GetUInt32());
+                } while (result->NextRow());
+        });
+    }
+}
