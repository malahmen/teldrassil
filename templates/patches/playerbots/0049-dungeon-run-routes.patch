+// kalimdor: "rndbot testrun <map id or name>" - a test group for a dungeon:
+// five online random bots of one faction that can take one of its group
+// quests and enter it (a tank, a healer, three more), out of their groups,
+// grouped, the quest given, and put at the dungeon's meeting point - from
+// there the group sets off, gathers, goes in and runs as any other (owner,
+// 2026-11-16: a test cycle in minutes, not hours; Kamino 151).
+std::list<std::string> RandomPlayerbotMgr::HandleConsoleTestRun(std::string param)
+{
+    // Its members by name, last: "rndbot testrun Wailing with A,B,C,D,E" -
+    // the tank and the healer among them by role, the leader the tank.
+    std::vector<std::string> named;
+    if (size_t const at = param.rfind(" with "); at != std::string::npos)
+    {
+        std::string list = param.substr(at + 6);
+        param.resize(at);
+        for (size_t from = 0; from <= list.size();)
+        {
+            size_t const to = std::min(list.find(',', from), list.size());
+            std::string name = list.substr(from, to - from);
+            name.erase(0, name.find_first_not_of(' '));
+            name.erase(name.find_last_not_of(' ') + 1);
+            if (!name.empty())
+            {
+                normalizePlayerName(name);
+                named.push_back(name);
+            }
+            from = to + 1;
+        }
+        if (named.size() != 5)
+            return { "testrun: five names, by commas - " + std::to_string(named.size()) + " given" };
+    }
+    // A step of its route to start from, last: "rndbot testrun Wailing step 8".
+    int startStep = 0;
+    if (size_t const at = param.rfind(" step "); at != std::string::npos)
+    {
+        startStep = std::atoi(param.c_str() + at + 6);
+        param.resize(at);
+    }
+    // A faction asked for last: "rndbot testrun Wailing alliance".
+    std::vector<Team> teams;
+    for (auto const& [word, team] : { std::pair<std::string, Team>{ " alliance", ALLIANCE }, { " horde", HORDE } })
+        if (param.size() > word.size() && param.compare(param.size() - word.size(), word.size(), word) == 0)
+        {
+            teams = { team };
+            param.resize(param.size() - word.size());
+        }
+    uint32 mapId = 0;
+    if (!param.empty() && std::all_of(param.begin(), param.end(), ::isdigit))
+        mapId = uint32(std::stoul(param));
+    else if (!param.empty())
+        for (uint32 i = 0; i < sMapStore.GetNumRows() && !mapId; ++i)
+            if (MapEntry const* entry = sMapStore.LookupEntry(i))
+                if (entry->IsDungeon() && std::string(entry->name[0]).find(param) != std::string::npos)
+                    mapId = entry->MapID;
+    MapEntry const* dungeon = mapId ? sMapStore.LookupEntry(mapId) : nullptr;
+    if (!dungeon || !dungeon->IsDungeon())
+        return { "testrun: '" + param + "' is no dungeon - give its map id or a part of its name" };
+
+    // Its group quests, lowest first.
+    std::vector<Quest const*> quests;
+    for (auto const& [id, quest] : sObjectMgr.GetQuestTemplates())
+    {
+        if (!GroupQuests::IsGroupQuest(quest.get()) || quest->GetZoneOrSort() <= 0)
+            continue;
+        if (AreaTableEntry const* area = GetAreaEntryByAreaID(quest->GetZoneOrSort()))
+            if (area->mapid == mapId)
+                quests.push_back(quest.get());
+    }
+    std::sort(quests.begin(), quests.end(), [](Quest const* a, Quest const* b) { return a->GetQuestLevel() < b->GetQuestLevel(); });
+    if (quests.empty())
+        return { std::string("testrun: ") + dungeon->name[0] + " has no group quest to give" };
+
+    // Else the faction whose land its way in is in first - an Alliance
+    // group at the Wailing Caverns, in Horde land, fled Horde bots and never
+    // went in (dev, 2026-11-17).
+    if (teams.empty())
+    {
+        teams = { ALLIANCE, HORDE };
+        if (auto result = WorldDatabase.PQuery("SELECT id FROM areatrigger_teleport WHERE target_map = %u LIMIT 1", mapId))
+            if (AreaTriggerEntry const* way = sAreaTriggerStore.LookupEntry(result->Fetch()[0].GetUInt32()))
+                if (AreaTableEntry const* area = WorldPosition(way->mapid, way->x, way->y, way->z).GetArea())
+                {
+                    AreaTableEntry const* zone = area->zone ? GetAreaEntryByAreaID(area->zone) : area;
+                    if (zone && (zone->team & AREATEAM_HORDE))
+                        teams = { HORDE, ALLIANCE };
+                }
+    }
+    for (Quest const* quest : quests)
+        for (Team team : teams)
+        {
+            Player* tank = nullptr;
+            Player* healer = nullptr;
+            std::vector<Player*> others;
+            std::vector<Player*> namedBots;
+            for (auto const& [guid, bot] : GetAllBots())
+            {
+                if (!bot || !bot->IsInWorld() || !bot->IsAlive() || bot->InBattleGround() || bot->IsBeingTeleported() || bot->GetTeam() != team)
+                    continue;
+                if (!named.empty())
+                {
+                    // Named: those only, whatever their quests - the leader's
+                    // checked below.
+                    if (std::find(named.begin(), named.end(), bot->GetName()) != named.end() && GroupQuests::CanEnter(bot, quest))
+                        namedBots.push_back(bot);
+                    continue;
+                }
+                if (!bot->SatisfyQuestRace(quest, false) || !bot->SatisfyQuestClass(quest, false) || bot->GetQuestRewardStatus(quest->GetQuestId()))
+                    continue;
+                // Still to do: a group sets off only for a quest in progress
+                // (GroupQuests::Ready) - a leader with its objectives done in
+                // an earlier test never did (dev, 2026-11-16).
+                QuestStatus const status = bot->GetQuestStatus(quest->GetQuestId());
+                if (status != QUEST_STATUS_NONE && status != QUEST_STATUS_INCOMPLETE)
+                    continue;
+                // Room in its quest log for it: a full log stopped the server
+                // ("AddQuest(): log_slot < 20"; dev, 2026-11-19).
+                if (status == QUEST_STATUS_NONE && bot->FindQuestSlot(0) >= MAX_QUEST_LOG_SIZE)
+                    continue;
+                if (bot->GetLevel() < quest->GetMinLevel() || int32(bot->GetLevel()) > int32(quest->GetQuestLevel()) + 5 || !GroupQuests::CanEnter(bot, quest))
+                    continue;
+                if (PlayerbotAI::IsTank(bot, false))
+                {
+                    if (!tank)
+                        tank = bot;
+                }
+                else if (PlayerbotAI::IsHeal(bot, false))
+                {
+                    if (!healer)
+                        healer = bot;
+                }
+                else if (others.size() < 3)
+                    others.push_back(bot);
+            }
+            if (!named.empty())
+            {
+                if (namedBots.size() != 5)
+                    continue;
+                for (Player* bot : namedBots)
+                    if (!tank && PlayerbotAI::IsTank(bot, false))
+                        tank = bot;
+                for (Player* bot : namedBots)
+                    if (!healer && bot != tank && PlayerbotAI::IsHeal(bot, false))
+                        healer = bot;
+                for (Player* bot : namedBots)
+                    if (!tank && bot != healer)
+                        tank = bot;
+                for (Player* bot : namedBots)
+                    if (!healer && bot != tank)
+                        healer = bot;
+                for (Player* bot : namedBots)
+                    if (bot != tank && bot != healer)
+                        others.push_back(bot);
+                // The leader sets off only for the quest in progress (or new).
+                QuestStatus const status = tank->GetQuestStatus(quest->GetQuestId());
+                // Not grey to it either - a group quest grey to its leader is
+                // never set off for (GroupQuests::Ready; dev, 2026-11-22).
+                if (tank->GetQuestRewardStatus(quest->GetQuestId()) || (status != QUEST_STATUS_NONE && status != QUEST_STATUS_INCOMPLETE) ||
+                    (status == QUEST_STATUS_NONE && tank->FindQuestSlot(0) >= MAX_QUEST_LOG_SIZE) || QuestFlow::IsGrey(tank, quest) ||
+                    tank->GetLevel() < quest->GetMinLevel())
+                    continue;
+            }
+            if (!tank || !healer || others.size() < 3)
+                continue;
+
+            std::vector<Player*> group = { tank, healer, others[0], others[1], others[2] };
+            for (Player* bot : group)
+            {
+                // A clean start: a focus left from an earlier group on the
+                // same quest kept the leader from ever setting off (its set-
+                // off fires on a new focus only; dev, 2026-11-16).
+                AiObjectContext* botContext = bot->GetPlayerbotAI()->GetAiObjectContext();
+                botContext->GetValue<int>("manual int", "group quest focus")->Set(0);
+                botContext->GetValue<int>("manual int", "gathered")->Set(0);
+                botContext->GetValue<int>("manual int", "way in step")->Set(0);
+                botContext->GetValue<int>("manual int", "lfg joined")->Set(0);
+                botContext->GetValue<int>("manual int", "lfg quest")->Set(0);
+                botContext->GetValue<time_t>("manual time", "lfg retry")->Set(0);
+                botContext->GetValue<std::set<uint32>>("focus travel target")->Set({});
+                DungeonRun::ClearGatherPoint(bot);
+                if (bot->GetGroup())
+                    bot->RemoveFromGroup();
+                if (bot->GetQuestStatus(quest->GetQuestId()) == QUEST_STATUS_NONE && !bot->GetQuestRewardStatus(quest->GetQuestId()) &&
+                    bot->FindQuestSlot(0) < MAX_QUEST_LOG_SIZE && bot->SatisfyQuestRace(quest, false) && bot->SatisfyQuestClass(quest, false))
+                    bot->AddQuest(quest, nullptr);
+            }
+            Group* newGroup = new Group();
+            if (!newGroup->Create(tank->GetObjectGuid(), tank->GetName()))
+            {
+                delete newGroup;
+                return { "testrun: the group could not be made" };
+            }
+            sObjectMgr.AddGroup(newGroup);
+            for (size_t i = 1; i < group.size(); ++i)
+                newGroup->AddMember(group[i]->GetObjectGuid(), group[i]->GetName());
+
+            // The leader searched for the quest - full, it sets off as usual.
+            AiObjectContext* context = tank->GetPlayerbotAI()->GetAiObjectContext();
+            context->GetValue<int>("manual int", "lfg quest")->Set(int(quest->GetQuestId()));
+            context->GetValue<time_t>("manual time", "lfg since")->Set(time(nullptr));
+            context->GetValue<int>("manual int", "test start step")->Set(startStep);
+            context->GetValue<bool>("manual bool", "lfg grouped")->Set(true);
+            for (size_t i = 1; i < group.size(); ++i)
+                group[i]->GetPlayerbotAI()->GetAiObjectContext()->GetValue<int>("manual int", "lfg joined")->Set(int(quest->GetQuestId()));
+
+            WorldPosition point;
+            std::string place;
+            float radius = 0.0f;
+            if (!DungeonRun::MeetingPoint(mapId, tank, point, place, radius))
+                return { "testrun: no way into " + std::string(dungeon->name[0]) };
+            std::string names;
+            for (size_t i = 0; i < group.size(); ++i)
+            {
+                // Its vendor stop, skipped with the trip: here (DungeonRun::StockInPlace).
+                sLog.outString("testrun: %s stocked - %s", group[i]->GetName(), DungeonRun::StockInPlace(group[i]).c_str());
+                group[i]->TeleportTo(point.getMapId(), point.getX() + float(i), point.getY(), point.getZ(), 0.0f);
+                names += std::string(i ? ", " : "") + group[i]->GetName() + " " + std::to_string(group[i]->GetLevel()) +
+                    (i == 0 ? " (tank, leader)" : i == 1 ? " (healer)" : "");
+            }
+            sLog.outString("testrun: %s - %s - %s at %s", dungeon->name[0], quest->GetTitle().c_str(), names.c_str(), place.c_str());
+            return { std::string("testrun: ") + dungeon->name[0] + " - " + quest->GetTitle() + " - " + names + " - at " + place };
+        }
+    if (!named.empty())
+    {
+        // Which of them, and why.
+        std::list<std::string> why = { std::string("testrun: no group of those five for ") + dungeon->name[0] + " -" };
+        for (std::string const& name : named)
+        {
+            Player* bot = nullptr;
+            for (auto const& [guid, each] : GetAllBots())
+                if (each && each->GetName() == name)
+                    bot = each;
+            std::string state = !bot ? "not a random bot online" : !bot->IsInWorld() ? "not in the world" : !bot->IsAlive() ? "dead" :
+                bot->InBattleGround() ? "in a battleground" : bot->IsBeingTeleported() ? "teleporting" :
+                (bot->GetTeam() == HORDE ? "Horde" : "Alliance") + std::string(", level ") + std::to_string(bot->GetLevel());
+            if (bot)
+                for (Quest const* quest : quests)
+                {
+                    QuestStatus const status = bot->GetQuestStatus(quest->GetQuestId());
+                    state += "; " + quest->GetTitle() + ": " + (GroupQuests::CanEnter(bot, quest) ? "can enter" : "can't enter") +
+                        ", status " + std::to_string(int(status)) + (bot->GetQuestRewardStatus(quest->GetQuestId()) ? " (done)" : "") +
+                        (status == QUEST_STATUS_NONE && bot->FindQuestSlot(0) >= MAX_QUEST_LOG_SIZE ? " (log full)" : "");
+                }
+            why.push_back("  " + name + ": " + state);
+        }
+        return why;
+    }
+    return { std::string("testrun: no tank, healer and three more online that can take a group quest of ") + dungeon->name[0] + " and go in" };
+}
+
+// kalimdor: "rndbot routepoints <map id> [wing]" - waypoints along a
+// dungeon's route (kalimdor_dungeon_route), from its way in through each boss
+// in order, as the rows of sql/0003 in the log. The places creatures spawn
+// trace a dungeon's paths; two are linked where the navmesh walks from one to
+// the other in a short, complete path, and each leg goes by the shortest
+// chain of such links - in caves the navmesh alone gives partial paths over
+// long distances (the Wailing Caverns, dev, 2026-11-16; Kamino 151).
+std::list<std::string> RandomPlayerbotMgr::HandleConsoleRoutePoints(std::string param)
+{
+    std::istringstream in(param);
+    uint32 mapId = 0, wing = 0;
+    float linkRange = 50.0f, detour = 1.5f;
+    in >> mapId >> wing >> linkRange >> detour;
+    // Its bosses in order - its waypoints made anew.
+    std::vector<DungeonRun::RouteStep> route;
+    for (DungeonRun::RouteStep const& step : DungeonRun::Route(mapId, wing))
+        if (step.entry)
+            route.push_back(step);
+    if (route.empty())
+        return { "routepoints: no route for map " + std::to_string(mapId) + " wing " + std::to_string(wing) };
+
+    // The nodes: its way in, then every creature's spawn, by entry.
+    std::vector<WorldPosition> nodes;
+    std::multimap<uint32, size_t> byEntry;
+    if (auto result = WorldDatabase.PQuery("SELECT target_position_x, target_position_y, target_position_z FROM areatrigger_teleport WHERE target_map = %u LIMIT 1", mapId))
+        nodes.push_back(WorldPosition(mapId, result->Fetch()[0].GetFloat(), result->Fetch()[1].GetFloat(), result->Fetch()[2].GetFloat()));
+    if (nodes.empty())
+        return { "routepoints: no way into map " + std::to_string(mapId) };
+    if (auto result = WorldDatabase.PQuery("SELECT IF(c.id, c.id, IFNULL(e.Entry, 0)), c.position_x, c.position_y, c.position_z FROM creature c "
+        "LEFT JOIN spawn_group_spawn s ON s.Guid = c.guid LEFT JOIN spawn_group_entry e ON e.Id = s.Id WHERE c.map = %u", mapId))
+    {
+        do
+        {
+            Field* fields = result->Fetch();
+            WorldPosition spawn(mapId, fields[1].GetFloat(), fields[2].GetFloat(), fields[3].GetFloat());
+            // A spawn under water, at the water's surface: a leader swam
+            // above one 13 yards down and stayed there (the Wailing Caverns,
+            // dev, 2026-11-16) - the caves' ways run through the water.
+            if (spawn.isUnderWater() && spawn.getTerrain())
+            {
+                float const surface = spawn.getTerrain()->GetWaterLevel(spawn.getX(), spawn.getY(), spawn.getZ());
+                if (surface > spawn.getZ() && surface < spawn.getZ() + 100.0f)
+                    spawn.setZ(surface);
+            }
+            byEntry.insert({ fields[0].GetUInt32(), nodes.size() });
+            nodes.push_back(spawn);
+        } while (result->NextRow());
+    }
+
+    std::vector<std::vector<std::pair<size_t, float>>> links(nodes.size());
+    uint32 tried = 0;
+    for (size_t a = 0; a < nodes.size(); ++a)
+        for (size_t b = a + 1; b < nodes.size(); ++b)
+        {
+            float const line = nodes[a].distance(nodes[b]);
+            if (line > linkRange || line < 1.0f)
+                continue;
+            ++tried;
+            std::vector<WorldPosition> path = nodes[b].getPathFromPath({ nodes[a] }, nullptr, 2);
+            if (path.size() < 2 || !nodes[b].isPathTo(path, 3.0f))
+                continue;
+            float length = 0.0f;
+            for (size_t i = 1; i < path.size(); ++i)
+                length += path[i - 1].distance(path[i]);
+            if (length > line * detour + 5.0f)
+                continue;
+            links[a].push_back({ b, length });
+            links[b].push_back({ a, length });
+        }
+
+    // Each leg by Dijkstra; a waypoint kept every 30 yards or more.
+    std::vector<std::string> rows;
+    std::list<std::string> out;
+    size_t at = 0;
+    uint32 step = 0;
+    auto addRow = [&](uint32 entry, WorldPosition const& p, bool optional, std::string const& note)
+    {
+        char row[200];
+        snprintf(row, sizeof(row), "(%u, %u, %u, %u, %.1f, %.1f, %.1f, %u, '%s')", mapId, wing, ++step, entry,
+            entry ? 0.0f : p.getX(), entry ? 0.0f : p.getY(), entry ? 0.0f : p.getZ(), optional ? 1u : 0u, note.c_str());
+        rows.push_back(row);
+    };
+    for (DungeonRun::RouteStep const& routeStep : route)
+    {
+        CreatureInfo const* info = routeStep.entry ? ObjectMgr::GetCreatureTemplate(routeStep.entry) : nullptr;
+        std::string name = info ? info->Name : "a waypoint";
+        for (size_t q = name.find('\''); q != std::string::npos; q = name.find('\'', q + 2))
+            name.insert(q, "'");
+        std::set<size_t> goals;
+        if (routeStep.entry)
+            for (auto [i, end] = byEntry.equal_range(routeStep.entry); i != end; ++i)
+                goals.insert(i->second);
+        // A rare's spot is not walked to when it is not there: no waypoints
+        // to it, the next leg from the step before.
+        if (routeStep.optional)
+        {
+            addRow(routeStep.entry, routeStep.point, routeStep.optional, name);
+            continue;
+        }
+        if (goals.empty())
+        {
+            out.push_back("routepoints: " + name + " - no spawn of it on the map; kept without waypoints");
+            addRow(routeStep.entry, routeStep.point, routeStep.optional, name);
+            continue;
+        }
+        std::vector<float> dist(nodes.size(), std::numeric_limits<float>::max());
+        std::vector<size_t> prev(nodes.size(), SIZE_MAX);
+        std::priority_queue<std::pair<float, size_t>, std::vector<std::pair<float, size_t>>, std::greater<>> open;
+        dist[at] = 0.0f;
+        open.push({ 0.0f, at });
+        size_t reached = SIZE_MAX;
+        while (!open.empty())
+        {
+            auto [d, n] = open.top();
+            open.pop();
+            if (d > dist[n])
+                continue;
+            if (goals.count(n))
+            {
+                reached = n;
+                break;
+            }
+            for (auto [m, length] : links[n])
+                if (d + length < dist[m])
+                {
+                    dist[m] = d + length;
+                    prev[m] = n;
+                    open.push({ dist[m], m });
+                }
+        }
+        if (reached == SIZE_MAX)
+        {
+            out.push_back("routepoints: " + name + " - no linked way from the step before; kept without waypoints");
+            addRow(routeStep.entry, routeStep.point, routeStep.optional, name);
+            continue;
+        }
+        std::vector<size_t> chain;
+        for (size_t n = prev[reached]; n != SIZE_MAX && n != at; n = prev[n])
+            chain.push_back(n);
+        std::reverse(chain.begin(), chain.end());
+        WorldPosition last = nodes[at];
+        for (size_t n : chain)
+            if (nodes[n].distance(last) >= 30.0f && nodes[n].distance(nodes[reached]) >= 20.0f)
+            {
+                addRow(0, nodes[n], false, "to " + name);
+                last = nodes[n];
+            }
+        addRow(routeStep.entry, routeStep.point, routeStep.optional, name);
+        out.push_back("routepoints: " + name + " - " + std::to_string(int(dist[reached])) + "y by " + std::to_string(chain.size()) + " links");
+        at = reached;
+    }
+    uint32 linked = 0;
+    for (auto const& l : links)
+        linked += uint32(l.size());
+    out.push_back("routepoints: map " + std::to_string(mapId) + " - " + std::to_string(nodes.size()) + " nodes, " + std::to_string(tried) + " pairs tried, " +
+        std::to_string(linked / 2) + " linked (range " + std::to_string(int(linkRange)) + ", detour " + std::to_string(detour).substr(0, 4) + "); the rows:");
+    for (size_t i = 0; i < rows.size(); ++i)
+        out.push_back(rows[i] + (i + 1 < rows.size() ? "," : ";"));
+    return out;
+}
