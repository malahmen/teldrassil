+std::string DungeonRun::PointKey(WorldPosition const& point)
+{
+    std::ostringstream out;
+    out << point.getMapId() << " " << int(point.getX()) << " " << int(point.getY()) << " " << int(point.getZ());
+    return out.str();
+}
+
+bool DungeonRun::StaleGatherTrip(Player* bot)
+{
+    AiObjectContext* context = bot->GetPlayerbotAI()->GetAiObjectContext();
+    std::string const trip = context->GetValue<std::string>("manual string", "gather trip")->Get();
+    if (trip.empty())
+        return false;
+    TravelTarget* target = context->GetValue<TravelTarget*>("travel target")->Get();
+    TemporaryTravelDestination* to = target->IsForced() && target->IsActive() ? dynamic_cast<TemporaryTravelDestination*>(target->GetDestination()) : nullptr;
+    if (!to || !to->GetPosition() || PointKey(*to->GetPosition()) != trip)
+    {
+        context->GetValue<std::string>("manual string", "gather trip")->Set("");
+        return false; // its travel moved on by itself
+    }
+    WorldPosition point, way;
+    Player* leader = nullptr;
+    if (GatherPoint(bot, point, leader) && PointKey(point) == trip)
+        return false;
+    if (FollowLeaderIn(bot, way) && PointKey(way) == trip)
+        return false;
+    return true;
+}
+
+bool DungeonRun::StayInside(Player* bot)
+{
+    if (!bot->IsInWorld() || !bot->GetMap()->IsDungeon() || !bot->GetGroup())
+        return false;
+    // On a run, until all its bosses are dead (or it gives up) - its quest
+    // done or not (owner, 2026-11-14).
+    if (Active(bot))
+        return true;
+    int const focus = bot->GetPlayerbotAI()->GetAiObjectContext()->GetValue<int>("manual int", "group quest focus")->Get();
+    Quest const* quest = focus > 0 ? sObjectMgr.GetQuestTemplate(uint32(focus)) : nullptr;
+    AreaTableEntry const* area = quest && quest->GetZoneOrSort() > 0 ? GetAreaEntryByAreaID(quest->GetZoneOrSort()) : nullptr;
+    return area && area->mapid == bot->GetMapId();
+}
+
+bool DungeonRun::HoldShort(Player* bot)
+{
+    Group* group = bot->GetGroup();
+    if (!group || !group->IsLeader(bot->GetObjectGuid()) || !bot->IsInWorld() || bot->GetMap()->IsDungeon())
+        return false;
+    int const focus = bot->GetPlayerbotAI()->GetAiObjectContext()->GetValue<int>("manual int", "group quest focus")->Get();
+    Quest const* quest = focus > 0 ? sObjectMgr.GetQuestTemplate(uint32(focus)) : nullptr;
+    AreaTableEntry const* area = quest && quest->GetZoneOrSort() > 0 ? GetAreaEntryByAreaID(quest->GetZoneOrSort()) : nullptr;
+    MapEntry const* dungeon = area ? sMapStore.LookupEntry(area->mapid) : nullptr;
+    if (!dungeon || !dungeon->IsDungeon() || GroupQuests::GroupSize(bot) >= GroupQuests::WantedSize(quest))
+        return false;
+    for (AreaTriggerEntry const* way : WaysInto(dungeon->MapID))
+        if (way->mapid == bot->GetMapId() && bot->GetDistance(way->x, way->y, way->z) <= 40.0f)
+            return true;
+    return false;
+}
+
+bool DungeonRun::NextBoss(Player* leader, WorldPosition& pos, Creature*& creature, int& entry, int chosen, std::string const& skip)
+{
+    creature = nullptr;
+    entry = 0;
+    Map* map = leader->GetMap();
+    float best = 0.0f;
+    bool found = false;
+    for (Boss const& boss : AliveBosses(leader))
+    {
+        if (!boss.guid)
+            continue; // a spawn group's boss not placed yet
+        WorldPosition where;
+        Creature* live = map->GetCreature(boss.guid);
+        if (live && !live->IsAlive())
+            continue;
+        if (live)
+            where = WorldPosition(live);
+        else if (CreatureData const* data = sObjectMgr.GetCreatureData(boss.guid))
+            where = WorldPosition(data->mapid, data->posX, data->posY, data->posZ);
+        else
+            continue;
+        if (skip.find(std::to_string(boss.entry) + ",") != std::string::npos &&
+            (skip.find(std::to_string(boss.entry) + ",") == 0 || skip[skip.find(std::to_string(boss.entry) + ",") - 1] == ','))
+            continue;
+        // The chosen one first, while it lives.
+        float const distance = int(boss.entry) == chosen ? -1.0f : where.distance(WorldPosition(leader));
+        if (!found || distance < best)
+        {
+            found = true;
+            best = distance;
+            pos = where;
+            creature = live;
+            entry = int(boss.entry);
+        }
+    }
+    return found;
+}
+
+bool DungeonRun::RunStart(Player* bot, WorldPosition& pos)
+{
+    if (!bot->IsInWorld() || !bot->GetMap()->IsDungeon())
+        return false;
+    for (AreaTriggerEntry const* entry : WaysInto(bot->GetMapId()))
+        if (AreaTrigger const* way = sObjectMgr.GetAreaTrigger(entry->id))
+        {
+            pos = WorldPosition(way->target_mapId, way->target_X, way->target_Y, way->target_Z, way->target_Orientation);
+            return true;
+        }
+    return false;
+}
+
+static std::mutex routesLock;
+static std::map<std::pair<uint32_t, uint32_t>, std::vector<DungeonRun::RouteStep>> routes;
+
+// The pieces of long legs on the ground under them, once a map's terrain is
+// at hand: on the owner's line between two points they hung in the air where
+// the ground dips - a leader stopped on one floated 4 yards up (dev,
+// 2026-11-21).
+void DungeonRun::SettlePieces(Player* bot)
+{
+    static std::set<uint32_t> settled;
+    Route(bot->GetMapId(), 0); // loaded
+    std::lock_guard<std::mutex> guard(routesLock);
+    if (!settled.insert(bot->GetMapId()).second)
+        return;
+    Map* map = bot->GetMap();
+    uint32_t moved = 0;
+    for (auto& [key, steps] : routes)
+        for (RouteStep& at : steps)
+        {
+            if (!at.piece || at.point.getMapId() != bot->GetMapId())
+                continue;
+            float const z = at.point.getZ();
+            float const ground = map->GetHeight(at.point.getX(), at.point.getY(), z + 5.0f);
+            if (ground > INVALID_HEIGHT && std::abs(ground - z) < 15.0f && std::abs(ground - z) > 0.5f)
+            {
+                at.point = WorldPosition(at.point.getMapId(), at.point.getX(), at.point.getY(), ground);
+                ++moved;
+            }
+        }
+    sLog.outString("Dungeon routes: %u pieces on map %u put on the ground", moved, bot->GetMapId());
+}
+
+std::vector<DungeonRun::RouteStep> const& DungeonRun::Route(uint32_t mapId, uint32_t wing)
+{
+    std::mutex& lock = routesLock;
+    static bool loaded = false;
+    std::lock_guard<std::mutex> guard(lock);
+    if (!loaded)
+    {
+        loaded = true;
+        auto result = WorldDatabase.Query("SELECT map, wing, step, entry, x, y, z, optional, kind, npc, leash, hold, tank_x, tank_y, tank_z, ranged_x, ranged_y, ranged_z FROM kalimdor_dungeon_route ORDER BY map, wing, step");
+        if (result)
+        {
+            do
+            {
+                Field* fields = result->Fetch();
+                uint32_t const map = fields[0].GetUInt32();
+                // The way in lies outside: its points on the continent of the
+                // dungeon's gathering point.
+                uint32_t const wing = fields[1].GetUInt32();
+                uint32_t pointMap = map;
+                if (wing == WayInWing)
+                    if (auto meet = SetMeetingPoints().find(map); meet != SetMeetingPoints().end())
+                        pointMap = meet->second.getMapId();
+                routes[{ map, wing }].push_back({ fields[3].GetUInt32(),
+                    WorldPosition(pointMap, fields[4].GetFloat(), fields[5].GetFloat(), fields[6].GetFloat()), fields[7].GetUInt32() != 0,
+                    fields[8].GetCppString(), fields[9].GetUInt32(), float(fields[10].GetUInt32()), fields[11].GetUInt32() != 0,
+                    fields[12].GetFloat() != 0.0f || fields[13].GetFloat() != 0.0f,
+                    WorldPosition(pointMap, fields[12].GetFloat(), fields[13].GetFloat(), fields[14].GetFloat()),
+                    fields[15].GetFloat() != 0.0f || fields[16].GetFloat() != 0.0f,
+                    WorldPosition(pointMap, fields[15].GetFloat(), fields[16].GetFloat(), fields[17].GetFloat()) });
+                routes[{ map, wing }].back().number = fields[2].GetUInt32();
+            } while (result->NextRow());
+        }
+        // Long legs in pieces (PieceLength).
+        uint32_t pieces = 0;
+        for (auto& [key, steps] : routes)
+        {
+            std::vector<RouteStep> split;
+            int last = -1; // the last point in split
+            for (RouteStep const& at : steps)
+            {
+                if (!at.entry && last >= 0 && (at.kind == "walk" || at.kind == "straight"))
+                {
+                    RouteStep const from = split[last];
+                    float const d = from.point.getMapId() == at.point.getMapId() ? from.point.distance(at.point) : 0.0f;
+                    if (d > PieceLimit)
+                    {
+                        int const n = int(std::ceil(d / PieceLength));
+                        bool const hold = from.hold && at.hold;
+                        float const leash = from.leash > 0.0f && at.leash > 0.0f ? std::min(from.leash, at.leash) : 0.0f;
+                        for (int k = 1; k < n; ++k)
+                        {
+                            float const t = float(k) / n;
+                            RouteStep piece = at;
+                            piece.point = WorldPosition(at.point.getMapId(), from.point.getX() + (at.point.getX() - from.point.getX()) * t,
+                                from.point.getY() + (at.point.getY() - from.point.getY()) * t, from.point.getZ() + (at.point.getZ() - from.point.getZ()) * t);
+                            piece.optional = false;
+                            piece.npc = 0;
+                            piece.kind = at.kind == "straight" ? "straight" : "walk";
+                            piece.leash = leash;
+                            piece.hold = hold;
+                            piece.hasTankSpot = hold && from.hasTankSpot && at.hasTankSpot;
+                            piece.hasRangedSpot = hold && from.hasRangedSpot && at.hasRangedSpot;
+                            // The nearer end's spots: all the start's sent a
+                            // leader 40 yards back to fight at every pull
+                            // along a 74-yard leg, and forward again after
+                            // (steps 81-82; dev, 2026-11-22).
+                            bool const nearEnd = at.hasTankSpot && from.hasTankSpot ?
+                                piece.point.distance(at.tankSpot) < piece.point.distance(from.tankSpot) : k * 2 > n;
+                            piece.tankSpot = nearEnd ? at.tankSpot : from.tankSpot;
+                            piece.rangedSpot = nearEnd ? at.rangedSpot : from.rangedSpot;
+                            piece.number = from.number;
+                            piece.piece = uint32_t(k);
+                            split.push_back(piece);
+                            ++pieces;
+                        }
+                    }
+                }
+                split.push_back(at);
+                if (!at.entry)
+                    last = int(split.size()) - 1;
+            }
+            steps = std::move(split);
+        }
+        sLog.outString("Dungeon routes: long legs in %u pieces", pieces);
+        sLog.outString("Dungeon routes: %u loaded", uint32(routes.size()));
+    }
+    static std::vector<RouteStep> const none;
+    auto found = routes.find({ mapId, wing });
+    return found != routes.end() ? found->second : none;
+}
+
+std::string DungeonRun::StepName(std::vector<RouteStep> const& route, int index)
+{
+    if (index < 0 || index >= int(route.size()))
+        return std::to_string(index + 1);
+    RouteStep const& at = route[index];
+    return at.piece ? std::to_string(at.number) + "." + std::to_string(at.piece) : std::to_string(at.number);
+}
+
+int DungeonRun::Shortcut(Player* bot, std::vector<RouteStep> const& route, int step, int upTo)
+{
+    if (step < 0 || step >= int(route.size()) || upTo <= step)
+        return -1;
+    WorldPosition const at(bot);
+    float along = 0.0f;
+    int previous = -1;
+    int found = -1;
+    for (int j = step; j <= upTo && j < int(route.size()); ++j)
+    {
+        RouteStep const& to = route[j];
+        // Never past a boss of the loop still alive (owner, 2026-11-21:
+        // "never while Cobrahn is alive").
+        if (to.entry && !to.optional && IsAliveBoss(bot, to.entry))
+            break;
+        if (to.entry)
+            continue;
+        if (previous >= 0)
+            along += route[previous].point.distance(to.point);
+        previous = j;
+        if (j == step || to.point.getMapId() != bot->GetMapId())
+            continue;
+        float const d = to.point.distance(at);
+        if (d <= ShortcutRange && std::abs(to.point.getZ() - at.getZ()) < 5.0f && along + at.distance(route[step].point) > 4.0f * d + 40.0f)
+            found = j;
+    }
+    if (found < 0 || Detour(bot, route[found].point))
+        return -1;
+    AiObjectContext* context = bot->GetPlayerbotAI()->GetAiObjectContext();
+    context->GetValue<int>("manual int", "shortcut from")->Set(LastPoint(bot, route, step) + 1);
+    context->GetValue<int>("manual int", "shortcut to")->Set(found + 1);
+    return found;
+}
+
+int DungeonRun::LastPoint(Player* bot, std::vector<RouteStep> const& route, int step)
+{
+    if (bot->GetPlayerbotAI())
+    {
+        AiObjectContext* context = bot->GetPlayerbotAI()->GetAiObjectContext();
+        int const from = context->GetValue<int>("manual int", "shortcut from")->Get() - 1;
+        if (context->GetValue<int>("manual int", "shortcut to")->Get() - 1 == step && from >= 0 && from < int(route.size()))
+            return from;
+    }
+    int last = step - 1;
+    while (last >= 0 && last < int(route.size()) && route[last].entry)
+        --last;
+    return last;
+}
+
+int DungeonRun::IndexOf(std::vector<RouteStep> const& route, uint32_t number)
+{
+    for (size_t i = 0; i < route.size(); ++i)
+        if (route[i].number == number && !route[i].piece)
+            return int(i);
+    return -1;
+}
+
+bool DungeonRun::BossOf(Player* leader, uint32_t entry, WorldPosition& pos, Creature*& creature)
+{
+    creature = nullptr;
+    Map* map = leader->GetMap();
+    for (Boss const& boss : AliveBosses(leader))
+    {
+        if (boss.entry != entry)
+            continue;
+        // A spawn group's boss whose point is not chosen yet - its grid not
+        // loaded: to its points in turn, the nearest not seen yet; near one,
+        // the group places it (Lady Anacondra was passed as unreachable,
+        // dev 2026-11-16).
+        if (!boss.guid && boss.group)
+        {
+            // Its points from the world data: the map's own spawn group is
+            // there only once its grid is loaded - far from it, none, and the
+            // boss was passed as unreachable at once (Lady Anacondra, dev,
+            // 2026-11-17).
+            auto const& groups = sObjectMgr.GetSpawnGroupContainer()->spawnGroupMap;
+            auto const group = groups.find(boss.group);
+            if (group == groups.end())
+                continue;
+            AiObjectContext* context = leader->GetPlayerbotAI()->GetAiObjectContext();
+            std::string seen = context->GetValue<std::string>("manual string", "run seen")->Get();
+            float best = 0.0f;
+            bool found = false;
+            for (SpawnGroupDbGuids const& point : group->second.DbGuids)
+            {
+                // Placed there and alive: there it is.
+                if (Creature* live = map->GetCreature(point.DbGuid))
+                    if (live->IsAlive() && live->GetEntry() == entry)
+                    {
+                        pos = WorldPosition(live);
+                        creature = live;
+                        return true;
+                    }
+                CreatureData const* data = sObjectMgr.GetCreatureData(point.DbGuid);
+                if (!data)
+                    continue;
+                WorldPosition const where(data->mapid, data->posX, data->posY, data->posZ);
+                std::string const key = std::to_string(point.DbGuid) + ",";
+                if (seen.find("," + key) != std::string::npos)
+                    continue;
+                if (where.distance(WorldPosition(leader)) < 20.0f)
+                {
+                    seen += "," + key; // here, and nothing: next
+                    continue;
+                }
+                float const distance = where.distance(WorldPosition(leader));
+                if (!found || distance < best)
+                {
+                    found = true;
+                    best = distance;
+                    pos = where;
+                }
+            }
+            context->GetValue<std::string>("manual string", "run seen")->Set(seen);
+            if (found)
+                return true;
+            continue;
+        }
+        if (!boss.guid)
+            continue;
+        Creature* live = map->GetCreature(boss.guid);
+        if (live && !live->IsAlive())
+            continue;
+        if (live)
+            pos = WorldPosition(live);
+        else if (CreatureData const* data = sObjectMgr.GetCreatureData(boss.guid))
+            pos = WorldPosition(data->mapid, data->posX, data->posY, data->posZ);
+        else
+            continue;
+        creature = live;
+        return true;
+    }
+    return false;
+}
+
+bool DungeonRun::InDungeonGroup(Player* bot)
+{
+    if (!bot->GetGroup() || !GroupQuests::Holds(bot))
+        return false;
+    WorldPosition point;
+    Player* gatherer = nullptr;
+    // Walking its way in too: one dead on it waited for at the gathering
+    // point near two hours (dev, 2026-11-19).
+    if (Active(bot) || GatherPoint(bot, point, gatherer) || GoingIn(bot))
+        return true;
+    Player* leader = sObjectMgr.GetPlayer(bot->GetGroup()->GetLeaderGuid());
+    return leader && leader != bot && leader->IsInWorld() && leader->GetMap()->IsDungeon();
+}
+
+Player* DungeonRun::Reviver(Player* bot)
+{
+    // Resurrection, Redemption, Ancestral Spirit, Rebirth - the first ranks,
+    // kept in the spellbook with the later ones.
+    static uint32 const revives[] = { 2006, 7328, 2008, 20484 };
+    Group* group = bot->GetGroup();
+    for (GroupReference* ref = group ? group->GetFirstMember() : nullptr; ref; ref = ref->next())
+    {
+        Player* member = ref->getSource();
+        if (!member || member == bot || !member->IsInWorld() || !member->IsAlive())
+            continue;
+        for (uint32 spell : revives)
+            if (member->HasSpell(spell))
+                return member;
+    }
+    return nullptr;
+}
+
+bool DungeonRun::GoingIn(Player* bot)
+{
+    Group* group = bot->GetGroup();
+    Player* leader = group ? sObjectMgr.GetPlayer(group->GetLeaderGuid()) : nullptr;
+    if (!leader || !leader->GetPlayerbotAI() || leader->GetPlayerbotAI()->IsRealPlayer())
+        return false;
+    AiObjectContext* context = leader->GetPlayerbotAI()->GetAiObjectContext();
+    int const focus = context->GetValue<int>("manual int", "group quest focus")->Get();
+    if (focus <= 0 || context->GetValue<int>("manual int", "gathered")->Get() != focus)
+        return false;
+    Quest const* quest = sObjectMgr.GetQuestTemplate(uint32(focus));
+    AreaTableEntry const* area = quest && quest->GetZoneOrSort() > 0 ? GetAreaEntryByAreaID(quest->GetZoneOrSort()) : nullptr;
+    MapEntry const* dungeon = area ? sMapStore.LookupEntry(area->mapid) : nullptr;
+    if (!dungeon || !dungeon->IsDungeon())
+        return false;
+    for (GroupReference* ref = group->GetFirstMember(); ref; ref = ref->next())
+        if (Player* member = ref->getSource())
+            if (member->GetMapId() != dungeon->MapID)
+                return true;
+    return false;
+}
+
+bool DungeonRun::WalkingIn(Player* bot)
+{
+    if (!GoingIn(bot))
+        return false;
+    Player* leader = sObjectMgr.GetPlayer(bot->GetGroup()->GetLeaderGuid());
+    WorldPosition way, inside;
+    if (!leader || !leader->IsInWorld() || leader->GetMap()->IsDungeon() || !WayInto(leader, way, inside))
+        return false;
+    return !Route(inside.getMapId(), WayInWing).empty();
+}
+
+void DungeonRun::TakeQuests(Player* leader, uint32_t npc, uint32_t dungeonMap)
+{
+    Creature* giver = GetClosestCreatureWithEntry(leader, npc, 60.0f);
+    if (!giver)
+        return;
+    auto const bounds = sObjectMgr.GetCreatureQuestRelationsMapBounds(npc);
+    for (GroupReference* ref = leader->GetGroup()->GetFirstMember(); ref; ref = ref->next())
+    {
+        Player* member = ref->getSource();
+        if (!member || !member->GetPlayerbotAI() || !member->IsInWorld() || !member->IsAlive() || member->GetDistance(giver) > 60.0f)
+            continue;
+        std::string taken;
+        for (auto i = bounds.first; i != bounds.second; ++i)
+        {
+            Quest const* quest = sObjectMgr.GetQuestTemplate(i->second);
+            AreaTableEntry const* area = quest && quest->GetZoneOrSort() > 0 ? GetAreaEntryByAreaID(quest->GetZoneOrSort()) : nullptr;
+            if (!area || area->mapid != dungeonMap)
+                continue; // the dungeon's quests only
+            if (member->GetQuestStatus(quest->GetQuestId()) != QUEST_STATUS_NONE || !member->CanTakeQuest(quest, false) || !member->CanAddQuest(quest, false))
+                continue;
+            if (member->FindQuestSlot(0) >= MAX_QUEST_LOG_SIZE)
+                break; // its log full: no more (a full log stops the server)
+            member->AddQuest(quest, giver);
+            taken += std::string(taken.empty() ? "" : ", ") + quest->GetTitle();
+        }
+        if (!taken.empty())
+            sLog.outString("Bot #%d %s:%d <%s>: takes %s's quests - %s", member->GetGUIDLow(), member->GetTeam() == ALLIANCE ? "A" : "H",
+                member->GetLevel(), member->GetName(), giver->GetName(), taken.c_str());
+    }
+}
+
+void DungeonRun::Gossip(Player* leader, uint32_t npc)
+{
+    Creature* host = GetClosestCreatureWithEntry(leader, npc, 60.0f);
+    if (!host)
+        return;
+    for (GroupReference* ref = leader->GetGroup()->GetFirstMember(); ref; ref = ref->next())
+    {
+        Player* member = ref->getSource();
+        if (!member || !member->GetPlayerbotAI() || !member->IsInWorld() || !member->IsAlive() || member->GetDistance(host) > 60.0f)
+            continue;
+        sScriptDevAIMgr.OnGossipHello(member, host);
+        member->GetPlayerMenu()->CloseGossip();
+    }
+    sLog.outString("Bot #%d %s:%d <%s>: its group greets %s", leader->GetGUIDLow(), leader->GetTeam() == ALLIANCE ? "A" : "H",
+        leader->GetLevel(), leader->GetName(), host->GetName());
+}
+
+bool DungeonRun::WayInto(Player* bot, WorldPosition& way, WorldPosition& inside)
+{
+    Group* group = bot->GetGroup();
+    Player* leader = group ? sObjectMgr.GetPlayer(group->GetLeaderGuid()) : nullptr;
+    if (!leader || !leader->GetPlayerbotAI())
+        return false;
+    int const focus = leader->GetPlayerbotAI()->GetAiObjectContext()->GetValue<int>("manual int", "group quest focus")->Get();
+    Quest const* quest = focus > 0 ? sObjectMgr.GetQuestTemplate(uint32(focus)) : nullptr;
+    AreaTableEntry const* area = quest && quest->GetZoneOrSort() > 0 ? GetAreaEntryByAreaID(quest->GetZoneOrSort()) : nullptr;
+    if (!area)
+        return false;
+    AreaTriggerEntry const* best = nullptr;
+    for (AreaTriggerEntry const* entry : WaysInto(area->mapid))
+        if (!best || (entry->mapid == bot->GetMapId() &&
+            (best->mapid != bot->GetMapId() || bot->GetDistance(entry->x, entry->y, entry->z) < bot->GetDistance(best->x, best->y, best->z))))
+            best = entry;
+    AreaTrigger const* target = best ? sObjectMgr.GetAreaTrigger(best->id) : nullptr;
+    if (!target)
+        return false;
+    way = WorldPosition(best->mapid, best->x, best->y, best->z);
+    inside = WorldPosition(target->target_mapId, target->target_X, target->target_Y, target->target_Z, target->target_Orientation);
+    return true;
+}
+
+bool DungeonRun::FightInside(Player* bot)
+{
+    Group* group = bot->GetGroup();
+    for (GroupReference* ref = group ? group->GetFirstMember() : nullptr; ref; ref = ref->next())
+    {
+        Player* member = ref->getSource();
+        if (member && member != bot && member->IsInWorld() && member->IsAlive() && member->GetMap()->IsDungeon() && member->IsInCombat())
+            return true;
+    }
+    return false;
+}
+
+// A member at the point its leader heads for, or the one before: with its
+// group - members waited at the way in's first point, 30 yards up from
+// their leader at the gathering point, and it waited for them (dev,
+// 2026-11-19).
+static bool AtLeadersPoint(Player* member, Player* leader);
+
+uint32 DungeonRun::ReadyManaOf(Player* member)
+{
+    if (RestFull(member))
+        return 100;
+    return PlayerbotAI::IsHeal(member) ? ReadyHealerMana : ReadyMana;
+}
+
+uint32 DungeonRun::ReadyHealthOf(Player* member)
+{
+    return RestFull(member) ? 100 : ReadyHealth;
+}
+
+bool DungeonRun::RestFull(Player* member)
+{
+    Player* leader = member->GetGroup() ? sObjectMgr.GetPlayer(member->GetGroup()->GetLeaderGuid()) : nullptr;
+    if (!leader || !leader->GetPlayerbotAI())
+        return false;
+    time_t const since = leader->GetPlayerbotAI()->GetAiObjectContext()->GetValue<time_t>("manual time", "rest full since")->Get();
+    return since && time(nullptr) - since < RestFullTime;
+}
+
+bool DungeonRun::GroupReady(Player* leader, std::string* why, Player** who)
+{
+    Group* group = leader->GetGroup();
+    if (!group)
+        return true;
+    for (GroupReference* ref = group->GetFirstMember(); ref; ref = ref->next())
+    {
+        Player* member = ref->getSource();
+        if (!member || !member->GetPlayerbotAI())
+            continue; // offline: not waited for
+        std::string lacks;
+        if (!member->IsInWorld() || member->IsBeingTeleported())
+            lacks = "on its way";
+        else if (!member->IsAlive())
+            lacks = "dead";
+        else if (member->GetMapId() != leader->GetMapId() || member->GetInstanceId() != leader->GetInstanceId())
+            lacks = "not here";
+        else if (member != leader && member->GetDistance(leader) > ReadyRange && !AtLeadersPoint(member, leader))
+            lacks = std::to_string(int(member->GetDistance(leader))) + "y away";
+        else if (member->IsInCombat())
+            lacks = "fighting";
+        else if (member->GetHealthPercent() < float(ReadyHealthOf(member)))
+            lacks = std::to_string(int(member->GetHealthPercent())) + "% health";
+        else if (member->GetPowerType() == POWER_MANA && member->GetMaxPower(POWER_MANA) &&
+            member->GetPower(POWER_MANA) * 100 < member->GetMaxPower(POWER_MANA) * ReadyManaOf(member))
+            lacks = std::to_string(member->GetPower(POWER_MANA) * 100 / member->GetMaxPower(POWER_MANA)) + "% mana";
+        if (lacks.empty())
+            continue;
+        if (why)
+            *why = std::string(member->GetName()) + " " + lacks;
+        if (who)
+            *who = member;
+        return false;
+    }
+    return true;
+}
+
+// Every unit within range of the player.
+static void UnitsNear(Player* player, std::list<Unit*>& units, float range)
+{
+    MaNGOS::AnyUnitInObjectRangeCheck check(player, range);
+    MaNGOS::UnitListSearcher<MaNGOS::AnyUnitInObjectRangeCheck> searcher(units, check);
+    Cell::VisitAllObjects(player, searcher, range);
+}
+
+Creature* DungeonRun::TrashAhead(Player* leader, WorldPosition const& goal, std::string const& failed, uint32 kept)
+{
+    std::list<Unit*> units;
+    UnitsNear(leader, units, PullScanRange);
+    float const own = goal.distance(WorldPosition(leader));
+    Creature* best = nullptr;
+    for (Unit* unit : units)
+    {
+        if (unit->GetTypeId() != TYPEID_UNIT)
+            continue;
+        Creature* creature = static_cast<Creature*>(unit);
+        if (!creature->IsAlive() || creature->IsInCombat() || creature->IsCritter() || creature->IsPet() || !creature->IsEnemy(leader))
+            continue;
+        if (failed.find("," + std::to_string(creature->GetGUIDLow()) + ",") != std::string::npos)
+            continue;
+        if (kept && creature->GetGUIDLow() == kept)
+            return creature;
+        if (std::abs(creature->GetPositionZ() - leader->GetPositionZ()) > 20.0f || !leader->IsWithinLOSInMap(creature))
+            continue;
+        // Not behind it: on its way, or close anyway.
+        if (goal.distance(WorldPosition(creature)) > own + 10.0f && leader->GetDistance(creature) > 20.0f)
+            continue;
+        if (!best || leader->GetDistance(creature) < leader->GetDistance(best))
+            best = creature;
+    }
+    return best;
+}
+
+Player* DungeonRun::Puller(Player* leader, Creature* target)
+{
+    std::vector<Player*> order;
+    Group* group = leader->GetGroup();
+    for (uint8 cls : { uint8(CLASS_HUNTER), uint8(CLASS_MAGE), uint8(CLASS_WARLOCK), uint8(0) })
+        for (GroupReference* ref = group ? group->GetFirstMember() : nullptr; ref; ref = ref->next())
+        {
+            Player* member = ref->getSource();
+            if (!member || member == leader || !member->GetPlayerbotAI() || !member->IsInWorld() || !member->IsAlive() ||
+                member->GetMapId() != leader->GetMapId() || member->GetDistance(leader) > ReadyRange)
+                continue;
+            // With its group, at its level: one above a cliff, 36 yards up,
+            // was picked (dev, 2026-11-20).
+            if (std::abs(member->GetPositionZ() - leader->GetPositionZ()) > 5.0f || member->GetDistance(leader) > 2.0f * CloseUpRange)
+                continue;
+            if (cls ? member->getClass() != cls : (member->getClass() == CLASS_HUNTER || member->getClass() == CLASS_MAGE ||
+                member->getClass() == CLASS_WARLOCK || PlayerbotAI::IsHeal(member)))
+                continue;
+            order.push_back(member);
+        }
+    order.push_back(leader); // the tank last
+    for (Player* member : order)
+    {
+        PlayerbotAI* ai = member->GetPlayerbotAI();
+        for (BotState state : { BotState::BOT_STATE_COMBAT, BotState::BOT_STATE_NON_COMBAT })
+            if (!ai->HasStrategy("pull", state))
+                ai->ChangeStrategy("+pull,+pull back", state);
+        PullStrategy* strategy = PullStrategy::Get(ai);
+        if (strategy && strategy->CanDoPullAction(target))
+            return member;
+    }
+    return nullptr;
+}
+
+bool DungeonRun::NeedsCorner(Player* leader, Creature* target)
+{
+    if (target->GetCreatureInfo()->UnitClass == CLASS_MAGE)
+        return true;
+    std::list<Unit*> units;
+    UnitsNear(leader, units, PullScanRange + 15.0f);
+    for (Unit* unit : units)
+        if (unit != target && unit->GetTypeId() == TYPEID_UNIT && unit->IsAlive() && !unit->IsInCombat() &&
+            unit->IsEnemy(leader) && unit->GetDistance(target) <= 10.0f)
+            return true;
+    return false;
+}
+
+bool DungeonRun::HiddenSpot(Player* leader, Creature* target, WorldPosition& spot)
+{
+    Map* map = leader->GetMap();
+    float const tz = target->GetPositionZ() + 2.0f;
+    float const away = target->GetDistance(leader);
+    for (float radius : { 8.0f, 12.0f, 16.0f, 20.0f })
+        for (int i = 0; i < 16; ++i)
+        {
+            float const angle = float(i) * float(M_PI) / 8.0f;
+            float const x = leader->GetPositionX() + radius * std::cos(angle);
+            float const y = leader->GetPositionY() + radius * std::sin(angle);
+            float const z = map->GetHeight(x, y, leader->GetPositionZ() + 5.0f);
+            if (z <= INVALID_HEIGHT || std::abs(z - leader->GetPositionZ()) > 5.0f)
+                continue;
+            if (target->GetDistance(x, y, z) <= away || map->IsInLineOfSight(target->GetPositionX(), target->GetPositionY(), tz, x, y, z + 2.0f, false))
+                continue;
+            WorldPosition const p(leader->GetMapId(), x, y, z);
+            std::vector<WorldPosition> path = WorldPosition(leader).getPathTo(p, leader);
+            if (path.size() < 2 || !p.isPathTo(path, 2.0f))
+                continue;
+            float length = 0.0f;
+            for (size_t k = 1; k < path.size(); ++k)
+                length += path[k - 1].distance(path[k]);
+            if (length > radius * 2.0f)
+                continue;
+            spot = p;
+            return true;
+        }
+    return false;
+}
+
+bool DungeonRun::InPullRange(Player* puller, Creature* target)
+{
+    PullStrategy* strategy = puller->GetPlayerbotAI() ? PullStrategy::Get(puller->GetPlayerbotAI()) : nullptr;
+    float range = 30.0f;
+    if (strategy)
+        puller->GetPlayerbotAI()->GetSpellRange(strategy->GetSpellName(), &range);
+    return puller->GetDistance(target) <= range - 2.0f && puller->IsWithinLOSInMap(target);
+}
+
+bool DungeonRun::StartPull(Player* leader, Player* puller, Creature* target, WorldPosition const& spot)
+{
+    PlayerbotAI* ai = puller->GetPlayerbotAI();
+    PullStrategy* strategy = PullStrategy::Get(ai);
+    if (!strategy || !strategy->CanDoPullAction(target))
+        return false;
+    PositionMap& posMap = ai->GetAiObjectContext()->GetValue<PositionMap&>("position")->Get();
+    posMap["pull"].Set(spot.getX(), spot.getY(), spot.getZ(), spot.getMapId());
+    ai->GetAiObjectContext()->GetValue<std::string>("manual string", "hold from")->Set(spot.to_string());
+    ai->GetAiObjectContext()->GetValue<time_t>("manual time", "hold from since")->Set(time(nullptr));
+    strategy->RequestPull(target);
+    ai->OnCombatStarted();
+    // The damage dealers hold till the tank has it a moment: the run's own
+    // hold (RunTankFirstMultiplier) - not 3 seconds from their own fight's
+    // start, over before a creature pulled from afar reached the tank.
+    return true;
+}
+
+// The route its leader walks now and the step it heads for (its index).
+std::vector<DungeonRun::RouteStep> const* DungeonRun::LeaderRoute(Player* leader, int& leaderStep, std::string& key)
+{
+    AiObjectContext* context = leader->GetPlayerbotAI()->GetAiObjectContext();
+    if (!leader->GetMap()->IsDungeon())
+    {
+        WorldPosition way, inside;
+        if (!DungeonRun::WalkingIn(leader) || !DungeonRun::WayInto(leader, way, inside))
+            return nullptr;
+        leaderStep = context->GetValue<int>("manual int", "way in step")->Get();
+        key = std::to_string(inside.getMapId()) + "|way in";
+        return &DungeonRun::Route(inside.getMapId(), DungeonRun::WayInWing);
+    }
+    if (!DungeonRun::Active(leader))
+        return nullptr;
+    uint32 const wing = uint32(context->GetValue<int>("manual int", "run wing")->Get());
+    leaderStep = context->GetValue<int>("manual int", "run step")->Get();
+    key = std::to_string(leader->GetMapId()) + "|" + std::to_string(leader->GetInstanceId()) + "|" + std::to_string(wing);
+    return &DungeonRun::Route(leader->GetMapId(), wing);
+}
+
+static bool AtLeadersPoint(Player* member, Player* leader)
+{
+    int leaderStep = 0;
+    std::string key;
+    std::vector<DungeonRun::RouteStep> const* route = DungeonRun::LeaderRoute(leader, leaderStep, key);
+    if (!route)
+        return false;
+    for (int i : { leaderStep, leaderStep - 1 })
+        if (i >= 0 && i < int(route->size()) && !(*route)[i].entry && (*route)[i].point.getMapId() == member->GetMapId() &&
+            (*route)[i].point.distance(WorldPosition(member)) <= 8.0f)
+            return true;
+    return false;
+}
+
+float DungeonRun::FromLeg(Player* bot, WorldPosition const& a, WorldPosition const& b)
+{
+    if (a.getMapId() != bot->GetMapId() || b.getMapId() != bot->GetMapId())
+        return 99999.0f;
+    float const dx = b.getX() - a.getX(), dy = b.getY() - a.getY(), dz = b.getZ() - a.getZ();
+    float const len2 = dx * dx + dy * dy + dz * dz;
+    float t = len2 > 0.0f ? ((bot->GetPositionX() - a.getX()) * dx + (bot->GetPositionY() - a.getY()) * dy +
+        (bot->GetPositionZ() - a.getZ()) * dz) / len2 : 0.0f;
+    t = std::max(0.0f, std::min(1.0f, t));
+    return WorldPosition(a.getMapId(), a.getX() + dx * t, a.getY() + dy * t, a.getZ() + dz * t).distance(WorldPosition(bot));
+}
+
+bool DungeonRun::FightOver(Player* bot)
+{
+    // Seen in its fight by RunFoughtTrigger - upstream's combat start time
+    // is back to 0 as a fight ends, nothing to tell one over by.
+    if (bot->IsInCombat() || !bot->GetPlayerbotAI())
+        return false;
+    AiObjectContext* context = bot->GetPlayerbotAI()->GetAiObjectContext();
+    if (!context->GetValue<int>("manual int", "fought")->Get())
+        return false;
+    context->GetValue<int>("manual int", "fought")->Set(0);
+    return true;
+}
+
+bool DungeonRun::GoingBack(Player* bot)
+{
+    if (!bot->GetPlayerbotAI() || bot->IsInCombat())
+        return false;
+    AiObjectContext* context = bot->GetPlayerbotAI()->GetAiObjectContext();
+    return context->GetValue<int>("manual int", "going back")->Get() > 0 &&
+        time(nullptr) - context->GetValue<time_t>("manual time", "going back since")->Get() < GoingBackTime;
+}
+
+bool DungeonRun::DropStuck(Player* bot, int step, WorldPosition const& point)
+{
+    AiObjectContext* context = bot->GetPlayerbotAI()->GetAiObjectContext();
+    time_t const now = time(nullptr);
+    float const gap = point.getMapId() == bot->GetMapId() ? point.distance(WorldPosition(bot)) : 9999.0f;
+    if (gap <= 3.0f)
+        return false;
+    time_t const since = context->GetValue<time_t>("manual time", "drop since")->Get();
+    if (!since || now - since > 2 * DropTime || context->GetValue<int>("manual int", "drop step")->Get() != step ||
+        gap < float(context->GetValue<int>("manual int", "drop best")->Get()) - 3.0f)
+    {
+        context->GetValue<int>("manual int", "drop step")->Set(step);
+        context->GetValue<int>("manual int", "drop best")->Set(int(gap));
+        context->GetValue<time_t>("manual time", "drop since")->Set(now);
+        return false;
+    }
+    if (now - since < DropTime || bot->IsInCombat())
+        return false;
+    context->GetValue<time_t>("manual time", "drop since")->Set(0);
+    return true;
+}
+
+bool DungeonRun::OnDropSlope(Player* bot, RouteStep const* next)
+{
+    if (!next || (next->kind != "drop" && next->kind != "jump") || next->point.getMapId() != bot->GetMapId())
+        return false;
+    // The point before it, in the same route (steps sit in one vector).
+    int step = 0;
+    std::string key;
+    Player* leader = bot->GetGroup() ? sObjectMgr.GetPlayer(bot->GetGroup()->GetLeaderGuid()) : bot;
+    std::vector<RouteStep> const* route = leader && leader->GetPlayerbotAI() ? LeaderRoute(leader, step, key) : nullptr;
+    if (!route || route->empty() || next < &route->front() || next > &route->back())
+        return false;
+    for (RouteStep const* at = next - 1; at >= &route->front(); --at)
+        if (!at->entry)
+        {
+            float const z = bot->GetPositionZ();
+            return z < at->point.getZ() - FallDepth && z > next->point.getZ() - 3.0f;
+        }
+    return false;
+}
+
+bool DungeonRun::AheadOfLeader(Player* member, WorldPosition& behind)
+{
+    Player* leader = member->GetGroup() ? sObjectMgr.GetPlayer(member->GetGroup()->GetLeaderGuid()) : nullptr;
+    if (!leader || leader == member || !leader->GetPlayerbotAI() || !leader->IsInWorld() || leader->GetMapId() != member->GetMapId())
+        return false;
+    int step = 0;
+    std::string key;
+    std::vector<RouteStep> const* route = DungeonRun::LeaderRoute(leader, step, key);
+    if (!route)
+        return false;
+    // Its leader's leg: the last point it passed to the one it heads for.
+    int last = LastPoint(leader, *route, step), ahead = step;
+    while (ahead < int(route->size()) && (*route)[ahead].entry)
+        ++ahead;
+    if (last < 0 || ahead >= int(route->size()))
+        return false;
+    float dx = (*route)[ahead].point.getX() - (*route)[last].point.getX();
+    float dy = (*route)[ahead].point.getY() - (*route)[last].point.getY();
+    float const len = std::sqrt(dx * dx + dy * dy);
+    if (len < 1.0f)
+        return false;
+    dx /= len;
+    dy /= len;
+    float const along = (member->GetPositionX() - leader->GetPositionX()) * dx + (member->GetPositionY() - leader->GetPositionY()) * dy;
+    if (along <= AheadRange)
+        return false;
+    float x = leader->GetPositionX() - dx * BehindRange;
+    float y = leader->GetPositionY() - dy * BehindRange;
+    float z = leader->GetPositionZ();
+    member->UpdateAllowedPositionZ(x, y, z);
+    behind = WorldPosition(leader->GetMapId(), x, y, z);
+    return true;
+}
+
+bool DungeonRun::FightLeg(Player* member, bool& hold, WorldPosition& tankSpot, bool& hasTankSpot)
+{
+    hold = false;
+    hasTankSpot = false;
+    Player* leader = member->GetGroup() ? sObjectMgr.GetPlayer(member->GetGroup()->GetLeaderGuid()) : nullptr;
+    if (!leader || !leader->GetPlayerbotAI() || !leader->IsInWorld() || leader->GetMapId() != member->GetMapId())
+        return false;
+    int step = 0;
+    std::string key;
+    std::vector<RouteStep> const* route = DungeonRun::LeaderRoute(leader, step, key);
+    if (!route)
+        return false;
+    for (int i : { step, step - 1 })
+        if (i >= 0 && i < int(route->size()))
+        {
+            hold = hold || (*route)[i].hold || (*route)[i].hasTankSpot;
+            if ((*route)[i].hasTankSpot && !hasTankSpot)
+            {
+                hasTankSpot = true;
+                tankSpot = (*route)[i].tankSpot;
+            }
+        }
+    return hold || hasTankSpot;
+}
+
+bool DungeonRun::RangedSpot(Player* member, WorldPosition& spot)
+{
+    Player* leader = member->GetGroup() ? sObjectMgr.GetPlayer(member->GetGroup()->GetLeaderGuid()) : nullptr;
+    if (!leader || !leader->GetPlayerbotAI() || !leader->IsInWorld() || leader->GetMapId() != member->GetMapId())
+        return false;
+    int step = 0;
+    std::string key;
+    std::vector<RouteStep> const* route = DungeonRun::LeaderRoute(leader, step, key);
+    if (!route)
+        return false;
+    for (int i : { step, step - 1 })
+        if (i >= 0 && i < int(route->size()) && (*route)[i].hasRangedSpot)
+        {
+            spot = (*route)[i].rangedSpot;
+            return true;
+        }
+    return false;
+}
+
+bool DungeonRun::ToTankSpot(Player* leader)
+{
+    bool hold = false, hasTank = false;
+    WorldPosition spot;
+    if (!FightLeg(leader, hold, spot, hasTank) || !hasTank || !leader->GetPlayerbotAI())
+        return false;
+    time_t const since = leader->GetPlayerbotAI()->GetAiObjectContext()->GetValue<time_t>("manual time", "to tank spot")->Get();
+    return spot.distance(WorldPosition(leader)) <= 8.0f || (since && time(nullptr) - since < 30);
+}
+
+Player* DungeonRun::TankOf(Player* member)
+{
+    Group* group = member->GetGroup();
+    if (!group)
+        return nullptr;
+    for (GroupReference* ref = group->GetFirstMember(); ref; ref = ref->next())
+        if (Player* tank = ref->getSource())
+            if (tank != member && tank->IsInWorld() && tank->IsAlive() && tank->GetMapId() == member->GetMapId() && PlayerbotAI::IsTank(tank))
+                return tank;
+    Player* leader = sObjectMgr.GetPlayer(group->GetLeaderGuid());
+    return leader && leader != member && leader->IsInWorld() && leader->IsAlive() && leader->GetMapId() == member->GetMapId() ? leader : nullptr;
+}
