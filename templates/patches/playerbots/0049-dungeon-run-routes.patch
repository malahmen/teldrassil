+    context->GetValue<time_t>("manual time", "gather progress since")->Set(0);
+}
+
+bool DungeonRun::WaitForLeaderAtPortal(Player* bot)
+{
+    Group* group = bot->GetGroup();
+    if (!group || group->IsLeader(bot->GetObjectGuid()) || !bot->IsInWorld() || bot->GetMap()->IsDungeon())
+        return false;
+    Player* leader = sObjectMgr.GetPlayer(group->GetLeaderGuid());
+    if (!leader || !leader->GetPlayerbotAI() || leader->GetPlayerbotAI()->IsRealPlayer())
+        return false;
+    int const focus = leader->GetPlayerbotAI()->GetAiObjectContext()->GetValue<int>("manual int", "group quest focus")->Get();
+    Quest const* quest = focus > 0 ? sObjectMgr.GetQuestTemplate(uint32(focus)) : nullptr;
+    AreaTableEntry const* area = quest && quest->GetZoneOrSort() > 0 ? GetAreaEntryByAreaID(quest->GetZoneOrSort()) : nullptr;
+    MapEntry const* dungeon = area ? sMapStore.LookupEntry(area->mapid) : nullptr;
+    if (!dungeon || !dungeon->IsDungeon())
+        return false;
+    if (leader->IsInWorld() && !leader->IsBeingTeleported() && leader->GetMapId() == dungeon->MapID)
+        return false; // inside: follow it in
+    for (AreaTriggerEntry const* way : WaysInto(dungeon->MapID))
+        if (way->mapid == bot->GetMapId() && bot->GetDistance(way->x, way->y, way->z) <= 40.0f)
+            return true;
+    return false;
+}
+
+bool DungeonRun::FollowLeaderIn(Player* bot, WorldPosition& way)
+{
+    Group* group = bot->GetGroup();
+    if (!group || !bot->IsInWorld() || bot->GetMap()->IsDungeon())
+        return false;
+    Player* leader = sObjectMgr.GetPlayer(group->GetLeaderGuid());
+    if (!leader || !leader->GetPlayerbotAI() || !leader->IsInWorld() || leader->IsBeingTeleported())
+        return false;
+    int const focus = leader->GetPlayerbotAI()->GetAiObjectContext()->GetValue<int>("manual int", "group quest focus")->Get();
+    Quest const* quest = focus > 0 ? sObjectMgr.GetQuestTemplate(uint32(focus)) : nullptr;
+    AreaTableEntry const* area = quest && quest->GetZoneOrSort() > 0 ? GetAreaEntryByAreaID(quest->GetZoneOrSort()) : nullptr;
+    if (!area)
+        return false;
+    // The leader of a gathered group goes first, straight to the way in: by
+    // its travel - its objectives inside - a leader stood an hour at the
+    // Wailing Caverns' cave and never went in (dev, 2026-11-17). Its members
+    // after it, once it is inside.
+    if (leader == bot)
+    {
+        MapEntry const* dungeon = sMapStore.LookupEntry(area->mapid);
+        if (!dungeon || !dungeon->IsDungeon() || !GoingIn(bot))
+            return false;
+        // A way in set by hand: walked step by step instead (WalkingIn).
+        if (!Route(area->mapid, WayInWing).empty())
+            return false;
+    }
+    else if (!leader->GetMap()->IsDungeon() || area->mapid != leader->GetMapId())
+        return false;
+    // The way in nearest it on its continent, else any.
+    AreaTriggerEntry const* best = nullptr;
+    for (AreaTriggerEntry const* entry : WaysInto(area->mapid))
+        if (!best || (entry->mapid == bot->GetMapId() &&
+            (best->mapid != bot->GetMapId() || bot->GetDistance(entry->x, entry->y, entry->z) < bot->GetDistance(best->x, best->y, best->z))))
+            best = entry;
+    if (!best)
+        return false;
+    way = WorldPosition(best->mapid, best->x, best->y, best->z);
+    return true;
+}
