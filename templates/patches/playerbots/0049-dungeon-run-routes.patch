+void DungeonRun::ShareQuests(Player* leader)
+{
+    Group* group = leader->GetGroup();
+    int const focus = leader->GetPlayerbotAI()->GetAiObjectContext()->GetValue<int>("manual int", "group quest focus")->Get();
+    Quest const* focused = focus > 0 ? sObjectMgr.GetQuestTemplate(uint32(focus)) : nullptr;
+    AreaTableEntry const* area = focused && focused->GetZoneOrSort() > 0 ? GetAreaEntryByAreaID(focused->GetZoneOrSort()) : nullptr;
+    if (!group || !area)
+        return;
+    std::vector<Player*> members;
+    for (GroupReference* ref = group->GetFirstMember(); ref; ref = ref->next())
+        if (Player* member = ref->getSource())
+            if (member->IsInWorld() && member->GetPlayerbotAI())
+                members.push_back(member);
+    for (Player* holder : members)
+        for (uint8 slot = 0; slot < MAX_QUEST_LOG_SIZE; ++slot)
+        {
+            Quest const* quest = sObjectMgr.GetQuestTemplate(holder->GetQuestSlotQuestId(slot));
+            if (!quest || quest->GetZoneOrSort() != focused->GetZoneOrSort())
+                continue;
+            for (Player* member : members)
+                if (member != holder && member->GetQuestStatus(quest->GetQuestId()) == QUEST_STATUS_NONE &&
+                    member->FindQuestSlot(0) < MAX_QUEST_LOG_SIZE && member->CanTakeQuest(quest, false))
+                {
+                    member->AddQuest(quest, nullptr);
+                    sLog.outString("Bot #%d %s:%d <%s>: takes %s, shared by %s", member->GetGUIDLow(), member->GetTeam() == ALLIANCE ? "A" : "H",
+                        member->GetLevel(), member->GetName(), quest->GetTitle().c_str(), holder->GetName());
+                }
+        }
+}
