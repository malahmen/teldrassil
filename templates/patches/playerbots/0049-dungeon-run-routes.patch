+bool RunLeashAction::Execute(Event& event)
+{
+    Player* leader = sObjectMgr.GetPlayer(bot->GetGroup()->GetLeaderGuid());
+    if (!leader)
+        return false;
+    if (bot->GetVictim())
+        bot->AttackStop();
+    return MoveNear(leader, 4.0f);
+}
+
+bool RunStayBehindAction::Execute(Event& event)
+{
+    WorldPosition behind;
+    if (!DungeonRun::AheadOfLeader(bot, behind))
+        return false;
+    return MoveTo(behind.getMapId(), behind.getX(), behind.getY(), behind.getZ());
+}
+
+bool RunHoldAction::Execute(Event& event)
+{
+    WorldPosition spot;
+    if (!DungeonRun::HoldSpot(bot, spot))
+        return false;
+    // Moved off it (a fear, a knockback): back; else still where it is.
+    if (spot.distance(WorldPosition(bot)) > 2.0f)
+        return MoveTo(spot.getMapId(), spot.getX(), spot.getY(), spot.getZ());
+    ai->StopMoving();
+    return true;
+}
+
+bool RunHealReachAction::Execute(Event& event)
+{
+    WorldPosition spot;
+    if (!DungeonRun::HoldingHealer(bot, spot))
+        return false;
+    WorldPosition const at(bot);
+    float const part = (DungeonRun::HealReach - 5.0f) / std::max(1.0f, at.distance(spot));
+    float x = spot.getX() + (at.getX() - spot.getX()) * part;
+    float y = spot.getY() + (at.getY() - spot.getY()) * part;
+    float z = spot.getZ();
+    bot->UpdateAllowedPositionZ(x, y, z);
+    return MoveTo(spot.getMapId(), x, y, z);
+}
+
+bool RunTankSpotAction::Execute(Event& event)
+{
+    bool hold = false, hasTank = false;
+    WorldPosition spot;
+    if (!DungeonRun::FightLeg(bot, hold, spot, hasTank) || !hasTank)
+        return false;
+    // Something on it: back to its spot facing it, backpedalling - it ran
+    // there with its back to what it had picked up (owner, 2026-11-22).
+    Unit* victim = bot->GetVictim();
+    if (victim && victim->IsAlive() && victim->GetVictim() == bot && bot->GetDistance(victim) <= 10.0f && spot.getMapId() == bot->GetMapId())
+    {
+        uint32 const nowMs = WorldTimer::getMSTime();
+        if (bot->movespline->Finalized() || WorldTimer::getMSTimeDiff(backpedalled, nowMs) >= 1000)
+        {
+            backpedalled = nowMs;
+            bot->GetMotionMaster()->Clear(false, true);
+            bot->GetMotionMaster()->MoveIdle();
+            Movement::MoveSplineInit init(*bot);
+            init.MoveTo(spot.getX(), spot.getY(), spot.getZ(), true);
+            init.SetFacing(victim);
+            init.SetVelocity(bot->GetSpeed(MOVE_RUN_BACK));
+            init.Launch();
+        }
+        return true;
+    }
+    return MoveTo(spot.getMapId(), spot.getX(), spot.getY(), spot.getZ());
+}
+
+bool RunToTankAction::Execute(Event& event)
+{
+    Player* tank = DungeonRun::TankOf(bot);
+    if (!tank)
+        return false;
+    return MoveNear(tank, 3.0f);
+}
+
+bool RunRaiseBodyAction::Execute(Event& event)
+{
+    uint32 spell = 0;
+    Corpse* corpse = nullptr;
+    Player* ghost = DungeonRun::BodyToRaise(bot, spell, corpse);
+    if (!ghost || bot->IsNonMeleeSpellCasted(true))
+        return false;
+    if (corpse->GetDistance(bot) > 25.0f || !bot->IsWithinLOSInMap(corpse))
+        return MoveTo(corpse->GetMapId(), corpse->GetPositionX(), corpse->GetPositionY(), corpse->GetPositionZ());
+    if (bot->IsMoving())
+        ai->StopMoving();
+    SpellEntry const* info = sSpellTemplate.LookupEntry<SpellEntry>(spell);
+    if (!info)
+        return false;
+    // On its body: the core lets a resurrection reach a player far away by
+    // its corpse near the caster (Spell.cpp, SPELL_EFFECT_RESURRECT_NEW).
+    Spell* cast = new Spell(bot, info, TRIGGERED_NONE);
+    SpellCastTargets targets;
+    targets.setUnitTarget(ghost);
+    targets.setCorpseTarget(corpse);
+    SpellCastResult const result = cast->SpellStart(&targets);
+    sLog.outString("Bot #%d %s:%d <%s>: raises %s's body (%s) - %s", bot->GetGUIDLow(), bot->GetTeam() == ALLIANCE ? "A" : "H",
+        bot->GetLevel(), bot->GetName(), ghost->GetName(), info->SpellName[0], result == SPELL_CAST_OK ? "cast" : std::to_string(int(result)).c_str());
+    return result == SPELL_CAST_OK;
+}
+
+bool RunChainPullAction::Execute(Event& event)
+{
+    Player* puller = nullptr;
+    Creature* next = DungeonRun::ChainNext(bot, puller);
+    if (!next || !puller)
+        return false;
+    PlayerbotAI* pullerAi = puller->GetPlayerbotAI();
+    PullStrategy* strategy = PullStrategy::Get(pullerAi);
+    if (!strategy || !strategy->CanDoPullAction(next))
+        return false;
+    // It pulls from where it stands and stays: the fight is here.
+    PositionMap& posMap = pullerAi->GetAiObjectContext()->GetValue<PositionMap&>("position")->Get();
+    posMap["pull"].Set(puller->GetPositionX(), puller->GetPositionY(), puller->GetPositionZ(), puller->GetMapId());
+    strategy->RequestPull(next);
+    SET_AI_VALUE2(time_t, "manual time", "run chain since", time(nullptr));
+    sLog.outString("Bot #%d %s:%d <%s>: chain pull - %s pulls %s (%.0fy) as the last one goes down", bot->GetGUIDLow(),
+        bot->GetTeam() == ALLIANCE ? "A" : "H", bot->GetLevel(), bot->GetName(), puller->GetName(), next->GetName(), bot->GetDistance(next));
+    return true;
+}
+
+bool RunKillFirstAction::Execute(Event& event)
+{
+    Creature* first = DungeonRun::KillFirst(bot);
+    if (!first)
+        return false;
+    return Attack(nullptr, first);
+}
