+bool RunNextBossAction::Execute(Event& event)
+{
+    DungeonRun::SettlePieces(bot);
+    // Its bosses dead and its escort to do: the escort (DungeonRun::EscortOf).
+    // The route walked to its end first - the escort's starter waits at its
+    // last point: from the last boss on another level, straight to him there
+    // was no way, the leader stood after Verdan (dev, 2026-11-22). By him
+    // already, or the escort on, the escort.
+    if (!DungeonRun::WalkingIn(bot) && DungeonRun::AliveBosses(bot).empty() && DungeonRun::EscortPending(bot))
