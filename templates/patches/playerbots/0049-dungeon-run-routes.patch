+bool DungeonRun::HeldByCc(Unit* unit)
+{
+    if (!unit || !unit->IsAlive())
+        return false;
+    for (auto const& [id, holder] : unit->GetSpellAuraHolderMap())
+    {
+        SpellEntry const* spell = holder ? holder->GetSpellProto() : nullptr;
+        if (spell && (spell->AuraInterruptFlags & AURA_INTERRUPT_FLAG_DAMAGE) && !holder->IsPositive() &&
+            (holder->GetCasterGuid().IsPlayer() || holder->GetCasterGuid().IsPet()))
+            return true;
+    }
+    return false;
+}
