+Creature* DungeonRun::ChainNext(Player* leader, Player*& puller)
+{
+    puller = nullptr;
+    Group* group = leader->GetGroup();
+    if (!group || !leader->GetMap()->IsDungeon() || !Active(leader) || EscortPending(leader))
+        return nullptr;
+    // What the group fights: one creature, low, no boss.
+    std::set<Unit*> foes;
+    Player* tank = TankOf(leader);
+    for (GroupReference* ref = group->GetFirstMember(); ref; ref = ref->next())
+    {
+        Player* member = ref->getSource();
+        if (!member || !member->IsInWorld() || member->GetMapId() != leader->GetMapId() || member->GetInstanceId() != leader->GetInstanceId())
+            continue;
+        if (!member->IsAlive())
+            return nullptr;
+        if (PlayerbotAI::IsHeal(member) && member->GetPowerType() == POWER_MANA &&
+            member->GetPower(POWER_MANA) * 100.0f < ChainHealerMana * member->GetMaxPower(POWER_MANA))
+            return nullptr;
+        for (HostileReference* hate = member->getHostileRefManager().getFirst(); hate; hate = hate->next())
+            if (Unit* unit = hate->getSource() ? hate->getSource()->getOwner() : nullptr)
+                if (unit->IsAlive())
+                    foes.insert(unit);
+    }
+    if (foes.size() != 1 || !tank || tank->GetHealthPercent() < ChainTankHealth)
+        return nullptr;
+    Unit* foe = *foes.begin();
+    if (foe->GetTypeId() != TYPEID_UNIT || IsBoss(static_cast<Creature*>(foe)) || foe->GetHealthPercent() > ChainHealth)
+        return nullptr;
+    bool hold = false, hasTankSpot = false;
+    WorldPosition tankSpot;
+    FightLeg(leader, hold, tankSpot, hasTankSpot);
+    if (hold)
+        return nullptr;
+    // Its next point on the way.
+    int step = 0;
+    std::string key;
+    std::vector<RouteStep> const* route = LeaderRoute(leader, step, key);
+    if (!route)
+        return nullptr;
+    while (step < int(route->size()) && (*route)[step].entry)
+        ++step;
+    if (step < 0 || step >= int(route->size()))
+        return nullptr;
+    std::string const failed = leader->GetPlayerbotAI()->GetAiObjectContext()->GetValue<std::string>("manual string", "run pull failed")->Get();
+    Creature* next = TrashAhead(leader, (*route)[step].point, failed);
+    if (!next || next == foe || next->IsInCombat() || IsBoss(next) || IsKillFirst(next) || NeedsCorner(leader, next) ||
+        std::abs(next->GetPositionZ() - leader->GetPositionZ()) > 5.0f)
+        return nullptr;
+    // A damage dealer at range, not the tank holding the one there.
+    Player* who = Puller(leader, next);
+    if (!who || who == tank || who == leader || PlayerbotAI::IsHeal(who) || !InPullRange(who, next))
+        return nullptr;
+    puller = who;
+    return next;
+}
+
+Creature* DungeonRun::KillFirst(Player* bot)
+{
+    LoadKillFirst();
+    Group* group = bot->GetGroup();
+    if (!group || !bot->GetMap()->IsDungeon())
+        return nullptr;
+    Creature* best = nullptr;
+    for (GroupReference* ref = group->GetFirstMember(); ref; ref = ref->next())
+    {
+        Player* member = ref->getSource();
+        if (!member || !member->IsInWorld() || !member->IsAlive() || member->GetMapId() != bot->GetMapId() || member->GetInstanceId() != bot->GetInstanceId())
+            continue;
+        for (HostileReference* hate = member->getHostileRefManager().getFirst(); hate; hate = hate->next())
+        {
+            Unit* unit = hate->getSource() ? hate->getSource()->getOwner() : nullptr;
+            if (!unit || unit->GetTypeId() != TYPEID_UNIT || !unit->IsAlive() ||
+                (!healers.count(unit->GetEntry()) && !killFirst.count({ bot->GetMapId(), unit->GetEntry() })) ||
+                bot->GetDistance(unit) > 40.0f || !unit->IsVisibleForOrDetect(bot, bot, true))
+                continue;
+            // Least health first; about as low (5 points), the nearest.
+            if (!best || unit->GetHealthPercent() < best->GetHealthPercent() - 5.0f ||
+                (unit->GetHealthPercent() < best->GetHealthPercent() + 5.0f && bot->GetDistance(unit) < bot->GetDistance(best)))
+                best = static_cast<Creature*>(unit);
+        }
+    }
+    return best;
+}
+
+Player* DungeonRun::BodyToRaise(Player* bot, uint32& spell, Corpse*& corpse)
+{
+    Group* group = bot->GetGroup();
+    if (!group || !bot->IsAlive() || bot->IsInCombat() || !bot->GetPlayerbotAI())
+        return nullptr;
+    spell = 0;
+    for (char const* name : { "resurrection", "redemption", "ancestral spirit" })
+        if (uint32 const id = bot->GetPlayerbotAI()->GetAiObjectContext()->GetValue<uint32>("spell id", name)->Get())
+        {
+            spell = id;
+            break;
+        }
+    if (!spell)
+        return nullptr;
+    Player* best = nullptr;
+    corpse = nullptr;
+    auto raiser = [](Player* p) { uint8 const c = p->getClass(); return c == CLASS_PRIEST || c == CLASS_PALADIN || c == CLASS_SHAMAN || c == CLASS_DRUID; };
+    for (GroupReference* ref = group->GetFirstMember(); ref; ref = ref->next())
+    {
+        Player* member = ref->getSource();
+        if (!member || member == bot || !member->IsInWorld() || !member->HasFlag(PLAYER_FLAGS, PLAYER_FLAGS_GHOST) || member->isRessurectRequested())
+            continue;
+        Corpse* body = sObjectAccessor.GetCorpseForPlayerGUID(member->GetObjectGuid());
+        if (!body || body->GetMapId() != bot->GetMapId() || body->GetInstanceId() != bot->GetInstanceId() ||
+            body->GetDistance(bot) > BodyRange)
+            continue;
+        if (!best || raiser(member) > raiser(best) || (raiser(member) == raiser(best) && body->GetDistance(bot) < corpse->GetDistance(bot)))
+        {
+            best = member;
+            corpse = body;
+        }
+    }
+    return best;
+}
