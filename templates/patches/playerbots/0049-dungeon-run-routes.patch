+    // escort's own state, not the leader's last escort step: a leader off
+    // it a moment sent its members back along the route (dev, 2026-11-22).
+    if (DungeonRun::EscortFollow(bot, leader))
+        return bot->GetDistance(leader) > DungeonRun::CloseUpRange;
+    // On a route: its own next step, after its leader.
+    DungeonRun::RouteStep const* next = nullptr;
+    if (DungeonRun::MemberStep(bot, leader, next))
+        return true;
+    if (DungeonRun::OnWalkedRoute(leader))
+        return false;
+    return bot->GetDistance(leader) > DungeonRun::RunFollowRange;
