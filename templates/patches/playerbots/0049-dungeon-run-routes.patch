+bool GroupQuests::CanEnter(Player* bot, Quest const* quest)
+{
+    AreaTableEntry const* area = quest && quest->GetZoneOrSort() > 0 ? GetAreaEntryByAreaID(quest->GetZoneOrSort()) : nullptr;
+    MapEntry const* dungeon = area ? sMapStore.LookupEntry(area->mapid) : nullptr;
+    if (!dungeon || !dungeon->IsDungeon())
+        return true;
+    // Its wing's level where known, else its dungeon's recommended minimum.
+    auto wing = questWing.find(quest->GetQuestId());
+    uint32 const wingLevel = wing != questWing.end() ? WingMinLevel(wing->second) : 0;
+    if (wingLevel)
+    {
+        if (bot->GetLevel() < wingLevel)
+            return false;
+    }
+    else
+    {
+        // A dungeon with wings, the quest's wing not known: its lowest
+        // wing's level - else the instance's recommended minimum.
+        uint32 lowest = 0;
+        for (uint32 w = DungeonRun::WING_LOWER_SPIRE; w <= DungeonRun::WING_MARA_INNER; ++w)
+            if (WingMinLevel(w) && DungeonRun::WingMapId(w) == dungeon->MapID && (!lowest || WingMinLevel(w) < lowest))
+                lowest = WingMinLevel(w);
+        InstanceTemplate const* instance = ObjectMgr::GetInstanceTemplate(dungeon->MapID);
+        uint32 const level = lowest ? lowest : instance ? instance->levelMin : 0;
+        if (bot->GetLevel() < level)
+            return false;
+    }
+    bool anyWay = false;
+    for (uint32 i = 0; i < sAreaTriggerStore.GetNumRows(); ++i)
+    {
+        AreaTriggerEntry const* entry = sAreaTriggerStore.LookupEntry(i);
+        AreaTrigger const* way = entry ? sObjectMgr.GetAreaTrigger(entry->id) : nullptr;
+        if (!way || way->target_mapId != dungeon->MapID || entry->mapid == dungeon->MapID)
+            continue;
+        anyWay = true;
+        if (bot->GetLevel() < way->requiredLevel)
+            continue;
+        if (way->requiredItem && !bot->HasItemCount(way->requiredItem, 1, true))
+            continue;
+        if (way->requiredItem2 && !bot->HasItemCount(way->requiredItem2, 1, true))
+            continue;
+        if (way->requiredQuest && !bot->GetQuestRewardStatus(way->requiredQuest))
+            continue;
+        return true;
+    }
+    return !anyWay;
+}
