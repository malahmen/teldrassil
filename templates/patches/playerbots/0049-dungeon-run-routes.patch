+bool RunFollowTrigger::IsActive()
+{
+    if (ai->IsRealPlayer() || bot->IsInCombat() || !bot->IsAlive() || !bot->GetGroup() || bot->GetGroup()->IsLeader(bot->GetObjectGuid()))
+        return false;
+    if (bot->IsSitState())
+        return false;
+    Player* leader = nullptr;
+    if (DungeonRun::Active(bot) && bot->GetMap()->IsDungeon())
+        leader = DungeonRun::Leader(bot);
+    else if (DungeonRun::WalkingIn(bot) || DungeonRun::WayInLeft(bot))
+        leader = sObjectMgr.GetPlayer(bot->GetGroup()->GetLeaderGuid());
+    // Its leader inside, it outside: its own way in, by its points.
+    if (leader && leader->GetMap()->IsDungeon() && !bot->GetMap()->IsDungeon())
+    {
+        DungeonRun::RouteStep const* next = nullptr;
+        return DungeonRun::MemberStep(bot, leader, next);
+    }
+    if (!leader || leader->GetMapId() != bot->GetMapId())
+        return false;
+    // Its leader about to pull: the group closes up to it.
+    if (leader->GetPlayerbotAI() && time(nullptr) - leader->GetPlayerbotAI()->GetAiObjectContext()->GetValue<time_t>("manual time", "run close up")->Get() <= 3 &&
