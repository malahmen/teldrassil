+bool DungeonRun::Holder(Player* member)
+{
+    if (!member->GetPlayerbotAI() || !member->GetGroup() || member->GetGroup()->IsLeader(member->GetObjectGuid()))
+        return false;
+    return PlayerbotAI::IsHeal(member) || member->GetPlayerbotAI()->IsRanged(member);
+}
+
+bool DungeonRun::HoldSpot(Player* member, WorldPosition& spot)
+{
+    if (!member->IsInCombat() || !Holder(member))
+        return false;
+    bool hold = false, hasTank = false;
+    WorldPosition tank;
+    if (!FightLeg(member, hold, tank, hasTank) || !hold)
+        return false;
+    AiObjectContext* context = member->GetPlayerbotAI()->GetAiObjectContext();
+    time_t const started = context->GetValue<time_t>("combat start time")->Get();
+    // Set as the fight starts: where it stands - the healer within reach of
+    // a tank spot.
+    if (context->GetValue<time_t>("manual time", "hold since")->Get() != started)
+    {
+        WorldPosition at(member);
+        WorldPosition marked;
+        // The puller: back where it pulled from, not where the pull took it.
+        if (time(nullptr) - context->GetValue<time_t>("manual time", "hold from since")->Get() <= 2 * PullTime)
+            at = WorldPosition(context->GetValue<std::string>("manual string", "hold from")->Get());
+        // The ranged spot marked: every ranged member's, its healer's too
+        // (owner, 2026-11-20).
+        else if (RangedSpot(member, marked))
+            at = marked;
+        else if (hasTank && PlayerbotAI::IsHeal(member) && at.distance(tank) > HealReach)
+        {
+            float const part = (HealReach - 5.0f) / at.distance(tank);
+            float x = tank.getX() + (at.getX() - tank.getX()) * part;
+            float y = tank.getY() + (at.getY() - tank.getY()) * part;
+            float z = tank.getZ();
+            member->UpdateAllowedPositionZ(x, y, z);
+            at = WorldPosition(tank.getMapId(), x, y, z);
+        }
+        context->GetValue<time_t>("manual time", "hold since")->Set(started);
+        context->GetValue<std::string>("manual string", "hold spot")->Set(at.to_string());
+    }
+    spot = WorldPosition(context->GetValue<std::string>("manual string", "hold spot")->Get());
+    return spot.getMapId() == member->GetMapId();
+}
+
+Player* DungeonRun::HoldingHealer(Player* member, WorldPosition& spot)
+{
+    Group* group = member->GetGroup();
+    for (GroupReference* ref = group ? group->GetFirstMember() : nullptr; ref; ref = ref->next())
+        if (Player* healer = ref->getSource())
+            if (healer != member && healer->IsInWorld() && healer->IsAlive() && PlayerbotAI::IsHeal(healer) &&
+                healer->GetMapId() == member->GetMapId() && HoldSpot(healer, spot))
+                return healer;
+    return nullptr;
+}
+
+float DungeonRun::LeashOf(Player* member)
+{
+    Player* leader = member->GetGroup() ? sObjectMgr.GetPlayer(member->GetGroup()->GetLeaderGuid()) : nullptr;
+    if (!leader || !leader->GetPlayerbotAI())
+        return 0.0f;
+    int step = 0;
+    std::string key;
+    std::vector<RouteStep> const* route = DungeonRun::LeaderRoute(leader, step, key);
+    if (!route)
+        return 0.0f;
+    float leash = 0.0f;
+    for (int i : { step, step - 1 })
+        if (i >= 0 && i < int(route->size()) && (*route)[i].leash > 0.0f)
+            leash = leash > 0.0f ? std::min(leash, (*route)[i].leash) : (*route)[i].leash;
+    return leash;
+}
