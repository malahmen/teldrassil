+bool RunNextBossAction::Escort()
+{
+    DungeonRun::EscortEvent const* escort = DungeonRun::EscortOf(bot->GetMapId());
+    DungeonRun::EscortState const state = DungeonRun::EscortStateOf(bot);
+    time_t const now = time(nullptr);
+    Creature* starter = GetClosestCreatureWithEntry(bot, escort->starter, 300.0f);
+    // Its starter dead mid-escort: the try failed. Its script resets the event
+    // only as it respawns - two hours for the Disciple of Naralex, a group
+    // waiting all along (dev, 2026-11-22) - so it is respawned now, as a GM
+    // would, for the next try; its last try failed, the escort given up.
+    if (state == DungeonRun::ESCORT_ON && !starter)
+        if (Creature* dead = GetClosestCreatureWithEntry(bot, escort->starter, 300.0f, false, true))
+        {
+            int const tries = AI_VALUE2(int, "manual int", "run escort tries");
+            SET_AI_VALUE2(int, "manual int", "run escort on", 0);
+            SET_AI_VALUE2(time_t, "manual time", "run escort failed", now);
+            sLog.outString("Bot #%d %s:%d <%s>: its escort failed - %s died (try %d of %d)%s", bot->GetGUIDLow(),
+                bot->GetTeam() == ALLIANCE ? "A" : "H", bot->GetLevel(), bot->GetName(), dead->GetName(), tries, DungeonRun::EscortTries,
+                tries < DungeonRun::EscortTries ? " - respawned for the next" : " - given up");
+            if (tries < DungeonRun::EscortTries)
+                dead->Respawn();
+            else
+                SET_AI_VALUE2(int, "manual int", "run escort tries", DungeonRun::EscortTries + 1);
