+void DungeonRun::UnseenAttackers(Player* member)
+{
+    static std::map<uint64, time_t> madeVisible;
+    // Its health and since when, per creature fighting a group: none taken
+    // in UnhurtTime, it is out of the fight - two Deviate Lurkers in the
+    // water by the Wailing Caverns' mouth, one evading below, one on a mage
+    // its spells never hurt, held a group in combat 20 minutes (dev,
+    // 2026-11-22).
+    static std::mutex unhurtLock;
+    static std::map<uint64, std::pair<uint32, time_t>> unhurt;
+    Group* group = member->GetGroup();
+    if (!group || !member->IsInCombat())
+        return;
+    time_t const now = time(nullptr);
+    std::vector<Creature*> unseen;
+    for (HostileReference* ref = member->getHostileRefManager().getFirst(); ref; ref = ref->next())
+    {
+        Unit* unit = ref->getSource() ? ref->getSource()->getOwner() : nullptr;
+        if (!unit || unit->GetTypeId() != TYPEID_UNIT || !unit->IsInWorld() || unit->GetMapId() != member->GetMapId())
+            continue;
+        // Not to be found by its own guid in its map - fighting, but no one
+        // can target it ("select a creature" to a GM's .die, its target
+        // doing nothing; the same Shambler, 2026-11-21): off the map.
+        if (member->GetMap()->GetAnyTypeCreature(unit->GetObjectGuid()) != unit)
+        {
+            Creature* lost = static_cast<Creature*>(unit);
+            sLog.outString("Bot #%d %s:%d <%s>: %s (%u) on it not found by its guid - visibility %u, death state %u, alive %d - taken off the map",
+                member->GetGUIDLow(), member->GetTeam() == ALLIANCE ? "A" : "H", member->GetLevel(), member->GetName(), lost->GetName(),
+                lost->GetDbGuid(), uint32(lost->GetVisibility()), uint32(lost->GetDeathState()), int(lost->IsAlive()));
+            lost->CombatStop(true);
+            lost->AddObjectToRemoveList();
+            return; // its references changed - the rest next time
+        }
+        {
+            Creature* fighting = static_cast<Creature*>(unit);
+            uint64 const key = fighting->GetObjectGuid().GetRawValue();
+            bool stale = false;
+            // Only a fight its group is at - 3 alive within 30 yards of it
+            // (all, if fewer are here): a tank left alone with a Deviate
+            // Guardian, its group gone off, hurt it too little and it was
+            // sent off ten times (dev, 2026-11-23).
+            uint32 inside = 0, by = 0;
+            for (GroupReference* g = group->GetFirstMember(); g; g = g->next())
+                if (Player* other = g->getSource())
+                    if (other->IsInWorld() && other->GetMapId() == fighting->GetMapId() && other->GetInstanceId() == fighting->GetInstanceId())
+                    {
+                        ++inside;
+                        if (other->IsAlive() && other->GetDistance(fighting) <= 30.0f)
+                            ++by;
+                    }
+            bool const present = by >= std::min<uint32>(3, inside);
+            {
+                std::lock_guard<std::mutex> guard(unhurtLock);
+                auto at = unhurt.find(key);
+                if (!present || at == unhurt.end() || fighting->GetHealth() < at->second.first || now - at->second.second > 2 * UnhurtTime)
+                    unhurt[key] = { fighting->GetHealth(), now };
+                else if (now - at->second.second >= UnhurtTime && !IsBoss(fighting))
+                {
+                    stale = true;
+                    unhurt.erase(at);
+                }
+            }
+            if (stale)
+            {
+                sLog.outString("Bot #%d %s:%d <%s>: %s (%u) unhurt %ds in a fight with its group%s - out of it", member->GetGUIDLow(),
+                    member->GetTeam() == ALLIANCE ? "A" : "H", member->GetLevel(), member->GetName(), fighting->GetName(),
+                    fighting->GetDbGuid(), int(UnhurtTime), fighting->GetCombatManager().IsInEvadeMode() ? ", evading" : "");
+                fighting->CombatStop(true);
+                if (fighting->AI())
+                    fighting->AI()->EnterEvadeMode();
+                for (GroupReference* g = group->GetFirstMember(); g; g = g->next())
+                    if (Player* other = g->getSource())
+                        if (other->IsInWorld() && other->GetMapId() == fighting->GetMapId() && other->getAttackers().empty())
+                            other->CombatStopWithPets(true);
+                return; // its references changed - the rest next time
+            }
+        }
+        bool seen = false;
+        for (GroupReference* g = group->GetFirstMember(); g && !seen; g = g->next())
+            if (Player* other = g->getSource())
+                if (other->IsInWorld() && other->GetMapId() == unit->GetMapId() && unit->IsVisibleForOrDetect(other, other, true))
+                    seen = true;
+        if (!seen)
+            unseen.push_back(static_cast<Creature*>(unit));
+    }
+    for (Creature* creature : unseen)
+    {
+        uint64 const guid = creature->GetObjectGuid().GetRawValue();
+        auto const made = madeVisible.find(guid);
+        if (creature->IsAlive() && creature->GetVisibility() != VISIBILITY_ON && made == madeVisible.end())
+        {
+            sLog.outString("Bot #%d %s:%d <%s>: unseen %s (%u) on it - visibility %u, death state %u, alive - made visible", member->GetGUIDLow(),
+                member->GetTeam() == ALLIANCE ? "A" : "H", member->GetLevel(), member->GetName(), creature->GetName(), creature->GetDbGuid(),
+                uint32(creature->GetVisibility()), uint32(creature->GetDeathState()));
+            madeVisible[guid] = now;
+            creature->SetVisibility(VISIBILITY_ON);
+            continue;
+        }
+        if (made != madeVisible.end() && now - made->second < 30)
+            continue;
+        sLog.outString("Bot #%d %s:%d <%s>: unseen %s (%u) on it - visibility %u, death state %u, alive %d - taken off the map", member->GetGUIDLow(),
+            member->GetTeam() == ALLIANCE ? "A" : "H", member->GetLevel(), member->GetName(), creature->GetName(), creature->GetDbGuid(),
+            uint32(creature->GetVisibility()), uint32(creature->GetDeathState()), int(creature->IsAlive()));
+        madeVisible.erase(guid);
+        creature->CombatStop(true);
+        creature->AddObjectToRemoveList();
+    }
+}
