+bool PlayerbotDbStore::HasStoredRows(uint64 guid)
+{
+    std::call_once(storedGuidsLoaded, [this]()
+    {
+        auto results = CharacterDatabase.Query("SELECT DISTINCT `guid` FROM `ai_playerbot_db_store` WHERE `preset` = ''");
+        if (results)
+        {
+            do
+            {
+                storedGuids.insert(results->Fetch()[0].GetUInt64());
+            } while (results->NextRow());
+        }
+    });
+    return storedGuids.count(guid) > 0;
+}
