         static Player* TankOf(Player* member);
+
+        // kalimdor (Kamino 299; the owner's "New Ideas", 2026-11-26): the
+        // run's marks. Its leader, alive or dead, marks the skull on the mob
+        // to kill first - healers, then crowd controllers, summoners, AOE
+        // casters, casters, melee (owner, 2026-11-26: what changes the
+        // group's response before what only adds damage); the least health
+        // (a value, not a percent) first among equals - before a pull (its pack) and through
+        // the fight, and moves it as each dies. Up to 3 crowd controllers of
+        // the group (mage, priest, druid, warlock, hunter) get moon, star and
+        // cross on mobs their spell can hold; their "rti cc" names it, their
+        // "cc" strategy holds it. While one is held its damage dealers use
+        // no AOE. Playerbots' dps and tank targets take the skull first, and
+        // skip held and marked mobs (FindNonCcTargetStrategy); on a run the
+        // tank takes every loose mob back before the skull, and breaks a
+        // held one, the least health first, only when nothing else is left;
+        // with no skull a damage dealer takes the tank's target.
+        enum MarkRole { MARK_HEALER, MARK_CC, MARK_SUMMONER, MARK_AOE, MARK_CASTER, MARK_MELEE };
+        static MarkRole RoleOfMob(Creature* creature);
+        static void UpdateMarks(Player* leader, Creature* pulling = nullptr);
+        static void ClearMarks(Player* leader);
+        static constexpr uint8 IconSkull = 7;
+        static constexpr float PackRange = 12.0f;
+        static constexpr time_t CcGrace = 15;   // a crowd controller's time to hold its mark
+        static constexpr time_t MarksQuiet = 5; // no mob this long: marks cleared
         static constexpr float ByTankRange = 8.0f;
         // Its hold spot in this fight (set as it starts), if it holds now.
         static bool HoldSpot(Player* member, WorldPosition& spot);
diff --git a/playerbot/strategy/values/TankTargetValue.cpp b/playerbot/strategy/values/TankTargetValue.cpp
index 66f2b01..33153cf 100644
--- a/playerbot/strategy/values/TankTargetValue.cpp
+++ b/playerbot/strategy/values/TankTargetValue.cpp
@@ -55,6 +55,29 @@ protected:
 
 ObjectGuid TankTargetValue::Calculate()
 {
+    // kalimdor (Kamino 299): on a run, every loose mob taken back first -
+    // one on someone else - and the skull after; nothing else left, a held
+    // one is broken, the least health first (only the tank or the leader
+    // breaks crowd control).
+    if (DungeonRun::Active(bot))
+    {
+        FindTargetForTankStrategy strategy(ai);
+        Unit* loose = FindTarget(&strategy);
+        if (loose && loose->GetVictim() && loose->GetVictim() != bot)
+            return loose->GetObjectGuid();
