+bool ZoneLevels::AtOrBelow(uint32_t level, const WorldPosition& at)
+{
+    AreaTableEntry const* area = at.GetArea();
+    if (!area)
+        return true;
+
+    uint32_t min = 0, max = 0;
+    uint32_t const zone = area->zone ? area->zone : area->ID;
+    return !Range(zone, min, max) || min <= level;
+}
