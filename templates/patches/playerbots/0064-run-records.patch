+                    (boss->GetMap()->Instanceable() || member->GetDistance(boss) <= 100.0f))
+                    there.push_back(member);
+    }
+    if (there.empty())
+        there.push_back(killer);
+    Player* leader = killer;
+    if (Group* group = killer->GetGroup())
+        if (Player* groupLeader = sObjectMgr.GetPlayer(group->GetLeaderGuid()))
+            leader = groupLeader;
     CharacterDatabase.PExecute("INSERT INTO `kalimdor_boss_kill` (`time`, `map`, `instance`, `boss`, `leader`, `members`) VALUES (%u, %u, %u, %u, %u, %u)",
