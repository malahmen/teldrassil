+}
+
+void DungeonRun::RecordRunStart(Player* leader, char const* dungeon, uint32 bosses)
+{
+    Group* group = leader->GetGroup();
+    std::string name = dungeon;
+    CharacterDatabase.escape_string(name);
+    CharacterDatabase.PExecute("INSERT INTO `kalimdor_run` (`started`, `map`, `instance`, `dungeon`, `leader`, `faction`, `members`, `bosses`)"
+        " VALUES (%u, %u, %u, '%s', %u, '%s', %u, %u)", uint32(time(nullptr)), leader->GetMapId(), leader->GetInstanceId(), name.c_str(),
+        leader->GetGUIDLow(), leader->GetTeam() == ALLIANCE ? "A" : "H", group ? group->GetMembersCount() : 1, bosses);
+}
+
+void DungeonRun::RecordRunEnd(Player* leader, char const* dungeon, bool cleared, int wipes, uint32 bossesLeft)
+{
+    // Once per copy: its leader's last update of the run may come again.
+    static std::mutex lock;
+    static std::set<std::pair<uint32, uint32>> ended;
+    {
+        std::lock_guard<std::mutex> guard(lock);
+        if (!ended.insert({ leader->GetMapId(), leader->GetInstanceId() }).second)
+            return;
+    }
+    std::string name = dungeon;
+    CharacterDatabase.escape_string(name);
+    CharacterDatabase.PExecute("UPDATE `kalimdor_run` SET `ended` = %u, `result` = %u, `wipes` = %u, `bosses_left` = %u"
+        " WHERE `map` = %u AND `instance` = %u AND `result` = 0", uint32(time(nullptr)), cleared ? 1 : 2, uint32(std::max(0, wipes)), bossesLeft,
+        leader->GetMapId(), leader->GetInstanceId());
+    // Its members' totals: those in the copy with it at the end.
+    if (Group* group = leader->GetGroup())
+        for (GroupReference* ref = group->GetFirstMember(); ref; ref = ref->next())
+            if (Player* member = ref->getSource())
+                if (member->GetMapId() == leader->GetMapId() && member->GetInstanceId() == leader->GetInstanceId())
+                    CharacterDatabase.PExecute("INSERT INTO `kalimdor_run_total` (`guid`, `map`, `dungeon`, `cleared`, `given_up`) VALUES (%u, %u, '%s', %u, %u)"
+                        " ON DUPLICATE KEY UPDATE `cleared` = `cleared` + %u, `given_up` = `given_up` + %u", member->GetGUIDLow(), leader->GetMapId(),
+                        name.c_str(), cleared ? 1 : 0, cleared ? 0 : 1, cleared ? 1 : 0, cleared ? 0 : 1);
 }
 
