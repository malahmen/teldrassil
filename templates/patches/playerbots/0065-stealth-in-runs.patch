+// Declared by the rogue's and the druid's triggers (RogueTriggers.h).
+bool ai::NoStealthOnRun(Player* bot)
+{
+    return bot && bot->GetPlayerbotAI() && bot->GetGroup() && (DungeonRun::Active(bot) || DungeonRun::WalkingIn(bot));
