+
+namespace
+{
+    std::mutex runsLock;
+    std::map<uint32, DungeonRun::RunRecord> runs; // group id -> its run
+}
+
+bool DungeonRun::RunRecordOf(Player* bot, RunRecord& record)
+{
+    Group* group = bot->GetGroup();
+    if (!group)
+        return false;
+    std::lock_guard<std::mutex> guard(runsLock);
+    auto const at = runs.find(group->GetId());
+    if (at == runs.end() || at->second.instance != int(bot->GetInstanceId()))
+        return false;
+    record = at->second;
+    return true;
+}
+
+void DungeonRun::KeepRunRecord(Player* leader)
+{
+    Group* group = leader->GetGroup();
+    if (!group)
+        return;
+    AiObjectContext* context = leader->GetPlayerbotAI()->GetAiObjectContext();
+    std::lock_guard<std::mutex> guard(runsLock);
+    RunRecord& record = runs[group->GetId()];
+    if (record.instance != int(leader->GetInstanceId()))
+        record = RunRecord{ int(leader->GetInstanceId()) };
+    record.step = context->GetValue<int>("manual int", "run step")->Get();
+    record.best = context->GetValue<int>("manual int", "run best")->Get();
+    record.escortTries = context->GetValue<int>("manual int", "run escort tries")->Get();
+}
+
+int DungeonRun::NoteWipe(Player* member)
+{
+    Group* group = member->GetGroup();
+    if (!group || !member->IsInWorld())
+        return 0;
+    uint32 here = 0, dead = 0;
+    for (GroupReference* ref = group->GetFirstMember(); ref; ref = ref->next())
+        if (Player* other = ref->getSource())
+            if (other->IsInWorld() && other->GetMapId() == member->GetMapId() && other->GetInstanceId() == member->GetInstanceId())
+            {
+                ++here;
+                dead += !other->IsAlive();
+            }
+    bool const wiped = here && dead == here;
+    std::lock_guard<std::mutex> guard(runsLock);
+    RunRecord& record = runs[group->GetId()];
+    if (record.instance != int(member->GetInstanceId()))
+        record = RunRecord{ int(member->GetInstanceId()) };
+    if (wiped && !record.wiped)
+    {
+        ++record.wipes;
+        sLog.outString("Bot #%d %s:%d <%s>: wipe %d in its run (%u dead)", member->GetGUIDLow(), member->GetTeam() == ALLIANCE ? "A" : "H",
+            member->GetLevel(), member->GetName(), record.wipes, here);
+    }
+    record.wiped = wiped;
+    return record.wipes;
+}
+
+void DungeonRun::ForgetRun(Player* bot)
+{
+    if (Group* group = bot->GetGroup())
+    {
+        std::lock_guard<std::mutex> guard(runsLock);
+        runs.erase(group->GetId());
+    }
+}
