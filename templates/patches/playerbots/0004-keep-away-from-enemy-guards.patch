diff --git a/playerbot/strategy/actions/MoveAwayFromEnemyGuardAction.cpp b/playerbot/strategy/actions/MoveAwayFromEnemyGuardAction.cpp
new file mode 100644
index 0000000..45e7f0a
--- /dev/null
+++ b/playerbot/strategy/actions/MoveAwayFromEnemyGuardAction.cpp
@@ -0,0 +1,81 @@
+#include "playerbot/playerbot.h"
+#include "MoveAwayFromEnemyGuardAction.h"
+#include "playerbot/strategy/values/EnemyGuards.h"
+
+using namespace ai;
+
+bool MoveAwayFromEnemyGuardAction::isPossible()
+{
+    return MovementAction::isPossible() && ai->CanMove();
+}
+
+bool MoveAwayFromEnemyGuardAction::Execute(Event& event)
+{
+    std::list<Creature*> guards = EnemyGuards::Near(bot, 80.0f);
+
+    Creature* nearest = nullptr;
+    float nearestDistance = 0.0f;
+    for (Creature* guard : guards)
+    {
+        float const distance = bot->GetDistance(guard);
+        if (distance < EnemyGuards::Reach(guard, bot) && (!nearest || distance < nearestDistance))
+        {
+            nearest = guard;
+            nearestDistance = distance;
+        }
+    }
+
+    if (!nearest)
+        return false;
+
+    // Points around the nearest guard, just outside its reach, starting
+    // straight away from it and widening left and right (as the dungeon
+    // actions' MoveAwayFromCreature does). A point must be out of every
+    // guard's reach, in line of sight and reachable on foot.
+    WorldPosition const botPosition(bot);
+    WorldPosition const guardPosition(nearest);
+    float const distance = EnemyGuards::Reach(nearest, bot) + 5.0f;
+    float angleLeft = guardPosition.getAngleTo(botPosition);
+    float angleRight = angleLeft;
+    uint8 const halfAttempts = 10;
+    float const angleIncrement = float(M_PI) / halfAttempts;
+
+    for (uint8 i = 0; i < halfAttempts; ++i)
+    {
+        for (float angle : { angleLeft, angleRight })
+        {
+            WorldPosition point = guardPosition + WorldPosition(0, distance * cos(angle), distance * sin(angle), 1.0f);
+            point.setZ(point.getHeight());
+
+            bool covered = false;
+            for (Creature* guard : guards)
+            {
+                if (guard->GetDistance(point.getX(), point.getY(), point.getZ()) < EnemyGuards::Reach(guard, bot))
+                {
+                    covered = true;
+                    break;
+                }
+            }
+            if (covered)
+                continue;
+
+            if (!bot->IsWithinLOS(point.getX(), point.getY(), point.getZ() + bot->GetCollisionHeight()))
+                continue;
+
+            if (!botPosition.canPathTo(point, bot))
+                continue;
+
+            if (MoveTo(bot->GetMapId(), point.getX(), point.getY(), point.getZ(), false, IsReaction(), false, true))
+            {
+                if (!IsReaction())
+                    WaitForReach(point.distance(botPosition));
+                return true;
+            }
+        }
+
+        angleLeft += angleIncrement;
+        angleRight -= angleIncrement;
+    }
+
+    return false;
+}
