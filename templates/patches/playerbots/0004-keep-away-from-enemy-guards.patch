diff --git a/playerbot/strategy/values/EnemyGuards.cpp b/playerbot/strategy/values/EnemyGuards.cpp
new file mode 100644
index 0000000..0b23e7d
--- /dev/null
+++ b/playerbot/strategy/values/EnemyGuards.cpp
@@ -0,0 +1,79 @@
+#include "playerbot/playerbot.h"
+#include "EnemyGuards.h"
+#include "Grids/GridNotifiers.h"
+#include "Grids/GridNotifiersImpl.h"
+#include "Grids/CellImpl.h"
+
+using namespace ai;
+
+bool EnemyGuards::IsDangerous(Creature* creature, Player* bot)
+{
+    if (!creature || !bot || !creature->IsAlive() || creature->IsPet())
+        return false;
+
+    if (bot->GetLevel() >= sWorld.getConfig(CONFIG_UINT32_MAX_PLAYER_LEVEL))
+        return false;
+
+    if (creature->GetLevel() < bot->GetLevel() + LevelsAbove)
+        return false;
+
+    FactionTemplateEntry const* faction = creature->GetFactionTemplateEntry();
+    if (!faction)
+        return false;
+
+    bool const aFriend = PlayerbotAI::friendToAlliance(faction);
+    bool const hFriend = PlayerbotAI::friendToHorde(faction);
+    if (aFriend == hFriend)
+        return false;
+
+    return bot->GetTeam() == ALLIANCE ? hFriend : aFriend;
+}
+
+float EnemyGuards::Reach(Creature* creature, Player* bot)
+{
+    bool const weak = bot->HasAura(ResurrectionSickness) || bot->GetHealthPercent() < 50.0f;
+    return creature->GetAttackDistance(bot) + (weak ? WeakMargin : Margin);
+}
+
+std::list<Creature*> EnemyGuards::Near(Player* bot, float range)
+{
+    std::list<Unit*> units;
+    MaNGOS::AnyUnitInObjectRangeCheck check(bot, range);
+    MaNGOS::UnitListSearcher<MaNGOS::AnyUnitInObjectRangeCheck> searcher(units, check);
+    Cell::VisitAllObjects(bot, searcher, range);
+
+    std::list<Creature*> guards;
+    for (Unit* unit : units)
+    {
+        if (unit->GetTypeId() != TYPEID_UNIT)
+            continue;
+
+        Creature* creature = (Creature*)unit;
+        if (IsDangerous(creature, bot))
+            guards.push_back(creature);
+    }
+
+    return guards;
+}
+
+bool EnemyGuards::Covers(const std::list<Creature*>& guards, float x, float y, float z, Player* bot)
+{
+    for (Creature* guard : guards)
+    {
+        if (guard->GetDistance(x, y, z) < Reach(guard, bot))
+            return true;
+    }
+
+    return false;
+}
+
+bool EnemyGuards::Covers(const std::list<Creature*>& guards, Unit* unit, Player* bot)
+{
+    for (Creature* guard : guards)
+    {
+        if (guard->GetDistance(unit) < Reach(guard, bot))
+            return true;
+    }
+
+    return false;
+}
diff --git a/playerbot/strategy/values/EnemyGuards.h b/playerbot/strategy/values/EnemyGuards.h
new file mode 100644
index 0000000..298f12b
--- /dev/null
+++ b/playerbot/strategy/values/EnemyGuards.h
@@ -0,0 +1,45 @@
+#pragma once
+
+#include <list>
+
+class Creature;
+class Player;
+class Unit;
+
+namespace ai
+{
+    // kalimdor: the other faction's guards and NPCs, when they are well above a
+    // bot's level (Kamino 210). Bots roam freely, enemy territory included;
+    // what they must not do below the level cap is walk into, or fight next
+    // to, guards they cannot survive. One definition for the trigger that
+    // keeps them away, the action that moves them, and the grind target
+    // choice that skips mobs standing under such guards.
+    class EnemyGuards
+    {
+    public:
+        // At least this many levels above the bot.
+        static constexpr unsigned int LevelsAbove = 5;
+        // Yards kept beyond the guard's aggro range...
+        static constexpr float Margin = 10.0f;
+        // ...and while the bot is weakened - resurrection sickness, or below
+        // half health. A bot the spirit healer revives in a hostile graveyard
+        // (Razor Hill's lies inside its grunts' patrol) came back weak and was
+        // caught by a roaming guard before the normal margin moved it: weak,
+        // it leaves for safety at once, before it rests (owner, 2026-10-30).
+        static constexpr float WeakMargin = 40.0f;
+        static constexpr unsigned int ResurrectionSickness = 15007;
+
+        // Friendly to exactly one faction - the bot's enemy - alive, not a
+        // pet, LevelsAbove or more over the bot, and the bot below the cap.
+        static bool IsDangerous(Creature* creature, Player* bot);
+        // How far the bot keeps from it: its aggro range on the bot + Margin,
+        // or + WeakMargin while the bot is weakened.
+        static float Reach(Creature* creature, Player* bot);
+        // The dangerous ones within range of the bot.
+        static std::list<Creature*> Near(Player* bot, float range);
+        // Whether a unit stands within the reach of any of them.
+        static bool Covers(const std::list<Creature*>& guards, Unit* unit, Player* bot);
+        // Whether a point does.
+        static bool Covers(const std::list<Creature*>& guards, float x, float y, float z, Player* bot);
+    };
+}
