+#pragma once
+#include "MovementActions.h"
+
+namespace ai
+{
+    // kalimdor: step out of the reach of the other faction's guards when they
+    // are well above the bot's level (Kamino 210; values/EnemyGuards.h). Out of
+    // combat it keeps a roaming bot away; in combat it gets one out when such
+    // a guard has aggroed.
+    class MoveAwayFromEnemyGuardAction : public MovementAction
+    {
+    public:
+        MoveAwayFromEnemyGuardAction(PlayerbotAI* ai) : MovementAction(ai, "move away from enemy guard") {}
+        bool Execute(Event& event) override;
+        bool isPossible() override;
+
+#ifdef GenerateBotHelp
+        virtual std::string GetHelpName() { return "move away from enemy guard"; }
+        virtual std::string GetHelpDescription()
+        {
+            return "This action moves the bot out of the reach of the other faction's guards\n"
+                   "and NPCs that are well above its level, while it is below the level cap.";
+        }
+        virtual std::vector<std::string> GetUsedActions() { return {}; }
+        virtual std::vector<std::string> GetUsedValues() { return {}; }
+#endif
+    };
+}
