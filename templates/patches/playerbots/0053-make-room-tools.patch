+namespace
+{
+    // kalimdor: what a bot never parts with to make room - not destroyed
+    // (MakeRoom), not sold (SellForRoom); one list for both (Kamino 295).
+    // Nothing to sell: a hearthstone, a key, a token - two hearthstones went
+    // for linen (dev, 2026-11-22). The profession tools, upstream's list
+    // (ItemUsageValue::IsItemNeededForSkill) and fishing poles: with a vendor
+    // price of a few copper they were the cheapest, so the first to go.
+    bool NeverPartedWith(ItemPrototype const* proto)
+    {
+        if (!proto || !proto->SellPrice || proto->Class == ITEM_CLASS_QUEST || proto->Class == ITEM_CLASS_CONSUMABLE ||
+            proto->Class == ITEM_CLASS_CONTAINER || proto->Class == ITEM_CLASS_PROJECTILE || proto->Class == ITEM_CLASS_QUIVER ||
+            proto->Class == ITEM_CLASS_KEY || proto->StartQuest || proto->Bonding == BIND_QUEST_ITEM || proto->ItemSet ||
+            proto->InventoryType == INVTYPE_TABARD || proto->InventoryType == INVTYPE_BODY ||
+            (proto->Class == ITEM_CLASS_WEAPON && proto->SubClass == ITEM_SUBCLASS_WEAPON_FISHING_POLE))
+            return true;
+        switch (proto->ItemId)
+        {
+            case 2901:  // Mining Pick
+            case 5956:  // Blacksmith Hammer
+            case 6219:  // Arclight Spanner
+            case 7005:  // Skinning Knife
+            case 6218: case 6339: case 11130: case 11145: case 16207:  // runed enchanting rods
+            case 4471:  // Flint and Tinder
+            case 4470:  // Simple Wood
+            case 6256:  // Fishing Pole
+                return true;
+            default:
+                return false;
+        }
+    }
+}
