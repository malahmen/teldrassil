+void Goals::Missed(PlayerbotAI* ai, const std::string& activity)
+{
+    AiObjectContext* context = ai->GetAiObjectContext();
+    time_t const now = time(nullptr);
+
+    int32 const misses = AI_VALUE2(int32, "manual int", "goal misses " + activity) + 1;
+    if (misses == 1)
+        SET_AI_VALUE2(time_t, "manual time", "goal first miss " + activity, now);
+    SET_AI_VALUE2(int32, "manual int", "goal misses " + activity, misses);
+
+    if (misses >= MissesBeforeSkip && now - AI_VALUE2(time_t, "manual time", "goal first miss " + activity) >= MissWindow)
+        NotReachable(ai, activity, "not reachable now (nothing found " + std::to_string(misses) + " times in a row)");
+}
