+    if (activity == "explore")
+        return ExploredAll(ai->GetBot());
+
     return false;
 }
 
@@ -107,6 +145,26 @@ bool GoalOpenValue::Calculate()
     if (activity == "gather" && !Goals::CanGather(bot))
         return false;
 
+    // Exploring waits for class training, and for the bot's quests - unless
+    // exploring is its archetype's first activity, the explorer's (owner,
+    // 2026-11-04; Kamino 255). Waiting is not "not reachable": no cool-down.
+    if (activity == "explore")
+    {
+        if (AI_VALUE2(uint32, "train cost", TRAINER_TYPE_CLASS) > 0)
+            return false;
+
+        std::vector<std::string> const ordered = Archetypes::Ordered(Archetypes::Of(bot), bot->GetLevel());
+        if (ordered.empty() || ordered.front() != "explore")
+        {
+            for (uint8 slot = 0; slot < MAX_QUEST_LOG_SIZE; ++slot)
+            {
+                uint32 const questId = bot->GetQuestSlotQuestId(slot);
+                if (questId && bot->GetQuestStatus(questId) == QUEST_STATUS_INCOMPLETE)
+                    return false;
+            }
+        }
+    }
+
     time_t const now = time(nullptr);
     if (AI_VALUE2(time_t, "manual time", "goal cooldown " + activity) > now)
         return false;
