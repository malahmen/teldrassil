 #include "Archetypes.h"
 #include "playerbot/PlayerbotAIConfig.h"
 #include "World/World.h"
+#include "playerbot/TravelMgr.h"
+
+#include <mutex>
+#include <vector>
 
 using namespace ai;
 
+namespace
+{
+    // The explore flags of every area upstream can send a bot to explore on
+    // the two continents, read once.
+    const std::vector<uint16>& ContinentAreas()
+    {
+        static std::vector<uint16> flags;
+        static std::once_flag built;
+        std::call_once(built, []()
+        {
+            for (auto const& [entry, destinations] : sTravelMgr.GetExploreLocs())
+                for (TravelDestination* destination : destinations)
+                    if (dynamic_cast<ExploreTravelDestination*>(destination))
+                        if (AreaTableEntry const* area = GetAreaEntryByAreaID(destination->GetEntry()))
+                            if ((area->mapid == 0 || area->mapid == 1) && area->exploreFlag != 0xffff)
+                                flags.push_back(area->exploreFlag);
+        });
+        return flags;
+    }
+}
+
+bool Goals::ExploredAll(Player* bot)
+{
+    for (uint16 const flag : ContinentAreas())
+        if (!(bot->GetUInt32Value(PLAYER_EXPLORED_ZONES_1 + flag / 32) & (1u << (flag % 32))))
+            return false;
+    return !ContinentAreas().empty();
+}
