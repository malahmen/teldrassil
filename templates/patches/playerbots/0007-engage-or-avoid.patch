diff --git a/playerbot/strategy/actions/KeepAwayFromEnemyPlayerAction.cpp b/playerbot/strategy/actions/KeepAwayFromEnemyPlayerAction.cpp
new file mode 100644
index 0000000..9291d3f
--- /dev/null
+++ b/playerbot/strategy/actions/KeepAwayFromEnemyPlayerAction.cpp
@@ -0,0 +1,67 @@
+#include "playerbot/playerbot.h"
+#include "KeepAwayFromEnemyPlayerAction.h"
+#include "playerbot/strategy/values/EngageOdds.h"
+#include "playerbot/TravelMgr.h"
+
+using namespace ai;
+
+bool KeepAwayFromEnemyPlayerAction::isPossible()
+{
+    return MovementAction::isPossible() && ai->CanMove();
+}
+
+bool KeepAwayFromEnemyPlayerAction::Execute(Event& event)
+{
+    Player* enemy = EngageOdds::StrongEnemyNear(bot);
+    if (!enemy)
+        return false;
+
+    // Said once per enemy, so the log shows the decisions, not every step.
+    std::string const enemyKey = std::to_string(enemy->GetGUIDLow());
+    if (AI_VALUE2(std::string, "manual string", "kept away from") != enemyKey)
+    {
+        SET_AI_VALUE2(std::string, "manual string", "kept away from", enemyKey);
+        float const enemySide = EngageOdds::PvpEnemySide(bot, enemy);
+        sLog.outString("Bot #%d %s:%d <%s> in %s: keeps away from %s:%d <%s> (sides %.1f against %s)", bot->GetGUIDLow(),
+            bot->GetTeam() == ALLIANCE ? "A" : "H", bot->GetLevel(), bot->GetName(), WorldPosition(bot).getAreaName().c_str(),
+            enemy->GetTeam() == ALLIANCE ? "A" : "H", enemy->GetLevel(), enemy->GetName(), EngageOdds::OwnSide(bot),
+            enemySide < 0.0f ? "its guards" : std::to_string(enemySide).substr(0, std::to_string(enemySide).find('.') + 2).c_str());
+    }
+
+    // Points around the enemy, just outside KeepAwayRange, starting straight
+    // away from it and widening left and right (as the guard keep-away does).
+    // A point must be in line of sight and reachable on foot.
+    WorldPosition const botPosition(bot);
+    WorldPosition const enemyPosition(enemy);
+    float const distance = EngageOdds::KeepAwayRange + 5.0f;
+    float angleLeft = enemyPosition.getAngleTo(botPosition);
+    float angleRight = angleLeft;
+    uint8 const halfAttempts = 10;
+    float const angleIncrement = float(M_PI) / halfAttempts;
+
+    for (uint8 i = 0; i < halfAttempts; ++i)
+    {
+        for (float angle : { angleLeft, angleRight })
+        {
+            WorldPosition point = enemyPosition + WorldPosition(0, distance * cos(angle), distance * sin(angle), 1.0f);
+            point.setZ(point.getHeight());
+
+            if (!bot->IsWithinLOS(point.getX(), point.getY(), point.getZ() + bot->GetCollisionHeight()))
+                continue;
+
+            if (!botPosition.canPathTo(point, bot))
+                continue;
+
+            if (MoveTo(bot->GetMapId(), point.getX(), point.getY(), point.getZ(), false, false, false, true))
+            {
+                WaitForReach(point.distance(botPosition));
+                return true;
+            }
+        }
+
+        angleLeft += angleIncrement;
+        angleRight -= angleIncrement;
+    }
+
+    return false;
+}
