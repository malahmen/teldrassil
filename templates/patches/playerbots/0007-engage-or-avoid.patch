diff --git a/playerbot/strategy/values/EngageOdds.cpp b/playerbot/strategy/values/EngageOdds.cpp
new file mode 100644
index 0000000..3c2f9b1
--- /dev/null
+++ b/playerbot/strategy/values/EngageOdds.cpp
@@ -0,0 +1,172 @@
+#include "playerbot/playerbot.h"
+#include "EngageOdds.h"
+#include "EnemyGuards.h"
+#include "playerbot/ServerFacade.h"
+#include "Grids/GridNotifiers.h"
+#include "Grids/GridNotifiersImpl.h"
+#include "Grids/CellImpl.h"
+
+#include <algorithm>
+#include <cmath>
+
+using namespace ai;
+
+namespace
+{
+    std::list<Unit*> UnitsNear(Unit* center, float range)
+    {
+        std::list<Unit*> units;
+        MaNGOS::AnyUnitInObjectRangeCheck check(center, range);
+        MaNGOS::UnitListSearcher<MaNGOS::AnyUnitInObjectRangeCheck> searcher(units, check);
+        Cell::VisitAllObjects(center, searcher, range);
+        return units;
+    }
+
+    bool InGroupOf(Player* bot, Unit* unit)
+    {
+        Player* player = dynamic_cast<Player*>(unit);
+        if (!player)
+        {
+            // A pet or guardian counts with its owner.
+            Unit* owner = unit->GetOwner();
+            player = owner ? dynamic_cast<Player*>(owner) : nullptr;
+        }
+
+        return player && (player == bot || (bot->GetGroup() && bot->GetGroup() == player->GetGroup()));
+    }
+}
+
+float EngageOdds::Strength(Unit* unit, Player* bot)
+{
+    if (!unit || !sServerFacade.IsAlive(unit))
+        return 0.0f;
+
+    float kind = 1.0f;
+    if (unit->GetObjectGuid().IsPet() || (unit->GetTypeId() == TYPEID_UNIT && unit->GetOwnerGuid().IsPlayer()))
+        kind = 0.3f;
+    else if (unit->GetTypeId() == TYPEID_UNIT)
+    {
+        Creature* creature = (Creature*)unit;
+        if (creature->IsTotem() || creature->IsCritter())
+            return 0.0f;
+
+        switch (creature->GetCreatureInfo()->Rank)
+        {
+            case CREATURE_ELITE_ELITE:     kind = 1.5f; break;
+            case CREATURE_ELITE_RAREELITE: kind = 2.0f; break;
+            case CREATURE_ELITE_WORLDBOSS: kind = 20.0f; break;
+            case CREATURE_ELITE_RARE:      kind = 0.75f; break;
+            default:                       kind = 0.5f; break;
+        }
+    }
+
+    int const levels = std::clamp(int(unit->GetLevel()) - int(bot->GetLevel()), -20, 20);
+    return std::pow(PerLevel, float(levels)) * kind * unit->GetHealthPercent() / 100.0f;
+}
+
+float EngageOdds::OwnSide(Player* bot)
+{
+    float side = Strength(bot, bot) + Strength(bot->GetPet(), bot);
+
+    if (Group* group = bot->GetGroup())
+    {
+        for (GroupReference* ref = group->GetFirstMember(); ref; ref = ref->next())
+        {
+            Player* member = ref->getSource();
+            if (!member || member == bot || member->GetMapId() != bot->GetMapId() || !member->IsWithinDist(bot, Range))
+                continue;
+
+            side += Strength(member, bot) + Strength(member->GetPet(), bot);
+        }
+    }
+
+    return side;
+}
+
+bool EngageOdds::Engaged(Player* bot, Unit* enemy)
+{
+    if (bot->GetVictim() == enemy)
+        return true;
+
+    Unit* victim = enemy->GetVictim();
+    return victim && InGroupOf(bot, victim);
+}
+
+float EngageOdds::PvpEnemySide(Player* bot, Player* enemy)
+{
+    std::list<Creature*> const guards = EnemyGuards::Near(bot, Range + EnemyGuards::WeakMargin);
+    if (EnemyGuards::Covers(guards, enemy, bot))
+        return -1.0f;
+
+    float enemySide = 0.0f;
+    for (Unit* unit : UnitsNear(enemy, Range))
+    {
+        if (InGroupOf(bot, unit) || !sServerFacade.IsHostileTo(unit, bot))
+            continue;
+
+        bool const joins = unit->GetTypeId() == TYPEID_PLAYER || unit->GetOwnerGuid().IsPlayer() ||
+            (unit->GetTypeId() == TYPEID_UNIT && ((Creature*)unit)->IsGuard());
+        if (joins)
+            enemySide += Strength(unit, bot);
+    }
+
+    return enemySide;
+}
+
+bool EngageOdds::FavoursPvp(Player* bot, Player* enemy)
+{
+    float const enemySide = PvpEnemySide(bot, enemy);
+    return enemySide >= 0.0f && OwnSide(bot) >= enemySide * PvpMargin;
+}
+
+bool EngageOdds::WorthPulling(Player* bot, Unit* mob)
+{
+    // The mob, and its pack: hostile mobs near it not already fighting, and
+    // enemy players near enough to join.
+    float enemySide = Strength(mob, bot);
+    for (Unit* unit : UnitsNear(mob, Range))
+    {
+        if (unit == mob || InGroupOf(bot, unit) || !sServerFacade.IsHostileTo(unit, bot))
+            continue;
+
+        if (unit->GetTypeId() == TYPEID_PLAYER)
+            enemySide += Strength(unit, bot);
+        else if (unit->GetTypeId() == TYPEID_UNIT && !unit->IsInCombat() && unit->IsWithinDist(mob, PackRange))
+            enemySide += Strength(unit, bot);
+    }
+
+    return OwnSide(bot) >= enemySide * PullMargin;
+}
+
+Player* EngageOdds::StrongEnemyNear(Player* bot)
+{
+    Player* nearest = nullptr;
+    for (Unit* unit : UnitsNear(bot, KeepAwayRange))
+    {
+        Player* enemy = dynamic_cast<Player*>(unit);
+        if (!enemy || !sServerFacade.IsAlive(enemy) || !enemy->CanAttack(bot) || !sServerFacade.IsHostileTo(enemy, bot))
+            continue;
+
+        if (nearest && bot->GetDistance(enemy) >= bot->GetDistance(nearest))
+            continue;
+
+        if (Engaged(bot, enemy) || FavoursPvp(bot, enemy))
+            continue;
+
+        nearest = enemy;
+    }
+
+    return nearest;
+}
+
+bool EngageOdds::Rested(Player* bot)
+{
+    if (bot->GetHealthPercent() < RestPercent)
+        return false;
+
+    if (bot->GetPowerType() == POWER_MANA && bot->GetMaxPower(POWER_MANA) &&
+        bot->GetPower(POWER_MANA) * 100.0f / bot->GetMaxPower(POWER_MANA) < RestPercent)
+        return false;
+
+    return true;
+}
diff --git a/playerbot/strategy/values/EngageOdds.h b/playerbot/strategy/values/EngageOdds.h
new file mode 100644
index 0000000..09aa16b
--- /dev/null
+++ b/playerbot/strategy/values/EngageOdds.h
@@ -0,0 +1,63 @@
+#pragma once
+
+// kalimdor: whether a fight is worth starting (Kamino 218; owner's rules,
+// 2026-10-30). Nothing weighed a fight before it started: the pvp strategy
+// attacked any reachable enemy player, and grinding pulled any mob within 4
+// levels, pack or not. Now a bot compares the two sides - its own (itself, its
+// group nearby, their pets) against the enemy's (the enemy players near the
+// target, and the guards that would join; or a mob and its pack) - and starts a
+// fight only when the odds favour it. A fight already on is never refused here:
+// fleeing stays with the flee strategy.
+
+class Player;
+class Unit;
+
+namespace ai
+{
+    class EngageOdds
+    {
+    public:
+        // Who counts on each side: within this of the bot (its side) and of
+        // the target (the enemy's).
+        static constexpr float Range = 30.0f;
+        // A mob's pack: hostile mobs this close to it, out of combat, join in.
+        static constexpr float PackRange = 10.0f;
+        // A level's worth: a unit one level above counts this much more.
+        static constexpr float PerLevel = 1.25f;
+        // How much stronger the bot's side has to be to start a fight with
+        // enemy players - "the odds favour it" (owner): an even fight is not
+        // started, a weakened or lower enemy, or a bigger group, is.
+        static constexpr float PvpMargin = 1.2f;
+        // And to pull a mob and its pack: at least even (a normal mob counts
+        // half a player, so two of the bot's level are a fair pull, three not).
+        static constexpr float PullMargin = 1.0f;
+        // An enemy player not worth fighting is kept this far away.
+        static constexpr float KeepAwayRange = 40.0f;
+        // No pull below this much health or mana: the bot rests first (it eats
+        // below 50% health and drinks below 65% mana, UseFoodStrategy).
+        static constexpr float RestPercent = 50.0f;
+
+        // A unit's weight: its health share, its kind (a player 1, a normal
+        // mob 0.5, an elite 1.5, a pet 0.3), and PerLevel per level above
+        // or below the bot.
+        static float Strength(Unit* unit, Player* bot);
+        // The bot, its pet, and its group's members within Range, with theirs.
+        static float OwnSide(Player* bot);
+        // Already fighting: the enemy attacks the bot, its pet or its group,
+        // or the bot attacks it. Such a fight is not weighed.
+        static bool Engaged(Player* bot, Unit* enemy);
+        // The enemy player's side: the enemy players near it, their pets, and
+        // the guards that would join - or -1 under the guards of a town the
+        // bot is no match for (Kamino 210).
+        static float PvpEnemySide(Player* bot, Player* enemy);
+        // Worth starting a fight with this enemy player.
+        static bool FavoursPvp(Player* bot, Player* enemy);
+        // Worth pulling this mob, pack and all.
+        static bool WorthPulling(Player* bot, Unit* mob);
+        // Health and mana enough to start a fight.
+        static bool Rested(Player* bot);
+        // The nearest enemy player within KeepAwayRange that could attack the
+        // bot and is not worth fighting - one to keep away from - or none.
+        static Player* StrongEnemyNear(Player* bot);
+    };
+}
