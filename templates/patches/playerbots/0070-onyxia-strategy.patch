+using namespace ai;
+
+namespace
+{
+    // Her ring's centre and a radius inside the room's wall (her points are
+    // about 45 yd out, over the edge of the floor).
+    constexpr float CentreX = -21.6f;
+    constexpr float CentreY = -214.5f;
+    constexpr float FloorRadius = 38.0f;
+}
+
+bool OnyxiaDeepBreathMoveAction::Execute(Event& event)
+{
+    Creature* onyxia = OnyxiaFight::Find(bot);
+    float fromX, fromY, dirX, dirY, side;
+    if (!onyxia || !OnyxiaFight::Breathing(onyxia, fromX, fromY, dirX, dirY))
+        return false;
+    OnyxiaFight::LaneDistance(bot, fromX, fromY, dirX, dirY, side);
+    // Straight across the lane from where the bot stands on its middle line:
+    // the foot of the bot on that line, then out along its normal.
+    float const along = (bot->GetPositionX() - fromX) * dirX + (bot->GetPositionY() - fromY) * dirY;
+    float footX = fromX + dirX * along, footY = fromY + dirY * along;
+    float const normalX = -dirY * side, normalY = dirX * side;
+    float x = footX + normalX * OnyxiaFight::LaneSafe, y = footY + normalY * OnyxiaFight::LaneSafe;
+    // Off the floor that way: slide along the lane towards the room's centre
+    // until the point is on it.
+    for (int i = 0; i < 8 && std::hypot(x - CentreX, y - CentreY) > FloorRadius; ++i)
+    {
+        footX += (CentreX - footX) * 0.35f;
+        footY += (CentreY - footY) * 0.35f;
+        x = footX + normalX * OnyxiaFight::LaneSafe;
+        y = footY + normalY * OnyxiaFight::LaneSafe;
+    }
+    return MoveTo(bot->GetMapId(), x, y, bot->GetPositionZ(), false, true, false, true);
+}
 
