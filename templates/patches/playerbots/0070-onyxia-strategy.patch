+bool OnyxiaFlankAction::Execute(Event& event)
+{
+    Creature* onyxia = OnyxiaFight::Find(bot);
+    if (!onyxia || OnyxiaFight::InAir(onyxia))
+        return false;
+    // Her side nearer the bot, at right angles to her facing.
+    float const toBot = onyxia->GetAngle(bot) - onyxia->GetOrientation();
+    float const flank = onyxia->GetOrientation() + (std::sin(toBot) >= 0.0f ? M_PI_F / 2.0f : -M_PI_F / 2.0f);
+    bool const melee = !ai->IsRanged(bot) && !ai->IsHeal(bot);
+    float const distance = melee ? onyxia->GetCombatReach() + 2.0f : 25.0f;
+    float const x = onyxia->GetPositionX() + distance * std::cos(flank);
+    float const y = onyxia->GetPositionY() + distance * std::sin(flank);
+    return MoveTo(bot->GetMapId(), x, y, bot->GetPositionZ(), false, true, false, true);
+}
