@@ -1,5 +1,119 @@
-
 #include "playerbot/playerbot.h"
 #include "OnyxiasLairDungeonTriggers.h"
+#include "Grids/GridNotifiers.h"
+#include "Grids/GridNotifiersImpl.h"
+#include "Grids/CellImpl.h"
+
+#include <cmath>
+
+using namespace ai;
+
+namespace
+{
+    // The centre of her ring of 8 points (boss_onyxia.cpp aMoveData: their
+    // mean, about 45 yd from each).
+    constexpr float CentreX = -21.6f;
+    constexpr float CentreY = -214.5f;
+
+    bool IsBreath(uint32 spellId)
+    {
+        switch (spellId)
+        {
+            case 17086: case 18351:     // north to south, south to north
+            case 18576: case 18609:     // east to west, west to east
+            case 18564: case 18584:     // south-east to north-west, and back
+            case 18596: case 18617:     // south-west to north-east, and back
+            case 21131:                 // into the entrance tunnel
+                return true;
+            default:
+                return false;
+        }
+    }
+}
+
+Creature* OnyxiaFight::Find(Player* bot)
+{
+    if (!bot->IsInWorld() || bot->IsBeingTeleported() || bot->GetMapId() != 249)
+        return nullptr;
+    std::list<Unit*> found;
+    MaNGOS::AllCreaturesOfEntryInRangeCheck check(bot, Entry, 150.0f);
+    MaNGOS::UnitListSearcher<MaNGOS::AllCreaturesOfEntryInRangeCheck> searcher(found, check);
+    Cell::VisitAllObjects(bot, searcher, 150.0f);
+    for (Unit* unit : found)
+        if (unit->IsAlive() && unit->IsInCombat())
+            return static_cast<Creature*>(unit);
+    return nullptr;
+}
+
+bool OnyxiaFight::InAir(Creature* onyxia)
+{
+    return onyxia && onyxia->IsHovering();
+}
+
+bool OnyxiaFight::Breathing(Creature* onyxia, float& fromX, float& fromY, float& dirX, float& dirY)
+{
+    Spell* spell = nullptr;
+    for (CurrentSpellTypes type : { CURRENT_GENERIC_SPELL, CURRENT_CHANNELED_SPELL })
+        if (Spell* current = onyxia ? onyxia->GetCurrentSpell(type) : nullptr)
+            if (current->m_spellInfo && IsBreath(current->m_spellInfo->Id))
+                spell = current;
+    if (!spell)
+        return false;
+    fromX = onyxia->GetPositionX();
+    fromY = onyxia->GetPositionY();
+    float dx = CentreX - fromX, dy = CentreY - fromY;
+    float length = std::sqrt(dx * dx + dy * dy);
+    // The tunnel breath, or a breath from near the centre: along her facing.
+    if (spell->m_spellInfo->Id == 21131 || length < 10.0f)
+    {
+        dx = std::cos(onyxia->GetOrientation());
+        dy = std::sin(onyxia->GetOrientation());
+        length = 1.0f;
+    }
+    dirX = dx / length;
+    dirY = dy / length;
+    return true;
+}
+
+float OnyxiaFight::LaneDistance(Player* bot, float fromX, float fromY, float dirX, float dirY, float& side)
+{
+    float const px = bot->GetPositionX() - fromX, py = bot->GetPositionY() - fromY;
+    // The signed distance from the lane's middle line (the cross product).
+    float const cross = dirX * py - dirY * px;
+    side = cross >= 0.0f ? 1.0f : -1.0f;
+    return std::fabs(cross);
+}
+
+bool OnyxiaFight::InFrontOrTail(Player* bot, Creature* onyxia)
+{
+    if (!bot->IsWithinDist(onyxia, 35.0f))
+        return false;
+    // The angle between her facing and the bot, 0 straight ahead, pi behind.
+    float angle = onyxia->GetAngle(bot) - onyxia->GetOrientation();
+    while (angle > M_PI_F)
+        angle -= 2.0f * M_PI_F;
+    while (angle < -M_PI_F)
+        angle += 2.0f * M_PI_F;
+    angle = std::fabs(angle);
+    // Flame Breath and Cleave in front (60 degrees either side); Tail Sweep
+    // behind (45 degrees either side, at the reach her tail has).
+    return angle < M_PI_F / 3.0f || (angle > M_PI_F * 0.75f && bot->IsWithinDist(onyxia, 25.0f));
+}
+
+bool OnyxiaDeepBreathTrigger::IsActive()
+{
+    Creature* onyxia = OnyxiaFight::Find(bot);
+    float fromX, fromY, dirX, dirY, side;
+    if (!onyxia || !bot->IsAlive() || !OnyxiaFight::Breathing(onyxia, fromX, fromY, dirX, dirY))
+        return false;
+    return OnyxiaFight::LaneDistance(bot, fromX, fromY, dirX, dirY, side) < OnyxiaFight::LaneHalfWidth;
+}
 
-using namespace ai;
\ No newline at end of file
+bool OnyxiaFrontOrTailTrigger::IsActive()
+{
+    Creature* onyxia = OnyxiaFight::Find(bot);
+    // Her tank stands in front, facing her away; everyone else on her flanks.
+    if (!onyxia || !bot->IsAlive() || OnyxiaFight::InAir(onyxia) || onyxia->GetVictim() == bot)
+        return false;
+    return OnyxiaFight::InFrontOrTail(bot, onyxia);
+}
