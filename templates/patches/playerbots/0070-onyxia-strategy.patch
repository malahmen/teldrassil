+    namespace OnyxiaFight
+    {
+        static constexpr uint32 Entry = 10184;
+        // Alive, in reach of the bot (the room is ~100 yd across).
+        Creature* Find(Player* bot);
+        bool InAir(Creature* onyxia);
+        // Casting a Deep Breath: the lane it burns, from her through the
+        // room's centre (or along her facing, for the tunnel breath).
+        bool Breathing(Creature* onyxia, float& fromX, float& fromY, float& dirX, float& dirY);
+        // The bot's distance from the lane's middle line, and on which side.
+        float LaneDistance(Player* bot, float fromX, float fromY, float dirX, float dirY, float& side);
+        static constexpr float LaneHalfWidth = 16.0f;
+        static constexpr float LaneSafe = 24.0f;
+        // On the ground: in her front cone (Flame Breath, Cleave) or behind
+        // her (Tail Sweep).
+        bool InFrontOrTail(Player* bot, Creature* onyxia);
+    }
+
+    class OnyxiaDeepBreathTrigger : public Trigger
