new file mode 100644
index 0000000..2575b54
--- /dev/null
+++ b/playerbot/strategy/actions/RethinkQuestTargetAction.cpp
@@ -0,0 +1,15 @@
+#include "playerbot/playerbot.h"
+#include "RethinkQuestTargetAction.h"
+#include "playerbot/TravelMgr.h"
+
+using namespace ai;
+
+bool RethinkQuestTargetAction::Execute(Event& event)
+{
+    // As upstream releases a travel target (PlayerbotAI::ResetStrategies).
+    TravelTarget* target = AI_VALUE(TravelTarget*, "travel target");
+    sTravelMgr.SetNullTravelTarget(target);
+    target->SetStatus(TravelStatus::TRAVEL_STATUS_EXPIRED);
+    target->SetExpireIn(1000);
+    return true;
+}
