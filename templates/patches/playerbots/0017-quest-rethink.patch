diff --git a/playerbot/strategy/triggers/QuestProgressTrigger.cpp b/playerbot/strategy/triggers/QuestProgressTrigger.cpp
new file mode 100644
index 0000000..ebac52a
--- /dev/null
+++ b/playerbot/strategy/triggers/QuestProgressTrigger.cpp
@@ -0,0 +1,34 @@
+#include "playerbot/playerbot.h"
+#include "QuestProgressTrigger.h"
+#include "playerbot/TravelMgr.h"
+
+using namespace ai;
+
+bool QuestProgressTrigger::IsActive()
+{
+    // Progress over all quests in the log: what counted toward their
+    // objectives, a finished one weighing more.
+    int32 progress = 0;
+    for (auto const& [questId, status] : bot->getQuestStatusMap())
+    {
+        if (status.m_rewarded || (status.m_status != QUEST_STATUS_INCOMPLETE && status.m_status != QUEST_STATUS_COMPLETE))
+            continue;
+
+        for (uint32 i = 0; i < QUEST_OBJECTIVES_COUNT; ++i)
+            progress += status.m_creatureOrGOcount[i];
+        for (uint32 i = 0; i < QUEST_ITEM_OBJECTIVES_COUNT; ++i)
+            progress += status.m_itemcount[i];
+        if (status.m_status == QUEST_STATUS_COMPLETE)
+            progress += 1000;
+    }
+
+    int32 const last = AI_VALUE2(int32, "manual int", "quest progress");
+    bool const known = AI_VALUE2(bool, "manual bool", "quest progress known");
+    SET_AI_VALUE2(int32, "manual int", "quest progress", progress);
+    SET_AI_VALUE2(bool, "manual bool", "quest progress known", true);
+    if (!known || progress <= last)
+        return false;
+
+    TravelTarget* target = AI_VALUE(TravelTarget*, "travel target");
+    return target && dynamic_cast<QuestObjectiveTravelDestination*>(target->GetDestination());
+}
diff --git a/playerbot/strategy/triggers/QuestProgressTrigger.h b/playerbot/strategy/triggers/QuestProgressTrigger.h
new file mode 100644
index 0000000..a1d82eb
--- /dev/null
+++ b/playerbot/strategy/triggers/QuestProgressTrigger.h
@@ -0,0 +1,18 @@
+#pragma once
+#include "playerbot/strategy/Trigger.h"
+
+namespace ai
+{
+    // kalimdor: the bot made progress on a quest - a kill, an object or an
+    // item counted - while its travel target is a quest objective (Kamino
+    // 231). The nearest objective may now be another quest's (owner,
+    // 2026-11-01): with quests x and y, after killing an x mob a nearer y mob
+    // goes next. Upstream re-chose only once the objective was done, walking
+    // past other quests' objectives out of sight.
+    class QuestProgressTrigger : public Trigger
+    {
+    public:
+        QuestProgressTrigger(PlayerbotAI* ai) : Trigger(ai, "quest progress", 2) {}
+        virtual bool IsActive() override;
+    };
+}
