+// kalimdor: where a group quest's group goes (GroupQuests::PlaceOf) - kind in
+// the high word: 1 the quest itself, 2 a dungeon or raid (map, wing), 3 a
+// world boss (its entry).
+uint64 GroupQuests::PlaceOf(Quest const* quest)
+{
+    if (!quest)
+        return 0;
+    for (int i = 0; i < QUEST_OBJECTIVES_COUNT; ++i)
+        if (quest->ReqCreatureOrGOId[i] > 0)
+            if (CreatureInfo const* info = ObjectMgr::GetCreatureTemplate(quest->ReqCreatureOrGOId[i]))
+                if (info->Rank == CREATURE_ELITE_WORLDBOSS)
+                    return (uint64(3) << 32) | uint32(quest->ReqCreatureOrGOId[i]);
+    if (quest->GetZoneOrSort() > 0)
+        if (AreaTableEntry const* area = GetAreaEntryByAreaID(quest->GetZoneOrSort()))
+            if (MapEntry const* map = sMapStore.LookupEntry(area->mapid))
+                if (map->IsDungeon())
+                {
+                    // A quest whose wing is not known goes with the others of
+                    // its dungeon whose wing is not known either: its group
+                    // goes by the dungeon's level (CanEnter).
+                    auto const wing = questWing.find(quest->GetQuestId());
+                    uint32 const w = wing != questWing.end() ? wing->second : 0;
+                    return (uint64(2) << 32) | (uint64(area->mapid) << 8) | w;
+                }
+    return (uint64(1) << 32) | quest->GetQuestId();
+}
+
+bool GroupQuests::HasQuestAt(Player* bot, uint64 place, uint32 wanted)
+{
+    // Kind 1 is one quest - the caller asked about it already.
+    if ((place >> 32) == 1)
+        return false;
+    for (uint8 slot = 0; slot < MAX_QUEST_LOG_SIZE; ++slot)
+    {
+        uint32 const questId = bot->GetQuestSlotQuestId(slot);
+        if (!questId || bot->GetQuestStatus(questId) != QUEST_STATUS_INCOMPLETE)
+            continue;
+        Quest const* quest = sObjectMgr.GetQuestTemplate(questId);
+        if (IsGroupQuest(quest) && PlaceOf(quest) == place && WantedSize(quest) == wanted && !QuestFlow::IsGrey(bot, quest) &&
+            !Skipped(bot, questId))
+            return true;
+    }
+    return false;
+}
+
 // The lowest level a wing takes (owner, 2026-11-12: wings are not all the
 // same level - Scarlet Monastery's Graveyard 26, its Cathedral 35).
