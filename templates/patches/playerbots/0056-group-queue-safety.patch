+void GroupQuests::BreakUp(Player* leader)
+{
+    std::lock_guard<std::mutex> guard(queueLock);
+    asking.erase(leader->GetObjectGuid().GetRawValue());
+    breakingUp.insert(leader->GetObjectGuid().GetRawValue());
+}
+
+bool GroupQuests::Queued(Player* bot)
+{
+    AiObjectContext* context = ContextOf(bot);
+    return context->GetValue<int>("manual int", "lfg quest")->Get() > 0 || context->GetValue<int>("manual int", "lfg joined")->Get() > 0 ||
+        context->GetValue<int>("manual int", "group quest focus")->Get() > 0;
+}
+
+// Still the leader's to look for: unfinished, not grey, enterable, and the
+// leader out of any dungeon - else its ask goes, whatever held it (Kamino 292).
+static bool StillWanted(Player* leader, Quest const* quest)
+{
+    return GroupQuests::IsGroupQuest(quest) && leader->GetQuestStatus(quest->GetQuestId()) == QUEST_STATUS_INCOMPLETE &&
+        !QuestFlow::IsGrey(leader, quest) && !leader->GetMap()->IsDungeon() && GroupQuests::CanEnter(leader, quest);
+}
+
+// A group the queue formed, broken up here, on the world's update: its
+// members may be on other maps, and the group is removed and freed as the
+// core does after its own disband (Player::RemoveFromGroup) - from the
+// leader's update it was neither, one leaked group a break-up (Kamino 291).
+// Every member waits RetryTime before it asks again, not the leader only:
+// they asked at once and the same group formed again (Kamino 292).
+static void BreakUpNow(Player* leader)
+{
+    Group* group = leader->GetGroup();
+    if (!group || !group->IsLeader(leader->GetObjectGuid()) || !OnlyRandomBots(group))
+        return;
+    time_t const retry = time(nullptr) + GroupQuests::RetryTime;
+    for (Player* member : MembersOf(leader))
+        if (member->GetPlayerbotAI())
+        {
+            AiObjectContext* context = ContextOf(member);
+            context->GetValue<int>("manual int", "lfg quest")->Set(0);
+            context->GetValue<int>("manual int", "lfg joined")->Set(0);
+            context->GetValue<time_t>("manual time", "lfg since")->Set(0);
+            context->GetValue<bool>("manual bool", "lfg grouped")->Set(false);
+            context->GetValue<time_t>("manual time", "lfg retry")->Set(retry);
+        }
+    sLog.outString("Bot #%d %s:%d <%s>: its group of %u breaks up", leader->GetGUIDLow(), leader->GetTeam() == ALLIANCE ? "A" : "H",
+        leader->GetLevel(), leader->GetName(), group->GetMembersCount());
+    group->Disband(true);
+    sObjectMgr.RemoveGroup(group);
+    delete group;
+}
