+bool RequestNamedTravelTargetAction::isUseful()
+{
+    if (getQualifier() != "trainer class")
+        return RequestTravelTargetAction::isUseful();
+
+    // kalimdor: class training goes first (owner, 2026-11-04; Kamino 254):
+    // as RequestTravelTargetAction::isUseful, but an active travel target does
+    // not hold it back - on the dev server a bot with training waiting wanted
+    // to go 152 times in 10 minutes, every time behind its target.
+    if (bot->InBattleGround() || !ai->AllowActivity(TRAVEL_ACTIVITY))
+        return false;
+    if (AI_VALUE(TravelTarget*, "travel target")->GetStatus() == TravelStatus::TRAVEL_STATUS_PREPARE)
+        return false;
+    if (AI_VALUE2(bool, "no active travel destinations", getQualifier()))
+        return false;
+    // Already on its way to a class trainer: no new request, or each would
+    // restart the trip (dev server: 200-290 requests in 15 minutes, none
+    // arrived).
+    TravelTarget* target = AI_VALUE(TravelTarget*, "travel target");
+    if (target->IsActive() && target->GetDestination())
+    {
+        std::vector<int32> const trainers = AI_VALUE2(std::vector<int32>, "available trainers", TRAINER_TYPE_CLASS);
+        if (std::find(trainers.begin(), trainers.end(), target->GetDestination()->GetEntry()) != trainers.end())
+            return false;
+    }
+    return AI_VALUE(bool, "can move around");
+}
