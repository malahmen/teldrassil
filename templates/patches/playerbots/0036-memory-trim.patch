 #include "playerbot/playerbot.h"
 #include "playerbot/PlayerbotAIConfig.h"
@@ -678,6 +683,38 @@ void RandomPlayerbotMgr::UpdateAIInternal(uint32 elapsed, bool minimal)
     sMemoryMonitor.SampleDiagnostics();
 #endif
 
+    // kalimdor: give freed memory back (Kamino 230). The bots free most of
+    // what they allocate, but glibc keeps it in its per-thread pools: on the
+    // dev server malloc_trim released 1.58 GB of 4.62 - memory the cluster
+    // counted against the limit, and the "growth" that got meksha OOM-killed.
+#ifdef __GLIBC__
+    if (sPlayerbotAIConfig.memoryTrimInterval)
+    {
+        static time_t nextTrim = time(nullptr) + sPlayerbotAIConfig.memoryTrimInterval;
+        if (time(nullptr) >= nextTrim)
+        {
+            nextTrim = time(nullptr) + sPlayerbotAIConfig.memoryTrimInterval;
+            auto residentMb = []()
+            {
+                long pages = 0, resident = 0;
+                if (FILE* f = fopen("/proc/self/statm", "r"))
+                {
+                    if (fscanf(f, "%ld %ld", &pages, &resident) != 2)
+                        resident = 0;
+                    fclose(f);
+                }
+                return resident * (sysconf(_SC_PAGESIZE) / 1024) / 1024;
+            };
+            long const before = residentMb();
+            auto const start = std::chrono::steady_clock::now();
+            malloc_trim(0);
+            long const ms = long(std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now() - start).count());
+            long const after = residentMb();
+            sLog.outString("Memory trim: %ld MB -> %ld MB (released %ld MB) in %ld ms", before, after, before - after, ms);
+        }
+    }
+#endif
+
     if (!sPlayerbotAIConfig.randomBotAutologin || !sPlayerbotAIConfig.enabled)
         return;
 
