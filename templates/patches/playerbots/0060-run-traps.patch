+namespace
+{
+    std::set<uint64> resets; // leaders whose group's copies are to be reset (queueLock)
+}
+
+void GroupQuests::ResetLater(Player* leader)
+{
+    std::lock_guard<std::mutex> guard(queueLock);
+    resets.insert(leader->GetObjectGuid().GetRawValue());
+}
+
+bool GroupQuests::Skipped(Player* bot, uint32 questId)
+{
+    std::string const skip = ContextOf(bot)->GetValue<std::string>("manual string", "group quest skip")->Get();
+    std::string const key = std::to_string(questId) + ":";
+    size_t const at = skip.find("," + key);
+    if (at == std::string::npos)
+        return false;
+    return time_t(std::stoll(skip.substr(at + 1 + key.size()))) > time(nullptr);
+}
+
+void GroupQuests::Skip(Player* bot, uint32 questId)
+{
+    // Its other entries still running, this one anew.
+    std::string kept = ",";
+    for (std::string const& entry : split(ContextOf(bot)->GetValue<std::string>("manual string", "group quest skip")->Get(), ','))
+    {
+        size_t const colon = entry.find(':');
+        if (colon == std::string::npos || entry.substr(0, colon) == std::to_string(questId))
+            continue;
+        if (time_t(std::stoll(entry.substr(colon + 1))) > time(nullptr))
+            kept += entry + ",";
+    }
+    kept += std::to_string(questId) + ":" + std::to_string(time(nullptr) + SkipTime) + ",";
+    ContextOf(bot)->GetValue<std::string>("manual string", "group quest skip")->Set(kept);
+}
