diff --git a/playerbot/strategy/actions/MakeBandageAction.cpp b/playerbot/strategy/actions/MakeBandageAction.cpp
new file mode 100644
index 0000000..0e5844a
--- /dev/null
+++ b/playerbot/strategy/actions/MakeBandageAction.cpp
@@ -0,0 +1,89 @@
+#include "playerbot/playerbot.h"
+#include "MakeBandageAction.h"
+#include "playerbot/strategy/values/CraftValues.h"
+#include "playerbot/ServerFacade.h"
+
+using namespace ai;
+
+namespace
+{
+    // How many it can make from the cloth really in its bags: upstream's
+    // "has reagents for" says yes to anything for a bot with the item cheat
+    // (random bots by default), but the craft itself takes real cloth -
+    // seven dev bots tried every 5 minutes with none.
+    uint32 CanMake(Player* bot, SpellEntry const* spell)
+    {
+        uint32 count = 0;
+        bool any = false;
+        for (uint8 i = 0; i < MAX_SPELL_REAGENTS; ++i)
+        {
+            if (spell->ReagentCount[i] <= 0 || !spell->Reagent[i])
+                continue;
+            uint32 const n = bot->GetItemCount(spell->Reagent[i]) / spell->ReagentCount[i];
+            count = any ? std::min(count, n) : n;
+            any = true;
+        }
+        return count;
+    }
+}
+
+uint32 MakeBandageAction::BandageToMake(PlayerbotAI* ai)
+{
+    Player* bot = ai->GetBot();
+    AiObjectContext* context = ai->GetAiObjectContext();
+
+    uint32 best = 0;
+    uint32 bestLevel = 0;
+    bool bestSkillUp = false;
+    for (uint32 spellId : AI_VALUE(std::vector<uint32>, "craft spells"))
+    {
+        uint32 level = 0;
+        SkillLineAbilityMapBounds bounds = sSpellMgr.GetSkillLineAbilityMapBoundsBySpellId(spellId);
+        for (auto it = bounds.first; it != bounds.second; ++it)
+            if (it->second->skillId == SKILL_FIRST_AID)
+                level = std::max<uint32>(1, it->second->max_value);
+        if (!level)
+            continue;
+
+        SpellEntry const* spell = sServerFacade.LookupSpellInfo(spellId);
+        if (!spell || !CanMake(bot, spell))
+            continue;
+
+        // A recipe that still raises the skill first, then the best bandage.
+        bool const skillUp = ShouldCraftSpellValue::SpellGivesSkillUp(spellId, bot);
+        if (!skillUp && !AI_VALUE2(bool, "should craft spell", spellId))
+            continue;
+
+        if (best && (bestSkillUp && !skillUp || bestSkillUp == skillUp && level <= bestLevel))
+            continue;
+
+        best = spellId;
+        bestLevel = level;
+        bestSkillUp = skillUp;
+    }
+    return best;
+}
+
+bool MakeBandageAction::Execute(Event& event)
+{
+    uint32 const spellId = BandageToMake(ai);
+    if (!spellId)
+        return false;
+
+    SpellEntry const* spell = sServerFacade.LookupSpellInfo(spellId);
+    ItemPrototype const* bandage = spell ? ObjectMgr::GetItemPrototype(spell->EffectItemType[0]) : nullptr;
+    if (!bandage)
+        return false;
+
+    ai->StopMoving();
+    uint32 duration = 0;
+    if (!ai->CastSpell(spellId, bot, nullptr, true, &duration))
+        return false;
+
+    sLog.outString("Bot #%d %s:%d <%s>: makes a %s (first aid %u, cloth for %u more)", bot->GetGUIDLow(), bot->GetTeam() == ALLIANCE ? "A" : "H",
+        bot->GetLevel(), bot->GetName(), bandage->Name1, bot->GetSkillValuePure(SKILL_FIRST_AID), CanMake(bot, spell) - 1);
+    // Half a second over the cast: a move the moment it ends would cancel
+    // it (MovementAction interrupts any cast).
+    SetDuration(duration + 500);
+    return true;
+}
diff --git a/playerbot/strategy/actions/MakeBandageAction.h b/playerbot/strategy/actions/MakeBandageAction.h
new file mode 100644
index 0000000..abdcc63
--- /dev/null
+++ b/playerbot/strategy/actions/MakeBandageAction.h
@@ -0,0 +1,28 @@
+#pragma once
+#include "playerbot/strategy/Action.h"
+
+namespace ai
+{
+    // kalimdor: first aid levelled like a profession (owner, 2026-11-04;
+    // Kamino 257). Upstream crafts only in its "rpg craft" strategy, which
+    // no random bot gets (RpgStrategy::OnStrategyAdded): no bot on meksha
+    // ever made a bandage, all 125 with first aid at 1, linen in their bags.
+    // This makes bandages - first aid only, the other professions are 212's -
+    // when the cloth is there and the bandage still raises the skill or is
+    // wanted (upstream "should craft spell"): the best such recipe, one at a
+    // time, at most one a minute (the trigger's interval), so travel is not
+    // stalled - cast here, not through the "castnc" chat command, which
+    // aims at the bot's target and failed every time on dev. Cloth
+    // is kept for it upstream (ItemUsageValue::IsItemNeededForUsefullCraft),
+    // the next ranks trained upstream ("trainer trade" travel, rpg train),
+    // the bandages used upstream ("use bandage", use potions strategy).
+    class MakeBandageAction : public Action
+    {
+    public:
+        MakeBandageAction(PlayerbotAI* ai) : Action(ai, "make bandage") {}
+        virtual bool Execute(Event& event) override;
+
+        // The first aid recipe to make now, or 0.
+        static uint32 BandageToMake(PlayerbotAI* ai);
+    };
+}
