diff --git a/playerbot/strategy/triggers/MakeBandageTrigger.cpp b/playerbot/strategy/triggers/MakeBandageTrigger.cpp
new file mode 100644
index 0000000..d7b10ae
--- /dev/null
+++ b/playerbot/strategy/triggers/MakeBandageTrigger.cpp
@@ -0,0 +1,21 @@
+#include "playerbot/playerbot.h"
+#include "MakeBandageTrigger.h"
+#include "playerbot/strategy/actions/MakeBandageAction.h"
+
+using namespace ai;
+
+bool MakeBandageTrigger::IsActive()
+{
+    if (ai->IsRealPlayer() || !ai->HasSkill(SKILL_FIRST_AID))
+        return false;
+
+    if (bot->IsMounted() || bot->IsTaxiFlying())
+        return false;
+
+    // A bandage needs one free slot; bots' bags run near full (dev: 15 of
+    // 40 had a backpack slot free).
+    if (AI_VALUE(uint8, "bag space") >= 100)
+        return false;
+
+    return MakeBandageAction::BandageToMake(ai) != 0;
+}
