+bool GroupQuests::StandInTank(Player const* bot)
+{
+    std::lock_guard<std::mutex> guard(standInLock);
+    return bot && standIns.count(bot->GetGUIDLow());
+}
+
+bool GroupQuests::CanStandIn(Player const* bot)
+{
+    // A warrior; a druid with its bear form. Not a healer - a group's one.
+    return bot && (bot->getClass() == CLASS_WARRIOR || (bot->getClass() == CLASS_DRUID && bot->HasSpell(5487))) &&
+        !PlayerbotAI::IsHeal(const_cast<Player*>(bot), false);
+}
+
+void GroupQuests::SetStandIn(Player const* bot, bool on)
+{
+    std::lock_guard<std::mutex> guard(standInLock);
+    if (on)
+        standIns.insert(bot->GetGUIDLow());
+    else
+        standIns.erase(bot->GetGUIDLow());
+}
