@@ -261,3 +262,21 @@ void AuctionGoods::BuyTripDone(PlayerbotAI* ai)
 {
     ai->GetAiObjectContext()->GetValue<time_t>("manual time", "ah buy next")->Set(time(nullptr) + BuyTripPause);
 }
+
+uint32 AuctionGoods::MarketPrice(Player* bot, ItemPrototype const* proto, uint32 ownPrice)
+{
+    uint32 lowest = 0;
+    for (AuctionEntry const& auction : sRandomPlayerbotMgr.GetAhPrices(proto->ItemId))
+    {
+        if (auction.owner == bot->GetGUIDLow() || !auction.itemCount || !auction.buyout)
+            continue;
+        uint32 const perItem = auction.buyout / auction.itemCount;
+        if (perItem && (!lowest || perItem < lowest))
+            lowest = perItem;
+    }
+    if (!lowest || lowest > ownPrice)
+        return ownPrice;
+    uint32 const undercut = std::max<uint32>(1, lowest * urand(0, MarketUndercutPercent) / 100);
+    uint32 const price = lowest > undercut ? lowest - undercut : 1;
+    return std::max<uint32>(std::max<uint32>(price, proto->SellPrice), 1);
+}
