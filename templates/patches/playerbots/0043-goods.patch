diff --git a/playerbot/strategy/values/AuctionGoods.cpp b/playerbot/strategy/values/AuctionGoods.cpp
new file mode 100644
index 0000000..7fe56f8
--- /dev/null
+++ b/playerbot/strategy/values/AuctionGoods.cpp
@@ -0,0 +1,263 @@
+#include "playerbot/playerbot.h"
+#include "AuctionGoods.h"
+#include "Archetypes.h"
+#include "playerbot/RandomItemMgr.h"
+#include "playerbot/RandomPlayerbotMgr.h"
+#include "CraftValues.h"
+#include "playerbot/ServerFacade.h"
+
+using namespace ai;
+
+namespace
+{
+    // "item:count,item:count,..." - one saved value, not one per item.
+    std::vector<std::pair<uint32, int>> ReadCounts(PlayerbotAI* ai)
+    {
+        std::vector<std::pair<uint32, int>> counts;
+        std::string const text = ai->GetAiObjectContext()->GetValue<std::string>("manual saved string", "ah unsold")->Get();
+        for (std::string const& entry : split(text, ','))
+        {
+            size_t const colon = entry.find(':');
+            if (colon == std::string::npos)
+                continue;
+            uint32 const item = uint32(atoi(entry.substr(0, colon).c_str()));
+            int const count = atoi(entry.substr(colon + 1).c_str());
+            if (item && count > 0)
+                counts.push_back({ item, count });
+        }
+        return counts;
+    }
+
+    void WriteCounts(PlayerbotAI* ai, std::vector<std::pair<uint32, int>> const& counts)
+    {
+        std::ostringstream out;
+        size_t const first = counts.size() > AuctionGoods::MaxTracked ? counts.size() - AuctionGoods::MaxTracked : 0;
+        for (size_t i = first; i < counts.size(); ++i)
+            out << counts[i].first << ":" << counts[i].second << ",";
+        ai->GetAiObjectContext()->GetValue<std::string>("manual saved string", "ah unsold")->Set(out.str());
+    }
+
+    void SetCount(PlayerbotAI* ai, uint32 itemId, int count)
+    {
+        std::vector<std::pair<uint32, int>> counts = ReadCounts(ai);
+        counts.erase(std::remove_if(counts.begin(), counts.end(), [itemId](auto const& c) { return c.first == itemId; }), counts.end());
+        if (count > 0)
+            counts.push_back({ itemId, count });
+        WriteCounts(ai, counts);
+    }
+}
+
+int AuctionGoods::Unsold(PlayerbotAI* ai, uint32 itemId)
+{
+    for (auto const& [item, count] : ReadCounts(ai))
+        if (item == itemId)
+            return count;
+    return 0;
+}
+
+void AuctionGoods::Returned(PlayerbotAI* ai, uint32 itemId)
+{
+    SetCount(ai, itemId, Unsold(ai, itemId) + 1);
+}
+
+void AuctionGoods::Sold(PlayerbotAI* ai, uint32 itemId)
+{
+    if (Unsold(ai, itemId))
+        SetCount(ai, itemId, 0);
+}
+
+uint32 AuctionGoods::PricePercent(PlayerbotAI* ai, uint32 itemId)
+{
+    if (IsTrader(ai->GetBot()))
+        return 100;
+    int const unsold = std::min(Unsold(ai, itemId), Relists - 1);
+    return 100 - StepPercent * uint32(unsold);
+}
+
+bool AuctionGoods::IsTrader(Player* bot)
+{
+    Archetype const* archetype = Archetypes::Of(bot);
+    return archetype && archetype->name == "trader";
+}
+
+bool AuctionGoods::IsValuable(ItemPrototype const* proto)
+{
+    if (proto->Quality >= ITEM_QUALITY_RARE)
+        return true;
+    // Gear by its quality only: nearly every green is a world drop under 1%
+    // (dev data), and gear below blue goes to a vendor (owner).
+    if (proto->Class == ITEM_CLASS_ARMOR || proto->Class == ITEM_CLASS_WEAPON)
+        return false;
+    float const chance = sRandomItemMgr.GetItemRarity(proto->ItemId);
+    return chance > 0.0f && chance <= RareDropChance;
+}
+
+bool AuctionGoods::IsScarce(uint32 itemId)
+{
+    return sRandomPlayerbotMgr.GetAhPrices(itemId).size() < ScarceListings;
+}
+
+ItemUsage AuctionGoods::Route(PlayerbotAI* ai, ItemPrototype const* proto)
+{
+    Player* bot = ai->GetBot();
+    if (ai->HasActivePlayerMaster() || !sRandomPlayerbotMgr.IsFreeBot(bot) || IsTrader(bot))
+        return ItemUsage::ITEM_USAGE_NONE;
+
+    if (proto->Bonding == BIND_WHEN_PICKED_UP || proto->Bonding == BIND_QUEST_ITEM || proto->Quality == ITEM_QUALITY_POOR)
+        return ItemUsage::ITEM_USAGE_NONE;
+    if (Item* item = ItemUsageValue::CurrentItem(proto, bot))
+        if (item->IsSoulBound())
+            return ItemUsage::ITEM_USAGE_NONE;
+
+    // Not worth listing (upstream's measure): the auction action skips it,
+    // so marked for the auction house it would stay in the bags for good.
+    bool const worthListing = ItemUsageValue::IsMoreProfitableToSellToAHThanToVendor(proto, bot);
+
+    // Valuable: the auction house while few are listed, else the bank -
+    // never a vendor.
+    if (IsValuable(proto))
+        return IsScarce(proto->ItemId) && worthListing ? ItemUsage::ITEM_USAGE_AH : BankOrSell(ai, proto);
+
+    // Gear below blue: a vendor.
+    if ((proto->Class == ITEM_CLASS_ARMOR || proto->Class == ITEM_CLASS_WEAPON) && proto->SellPrice > 0)
+        return ItemUsage::ITEM_USAGE_VENDOR;
+
+    // Materials and recipes: the auction house, after Relists unsold the
+    // bank - never a vendor.
+    if (proto->Class == ITEM_CLASS_TRADE_GOODS || proto->Class == ITEM_CLASS_REAGENT || proto->Class == ITEM_CLASS_RECIPE)
+        return worthListing && Unsold(ai, proto->ItemId) < Relists ? ItemUsage::ITEM_USAGE_AH : BankOrSell(ai, proto);
+
+    return ItemUsage::ITEM_USAGE_NONE;
+}
+
+double AuctionGoods::Value(ItemPrototype const* proto, uint32 count)
+{
+    double unit = ItemUsageValue::GetAHMedianBuyoutPricePerItem(proto);
+    if (!unit)
+        unit = ItemUsageValue::GetItemBaseValue(proto);
+    if (!unit)
+        unit = proto->SellPrice;
+
+    float const chance = sRandomItemMgr.GetItemRarity(proto->ItemId);
+    double const rarity = chance > 0.0f ? std::min(20.0, 1.0 + 10.0 / chance) : 1.0;
+
+    size_t const listed = sRandomPlayerbotMgr.GetAhPrices(proto->ItemId).size();
+    double const availability = listed == 0 ? 2.0 : listed < ScarceListings ? 1.5 : 1.0;
+
+    return unit * std::max<uint32>(1, count) * rarity * availability;
+}
+
+bool AuctionGoods::BankFull(PlayerbotAI* ai)
+{
+    return ai->GetAiObjectContext()->GetValue<uint8>("bank space")->Get() > 80;
+}
+
+Item* AuctionGoods::LeastValuableInBank(PlayerbotAI* ai, double* value)
+{
+    Item* least = nullptr;
+    double leastValue = 0;
+    for (Item* item : ai->GetAiObjectContext()->GetValue<std::list<Item*>>("bank items", "all")->Get())
+    {
+        ItemPrototype const* proto = item ? item->GetProto() : nullptr;
+        if (!proto || IsValuable(proto) || !proto->SellPrice || proto->Class == ITEM_CLASS_CONTAINER || proto->Class == ITEM_CLASS_QUEST)
+            continue;
+        double const v = Value(proto, item->GetCount());
+        if (!least || v < leastValue)
+        {
+            least = item;
+            leastValue = v;
+        }
+    }
+    if (value)
+        *value = leastValue;
+    return least;
+}
+
+namespace
+{
+    // A stack in the bags worth more than the bank's least valuable one, of
+    // a kind that goes to the bank (valuables aside - they wait anyway).
+    bool BetterWaiting(PlayerbotAI* ai, uint32 leastItemId, double leastValue)
+    {
+        for (Item* item : ai->GetAiObjectContext()->GetValue<std::list<Item*>>("inventory items", "inventory")->Get())
+        {
+            ItemPrototype const* proto = item ? item->GetProto() : nullptr;
+            if (!proto || proto->ItemId == leastItemId || AuctionGoods::IsValuable(proto))
+                continue;
+            if (proto->Class != ITEM_CLASS_TRADE_GOODS && proto->Class != ITEM_CLASS_REAGENT && proto->Class != ITEM_CLASS_RECIPE &&
+                proto->Class != ITEM_CLASS_ARMOR && proto->Class != ITEM_CLASS_WEAPON)
+                continue;
+            if (AuctionGoods::Value(proto, item->GetCount()) > leastValue)
+                return true;
+        }
+        return false;
+    }
+}
+
+ItemUsage AuctionGoods::BankOrSell(PlayerbotAI* ai, ItemPrototype const* proto)
+{
+    Player* bot = ai->GetBot();
+    if (ai->HasActivePlayerMaster() || !sRandomPlayerbotMgr.IsFreeBot(bot) || !BankFull(ai) || IsValuable(proto) || !proto->SellPrice)
+        return ItemUsage::ITEM_USAGE_BANK;
+
+    double leastValue = 0;
+    Item* least = LeastValuableInBank(ai, &leastValue);
+    if (!least)
+        return ItemUsage::ITEM_USAGE_BANK;
+
+    if (least->GetProto()->ItemId == proto->ItemId)
+        return BetterWaiting(ai, proto->ItemId, leastValue) ? ItemUsage::ITEM_USAGE_VENDOR : ItemUsage::ITEM_USAGE_BANK;
+
+    Item* item = ItemUsageValue::CurrentItem(proto, bot);
+    return Value(proto, item ? item->GetCount() : 1) <= leastValue ? ItemUsage::ITEM_USAGE_VENDOR : ItemUsage::ITEM_USAGE_BANK;
+}
+
+uint32 AuctionGoods::TraderPrice(ItemPrototype const* proto, uint32 upstreamPrice)
+{
+    uint32 const lowest = ItemUsageValue::GetAHListingLowestBuyoutPricePerItem(proto);
+    uint32 const price = lowest ? lowest * (100 - TraderUndercutPercent) / 100 : upstreamPrice * TraderNoListingPercent / 100;
+    return std::max<uint32>(1, std::min(price, upstreamPrice));
+}
+
+bool AuctionGoods::MailIsCache(PlayerbotAI* ai)
+{
+    return IsTrader(ai->GetBot()) && BankFull(ai) && ai->GetAiObjectContext()->GetValue<uint8>("bag space")->Get() > 80;
+}
+
+bool AuctionGoods::WantsToBuy(PlayerbotAI* ai)
+{
+    Player* bot = ai->GetBot();
+    AiObjectContext* context = ai->GetAiObjectContext();
+    if (ai->HasActivePlayerMaster() || !sRandomPlayerbotMgr.IsFreeBot(bot))
+        return false;
+    if (context->GetValue<time_t>("manual time", "ah buy next")->Get() > time(nullptr))
+        return false;
+
+    for (uint32 spellId : context->GetValue<std::vector<uint32>>("craft spells")->Get())
+    {
+        bool firstAid = false;
+        SkillLineAbilityMapBounds bounds = sSpellMgr.GetSkillLineAbilityMapBoundsBySpellId(spellId);
+        for (auto it = bounds.first; it != bounds.second; ++it)
+            if (it->second->skillId == SKILL_FIRST_AID)
+                firstAid = true;
+        if (!firstAid || !ShouldCraftSpellValue::SpellGivesSkillUp(spellId, bot))
+            continue;
+
+        SpellEntry const* spell = sServerFacade.LookupSpellInfo(spellId);
+        if (!spell)
+            continue;
+        for (uint8 i = 0; i < MAX_SPELL_REAGENTS; ++i)
+        {
+            if (spell->ReagentCount[i] <= 0 || !spell->Reagent[i])
+                continue;
+            if (bot->GetItemCount(spell->Reagent[i]) < uint32(spell->ReagentCount[i]) && !sRandomPlayerbotMgr.GetAhPrices(spell->Reagent[i]).empty())
+                return true;
+        }
+    }
+    return false;
+}
+
+void AuctionGoods::BuyTripDone(PlayerbotAI* ai)
+{
+    ai->GetAiObjectContext()->GetValue<time_t>("manual time", "ah buy next")->Set(time(nullptr) + BuyTripPause);
+}
diff --git a/playerbot/strategy/values/AuctionGoods.h b/playerbot/strategy/values/AuctionGoods.h
new file mode 100644
index 0000000..c0c72fc
--- /dev/null
+++ b/playerbot/strategy/values/AuctionGoods.h
@@ -0,0 +1,78 @@
+#pragma once
+#include "playerbot/strategy/values/ItemUsageValue.h"
+
+namespace ai
+{
+    // kalimdor: a random bot's goods by the owner's rules (2026-11-07; Kamino
+    // 271). Bots listed goods at the auction house, nobody bought, the
+    // auctions expired and came back by mail (dev: 56,012 expired, 403
+    // sold), bags stayed full. Now an unsold item is relisted Relists times,
+    // StepPercent cheaper each; still unsold, materials and recipes go to
+    // the bank, to sell later; gear below blue goes to a vendor; valuable
+    // items go to the auction house only while few are listed (Scarce), else
+    // the bank, never a vendor. Traders are exempt: upstream's ways.
+    // Value (owner): rarity - the drop chance, kalimdor's item rarity table
+    // (sql/0002) - availability at the auction house, its price; the vendor
+    // price least. A full bank (over 80%, upstream's deposit limit) makes
+    // room: a stack bound for it worth no more than the bank's least
+    // valuable goes to a vendor; worth more, that bank stack is withdrawn
+    // and sold instead (valuables never), traders too. Traders price to
+    // sell: under the lowest listing (TraderUndercutPercent), or
+    // TraderNoListingPercent of upstream's price; with a full bank and full
+    // bags they leave item mail in the mailbox. Bots buy what their crafting
+    // lacks - first aid's cloth, the only craft random bots do (Kamino 257):
+    // a trip to the auction house when it is listed, at most every
+    // BuyTripPause.
+    class AuctionGoods
+    {
+    public:
+        static constexpr int Relists = 5;
+        static constexpr uint32 StepPercent = 10;
+        // Fewer listed than this is scarce.
+        static constexpr uint32 ScarceListings = 3;
+        // A drop chance (%) at or below this is a rare drop (materials and
+        // recipes; spawn rarity - Black Lotus, 100% a herb - not yet).
+        static constexpr float RareDropChance = 1.0f;
+        // Items with a count kept at most, the oldest dropped.
+        static constexpr size_t MaxTracked = 100;
+
+        // How often it came back unsold since it last sold.
+        static int Unsold(PlayerbotAI* ai, uint32 itemId);
+        // An expired auction taken from the mail, or a sale.
+        static void Returned(PlayerbotAI* ai, uint32 itemId);
+        static void Sold(PlayerbotAI* ai, uint32 itemId);
+        // The price to list at, in percent of upstream's.
+        static uint32 PricePercent(PlayerbotAI* ai, uint32 itemId);
+
+        static bool IsTrader(Player* bot);
+        static bool IsValuable(ItemPrototype const* proto);
+        static bool IsScarce(uint32 itemId);
+        // The owner's choice for an item upstream would sell, or
+        // ITEM_USAGE_NONE to leave it to upstream.
+        static ItemUsage Route(PlayerbotAI* ai, ItemPrototype const* proto);
+
+        // A stack's worth: its auction price (median buyout, else upstream's
+        // item value; the vendor price last) times its count, times its
+        // rarity (a 1% drop about 11, 10% about 2) and its availability (none
+        // listed 2, fewer than ScarceListings 1.5).
+        static double Value(ItemPrototype const* proto, uint32 count);
+        static bool BankFull(PlayerbotAI* ai);
+        // The bank's least valuable stack, valuables aside, or null.
+        static Item* LeastValuableInBank(PlayerbotAI* ai, double* value);
+        // For an item bound for the bank: the bank, or a vendor when the
+        // bank is full and it is worth no more than the bank's least
+        // valuable stack - or is that stack, with something better waiting.
+        static ItemUsage BankOrSell(PlayerbotAI* ai, ItemPrototype const* proto);
+
+        static constexpr uint32 TraderUndercutPercent = 5;
+        static constexpr uint32 TraderNoListingPercent = 75;
+        static constexpr time_t BuyTripPause = 30 * 60;
+        // A trader's price per item for what upstream would ask.
+        static uint32 TraderPrice(ItemPrototype const* proto, uint32 upstreamPrice);
+        // A trader keeps its item mail in the mailbox (bank and bags full).
+        static bool MailIsCache(PlayerbotAI* ai);
+        // Something its crafting lacks is listed at the auction house.
+        static bool WantsToBuy(PlayerbotAI* ai);
+        static void BuyTripDone(PlayerbotAI* ai);
+    };
+}
