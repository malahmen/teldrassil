+void RandomItemMgr::LoadItemRarity()
+{
+    auto results = WorldDatabase.Query("SELECT `item`, `chance` FROM `kalimdor_item_rarity`");
+    if (!results)
+    {
+        sLog.outString("Item rarity: no kalimdor_item_rarity rows");
+        return;
+    }
+    uint32 count = 0;
+    do
+    {
+        Field* fields = results->Fetch();
+        rarityCache[fields[0].GetUInt32()] = fields[1].GetFloat();
+        ++count;
+    } while (results->NextRow());
+    sLog.outString("Item rarity: %u items", count);
 }
 
