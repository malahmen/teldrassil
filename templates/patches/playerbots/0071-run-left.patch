+void DungeonRun::RunGroupBreaksUp(Player* leader)
+{
+    Group* group = leader->GetGroup();
+    if (!group)
+        return;
+    bool forget = false;
+    {
+        std::lock_guard<std::mutex> guard(openRunsLock);
+        for (auto at = openRuns.begin(); at != openRuns.end(); ++at)
+        {
+            if (at->second.group != group->GetId())
+                continue;
+            // Its members in the copy now, the group still there.
+            for (GroupReference* ref = group->GetFirstMember(); ref; ref = ref->next())
+                if (Player* member = ref->getSource())
+                    if (member->IsInWorld() && member->GetMapId() == at->first.first && member->GetInstanceId() == at->first.second)
+                        at->second.members.insert(member->GetGUIDLow());
+            GiveUpLeftRun(at->first, at->second, WipesOf(at->second.group, at->first.second), "its group broke up");
+            openRuns.erase(at);
+            forget = true;
+            break;
+        }
+    }
+    if (forget)
+    {
+        std::lock_guard<std::mutex> guard(runsLock);
+        runs.erase(group->GetId());
+    }
+}
+
+void DungeonRun::SweepRuns()
+{
+    time_t const now = time(nullptr);
+    std::vector<uint32> forget;
+    {
+        std::lock_guard<std::mutex> guard(openRunsLock);
+        for (auto at = openRuns.begin(); at != openRuns.end();)
+        {
+            std::pair<uint32, uint32> const& copy = at->first;
+            OpenRun& run = at->second;
+            Group* group = run.group ? sObjectMgr.GetGroupById(run.group) : nullptr;
+            char const* why = nullptr;
+            if (!group)
+                why = "its group is gone";
+            else
+            {
+                // One of its group in the copy - alive, dead there, or a
+                // ghost whose corpse lies there (running back).
+                bool there = false;
+                for (GroupReference* ref = group->GetFirstMember(); ref; ref = ref->next())
+                    if (Player* member = ref->getSource())
+                    {
+                        bool inside = member->IsInWorld() && member->GetMapId() == copy.first && member->GetInstanceId() == copy.second;
+                        if (inside)
+                            run.members.insert(member->GetGUIDLow());
+                        else if (!member->IsAlive())
+                            if (Corpse* corpse = member->GetCorpse())
+                                inside = corpse->GetMapId() == copy.first && corpse->GetInstanceId() == copy.second;
+                        there |= inside;
+                    }
+                if (there)
+                    run.seen = now;
+                else if (now - run.seen >= LeftRunTime)
+                    why = "none of its group there for 10 minutes";
+            }
+            if (!why)
+            {
+                ++at;
+                continue;
+            }
+            GiveUpLeftRun(copy, run, WipesOf(run.group, copy.second), why);
+            if (group)
+                forget.push_back(run.group);
+            at = openRuns.erase(at);
+        }
+    }
+    // Its group's record of the run (its step, its wipes) forgotten: back
+    // in the copy, it is a new run.
+    std::lock_guard<std::mutex> guard(runsLock);
+    for (uint32 id : forget)
+        runs.erase(id);
+}
