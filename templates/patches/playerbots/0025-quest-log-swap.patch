+bool QuestFlow::IsGrey(Player* bot, Quest const* quest)
+{
+    // A quest level of 0 or less follows the player's: never grey. Nor are
+    // class and profession quests - they give spells, totems, skills: a
+    // shaman dropped its totem quests, a priest its own (dev server,
+    // 2026-11-04); upstream always does class quests (NeedQuestRewardValue).
+    if (!quest || quest->GetQuestLevel() <= 0 || quest->GetRequiredClasses() || quest->GetRequiredSkill())
+        return false;
+
+    uint32 const level = bot->GetLevel();
+    uint32 const gap = sPlayerbotAIConfig.grayQuestGap;
+    uint32 const grayLevel = gap ? (level > gap ? level - gap : 0) : MaNGOS::XP::GetGrayLevel(level);
+    return uint32(quest->GetQuestLevel()) <= grayLevel;
+}
+
