+bool QuestFlow::IsAttunement(uint32_t questId)
+{
+    // The chains, read once: each attunement quest and every quest before it.
+    static std::set<uint32> chains;
+    static std::once_flag built;
+    std::call_once(built, []()
+    {
+        std::vector<uint32> todo(sPlayerbotAIConfig.randomBotQuestIds.begin(), sPlayerbotAIConfig.randomBotQuestIds.end());
+        while (!todo.empty())
+        {
+            uint32 const id = todo.back();
+            todo.pop_back();
+            Quest const* quest = sObjectMgr.GetQuestTemplate(id);
+            if (!quest || !chains.insert(id).second)
+                continue;
+            if (int32 const prev = quest->GetPrevQuestId())
+                todo.push_back(uint32(prev > 0 ? prev : -prev));
+        }
+    });
+
+    return chains.count(questId);
+}
+
+namespace
+{
+    // The log slot of the weakest quest - the least XP among unfinished ones
+    // that are not attunements - or -1.
+    int WeakestSlot(Player* bot, uint32& weakestXp)
+    {
+        int weakest = -1;
+        for (uint8 slot = 0; slot < MAX_QUEST_LOG_SIZE; ++slot)
+        {
+            uint32 const questId = bot->GetQuestSlotQuestId(slot);
+            Quest const* quest = sObjectMgr.GetQuestTemplate(questId);
+            if (!quest || bot->GetQuestStatus(questId) != QUEST_STATUS_INCOMPLETE || QuestFlow::IsAttunement(questId))
+                continue;
+
+            uint32 const xp = quest->XPValue(bot);
+            if (weakest < 0 || xp < weakestXp)
+            {
+                weakest = slot;
+                weakestXp = xp;
+            }
+        }
+
+        return weakest;
+    }
+
+    bool MaySwap(Player* bot)
+    {
+        if (bot->GetPlayerbotAI()->IsRealPlayer() || bot->SatisfyQuestLog(false))
+            return false;
+
+        const Archetype* archetype = Archetypes::Of(bot);
+        return !(archetype && archetype->grayQuests == Archetype::GrayQuests::AtCap &&
+            bot->GetLevel() >= sWorld.getConfig(CONFIG_UINT32_MAX_PLAYER_LEVEL));
+    }
+}
+
+bool QuestFlow::WorthSwapping(Player* bot, Quest const* offered)
+{
+    if (!MaySwap(bot))
+        return false;
+
+    uint32 weakestXp = 0;
+    return WeakestSlot(bot, weakestXp) >= 0 && offered->XPValue(bot) > weakestXp;
+}
+
+bool QuestFlow::OffersSwap(Player* bot, int32_t giver)
+{
+    if (!MaySwap(bot))
+        return false;
+
+    QuestRelationsMapBounds const bounds = giver > 0 ? sObjectMgr.GetCreatureQuestRelationsMapBounds(giver) : sObjectMgr.GetGOQuestRelationsMapBounds(-giver);
+    for (auto it = bounds.first; it != bounds.second; ++it)
+    {
+        Quest const* quest = sObjectMgr.GetQuestTemplate(it->second);
+        if (quest && quest->IsActive() && bot->GetQuestStatus(it->second) == QUEST_STATUS_NONE && bot->CanSeeStartQuest(quest) &&
+            bot->SatisfyQuestLevel(quest, false) && WorthSwapping(bot, quest))
+            return true;
+    }
+
+    return false;
+}
+
+bool QuestFlow::DropWeakest(Player* bot, Quest const* offered)
+{
+    uint32 weakestXp = 0;
+    int const slot = WeakestSlot(bot, weakestXp);
+    if (slot < 0)
+        return false;
+
+    uint32 const questId = bot->GetQuestSlotQuestId(slot);
+    Quest const* weakest = sObjectMgr.GetQuestTemplate(questId);
+
+    // As DropQuestAction does.
+    bot->SetQuestSlot(slot, 0);
+    bot->TakeQuestSourceItem(questId, false);
+    bot->SetQuestStatus(questId, QUEST_STATUS_NONE);
+    bot->getQuestStatusMap()[questId].m_rewarded = false;
+
+    sLog.outString("Bot #%d %s:%d <%s>: drops quest %s (%u XP) for %s (%u XP) - the log is full", bot->GetGUIDLow(),
+        bot->GetTeam() == ALLIANCE ? "A" : "H", bot->GetLevel(), bot->GetName(), weakest ? weakest->GetTitle().c_str() : "?", weakestXp,
+        offered->GetTitle().c_str(), offered->XPValue(bot));
+    return true;
+}
