+float Archetypes::ChanceFactor(Player* bot, const std::string& activity)
+{
+    const Archetype* archetype = Of(bot);
+    if (!archetype || !archetype->weighted)
+        return 1.0f;
+
+    uint32_t const level = bot->GetLevel();
+    float const weight = Weight(archetype, activity, level);
+    if (weight <= 0.0f)
+        return 1.0f;
+
+    float sum = 0.0f;
+    int count = 0;
+    for (const std::string& named : Ordered(archetype, level))
+    {
+        float const w = Weight(archetype, named, level);
+        if (w > 0.0f)
+        {
+            sum += w;
+            ++count;
+        }
+    }
+
+    return count ? weight / (sum / count) : 1.0f;
+}
+
+bool Archetypes::Roll(Player* bot, const std::string& activity, uint32_t percent)
+{
+    float const chance = std::min(100.0f, percent * ChanceFactor(bot, activity));
+    return urand(1, 100) <= uint32(chance);
+}
