+// kalimdor: what the supplier lists - a material or recipe that drops 1% of
+// the time or less (kalimdor_item_rarity, sql/0002; AuctionGoods::
+// RareDropChance). Not by quality: blue shards come from disenchanting at
+// 17-22%; nor items no loot table holds - crafted, not dropped (dev server,
+// Kamino 273).
+bool AhBot::SupplierItem(ItemPrototype const* proto)
+{
+    if (proto->Class != ITEM_CLASS_TRADE_GOODS && proto->Class != ITEM_CLASS_REAGENT && proto->Class != ITEM_CLASS_RECIPE)
+        return false;
+    float const chance = sRandomItemMgr.GetItemRarity(proto->ItemId);
+    return chance > 0.0f && chance <= ai::AuctionGoods::RareDropChance;
+}
