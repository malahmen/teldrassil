diff --git a/playerbot/strategy/values/BattlegroundSlots.cpp b/playerbot/strategy/values/BattlegroundSlots.cpp
new file mode 100644
index 0000000..8178412
--- /dev/null
+++ b/playerbot/strategy/values/BattlegroundSlots.cpp
@@ -0,0 +1,105 @@
+#include "playerbot/playerbot.h"
+#include "BattlegroundSlots.h"
+#include "Archetypes.h"
+#include "playerbot/RandomPlayerbotMgr.h"
+#include "World/World.h"
+
+#include <algorithm>
+
+using namespace ai;
+
+namespace
+{
+    uint32 taken[2][6] = {};
+    uint32 pvpiWaiting[2][6] = {};
+
+    uint32 Cap(int band, bool pvpi)
+    {
+        switch (band)
+        {
+            case 1: return 10;
+            case 2: return 10;
+            case 3: return 15;
+            case 4: return pvpi ? 15 : 0;
+            case 5: return 40;
+            default: return 0;
+        }
+    }
+}
+
+int BattlegroundSlots::Band(uint32_t level)
+{
+    if (level >= sWorld.getConfig(CONFIG_UINT32_MAX_PLAYER_LEVEL))
+        return 5;
+    if (level < 10)
+        return 0;
+    if (level < 20)
+        return 1;
+    if (level < 30)
+        return 2;
+    if (level < 40)
+        return 3;
+    return 4;
+}
+
+void BattlegroundSlots::Count()
+{
+    uint32 newTaken[2][6] = {}, newWaiting[2][6] = {};
+    for (auto const& [guid, bot] : sRandomPlayerbotMgr.GetAllBots())
+    {
+        if (!bot || !bot->IsInWorld())
+            continue;
+
+        int const side = bot->GetTeam() == ALLIANCE ? 0 : 1;
+        int const band = Band(bot->GetLevel());
+        if (bot->InBattleGround() || bot->InBattleGroundQueue())
+            ++newTaken[side][band];
+        else if (band && IsPvpi(bot))
+            ++newWaiting[side][band];
+    }
+
+    for (int side = 0; side < 2; ++side)
+        for (int band = 0; band < 6; ++band)
+        {
+            taken[side][band] = newTaken[side][band];
+            pvpiWaiting[side][band] = newWaiting[side][band];
+        }
+}
+
+bool BattlegroundSlots::IsPvpi(Player* bot)
+{
+    const Archetype* archetype = Archetypes::Of(bot);
+    return archetype && std::find(archetype->activities.begin(), archetype->activities.end(), "pvpi") != archetype->activities.end();
+}
+
+void BattlegroundSlots::SeenInside(Player* bot)
+{
+    if (PlayerbotAI* ai = bot->GetPlayerbotAI())
+        ai->GetAiObjectContext()->GetValue<time_t>("manual time", "last battleground")->Set(time(nullptr));
+}
+
+bool BattlegroundSlots::MayQueue(Player* bot)
+{
+    bool const pvpi = IsPvpi(bot);
+    int const band = Band(bot->GetLevel());
+    uint32 const cap = Cap(band, pvpi);
+    if (!cap)
+        return false;
+
+    if (!pvpi)
+    {
+        time_t const last = bot->GetPlayerbotAI()->GetAiObjectContext()->GetValue<time_t>("manual time", "last battleground")->Get();
+        if (last && time(nullptr) - last < Cooldown)
+            return false;
+    }
+
+    // Counted in the world thread (Count): its side and band.
+    int const side = bot->GetTeam() == ALLIANCE ? 0 : 1;
+    uint32 const inUse = taken[side][band];
+    // A pvpi bot counted as waiting may be this one.
+    uint32 const waiting = pvpiWaiting[side][band] - (pvpi && pvpiWaiting[side][band] ? 1 : 0);
+
+    if (pvpi)
+        return inUse < cap;
+    return inUse + waiting < cap;
+}
diff --git a/playerbot/strategy/values/BattlegroundSlots.h b/playerbot/strategy/values/BattlegroundSlots.h
new file mode 100644
index 0000000..bf43f58
--- /dev/null
+++ b/playerbot/strategy/values/BattlegroundSlots.h
@@ -0,0 +1,40 @@
+#pragma once
+
+#include <cstdint>
+
+// kalimdor: how many bots may be in battlegrounds, and who goes (owner,
+// 2026-11-03). Per side, counting bots queued or inside, by level band:
+//   10-19: 10   20-29: 10   30-39: 15   40-59: 15, pvpi archetypes only
+//   level cap: 40
+// A bot whose archetype lists pvpi takes a free slot first; any other bot
+// only when the slots left outnumber the pvpi bots of its band and side
+// still waiting, and then not again for 45 minutes after a battleground.
+// pvpi is not a travel goal: every bot still levels and quests, also while
+// it waits in the queue - pvpi bots just go more often. Upstream sent every
+// bot: on the dev server 46 of 101 bots sat in battlegrounds, holding 181 of
+// 429 finished quests unreturned.
+
+class Player;
+
+namespace ai
+{
+    class BattlegroundSlots
+    {
+    public:
+        static constexpr long Cooldown = 45 * 60;
+
+        static bool IsPvpi(Player* bot);
+        // The owner's level band: 1 10-19, 2 20-29, 3 30-39, 4 40-59, 5 the
+        // cap; 0 below 10.
+        static int Band(uint32_t level);
+        // Counted in the world thread (RandomPlayerbotMgr's battleground
+        // check), read by the bots: per side (0 Alliance, 1 Horde) and band,
+        // bots queued or inside, and pvpi bots still out.
+        static void Count();
+        // The bot may queue now.
+        static bool MayQueue(Player* bot);
+        // To be called while the bot is in a battleground: the cool-down runs
+        // from the last time this saw it there.
+        static void SeenInside(Player* bot);
+    };
+}
