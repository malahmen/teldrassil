+bool ZoneLevels::MayPlaceAt(Player* bot, const WorldPosition& at, uint32_t& zone)
+{
+    if (bot->GetLevel() < 20 && at.getMapId() != HomeBinds::HomeMap(bot))
+        return false;
+
+    at.loadMapAndVMap(0);
+    zone = sTerrainMgr.GetZoneId(at.getMapId(), at.getX(), at.getY(), at.getZ());
+    uint32_t min = 0, max = 0;
+    if (!Range(zone, min, max) || bot->GetLevel() < min || bot->GetLevel() > max)
+        return false;
+
+    return !EnemyGuards::IsHostileTerritory(at, bot);
+}
