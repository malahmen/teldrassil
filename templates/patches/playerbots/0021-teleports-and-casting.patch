+bool QuestFlow::HoldsGray(Player* bot)
+{
+    const Archetype* archetype = Archetypes::Of(bot);
+    if (!archetype)
+        return true;
+
+    switch (archetype->grayQuests)
+    {
+        case Archetype::GrayQuests::Keep:  return true;
+        case Archetype::GrayQuests::AtCap: return bot->GetLevel() >= sWorld.getConfig(CONFIG_UINT32_MAX_PLAYER_LEVEL);
+        default:                           return false;
+    }
+}
