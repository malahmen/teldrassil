diff --git a/playerbot/strategy/values/GroupQuests.cpp b/playerbot/strategy/values/GroupQuests.cpp
new file mode 100644
index 0000000..6c4822c
--- /dev/null
+++ b/playerbot/strategy/values/GroupQuests.cpp
@@ -0,0 +1,175 @@
+#include "playerbot/playerbot.h"
+#include "GroupQuests.h"
+#include "QuestFlow.h"
+#include "Maps/Map.h"
+
+#include <algorithm>
+#include <set>
+
+using namespace ai;
+
+namespace
+{
+    // A quest whose kill target is an open-world boss (world-boss rank).
+    bool TargetsWorldBoss(Quest const* quest)
+    {
+        for (int i = 0; i < QUEST_OBJECTIVES_COUNT; ++i)
+            if (quest->ReqCreatureOrGOId[i] > 0)
+                if (CreatureInfo const* info = ObjectMgr::GetCreatureTemplate(quest->ReqCreatureOrGOId[i]))
+                    if (info->Rank == CREATURE_ELITE_WORLDBOSS)
+                        return true;
+        return false;
+    }
+
+    enum Role { Tank, Healer, Damage };
+
+    Role RoleOf(Player* player)
+    {
+        if (PlayerbotAI::IsTank(player, false))
+            return Tank;
+        if (PlayerbotAI::IsHeal(player, false))
+            return Healer;
+        return Damage;
+    }
+
+    struct Limits { uint32 minTanks, maxTanks, minHealers, maxHealers; };
+
+    Limits LimitsFor(uint32 wanted)
+    {
+        if (wanted <= 3)
+            return { 0, wanted, 0, wanted };
+        if (wanted <= 5)
+            return { 1, 1, 1, 1 };
+        if (wanted <= 10)
+            return { 2, 2, 2, 2 };
+        if (wanted <= 20)
+            return { 2, 3, 4, 5 };
+        return { 3, 4, 10, 12 };
+    }
+}
+
+bool GroupQuests::IsGroupQuest(Quest const* quest)
+{
+    return quest && (quest->GetType() == QUEST_TYPE_ELITE || quest->GetType() == QUEST_TYPE_DUNGEON || quest->GetType() == QUEST_TYPE_RAID ||
+        TargetsWorldBoss(quest));
+}
+
+uint32_t GroupQuests::WantedSize(Quest const* quest)
+{
+    // An open-world boss is a raid (owner, 2026-11-06).
+    if (TargetsWorldBoss(quest))
+        return 40;
+
+    // The quest's zone tells the instance: a dungeon 5, a raid its limit.
+    if (quest->GetZoneOrSort() > 0)
+        if (AreaTableEntry const* area = GetAreaEntryByAreaID(quest->GetZoneOrSort()))
+            if (MapEntry const* map = sMapStore.LookupEntry(area->mapid))
+            {
+                if (map->IsRaid())
+                {
+                    InstanceTemplate const* instance = ObjectMgr::GetInstanceTemplate(area->mapid);
+                    return instance && instance->maxPlayers ? instance->maxPlayers : 40;
+                }
+                if (map->IsNonRaidDungeon())
+                    return 5;
+            }
+
+    switch (quest->GetType())
+    {
+        case QUEST_TYPE_RAID: return 40;
+        case QUEST_TYPE_DUNGEON: return 5;
+        default: return 3;
+    }
+}
+
+time_t GroupQuests::WaitFor(uint32_t wanted)
+{
+    return std::max<time_t>(MinWait, WaitPerMember * wanted);
+}
+
+uint32_t GroupQuests::GroupSize(Player* bot)
+{
+    // Invitations still open count: bots invited in the same second pushed
+    // a 3-bot group past 3 (dev server). A group not formed yet is the
+    // leader's pending invite, the leader one of its invitees.
+    if (Group* group = bot->GetGroup())
+        return group->GetMembersCount() + group->GetInviteesCount();
+    Group* pending = bot->GetGroupInvite();
+    if (pending && pending->GetLeaderGuid() == bot->GetObjectGuid())
+        return std::max<uint32_t>(1, pending->GetInviteesCount());
+    return 1;
+}
+
+const char* GroupQuests::RoleName(Player* player)
+{
+    switch (RoleOf(player))
+    {
+        case Tank: return "tank";
+        case Healer: return "healer";
+        default: return "damage";
+    }
+}
+
+bool GroupQuests::RoleFits(Player* announcer, Player* candidate, uint32_t wanted)
+{
+    Limits const limits = LimitsFor(wanted);
+    uint32 counts[3] = { 0, 0, 0 };
+    uint32 total = 0;
+    std::set<uint32> counted;
+    auto count = [&](Player* player)
+    {
+        if (player && counted.insert(player->GetGUIDLow()).second)
+        {
+            ++counts[RoleOf(player)];
+            ++total;
+        }
+    };
+
+    count(announcer);
+    if (Group* group = announcer->GetGroup())
+        for (auto const& slot : group->GetMemberSlots())
+            count(sObjectMgr.GetPlayer(slot.guid));
+
+    // The bots it invited that have not answered yet.
+    Group* const pending = announcer->GetGroup() ? announcer->GetGroup() : announcer->GetGroupInvite();
+    std::string const invited = announcer->GetPlayerbotAI()->GetAiObjectContext()->GetValue<std::string>("manual string", "lfg invited")->Get();
+    for (std::string const& id : split(invited, ','))
+        if (!id.empty())
+            if (Player* player = sObjectMgr.GetPlayer(ObjectGuid(HIGHGUID_PLAYER, uint32(std::stoul(id)))))
+                if (pending && player->GetGroupInvite() == pending)
+                    count(player);
+
+    Role const role = RoleOf(candidate);
+    ++counts[role];
+    ++total;
+    if (total > wanted || counts[Tank] > limits.maxTanks || counts[Healer] > limits.maxHealers)
+        return false;
+
+    // The slots left must still hold the tanks and healers it needs.
+    uint32 const stillNeeded = (counts[Tank] < limits.minTanks ? limits.minTanks - counts[Tank] : 0) +
+        (counts[Healer] < limits.minHealers ? limits.minHealers - counts[Healer] : 0);
+    return wanted - total >= stillNeeded;
+}
+
+Quest const* GroupQuests::Pending(Player* bot)
+{
+    if (bot->InBattleGround() || bot->GetMap()->IsDungeon())
+        return nullptr;
+
+    Group* group = bot->GetGroup();
+    if (group && !group->IsLeader(bot->GetObjectGuid()))
+        return nullptr;
+
+    for (uint8 slot = 0; slot < MAX_QUEST_LOG_SIZE; ++slot)
+    {
+        uint32 const questId = bot->GetQuestSlotQuestId(slot);
+        Quest const* quest = sObjectMgr.GetQuestTemplate(questId);
+        if (!IsGroupQuest(quest) || bot->GetQuestStatus(questId) != QUEST_STATUS_INCOMPLETE || QuestFlow::IsGrey(bot, quest))
+            continue;
+
+        if (GroupSize(bot) < WantedSize(quest))
+            return quest;
+    }
+
+    return nullptr;
+}
diff --git a/playerbot/strategy/values/GroupQuests.h b/playerbot/strategy/values/GroupQuests.h
new file mode 100644
index 0000000..4b2d7a4
--- /dev/null
+++ b/playerbot/strategy/values/GroupQuests.h
@@ -0,0 +1,54 @@
+#pragma once
+
+#include <cstdint>
+#include <ctime>
+
+// kalimdor: bots look for a group for their group quests, in chat, and
+// answer each other (owner, 2026-11-06; Kamino 268). A bot with an unfinished
+// elite, dungeon or raid quest that is not grey, and no group big enough for
+// it (alone, or leading a smaller one), says "LFG [quest]" in its zone's
+// General and in LookingForGroup, every RepostTime while it waits. A bot on
+// the same map with the same unfinished quest, in no group, is invited - any
+// level: higher bots help (ChatReplyAction::HandleLFGQuestsReply). Size by
+// the quest: elite 3, dungeon 5, raid its instance's limit (Zul'Gurub 20,
+// Molten Core 40). It waits WaitPerMember a member, at least MinWait (a
+// dungeon 30 minutes - group forming is slow); not full by then, a group it
+// formed so is broken up and it tries again after RetryTime. Once full,
+// upstream's "can fight elite/boss" lets the quest travel take the group.
+// A quest whose target is an open-world boss is a raid (owner: world bosses
+// are like raids), 40. Roles (owner, 2026-11-06), by PlayerbotAI::IsTank and
+// IsHeal, damage the rest, melee or ranged: elite 3 - any; 5 - exactly 1
+// tank, 1 healer; 10 - exactly 2 and 2; 20 - 2-3 tanks, 4-5 healers; 40 -
+// 3-4 tanks, 10-12 healers. A bot joins only if its role still fits and the
+// slots left can still hold the minimum tanks and healers.
+
+class Player;
+class Quest;
+
+namespace ai
+{
+    class GroupQuests
+    {
+    public:
+        static constexpr time_t WaitPerMember = 6 * 60;
+        static constexpr time_t MinWait = 20 * 60;
+        static constexpr time_t RepostTime = 15 * 60;
+        static constexpr time_t RetryTime = 30 * 60;
+
+        static bool IsGroupQuest(Quest const* quest);
+        // The group it needs: elite 3, dungeon 5, raid the instance's limit.
+        static uint32_t WantedSize(Quest const* quest);
+        static time_t WaitFor(uint32_t wanted);
+        // Its size now: the bot's group with the invitations still open, or 1
+        // alone.
+        static uint32_t GroupSize(Player* bot);
+        // Whether the candidate fits the announcer's group by role, counting
+        // its members and the bots it has invited and not heard back from.
+        static bool RoleFits(Player* announcer, Player* candidate, uint32_t wanted);
+        // "tank", "healer" or "damage", for the log.
+        static const char* RoleName(Player* player);
+        // The group quest it should look for a group for, or none: alone or
+        // leading, unfinished, not grey, the group not yet big enough.
+        static Quest const* Pending(Player* bot);
+    };
+}
