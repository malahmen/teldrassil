+bool GroupQuestPendingTrigger::IsActive()
+{
+    if (ai->IsRealPlayer())
+        return false;
+
+    if (AI_VALUE2(time_t, "manual time", "lfg retry") > time(nullptr))
+        return false;
+
+    return GroupQuests::Pending(bot) != nullptr;
