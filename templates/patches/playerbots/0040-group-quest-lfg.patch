index 0000000..82298f6
--- /dev/null
+++ b/playerbot/strategy/actions/LookForGroupAction.cpp
@@ -0,0 +1,56 @@
+#include "playerbot/playerbot.h"
+#include "LookForGroupAction.h"
+#include "playerbot/strategy/values/GroupQuests.h"
+
+using namespace ai;
+
+bool LookForGroupAction::Execute(Event& event)
+{
+    Quest const* quest = GroupQuests::Pending(bot);
+    if (!quest)
+        return false;
+
+    time_t const now = time(nullptr);
+    uint32 const wanted = GroupQuests::WantedSize(quest);
+    uint32 const have = GroupQuests::GroupSize(bot);
+
+    // A new search, or another quest: start the clock.
+    if (AI_VALUE2(int, "manual int", "lfg quest") != int(quest->GetQuestId()) || !AI_VALUE2(time_t, "manual time", "lfg since"))
+    {
+        SET_AI_VALUE2(int, "manual int", "lfg quest", int(quest->GetQuestId()));
+        SET_AI_VALUE2(time_t, "manual time", "lfg since", now);
+        SET_AI_VALUE2(time_t, "manual time", "lfg posted", 0);
+        SET_AI_VALUE2(bool, "manual bool", "lfg grouped", false);
+        SET_AI_VALUE2(std::string, "manual string", "lfg invited", "");
+    }
+
+    // Not full in time: a group formed for it breaks up; try again later.
+    if (now - AI_VALUE2(time_t, "manual time", "lfg since") > GroupQuests::WaitFor(wanted))
+    {
+        Group* group = bot->GetGroup();
+        bool const breakUp = group && AI_VALUE2(bool, "manual bool", "lfg grouped") && group->IsLeader(bot->GetObjectGuid());
+        sLog.outString("Bot #%d %s:%d <%s>: no group for %s (%u of %u) - %s, again in %d minutes", bot->GetGUIDLow(),
+            bot->GetTeam() == ALLIANCE ? "A" : "H", bot->GetLevel(), bot->GetName(), quest->GetTitle().c_str(), have, wanted,
+            breakUp ? "the group breaks up" : "gives up for now", int(GroupQuests::RetryTime / 60));
+        if (breakUp)
+            group->Disband();
+
+        SET_AI_VALUE2(int, "manual int", "lfg quest", 0);
+        SET_AI_VALUE2(time_t, "manual time", "lfg since", 0);
+        SET_AI_VALUE2(bool, "manual bool", "lfg grouped", false);
+        SET_AI_VALUE2(time_t, "manual time", "lfg retry", now + GroupQuests::RetryTime);
+        return true;
+    }
+
+    if (now - AI_VALUE2(time_t, "manual time", "lfg posted") < GroupQuests::RepostTime)
+        return false;
+
+    // "LFG" first: that is what bots answer (ChatReplyAction::ChatReplyDo).
+    std::string const msg = "LFG " + ai->GetChatHelper()->formatQuest(quest) + " - " + std::to_string(wanted - have) + " more";
+    ai->SayToGeneral(msg);
+    ai->SayToLFG(msg);
+    SET_AI_VALUE2(time_t, "manual time", "lfg posted", now);
+    sLog.outString("Bot #%d %s:%d <%s>: looks for a group for %s (%u of %u)", bot->GetGUIDLow(),
+        bot->GetTeam() == ALLIANCE ? "A" : "H", bot->GetLevel(), bot->GetName(), quest->GetTitle().c_str(), have, wanted);
+    return true;
+}
