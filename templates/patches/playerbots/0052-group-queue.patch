+// The queue: who asks, for which quest; the matcher reads it on the world's
+// update (GroupQuests::Match).
+namespace
+{
+    std::mutex queueLock;
+    std::map<uint64, uint32> asking; // leader's guid -> quest
+
+    AiObjectContext* ContextOf(Player* player) { return player->GetPlayerbotAI()->GetAiObjectContext(); }
+
+    // A bot the matcher may move: in the world, alive, a bot's own AI.
+    bool Movable(Player* player)
+    {
+        return player && player->IsInWorld() && player->IsAlive() && !player->IsBeingTeleported() && !player->InBattleGround() &&
+            player->GetPlayerbotAI() && !player->GetPlayerbotAI()->IsRealPlayer();
+    }
+
+    // Its group's members, or itself alone.
+    std::vector<Player*> MembersOf(Player* leader)
+    {
+        std::vector<Player*> members;
+        if (Group* group = leader->GetGroup())
+        {
+            for (auto const& slot : group->GetMemberSlots())
+                if (Player* member = sObjectMgr.GetPlayer(slot.guid))
+                    members.push_back(member);
+        }
+        else
+            members.push_back(leader);
+        return members;
+    }
+
+    // These joiners all fit the leader's group by role at once.
+    bool FitAll(Player* leader, std::vector<Player*> const& joiners, uint32 wanted)
+    {
+        Limits const limits = LimitsFor(wanted);
+        uint32 counts[3] = { 0, 0, 0 };
+        uint32 total = 0;
+        for (Player* member : MembersOf(leader))
+        {
+            ++counts[RoleOf(member)];
+            ++total;
+        }
+        for (Player* joiner : joiners)
+        {
+            ++counts[RoleOf(joiner)];
+            ++total;
+        }
+        if (total > wanted || counts[Tank] > limits.maxTanks || counts[Healer] > limits.maxHealers)
+            return false;
+        uint32 const stillNeeded = (counts[Tank] < limits.minTanks ? limits.minTanks - counts[Tank] : 0) +
+            (counts[Healer] < limits.minHealers ? limits.minHealers - counts[Healer] : 0);
+        return wanted - total >= stillNeeded;
+    }
+
+    // The leader's group, made if it leads none yet.
+    Group* GroupFor(Player* leader)
+    {
+        if (Group* group = leader->GetGroup())
+            return group;
+        Group* group = new Group();
+        if (!group->Create(leader->GetObjectGuid(), leader->GetName()))
+        {
+            delete group;
+            return nullptr;
+        }
+        sObjectMgr.AddGroup(group);
+        return group;
+    }
+
+    // A place in the leader's group for the quest: it joins, holds the group
+    // for it (GroupQuests::Holds), and both drop whatever trip they were on.
+    bool Join(Player* leader, Player* bot, Quest const* quest, uint32 wanted, char const* how)
+    {
+        Group* group = GroupFor(leader);
+        if (!group)
+            return false;
+        if (!group->IsRaidGroup() && wanted > 5 && group->GetMembersCount() >= 5)
+            group->ConvertToRaid();
+        if (bot->GetGroup())
+            bot->RemoveFromGroup();
+        if (!group->AddMember(bot->GetObjectGuid(), bot->GetName()))
+            return false;
+        ContextOf(bot)->GetValue<int>("manual int", "lfg joined")->Set(int(quest->GetQuestId()));
+        ContextOf(bot)->GetValue<int>("manual int", "lfg quest")->Set(0);
+        ContextOf(bot)->GetValue<time_t>("manual time", "lfg since")->Set(0);
+        ContextOf(bot)->GetValue<TravelTarget*>("travel target")->Get()->SetStatus(TravelStatus::TRAVEL_STATUS_EXPIRED);
+        ContextOf(leader)->GetValue<bool>("manual bool", "lfg grouped")->Set(true);
+        ContextOf(leader)->GetValue<TravelTarget*>("travel target")->Get()->SetStatus(TravelStatus::TRAVEL_STATUS_EXPIRED);
+        sLog.outString("Bot #%d %s:%d <%s>: joins %s's group for %s%s (%u of %u, %s)", bot->GetGUIDLow(),
+            bot->GetTeam() == ALLIANCE ? "A" : "H", bot->GetLevel(), bot->GetName(), leader->GetName(), quest->GetTitle().c_str(), how,
+            group->GetMembersCount(), wanted, GroupQuests::RoleName(bot));
+        return true;
+    }
+
+    // Close enough to the leader: its continent, and in its first 5 minutes
+    // within NearRange.
+    bool Near(Player* leader, Player* other)
+    {
+        if (leader->GetMapId() != other->GetMapId() || leader->GetInstanceId() != other->GetInstanceId())
+            return false;
+        time_t const since = ContextOf(leader)->GetValue<time_t>("manual time", "lfg since")->Get();
+        return !since || time(nullptr) - since >= 5 * MINUTE || leader->GetDistance(other) <= GroupQuests::NearRange;
+    }
+}
+
+void GroupQuests::Ask(Player* leader, Quest const* quest)
+{
+    std::lock_guard<std::mutex> guard(queueLock);
+    asking[leader->GetObjectGuid().GetRawValue()] = quest->GetQuestId();
+}
+
+void GroupQuests::Withdraw(Player* leader)
+{
+    std::lock_guard<std::mutex> guard(queueLock);
+    asking.erase(leader->GetObjectGuid().GetRawValue());
+}
+
+void GroupQuests::Match()
+{
+    std::map<uint64, uint32> asks;
+    {
+        std::lock_guard<std::mutex> guard(queueLock);
+        asks = asking;
+    }
+    struct Request { Player* leader; Quest const* quest; uint32 wanted; time_t since; };
+    std::map<std::pair<uint32, uint32>, std::vector<Request>> byQuest; // (team, quest)
+    std::vector<uint64> gone;
+    for (auto const& [raw, questId] : asks)
+    {
+        Player* leader = sObjectMgr.GetPlayer(ObjectGuid(raw));
+        Quest const* quest = sObjectMgr.GetQuestTemplate(questId);
+        bool ok = Movable(leader) && quest && ContextOf(leader)->GetValue<int>("manual int", "lfg quest")->Get() == int(questId) &&
+            ContextOf(leader)->GetValue<int>("manual int", "group quest focus")->Get() <= 0;
+        if (ok)
+            if (Group* group = leader->GetGroup())
+            {
+                ok = group->IsLeader(leader->GetObjectGuid());
+                for (Player* member : MembersOf(leader))
+                    if (!member->GetPlayerbotAI() || member->GetPlayerbotAI()->IsRealPlayer())
+                        ok = false; // a real player's group is its own
+            }
+        if (ok && GroupSize(leader) >= WantedSize(quest))
+            ok = false;
+        if (!ok)
+        {
+            gone.push_back(raw);
+            continue;
+        }
+        byQuest[{ uint32(leader->GetTeam()), questId }].push_back({ leader, quest, WantedSize(quest),
+            ContextOf(leader)->GetValue<time_t>("manual time", "lfg since")->Get() });
+    }
+    {
+        std::lock_guard<std::mutex> guard(queueLock);
+        for (uint64 raw : gone)
+            asking.erase(raw);
+    }
+    if (byQuest.empty())
+        return;
+
+    time_t const now = time(nullptr);
+    std::set<uint32> placed; // bots given a place this round
+    for (auto& [key, requests] : byQuest)
+    {
+        // The bigger first, then the longer waiting.
+        std::sort(requests.begin(), requests.end(), [](Request const& a, Request const& b)
+        {
+            uint32 const sa = GroupQuests::GroupSize(a.leader), sb = GroupQuests::GroupSize(b.leader);
+            return sa != sb ? sa > sb : a.since < b.since;
+        });
+        std::vector<bool> merged(requests.size(), false);
+        for (size_t i = 0; i < requests.size(); ++i)
+        {
+            if (merged[i])
+                continue;
+            Request const& into = requests[i];
+            // The smaller groups for the same quest, whole, while they fit.
+            for (size_t j = i + 1; j < requests.size(); ++j)
+            {
+                if (merged[j])
+                    continue;
+                Player* other = requests[j].leader;
+                std::vector<Player*> joiners = MembersOf(other);
+                bool fits = Near(into.leader, other) && GroupSize(into.leader) + joiners.size() <= into.wanted &&
+                    FitAll(into.leader, joiners, into.wanted);
+                for (Player* joiner : joiners)
+                    fits = fits && Movable(joiner) && CanEnter(joiner, into.quest) && !placed.count(joiner->GetGUIDLow());
+                if (!fits)
+                    continue;
+                sLog.outString("Bot #%d %s:%d <%s>: its group of %u joins %s's, bigger, for the same quest", other->GetGUIDLow(),
+                    other->GetTeam() == ALLIANCE ? "A" : "H", other->GetLevel(), other->GetName(), uint32(joiners.size()), into.leader->GetName());
+                Withdraw(other);
+                ContextOf(other)->GetValue<bool>("manual bool", "lfg grouped")->Set(false);
+                // Its members first, its leader last: the group it leaves
+                // goes when it is empty.
+                std::stable_partition(joiners.begin(), joiners.end(), [other](Player* p) { return p != other; });
+                for (Player* joiner : joiners)
+                    if (Join(into.leader, joiner, into.quest, into.wanted, ""))
+                        placed.insert(joiner->GetGUIDLow());
+                merged[j] = true;
+            }
+            // Free bots, the nearest first.
+            if (GroupSize(into.leader) >= into.wanted)
+                continue;
+            bool const late = into.since && now - into.since >= HelpAfter;
+            struct Candidate { Player* bot; float distance; char const* how; };
+            std::vector<Candidate> candidates;
+            for (auto const& [low, bot] : sRandomPlayerbotMgr.GetAllBots())
+            {
+                if (!Movable(bot) || bot == into.leader || bot->GetTeam() != into.leader->GetTeam() || bot->GetGroup() || bot->GetGroupInvite() ||
+                    placed.count(bot->GetGUIDLow()) || !Near(into.leader, bot))
+                    continue;
+                AiObjectContext* context = ContextOf(bot);
+                if (context->GetValue<int>("manual int", "lfg quest")->Get() > 0 || context->GetValue<int>("manual int", "group quest focus")->Get() > 0)
+                    continue;
+                uint32 const questId = into.quest->GetQuestId();
+                QuestStatus const status = bot->GetQuestStatus(questId);
+                int32 const above = int32(bot->GetLevel()) - int32(into.quest->GetQuestLevel());
+                char const* how = nullptr;
+                if (status == QUEST_STATUS_INCOMPLETE)
+                    how = "";
+                else if (status == QUEST_STATUS_NONE && bot->GetLevel() >= into.quest->GetMinLevel())
+                {
+                    if ((PlayerbotAI::IsTank(bot, false) || PlayerbotAI::IsHeal(bot, false)) && std::abs(above) <= 5)
+                        how = " to help";
+                    else if (late && above > 0 && above <= HelpLevelGap)
+                        how = above > 5 ? " to help, above its level" : " to help";
+                }
+                if (!how || !CanEnter(bot, into.quest))
+                    continue;
+                candidates.push_back({ bot, into.leader->GetDistance(bot), how });
+            }
+            std::sort(candidates.begin(), candidates.end(), [](Candidate const& a, Candidate const& b) { return a.distance < b.distance; });
+            for (Candidate const& candidate : candidates)
+            {
+                if (GroupSize(into.leader) >= into.wanted)
+                    break;
+                if (!FitAll(into.leader, { candidate.bot }, into.wanted))
+                    continue;
+                if (Join(into.leader, candidate.bot, into.quest, into.wanted, candidate.how))
+                    placed.insert(candidate.bot->GetGUIDLow());
+            }
+        }
+    }
+}
