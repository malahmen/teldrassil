+#include "playerbot/TravelMgr.h"
+
+using namespace ai;
+
+bool QuestTurnInDueTrigger::IsActive()
+{
+    if (!QuestFlow::HasTurnIn(bot) || QuestFlow::HasUnfinishedLocalQuest(bot))
+        return false;
+
+    TravelTarget* target = AI_VALUE(TravelTarget*, "travel target");
+    return !(target && dynamic_cast<QuestRelationTravelDestination*>(target->GetDestination()));
+}
