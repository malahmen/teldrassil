diff --git a/playerbot/strategy/actions/DropGrayQuestsAction.cpp b/playerbot/strategy/actions/DropGrayQuestsAction.cpp
new file mode 100644
index 0000000..4652266
--- /dev/null
+++ b/playerbot/strategy/actions/DropGrayQuestsAction.cpp
@@ -0,0 +1,29 @@
+#include "playerbot/playerbot.h"
+#include "DropGrayQuestsAction.h"
+#include "playerbot/strategy/values/QuestFlow.h"
+
+using namespace ai;
+
+bool DropGrayQuestsAction::Execute(Event& event)
+{
+    bool dropped = false;
+    for (uint8 slot = 0; slot < MAX_QUEST_LOG_SIZE; ++slot)
+    {
+        uint32 const questId = bot->GetQuestSlotQuestId(slot);
+        Quest const* quest = sObjectMgr.GetQuestTemplate(questId);
+        if (!quest || QuestFlow::GivesXp(bot, quest))
+            continue;
+
+        // As DropQuestAction does.
+        bot->SetQuestSlot(slot, 0);
+        bot->TakeQuestSourceItem(questId, false);
+        bot->SetQuestStatus(questId, QUEST_STATUS_NONE);
+        bot->getQuestStatusMap()[questId].m_rewarded = false;
+        dropped = true;
+
+        sLog.outString("Bot #%d %s:%d <%s>: drops quest %s (level %d) - no XP any more", bot->GetGUIDLow(),
+            bot->GetTeam() == ALLIANCE ? "A" : "H", bot->GetLevel(), bot->GetName(), quest->GetTitle().c_str(), quest->GetQuestLevel());
+    }
+
+    return dropped;
+}
