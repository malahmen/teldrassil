diff --git a/playerbot/strategy/values/QuestFlow.cpp b/playerbot/strategy/values/QuestFlow.cpp
new file mode 100644
index 0000000..abcbd9d
--- /dev/null
+++ b/playerbot/strategy/values/QuestFlow.cpp
@@ -0,0 +1,54 @@
+#include "playerbot/playerbot.h"
+#include "QuestFlow.h"
+
+using namespace ai;
+
+namespace
+{
+    // Each quest in the bot's log, with whether it is finished.
+    template <typename F>
+    void ForEachLogQuest(Player* bot, F f)
+    {
+        for (auto const& [questId, status] : bot->getQuestStatusMap())
+        {
+            if (status.m_rewarded || (status.m_status != QUEST_STATUS_INCOMPLETE && status.m_status != QUEST_STATUS_COMPLETE))
+                continue;
+
+            if (Quest const* quest = sObjectMgr.GetQuestTemplate(questId))
+                f(quest, status.m_status == QUEST_STATUS_COMPLETE);
+        }
+    }
+}
+
+bool QuestFlow::GivesXp(Player* bot, Quest const* quest)
+{
+    return quest && quest->XPValue(bot) > 0;
+}
+
+int32 QuestFlow::ZoneOf(Quest const* quest)
+{
+    return quest && quest->GetZoneOrSort() > 0 ? quest->GetZoneOrSort() : 0;
+}
+
+bool QuestFlow::HasLocalQuests(Player* bot)
+{
+    int32 const zone = bot->GetZoneId();
+    bool found = false;
+    ForEachLogQuest(bot, [&](Quest const* quest, bool) { found |= ZoneOf(quest) == zone && GivesXp(bot, quest); });
+    return found;
+}
+
+bool QuestFlow::HasUnfinishedLocalQuest(Player* bot)
+{
+    int32 const zone = bot->GetZoneId();
+    bool found = false;
+    ForEachLogQuest(bot, [&](Quest const* quest, bool finished) { found |= !finished && ZoneOf(quest) == zone && GivesXp(bot, quest); });
+    return found;
+}
+
+bool QuestFlow::HasTurnIn(Player* bot)
+{
+    bool found = false;
+    ForEachLogQuest(bot, [&](Quest const*, bool finished) { found |= finished; });
+    return found;
+}
diff --git a/playerbot/strategy/values/QuestFlow.h b/playerbot/strategy/values/QuestFlow.h
new file mode 100644
index 0000000..19ecad5
--- /dev/null
+++ b/playerbot/strategy/values/QuestFlow.h
@@ -0,0 +1,34 @@
+#pragma once
+
+// kalimdor: how a bot works its quest log (owner, 2026-11-02; Kamino 231).
+//  - Quests in the log are travelled to wherever they are, other continents
+//    included (no distance cap; the nearest still first).
+//  - A finished quest is turned in first, as upkeep - unless a quest of the
+//    zone the bot is in is still unfinished.
+//  - While the bot has quests of its zone that still give XP, it does not
+//    leave: its activities stay in the zone and its quest choice sticks to
+//    them. One that no longer gives XP does not hold it.
+//  - A quest that gives no XP is dropped - for a bot whose archetype says so
+//    (the default; "gray_quests=keep" keeps them).
+// "Of its zone" is the quest's own zone (its ZoneOrSort).
+
+class Player;
+class Quest;
+
+namespace ai
+{
+    class QuestFlow
+    {
+    public:
+        static bool GivesXp(Player* bot, Quest const* quest);
+        // Quests in the log - unfinished or finished, not yet turned in - of
+        // the zone the bot is in, that still give XP.
+        static bool HasLocalQuests(Player* bot);
+        static bool HasUnfinishedLocalQuest(Player* bot);
+        // A finished quest waiting to be turned in.
+        static bool HasTurnIn(Player* bot);
+        // The quest's zone, or 0 for a quest of a sort (a class or
+        // profession quest).
+        static int32 ZoneOf(Quest const* quest);
+    };
+}
