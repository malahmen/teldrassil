diff --git a/playerbot/strategy/triggers/GrayQuestTrigger.cpp b/playerbot/strategy/triggers/GrayQuestTrigger.cpp
new file mode 100644
index 0000000..b8233fa
--- /dev/null
+++ b/playerbot/strategy/triggers/GrayQuestTrigger.cpp
@@ -0,0 +1,22 @@
+#include "playerbot/playerbot.h"
+#include "GrayQuestTrigger.h"
+#include "playerbot/strategy/values/Archetypes.h"
+#include "playerbot/strategy/values/QuestFlow.h"
+
+using namespace ai;
+
+bool GrayQuestTrigger::IsActive()
+{
+    const Archetype* archetype = Archetypes::Of(bot);
+    if (!archetype || archetype->keepGrayQuests)
+        return false;
+
+    for (uint8 slot = 0; slot < MAX_QUEST_LOG_SIZE; ++slot)
+    {
+        if (Quest const* quest = sObjectMgr.GetQuestTemplate(bot->GetQuestSlotQuestId(slot)))
+            if (!QuestFlow::GivesXp(bot, quest))
+                return true;
+    }
+
+    return false;
+}
