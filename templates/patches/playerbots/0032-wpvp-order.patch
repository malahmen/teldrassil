+float EngageOdds::HonourRatio(Player* bot, Player* enemy)
+{
+    if (MaNGOS::XP::IsTrivialLevelDifference(bot->GetLevel(), enemy->GetLevel()))
+        return 0.0f;
+
+    // The same-level, unranked victim, with the same kills-today factor.
+    int const killsToday = bot->CalculateTotalKills(enemy, sWorld.GetDateToday(), sWorld.GetDateToday());
+    int const f = std::max(0, 10 - killsToday);
+    float const base = f * 0.25f * (bot->GetLevel() + 1) * 1.05f;
+    if (base <= 0.0f)
+        return 0.0f;
+
+    return MaNGOS::Honor::HonorableKillPoints(bot, enemy, 1) / base;
+}
+
 bool EngageOdds::FavoursPvp(Player* bot, Player* enemy)
 {
     // The bot's archetype can set the margin (Kamino 211): "always" attacks
     // every enemy player on sight, guards or not; "never" none.
     float const margin = Archetypes::PvpMargin(bot);
-    if (margin <= Archetypes::Always)
-        return true;
     if (margin >= Archetypes::Never)
         return false;
 
+    // kalimdor: an archetype hunting by the owner's order (rhk set; Kamino
+    // 253): (1) not past its objective, (2) the odds below, (3) below the
+    // cap only where it has topped the zone, (4) a victim worth the honour.
+    const Archetype* archetype = Archetypes::Of(bot);
+    bool const ordered = archetype && archetype->rhk >= 0.0f;
+    if (ordered)
+    {
+        TravelTarget* target = bot->GetPlayerbotAI()->GetAiObjectContext()->GetValue<TravelTarget*>("travel target")->Get();
+        WorldPosition const* objective = target && target->IsActive() ? target->GetPosition() : nullptr;
+        if (objective && objective->getMapId() == bot->GetMapId() &&
+            bot->GetDistance(enemy) > objective->distance(WorldPosition(bot)))
+            return false;
+
+        if (bot->GetLevel() < sWorld.getConfig(CONFIG_UINT32_MAX_PLAYER_LEVEL) && !ZoneLevels::Outlevelled(bot))
+            return false;
+
+        if (archetype->rhk > 0.0f && HonourRatio(bot, enemy) < archetype->rhk)
+            return false;
+    }
+
+    if (margin <= Archetypes::Always)
+        return true;
+
     float const enemySide = PvpEnemySide(bot, enemy);
     return enemySide >= 0.0f && OwnSide(bot) >= enemySide * margin;
 }
