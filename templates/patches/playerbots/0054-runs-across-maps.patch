 using namespace ai;
 
+// kalimdor (Kamino 288): who reads and writes whose AI values, from which
+// thread - see DungeonRun::Mine.
+namespace
+{
+    thread_local Player* updating = nullptr;
+
+    // What a bot's group reads of it from elsewhere: its values by name, and
+    // the route it walks (LeaderRoute) - the names every Peer* read here
+    // asks for.
+    char const* const publishedInts[] = { "group quest focus", "gathered", "run wing", "run instance", "run escort tries", "run step",
+        "way in step", "shortcut from", "shortcut to" };
+    char const* const publishedTimes[] = { "run close up", "rest full since", "to tank spot", "run escort", "run escort failed" };
+    char const* const publishedStrings[] = { "gather point", "run pull failed", "run pull" };
+
+    struct Published
+    {
+        time_t at = 0;
+        std::map<std::string, int> ints;
+        std::map<std::string, time_t> times;
+        std::map<std::string, std::string> strings;
+        uint32 focusQuest = 0;
+        QuestStatus focusStatus = QUEST_STATUS_NONE;
+        std::vector<DungeonRun::RouteStep> const* route = nullptr;
+        int routeStep = 0;
+        std::string routeKey;
+    };
+
+    struct Posted
+    {
+        std::vector<std::pair<std::string, int>> ints;
+        std::vector<std::pair<std::string, time_t>> times;
+        std::vector<std::pair<std::string, std::string>> strings;
+        bool put = false;
+        WorldPosition at;
+        std::vector<std::function<void(Player*)>> calls;
+    };
+
+    std::mutex peersLock;
+    std::map<uint32, Published> published;
+    std::map<uint32, Posted> posted;
+    std::atomic<int> postedCount{ 0 };
+
+    AiObjectContext* ContextOf(Player* player)
+    {
+        return player && player->GetPlayerbotAI() ? player->GetPlayerbotAI()->GetAiObjectContext() : nullptr;
+    }
+}
+
+DungeonRun::Updating::Updating(Player* bot) : previous(updating) { updating = bot; }
+DungeonRun::Updating::~Updating() { updating = previous; }
+
+bool DungeonRun::Mine(Player* other)
+{
+    // No bot updating: the world thread, which runs with every map thread
+    // parked (the console, the group queue's matcher).
+    Player* const self = updating;
+    if (!other || !self || other == self)
+        return true;
+    // One map object, one thread: the same map and instance, both in it.
+    return self->IsInWorld() && other->IsInWorld() && other->GetMapId() == self->GetMapId() &&
+        other->GetInstanceId() == self->GetInstanceId();
+}
+
+bool DungeonRun::OnDungeonMap(Player* player)
+{
+    MapEntry const* entry = player ? sMapStore.LookupEntry(player->GetMapId()) : nullptr;
+    return entry && entry->IsDungeon();
+}
+
+int DungeonRun::PeerInt(Player* other, std::string const& name)
+{
+    if (Mine(other))
+    {
+        AiObjectContext* context = ContextOf(other);
+        return context ? context->GetValue<int>("manual int", name)->Get() : 0;
+    }
+    std::lock_guard<std::mutex> guard(peersLock);
+    auto const at = published.find(other->GetGUIDLow());
+    if (at == published.end())
+        return 0;
+    auto const value = at->second.ints.find(name);
+    return value == at->second.ints.end() ? 0 : value->second;
+}
+
+time_t DungeonRun::PeerTime(Player* other, std::string const& name)
+{
+    if (Mine(other))
+    {
+        AiObjectContext* context = ContextOf(other);
+        return context ? context->GetValue<time_t>("manual time", name)->Get() : 0;
+    }
+    std::lock_guard<std::mutex> guard(peersLock);
+    auto const at = published.find(other->GetGUIDLow());
+    if (at == published.end())
+        return 0;
+    auto const value = at->second.times.find(name);
+    return value == at->second.times.end() ? 0 : value->second;
+}
+
+std::string DungeonRun::PeerString(Player* other, std::string const& name)
+{
+    if (Mine(other))
+    {
+        AiObjectContext* context = ContextOf(other);
+        return context ? context->GetValue<std::string>("manual string", name)->Get() : "";
+    }
+    std::lock_guard<std::mutex> guard(peersLock);
+    auto const at = published.find(other->GetGUIDLow());
+    if (at == published.end())
+        return "";
+    auto const value = at->second.strings.find(name);
+    return value == at->second.strings.end() ? "" : value->second;
+}
+
+QuestStatus DungeonRun::PeerQuestStatus(Player* other, uint32 questId)
+{
+    if (Mine(other))
+        return other->GetQuestStatus(questId);
+    std::lock_guard<std::mutex> guard(peersLock);
+    auto const at = published.find(other->GetGUIDLow());
+    return at != published.end() && at->second.focusQuest == questId ? at->second.focusStatus : QUEST_STATUS_NONE;
+}
+
+void DungeonRun::PostInt(Player* other, std::string const& name, int value)
+{
+    if (Mine(other))
+    {
+        if (AiObjectContext* context = ContextOf(other))
+            context->GetValue<int>("manual int", name)->Set(value);
+        return;
+    }
+    std::lock_guard<std::mutex> guard(peersLock);
+    posted[other->GetGUIDLow()].ints.emplace_back(name, value);
+    ++postedCount;
+}
+
+void DungeonRun::PostTime(Player* other, std::string const& name, time_t value)
+{
+    if (Mine(other))
+    {
+        if (AiObjectContext* context = ContextOf(other))
+            context->GetValue<time_t>("manual time", name)->Set(value);
+        return;
+    }
+    std::lock_guard<std::mutex> guard(peersLock);
+    posted[other->GetGUIDLow()].times.emplace_back(name, value);
+    ++postedCount;
+}
+
+void DungeonRun::PostString(Player* other, std::string const& name, std::string const& value)
+{
+    if (Mine(other))
+    {
+        if (AiObjectContext* context = ContextOf(other))
+            context->GetValue<std::string>("manual string", name)->Set(value);
+        return;
+    }
+    std::lock_guard<std::mutex> guard(peersLock);
+    posted[other->GetGUIDLow()].strings.emplace_back(name, value);
+    ++postedCount;
+}
