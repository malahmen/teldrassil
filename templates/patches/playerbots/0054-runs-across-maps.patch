+    {
+        if (other->GetPlayerbotAI())
+            other->GetPlayerbotAI()->OnCombatEnded();
+        other->TeleportTo(at.getMapId(), at.getX(), at.getY(), at.getZ(), other->GetOrientation());
+        return;
+    }
+    std::lock_guard<std::mutex> guard(peersLock);
+    Posted& post = posted[other->GetGUIDLow()];
+    post.put = true;
+    post.at = at;
+    ++postedCount;
+}
+
+void DungeonRun::PostCall(Player* other, std::function<void(Player*)> call)
+{
+    if (Mine(other))
+    {
+        call(other);
+        return;
+    }
+    std::lock_guard<std::mutex> guard(peersLock);
+    posted[other->GetGUIDLow()].calls.push_back(std::move(call));
+    ++postedCount;
+}
+
+void DungeonRun::Sync(Player* bot)
+{
+    AiObjectContext* context = ContextOf(bot);
+    if (!context)
+        return;
+    // What was posted for it, in its own update.
+    if (postedCount.load() > 0)
+    {
+        Posted post;
+        bool any = false;
+        {
+            std::lock_guard<std::mutex> guard(peersLock);
+            auto const at = posted.find(bot->GetGUIDLow());
+            if (at != posted.end())
+            {
+                post = std::move(at->second);
+                posted.erase(at);
+                --postedCount;
+                any = true;
+            }
+        }
+        if (any)
+        {
+            for (auto const& value : post.ints)
+                context->GetValue<int>("manual int", value.first)->Set(value.second);
+            for (auto const& value : post.times)
+                context->GetValue<time_t>("manual time", value.first)->Set(value.second);
+            for (auto const& value : post.strings)
+                context->GetValue<std::string>("manual string", value.first)->Set(value.second);
+            for (auto const& call : post.calls)
+                call(bot);
+            if (post.put && bot->IsInWorld() && !bot->IsBeingTeleported())
+            {
+                bot->GetPlayerbotAI()->OnCombatEnded();
+                bot->TeleportTo(post.at.getMapId(), post.at.getX(), post.at.getY(), post.at.getZ(), bot->GetOrientation());
+            }
+        }
+    }
+
+    // Its values, for its group elsewhere: once a second at most; none
+    // kept out of a group.
+    time_t const now = time(nullptr);
+    if (!bot->GetGroup())
+    {
+        std::lock_guard<std::mutex> guard(peersLock);
+        published.erase(bot->GetGUIDLow());
+        return;
+    }
+    {
+        std::lock_guard<std::mutex> guard(peersLock);
+        auto const at = published.find(bot->GetGUIDLow());
+        if (at != published.end() && at->second.at == now)
+            return;
+    }
+    Published fresh;
+    fresh.at = now;
+    for (char const* name : publishedInts)
+        fresh.ints[name] = context->GetValue<int>("manual int", name)->Get();
+    for (char const* name : publishedTimes)
+        fresh.times[name] = context->GetValue<time_t>("manual time", name)->Get();
+    for (char const* name : publishedStrings)
+        fresh.strings[name] = context->GetValue<std::string>("manual string", name)->Get();
+    if (fresh.ints["group quest focus"] > 0)
+    {
+        fresh.focusQuest = uint32(fresh.ints["group quest focus"]);
+        fresh.focusStatus = bot->GetQuestStatus(fresh.focusQuest);
+    }
+    if (bot->IsInWorld() && bot->GetGroup()->IsLeader(bot->GetObjectGuid()))
+        fresh.route = LeaderRoute(bot, fresh.routeStep, fresh.routeKey);
+    std::lock_guard<std::mutex> guard(peersLock);
+    published[bot->GetGUIDLow()] = std::move(fresh);
+}
