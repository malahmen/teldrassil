diff --git a/playerbot/strategy/actions/BgQueueLeaveAction.cpp b/playerbot/strategy/actions/BgQueueLeaveAction.cpp
new file mode 100644
index 0000000..ee904ba
--- /dev/null
+++ b/playerbot/strategy/actions/BgQueueLeaveAction.cpp
@@ -0,0 +1,27 @@
+#include "playerbot/playerbot.h"
+#include "BgQueueLeaveAction.h"
+#include "playerbot/ServerFacade.h"
+#include "playerbot/strategy/values/BattlegroundSlots.h"
+#include "BattleGround/BattleGroundMgr.h"
+
+using namespace ai;
+
+bool BgQueueLeaveAction::Execute(Event& event)
+{
+    char const* reason = BattlegroundSlots::ShouldLeave(bot);
+    if (!reason)
+        return false;
+
+    int const queueType = AI_VALUE2(int, "manual int", "bg queue type");
+    BattleGroundTypeId const bgTypeId = sServerFacade.BgTemplateId(BattleGroundQueueTypeId(queueType));
+    time_t const waited = time(nullptr) - AI_VALUE2(time_t, "manual time", "bg queue since");
+
+    WorldPacket packet(CMSG_BATTLEFIELD_PORT, 20);
+    packet << uint32(GetBattleGrounMapIdByTypeId(bgTypeId)) << uint8(0);
+    bot->GetSession()->HandleBattlefieldPortOpcode(packet);
+
+    SET_AI_VALUE2(time_t, "manual time", "bg queue since", 0);
+    sLog.outString("BgSlots: Bot #%d %s:%d <%s> leaves its battleground queue after %d min: %s", bot->GetGUIDLow(), bot->GetTeam() == ALLIANCE ? "A" : "H",
+        bot->GetLevel(), bot->GetName(), int(waited / 60), reason);
+    return true;
+}
