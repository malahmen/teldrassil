@@ -145,6 +143,22 @@ bool GoalOpenValue::Calculate()
     if (activity == "gather" && !Goals::CanGather(bot))
         return false;
 
+    // Grinding below the cap waits for the bot's quests and for gathering it
+    // can do - the last thing to do, for XP (owner, 2026-11-04; Kamino 256).
+    // At the cap it does not wait. Waiting sets no cool-down.
+    if (activity == "grind" && bot->GetLevel() < sWorld.getConfig(CONFIG_UINT32_MAX_PLAYER_LEVEL))
